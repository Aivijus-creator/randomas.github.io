	local caption = textLabel(button, { Size = UDim2.new(1, -6, 0.3, 0), Position = UDim2.new(0, 3, 0.66, 0), Font = STYLE.TitleFont, TextColor3 = STYLE.Cream })
	bindText(caption, key)
