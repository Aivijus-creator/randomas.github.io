task.spawn(function()
	while player:GetAttribute("DataLoaded") ~= true do
		task.wait(0.5)
	end
	local ok, systemLocale = pcall(function()
		return game:GetService("LocalizationService").SystemLocaleId
	end)
	if ok and type(systemLocale) == "string" and systemLocale ~= "" then
