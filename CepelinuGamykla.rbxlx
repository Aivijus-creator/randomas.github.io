<Item class="ServerScriptService" referent="RBX69"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX40"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--[[
	Build – pagalbinės funkcijos modeliams iš Parts kurti (placeholder'iai, žemėlapis).
]]

local CollectionService = game:GetService("CollectionService")

local Build = {}

local SKIP = { Parent = true, Shape = true, Tags = true, Attributes = true }

-- Sukuria Part. props – bet kokios Part savybės + Parent, Shape, Tags, Attributes.
function Build.Part(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		part.Shape = props.Shape
	end
	for key, value in pairs(props) do
		if not SKIP[key] then
			part[key] = value
		end
	end
	if props.Tags then
		for _, tag in ipairs(props.Tags) do
			CollectionService:AddTag(part, tag)
		end
	end
	if props.Attributes then
		for key, value in pairs(props.Attributes) do
			part:SetAttribute(key, value)
		end
	end
	part.Parent = props.Parent
	return part
end

-- Tas pats, tik WedgePart
function Build.Wedge(props)
	local part = Instance.new("WedgePart")
	part.Anchored = true
	for key, value in pairs(props) do
		if not SKIP[key] then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

function Build.Model(name, parent)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.Folder(name, parent)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- Prideda SpecialMesh (pvz. elipsoidas iš Block dalies)
function Build.Mesh(part, meshType, scale)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = meshType
	if scale then
		mesh.Scale = scale
	end
	mesh.Parent = part
	return mesh
end

-- Pažymi TextLabel, kad klientas jį išverstų pagal žaidėjo kalbą.
-- args: { item = "Cepelinai_3" } -> verčiama kaip raktas (ArgKey_),
--       { name = "Jonas" }       -> paprastas tekstas (Arg_),
--       nums: { price = 50 }     -> sutrumpintas skaičius (ArgNum_).
function Build.Localize(label, key, args, nums, keys)
	label:SetAttribute("TextKey", key)
	if args then
		for name, value in pairs(args) do
			label:SetAttribute("Arg_" .. name, value)
		end
	end
	if nums then
		for name, value in pairs(nums) do
			label:SetAttribute("ArgNum_" .. name, value)
		end
	end
	if keys then
		for name, value in pairs(keys) do
			label:SetAttribute("ArgKey_" .. name, value)
		end
	end
	CollectionService:AddTag(label, "Loc")
end

-- BillboardGui su vienu TextLabel.
function Build.Billboard(parent, opts)
	opts = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = opts.Name or "Billboard"
	gui.Size = opts.Size or UDim2.fromScale(8, 2)
	gui.StudsOffset = opts.Offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = opts.AlwaysOnTop == true
	gui.MaxDistance = opts.MaxDistance or 120
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = parent

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = opts.Font or Enum.Font.Fondamento
	label.TextColor3 = opts.Color or Color3.fromRGB(255, 240, 200)
	label.TextStrokeTransparency = 0.15
	label.TextStrokeColor3 = Color3.fromRGB(45, 28, 12)
	label.Text = opts.Text or ""
	label.Parent = gui

	if opts.TextKey then
		Build.Localize(label, opts.TextKey, opts.Args, opts.Nums, opts.Keys)
	end
	return gui, label
end

-- Viduramžiška lentelė (pergamentas su mediniu rėmu) kaip BillboardGui
function Build.Sign(parent, opts)
	opts = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = opts.Name or "Sign"
	gui.Size = opts.Size or UDim2.fromScale(7, 2.2)
	gui.StudsOffset = opts.Offset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = opts.AlwaysOnTop == true
	gui.MaxDistance = opts.MaxDistance or 90
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = parent

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = opts.Background or Color3.fromRGB(232, 211, 162)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.15, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = opts.Border or Color3.fromRGB(92, 58, 30)
	stroke.Thickness = 3
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.86)
	label.Position = UDim2.fromScale(0.04, 0.07)
	label.TextScaled = true
	label.Font = opts.Font or Enum.Font.Fondamento
	label.TextColor3 = opts.Color or Color3.fromRGB(60, 35, 15)
	label.Text = opts.Text or ""
	label.Parent = frame

	if opts.TextKey then
		Build.Localize(label, opts.TextKey, opts.Args, opts.Nums, opts.Keys)
	end
	return gui, label
end

-- Pastato modelį taip, kad jo apačia būtų ant cf aukščio.
function Build.PlaceOnFloor(model, cf)
	model:PivotTo(cf)
	local bbCFrame, bbSize = model:GetBoundingBox()
	local bottom = bbCFrame.Position.Y - bbSize.Y / 2
	local delta = cf.Position.Y - bottom
	model:PivotTo(cf + Vector3.new(0, delta, 0))
end

-- Suvirina (WeldConstraint) visas modelio dalis prie root ir atanchorina jas.
function Build.WeldAll(model, root)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = d
			weld.Parent = d
			d.Anchored = false
		end
	end
end

-- Nustato modelio savybę visoms dalims
function Build.SetAll(model, prop, value)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d[prop] = value
		end
	end
end

return Build
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">DecorModels</string><ProtectedString name="Source"><![CDATA[--[[
	DecorModels – lentynos puošmenų modeliai sklype (Settings.GlobalUpgrades.Decor).
	Kiekviena funkcija(model) sudeda dalis vietinėmis koordinatėmis: (0,0,0) – apačios centras,
	priekis -Z kryptimi (į vartus / lobby).
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local WOOD = C(122, 82, 46)
local DARK_WOOD = C(78, 50, 26)
local GOLD = C(240, 195, 60)
local CYL_UP = CFrame.Angles(0, 0, math.rad(90))

local function p(model, name, size, cf, color, material, shape)
	return Build.Part({ Name = name, Parent = model, Size = size, CFrame = cf, Color = color, Material = material or M.SmoothPlastic, Shape = shape })
end

local DecorModels = {}

-- Gandralizdis: aukštas stulpas, lizdas, gandras ant vienos kojos
function DecorModels.StorkNest(model)
	p(model, "Pole", V(0.8, 12, 0.8), CF(0, 6, 0), DARK_WOOD, M.Wood)
	p(model, "Wheel", V(0.5, 4.4, 4.4), CF(0, 12.2, 0) * CYL_UP, C(110, 75, 45), M.Wood, Enum.PartType.Cylinder)
	-- Šakų lizdas
	for i = 0, 9 do
		local a = math.rad(i * 36)
		p(model, "Twig", V(0.25, 0.25, 2.6), CF(math.cos(a) * 1.6, 12.8, math.sin(a) * 1.6) * CFrame.Angles(0, -a, math.rad(8)), C(120, 90, 55), M.Wood)
	end
	p(model, "NestFill", V(0.6, 3.4, 3.4), CF(0, 12.7, 0) * CYL_UP, C(140, 105, 65), M.Grass, Enum.PartType.Cylinder)
	-- Gandras
	local white = C(245, 245, 240)
	local body = p(model, "StorkBody", V(1.2, 1.1, 2), CF(0, 14.4, 0) * CFrame.Angles(math.rad(-12), 0, 0), white)
	Build.Mesh(body, Enum.MeshType.Sphere)
	p(model, "StorkWingL", V(0.2, 0.7, 1.6), CF(-0.62, 14.5, 0.2), C(25, 25, 25))
	p(model, "StorkWingR", V(0.2, 0.7, 1.6), CF(0.62, 14.5, 0.2), C(25, 25, 25))
	p(model, "StorkNeck", V(0.3, 1.3, 0.3), CF(0, 15.3, -0.8) * CFrame.Angles(math.rad(-15), 0, 0), white)
	p(model, "StorkHead", V(0.5, 0.5, 0.5), CF(0, 16, -0.95), white, nil, Enum.PartType.Ball)
	p(model, "StorkBeak", V(0.15, 0.15, 1.1), CF(0, 15.9, -1.6) * CFrame.Angles(math.rad(12), 0, 0), C(225, 60, 40))
	p(model, "StorkLeg", V(0.12, 1.2, 0.12), CF(0.15, 13.4, 0), C(225, 60, 40))
	p(model, "StorkEyeL", V(0.08, 0.08, 0.08), CF(-0.22, 16.08, -1.1), C(10, 10, 10), nil, Enum.PartType.Ball)
	p(model, "StorkEyeR", V(0.08, 0.08, 0.08), CF(0.22, 16.08, -1.1), C(10, 10, 10), nil, Enum.PartType.Ball)
end

-- Rūtų darželis: tvorelė iš statinių ir žalios rūtos su geltonais žiedeliais
function DecorModels.RueGarden(model)
	p(model, "Bed", V(9, 0.5, 5), CF(0, 0.25, 0), C(95, 65, 40), M.Ground)
	for i = 0, 17 do
		local x = -4.5 + (i % 9) * 1.125
		local z = i < 9 and -2.5 or 2.5
		p(model, "Picket", V(0.3, 1.4, 0.3), CF(x, 0.7, z), WOOD, M.Wood)
	end
	for _, x in ipairs({ -4.5, 4.5 }) do
		for k = 0, 3 do
			p(model, "Picket", V(0.3, 1.4, 0.3), CF(x, 0.7, -1.5 + k), WOOD, M.Wood)
		end
	end
	p(model, "Rail", V(9, 0.2, 0.2), CF(0, 1.1, -2.5), DARK_WOOD, M.Wood)
	p(model, "Rail", V(9, 0.2, 0.2), CF(0, 1.1, 2.5), DARK_WOOD, M.Wood)
	for row = 0, 1 do
		for i = 0, 5 do
			local x = -3.4 + i * 1.36
			local z = -0.9 + row * 1.8
			local bush = p(model, "Rue", V(1.1, 0.9, 1.1), CF(x, 0.95, z), C(95, 140, 90), M.Grass)
			Build.Mesh(bush, Enum.MeshType.Sphere)
			p(model, "RueFlower", V(0.22, 0.22, 0.22), CF(x + 0.2, 1.45, z - 0.1), C(240, 210, 60), nil, Enum.PartType.Ball)
		end
	end
end

-- Šulinys su svirtimi (lietuviškas „svirtis“)
function DecorModels.Well(model)
	local stone = C(130, 125, 115)
	p(model, "WellRing", V(2.6, 3.6, 3.6), CF(0, 1.3, 0) * CYL_UP, stone, M.Cobblestone, Enum.PartType.Cylinder)
	p(model, "Water", V(0.1, 2.9, 2.9), CF(0, 2.45, 0) * CYL_UP, C(60, 110, 150), M.Glass, Enum.PartType.Cylinder)
	-- Svirties stulpas ir ilga svirtis
	p(model, "Post", V(0.6, 7, 0.6), CF(3.5, 3.5, 0), DARK_WOOD, M.Wood)
	p(model, "Fork", V(0.2, 0.8, 0.8), CF(3.5, 7.2, 0), DARK_WOOD, M.Wood)
	local lever = CF(3.5, 7.2, 0) * CFrame.Angles(0, 0, math.rad(-28))
	p(model, "Lever", V(11, 0.35, 0.35), lever * CF(-1.5, 0, 0), WOOD, M.Wood)
	p(model, "Weight", V(0.9, 0.9, 0.9), lever * CF(3.6, -0.3, 0), stone, M.Slate)
	local tip = (lever * CF(-7, 0, 0)).Position
	p(model, "Rope", V(0.12, tip.Y - 3.4, 0.12), CF(tip.X, (tip.Y + 3.4) / 2, 0), C(170, 140, 90), M.Fabric)
	p(model, "Bucket", V(0.9, 0.8, 0.8), CF(tip.X, 3.3, 0) * CYL_UP, C(110, 80, 50), M.Wood, Enum.PartType.Cylinder)
end

-- Gintariniai žibintai abipus įėjimo
function DecorModels.AmberLanterns(model)
	for _, x in ipairs({ -10.5, 10.5 }) do
		for _, z in ipairs({ -4, 4 }) do
			p(model, "LanternPost", V(0.5, 6, 0.5), CF(x, 3, z), C(45, 40, 38), M.Metal)
			p(model, "LanternCap", V(1.4, 0.3, 1.4), CF(x, 7.3, z), C(45, 40, 38), M.Metal)
			local amber = p(model, "Amber", V(1, 1.2, 1), CF(x, 6.55, z), C(255, 160, 40), M.Neon)
			amber.Transparency = 0.15
			local light = Instance.new("PointLight")
			light.Color = C(255, 170, 70)
			light.Range = 14
			light.Brightness = 1.4
			light.Shadows = false
			light.Parent = amber
		end
	end
end

-- Auksinis Vytis: raitelis su kardu ir skydu ant marmurinio postamento
function DecorModels.VytisStatue(model)
	local marble = C(235, 230, 220)
	p(model, "Pedestal", V(6, 2.4, 3.6), CF(0, 1.2, 0), marble, M.Marble)
	p(model, "PedestalTop", V(6.4, 0.3, 4), CF(0, 2.55, 0), marble, M.Marble)
	-- Žirgas (stovi šonu, galva į kairę, šuolio poza)
	p(model, "HorseBody", V(4, 1.6, 1.4), CF(0, 4.6, 0) * CFrame.Angles(0, 0, math.rad(8)), GOLD, M.Metal)
	p(model, "HorseNeck", V(0.9, 1.8, 0.9), CF(-2, 5.8, 0) * CFrame.Angles(0, 0, math.rad(30)), GOLD, M.Metal)
	p(model, "HorseHead", V(1.5, 0.7, 0.7), CF(-2.7, 6.6, 0) * CFrame.Angles(0, 0, math.rad(-20)), GOLD, M.Metal)
	for _, leg in ipairs({ { -1.4, -0.45, 25 }, { -1.4, 0.45, 40 }, { 1.4, -0.45, -10 }, { 1.4, 0.45, 5 } }) do
		p(model, "HorseLeg", V(0.35, 1.9, 0.35), CF(leg[1], 3.4, leg[2]) * CFrame.Angles(0, 0, math.rad(leg[3])), GOLD, M.Metal)
	end
	p(model, "HorseTail", V(0.3, 1.6, 0.3), CF(2.2, 4.6, 0) * CFrame.Angles(0, 0, math.rad(-35)), GOLD, M.Metal)
	-- Raitelis
	p(model, "RiderBody", V(1, 1.6, 0.9), CF(0.2, 6.1, 0), GOLD, M.Metal)
	p(model, "RiderHead", V(0.7, 0.7, 0.7), CF(0.2, 7.25, 0), GOLD, M.Metal, Enum.PartType.Ball)
	p(model, "RiderHelmet", V(0.75, 0.4, 0.75), CF(0.2, 7.6, 0), GOLD, M.Metal)
	p(model, "Sword", V(0.2, 2.6, 0.2), CF(-0.6, 7.9, -0.3) * CFrame.Angles(0, 0, math.rad(30)), C(230, 230, 240), M.Metal)
	-- Skydas su dvigubu kryžiumi (priekyje, -Z)
	p(model, "Shield", V(1.1, 1.3, 0.15), CF(0.25, 6.0, -0.55), C(190, 35, 40), M.Metal)
	p(model, "CrossV", V(0.14, 0.9, 0.05), CF(0.25, 6.0, -0.65), GOLD, M.Neon)
	p(model, "CrossH1", V(0.6, 0.12, 0.05), CF(0.25, 6.2, -0.65), GOLD, M.Neon)
	p(model, "CrossH2", V(0.45, 0.12, 0.05), CF(0.25, 5.95, -0.65), GOLD, M.Neon)
	local light = Instance.new("PointLight")
	light.Color = C(255, 210, 120)
	light.Range = 16
	light.Brightness = 1.2
	light.Parent = model:FindFirstChild("RiderHead")
end

return DecorModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">FoodLooks</string><ProtectedString name="Source"><![CDATA[--[[
	FoodLooks – kaip atrodo produktas po kiekvieno apdorojimo (upgrader'io) konvejeryje.
	ProductLines upgrader'iuose nurodomas ItemLook = "<pavadinimas>" – tada produktas
	visiškai perpiešiamas: šaknis (fizikos dalis) tampa nematoma pagrindo plokštele,
	o viskas, kas matosi, – privirintos smulkios dalys ("Detail").

	FoodLooks.Apply(root, lookName) – grąžina true, jei toks vaizdas yra.
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local SPHERE = "sphere"
local CYL = "cyl"          -- stačias cilindras (Part.Shape = Cylinder, pasuktas aukštyn)
local BALL = "ball"
local CYL_UP = CFrame.Angles(0, 0, math.rad(90))

local FoodLooks = {}

-- Privirinta dekoratyvi dalis (be fizikos). offset – nuo šaknies apačios centro.
local function d(root, size, offset, color, material, kind, rot)
	local part = Instance.new("Part")
	part.Name = "Detail"
	part.Color = color
	part.Material = material or M.SmoothPlastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local cf = root.CFrame * CF(0, -root.Size.Y / 2, 0) * offset
	if kind == CYL then
		part.Shape = Enum.PartType.Cylinder
		part.Size = V(size.Y, size.X, size.Z)
		cf = cf * CYL_UP
	elseif kind == BALL then
		part.Shape = Enum.PartType.Ball
		part.Size = size
	else
		part.Size = size
	end
	if rot then
		cf = cf * rot
	end
	part.CFrame = cf
	if kind == SPHERE then
		Build.Mesh(part, Enum.MeshType.Sphere)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = root
	return part
end

-- Šaknis – nematomas pagrindas nurodyto dydžio
local function base(root, size, color)
	root.Transparency = 1
	root.Size = size
	root.Color = color
	local mesh = root:FindFirstChildOfClass("SpecialMesh")
	if mesh then
		mesh:Destroy()
	end
end

----------------------------------------------------------------------
-- Bendros dalys
----------------------------------------------------------------------
local WHITE_PLATE = C(248, 248, 244)

local function plate(root, diameter, color)
	d(root, V(diameter, 0.14, diameter), CF(0, 0.07, 0), color or WHITE_PLATE, M.SmoothPlastic, CYL)
end

-- Gilus baltas dubenėlis su sriubos paviršiumi
local function bowl(root, soupColor, rimColor)
	rimColor = rimColor or C(250, 250, 248)
	d(root, V(1.4, 0.42, 1.4), CF(0, 0.21, 0), rimColor, M.SmoothPlastic, CYL)
	d(root, V(1.85, 0.35, 1.85), CF(0, 0.6, 0), rimColor, M.SmoothPlastic, CYL)
	d(root, V(1.95, 0.08, 1.95), CF(0, 0.76, 0), C(70, 120, 190), M.SmoothPlastic, CYL)        -- mėlynas kraštas
	d(root, V(1.7, 0.06, 1.7), CF(0, 0.81, 0), soupColor, M.SmoothPlastic, CYL)              -- sriubos paviršius (virš krašto)
end

local function cepelinas(root, color, material, y, length)
	length = length or 1.9
	d(root, V(length, 0.95, 1.05), CF(0, y or 0.5, 0), color, material or M.SmoothPlastic, SPHERE)
end

local function sourCream(root, x, y, z)
	d(root, V(0.75, 0.3, 0.6), CF(x, y, z), C(252, 252, 246), M.SmoothPlastic, SPHERE)
end

local function spirgai(root, y)
	for i, off in ipairs({ { -0.35, 0.1 }, { 0.3, -0.12 }, { 0.05, 0.2 } }) do
		d(root, V(0.16, 0.12, 0.16), CF(off[1], y + (i % 2) * 0.04, off[2]), C(150, 85, 40), M.SmoothPlastic)
	end
end

local function dill(root, y, spots)
	for i = 1, math.min(spots or 2, 2) do
		local a = i * 2.3
		d(root, V(0.22, 0.03, 0.1), CF(math.cos(a) * 0.45, y, math.sin(a) * 0.4), C(70, 150, 60), M.Grass, nil, CFrame.Angles(0, a, 0))
	end
end

local function shreds(root, color, y, count, spread)
	for i = 1, math.min(count, 4) do
		local a = i * 2.4
		local r = (i % 3) * 0.18 + 0.05
		d(root, V(0.5, 0.06, 0.08), CF(math.cos(a) * r * spread, y + (i % 4) * 0.05, math.sin(a) * r * spread), color, M.SmoothPlastic, nil, CFrame.Angles(0, a, math.rad(10)))
	end
end

----------------------------------------------------------------------
-- Cepelinai
----------------------------------------------------------------------
local L = {}

L.GratedPotato = function(root)
	base(root, V(1.5, 0.4, 1.5), C(232, 218, 170))
	d(root, V(1.5, 0.55, 1.4), CF(0, 0.25, 0), C(232, 218, 170), M.Sand, SPHERE)
	shreds(root, C(240, 228, 185), 0.48, 9, 1)
end

L.PotatoMeat = function(root)
	base(root, V(1.4, 0.5, 1.4), C(225, 212, 175))
	d(root, V(1.45, 0.95, 1.35), CF(0, 0.45, 0), C(225, 212, 175), M.Sand, SPHERE)
	d(root, V(0.7, 0.35, 0.6), CF(0.05, 0.88, 0), C(190, 110, 95), M.Sand, SPHERE)               -- mėsos įdaras viršuje
end

L.CepelinasRaw = function(root)
	base(root, V(1.8, 0.5, 1.0), C(205, 200, 185))
	cepelinas(root, C(205, 200, 185), M.Sand, 0.45)
end

L.CepelinasBoiled = function(root)
	base(root, V(1.8, 0.5, 1.0), C(228, 224, 210))
	cepelinas(root, C(228, 224, 210), M.SmoothPlastic, 0.45)
end

L.CepelinasServed = function(root)
	base(root, V(2.2, 0.2, 2.2), WHITE_PLATE)
	plate(root, 2.3)
	cepelinas(root, C(228, 224, 210), M.SmoothPlastic, 0.62, 1.8)
	sourCream(root, 0.15, 1.08, 0)
	spirgai(root, 1.05)
	dill(root, 1.12, 3)
end

----------------------------------------------------------------------
-- Kibinai (pusmėnulio formos pyragėliai su „kasele“ viršuje)
----------------------------------------------------------------------
local function kibinas(root, color, crimpColor, y)
	d(root, V(1.9, 0.75, 1.05), CF(0, y, 0), color, M.SmoothPlastic, SPHERE)
	for i = -1.5, 1.5 do
		d(root, V(0.32, 0.22, 0.28), CF(i * 0.36, y + 0.35 - math.abs(i) * 0.03, 0), crimpColor, M.SmoothPlastic, SPHERE, CFrame.Angles(0, 0, math.rad(35)))
	end
end

L.DoughSheet = function(root)
	base(root, V(1.7, 0.25, 1.7), C(240, 232, 212))
	d(root, V(1.8, 0.18, 1.8), CF(0, 0.12, 0), C(240, 232, 212), M.Sand, CYL)
	d(root, V(0.9, 0.04, 0.7), CF(-0.3, 0.22, 0.2), C(252, 250, 244), M.Sand, SPHERE)             -- miltai
end

L.DoughFilled = function(root)
	L.DoughSheet(root)
	d(root, V(0.95, 0.35, 0.75), CF(0.25, 0.32, 0), C(175, 105, 85), M.Sand, SPHERE)              -- aviena
	d(root, V(0.2, 0.06, 0.2), CF(0.35, 0.48, 0.1), C(240, 230, 200), M.SmoothPlastic, BALL)       -- svogūnas
end

L.KibinasRaw = function(root)
	base(root, V(1.8, 0.4, 1.0), C(235, 215, 175))
	kibinas(root, C(235, 215, 175), C(225, 200, 160), 0.38)
end

L.KibinasBaked = function(root)
	base(root, V(1.8, 0.4, 1.0), C(200, 135, 60))
	kibinas(root, C(205, 140, 62), C(160, 95, 38), 0.38)
end

L.KibinasServed = function(root)
	base(root, V(2.2, 0.2, 1.7), C(245, 240, 230))
	d(root, V(2.2, 0.08, 1.7), CF(0, 0.04, 0), C(245, 240, 230), M.Fabric)                      -- lininė servetėlė
	kibinas(root, C(205, 140, 62), C(160, 95, 38), 0.45)
	d(root, V(0.28, 0.06, 0.28), CF(0.55, 0.8, 0.1), C(200, 40, 40), M.SmoothPlastic, CYL)        -- Trakų antspaudas
end

----------------------------------------------------------------------
-- Šaltibarščiai (sriuba dubenėlyje)
----------------------------------------------------------------------
local PINK = C(240, 105, 170)

L.GratedBeet = function(root)
	base(root, V(1.4, 0.4, 1.4), C(150, 25, 70))
	d(root, V(1.4, 0.5, 1.3), CF(0, 0.22, 0), C(150, 25, 70), M.SmoothPlastic, SPHERE)
	shreds(root, C(175, 35, 85), 0.42, 10, 1)
end

L.SoupBowl = function(root)
	base(root, V(1.8, 0.5, 1.8), PINK)
	bowl(root, PINK)
	shreds(root, C(200, 60, 120), 0.84, 2, 0.8)
end

L.SoupCucumber = function(root)
	L.SoupBowl(root)
	for i = 1, 2 do
		local a = i * 2.3
		d(root, V(0.3, 0.08, 0.16), CF(math.cos(a) * 0.45, 0.85, math.sin(a) * 0.45), C(120, 190, 90), M.SmoothPlastic)
	end
	dill(root, 0.85, 2)
end

local function eggHalves(root, y)
	d(root, V(0.5, 0.18, 0.38), CF(0.1, y, 0.15), C(255, 252, 245), M.SmoothPlastic, SPHERE)
	d(root, V(0.22, 0.08, 0.22), CF(0.1, y + 0.07, 0.15), C(255, 195, 40), M.SmoothPlastic, SPHERE)
end

L.SoupEgg = function(root)
	L.SoupCucumber(root)
	eggHalves(root, 0.88)
end

L.SoupChilled = function(root)
	base(root, V(1.8, 0.5, 1.8), PINK)
	bowl(root, C(245, 120, 180), C(235, 245, 255))
	eggHalves(root, 0.88)
	dill(root, 0.85, 2)
	for i = 1, 1 do
		local ice = d(root, V(0.28, 0.24, 0.28), CF(-0.5 + i * 0.35, 0.88, -0.35), C(220, 240, 255), M.Glass, nil, CFrame.Angles(0, i, 0.3))
		ice.Transparency = 0.35
	end
end

L.SoupWithPotatoes = function(root)
	base(root, V(2.3, 0.2, 2.3), WHITE_PLATE)
	plate(root, 2.4)
	-- Dubenėlis ant lėkštės (šiek tiek į šoną)
	d(root, V(1.2, 0.4, 1.2), CF(-0.35, 0.36, 0), C(250, 250, 248), M.SmoothPlastic, CYL)
	d(root, V(1.55, 0.3, 1.55), CF(-0.35, 0.68, 0), C(250, 250, 248), M.SmoothPlastic, CYL)
	d(root, V(1.62, 0.06, 1.62), CF(-0.35, 0.81, 0), C(70, 120, 190), M.SmoothPlastic, CYL)
	d(root, V(1.42, 0.06, 1.42), CF(-0.35, 0.86, 0), PINK, M.SmoothPlastic, CYL)
	d(root, V(0.4, 0.15, 0.3), CF(-0.35, 0.93, 0.1), C(255, 252, 245), M.SmoothPlastic, SPHERE)
	d(root, V(0.18, 0.07, 0.18), CF(-0.35, 0.99, 0.1), C(255, 195, 40), M.SmoothPlastic, SPHERE)
	-- Karštos bulvės su krapais šalia
	for i, off in ipairs({ { 0.75, 0.35 }, { 0.8, -0.3 }, { 0.45, -0.75 } }) do
		d(root, V(0.55, 0.42, 0.48), CF(off[1], 0.38, off[2]), C(240, 205, 120), M.SmoothPlastic, SPHERE, CFrame.Angles(0, i, 0))
	end
end

----------------------------------------------------------------------
-- Šakotis (kūgis su traškiomis „šakomis“)
----------------------------------------------------------------------
local DOUGH = C(225, 172, 80)
local CRUST = C(165, 100, 38)

local function sakotisCone(root, y0, height, width, spikeLen, sugar)
	-- 3 sluoksniai po 2–3 „šakas“ (nedaug dalių – konvejeryje jų daug)
	local layers = 3
	local spikeColor = sugar and C(235, 215, 185) or CRUST   -- cukraus pudra ant šakų
	for i = 0, layers - 1 do
		local t = i / (layers - 1)
		local diameter = width * (1 - t * 0.6)
		local ly = y0 + (i + 0.5) * height / layers
		d(root, V(diameter, height / layers * 0.95, diameter), CF(0, ly, 0), i % 2 == 0 and DOUGH or CRUST, M.SmoothPlastic, CYL)
		local spikes = i < 2 and 3 or 2
		for k = 0, spikes - 1 do
			local a = k * (2 * math.pi / spikes) + i * 0.9
			local r = diameter / 2 + spikeLen * 0.3
			d(root, V(0.16, 0.16, spikeLen), CF(math.cos(a) * r, ly, math.sin(a) * r), spikeColor, M.SmoothPlastic, nil, CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(math.rad(-28), 0, 0))
		end
	end
	d(root, V(0.25, 0.2, 0.25), CF(0, y0 + height + 0.05, 0), CRUST, M.SmoothPlastic, SPHERE)
end

L.BatterWhipped = function(root)
	base(root, V(1.6, 0.4, 1.6), C(250, 235, 160))
	d(root, V(1.2, 0.3, 1.2), CF(0, 0.15, 0), C(200, 200, 205), M.Metal, CYL)
	d(root, V(1.55, 0.35, 1.55), CF(0, 0.45, 0), C(200, 200, 205), M.Metal, CYL)
	d(root, V(1.4, 0.55, 1.4), CF(0, 0.7, 0), C(252, 238, 170), M.SmoothPlastic, SPHERE)     -- puri tešla
end

L.SakotisSpit = function(root)
	base(root, V(1.2, 0.3, 1.2), C(235, 200, 110))
	d(root, V(0.16, 2.0, 0.16), CF(0, 1.0, 0), C(120, 85, 50), M.Wood, CYL)                      -- iešmas
	for i = 0, 3 do
		local w = 1.1 - i * 0.18
		d(root, V(w, 0.32, w), CF(0, 0.35 + i * 0.32, 0), C(240, 210, 120), M.SmoothPlastic, CYL)
	end
end

L.SakotisBaked = function(root)
	base(root, V(1.3, 0.2, 1.3), DOUGH)
	sakotisCone(root, 0, 1.7, 1.25, 0.4, false)
end

L.SakotisSugar = function(root)
	base(root, V(1.3, 0.2, 1.3), DOUGH)
	sakotisCone(root, 0, 1.7, 1.25, 0.4, true)
end

L.SakotisBranches = function(root)
	base(root, V(1.4, 0.2, 1.4), DOUGH)
	sakotisCone(root, 0, 2.1, 1.35, 0.6, true)
end

L.SakotisFestive = function(root)
	base(root, V(1.9, 0.2, 1.9), C(150, 105, 60))
	d(root, V(1.9, 0.16, 1.9), CF(0, 0.08, 0), C(150, 105, 60), M.Wood, CYL)                     -- medinis padėklas
	sakotisCone(root, 0.16, 2.1, 1.35, 0.6, true)
	-- Šventinis kaspinas su kilpa
	d(root, V(1.42, 0.14, 1.42), CF(0, 0.45, 0), C(200, 30, 40), M.Fabric, CYL)
	d(root, V(0.4, 0.35, 0.14), CF(0, 0.5, -0.72), C(200, 30, 40), M.Fabric, nil, CFrame.Angles(0, 0, math.rad(45)))
end

----------------------------------------------------------------------
-- Auksinis Cepelinas
----------------------------------------------------------------------
local GOLD = C(255, 205, 60)

L.GoldenGrated = function(root)
	base(root, V(1.5, 0.4, 1.5), GOLD)
	d(root, V(1.5, 0.55, 1.4), CF(0, 0.25, 0), GOLD, M.Metal, SPHERE)
	shreds(root, C(255, 225, 110), 0.48, 9, 1)
end

L.GoldenAmber = function(root)
	base(root, V(1.4, 0.5, 1.4), GOLD)
	d(root, V(1.45, 0.95, 1.35), CF(0, 0.45, 0), GOLD, M.Metal, SPHERE)
	local amber = d(root, V(0.55, 0.45, 0.5), CF(0.1, 0.9, 0), C(255, 150, 30), M.Glass, nil, CFrame.Angles(0.4, 0.7, 0.2))
	amber.Transparency = 0.15
end

L.GoldenCepelinas = function(root)
	base(root, V(1.8, 0.5, 1.0), GOLD)
	cepelinas(root, C(255, 215, 80), M.Metal, 0.45)
end

L.GoldenRoyal = function(root)
	base(root, V(2.2, 0.2, 2.2), GOLD)
	plate(root, 2.3, C(240, 190, 50))
	cepelinas(root, C(255, 215, 0), M.Neon, 0.62, 1.8)
	-- Maža karūnėlė ant viršaus
	d(root, V(0.6, 0.18, 0.6), CF(0, 1.15, 0), C(255, 200, 40), M.Metal, CYL)
	for k = 0, 2 do
		local a = k * 2 * math.pi / 3
		d(root, V(0.1, 0.22, 0.1), CF(math.cos(a) * 0.26, 1.33, math.sin(a) * 0.26), C(255, 200, 40), M.Metal)
	end
	d(root, V(0.14, 0.14, 0.14), CF(0, 1.3, 0), C(200, 30, 40), M.Neon, BALL)
end

function FoodLooks.Apply(root, lookName)
	local look = L[lookName]
	if not look then
		return false
	end
	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "Detail" or child.Name == "Topping" then
			child:Destroy()
		end
	end
	look(root)
	return true
end

FoodLooks.Names = L

return FoodLooks
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">GateModels</string><ProtectedString name="Source"><![CDATA[--[[
	GateModels – sklypo vartų išvaizda pagal lygį (lentynos patobulinimas „Vartai“):
	  0 – rąstų vartai (pradžia): apvalūs rąstai su nusmailintomis viršūnėmis
	  1 – dailidės vartai: tašyti stulpai su kepurėmis, gontų stogelis, saulutė
	  2 – plytų vartai: raudonų plytų bokštai su dantytais viršais ir arka
	Visi bokštai ~12 studų aukščio (ant jų stovi fakelai ir vėliava).

	GateModels.Build(parent, plotCF, level, gateX, gateZ, gateWidth)
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local CYL_UP = CFrame.Angles(0, 0, math.rad(90))

local GateModels = {}

local function p(parent, plotCF, name, size, cf, color, material, shape)
	return Build.Part({ Name = name, Parent = parent, Size = size, CFrame = plotCF * cf, Color = color, Material = material, Shape = shape })
end

local function logGate(parent, plotCF, gateX, z, width)
	local log = C(125, 88, 52)
	for _, side in ipairs({ -1, 1 }) do
		local x = side * gateX
		for k, off in ipairs({ { -0.7, -0.5 }, { 0.7, -0.5 }, { 0, 0.7 } }) do
			local h = 10.5 + (k % 2) * 0.8
			p(parent, plotCF, "GateLog", V(h, 1.4, 1.4), CF(x + off[1], h / 2, z + off[2]) * CYL_UP, log, M.Wood, Enum.PartType.Cylinder)
			for t = 0, 2 do
				local d = 1.2 - t * 0.35
				p(parent, plotCF, "GateLogTip", V(0.35, d, d), CF(x + off[1], h + 0.15 + t * 0.32, z + off[2]) * CYL_UP, log:Lerp(C(80, 55, 30), 0.3), M.Wood, Enum.PartType.Cylinder)
			end
		end
		-- Virvės raištis
		p(parent, plotCF, "GateRope", V(0.5, 3.2, 3.2), CF(x, 7.5, z) * CYL_UP, C(190, 160, 110), M.Fabric, Enum.PartType.Cylinder)
		p(parent, plotCF, "GateTop", V(2.6, 0.5, 2.6), CF(x, 11.6, z), log, M.Wood)
	end
	p(parent, plotCF, "GateBeamLog", V(width + 6, 1.6, 1.6), CF(0, 11, z), log, M.Wood, Enum.PartType.Cylinder)
end

local function carvedGate(parent, plotCF, gateX, z, width)
	local wood = C(150, 100, 55)
	local dark = C(90, 58, 30)
	for _, side in ipairs({ -1, 1 }) do
		local x = side * gateX
		p(parent, plotCF, "GatePost", V(2.6, 11.4, 2.6), CF(x, 5.7, z), wood, M.WoodPlanks)
		for _, dx in ipairs({ -1.25, 1.25 }) do
			for _, dz in ipairs({ -1.25, 1.25 }) do
				p(parent, plotCF, "GatePostTrim", V(0.3, 11.4, 0.3), CF(x + dx, 5.7, z + dz), dark, M.Wood)
			end
		end
		-- Išdrožinėti rombai stulpo priekyje
		for k = 0, 3 do
			p(parent, plotCF, "GateCarving", V(0.6, 0.6, 0.12), CF(x, 3 + k * 1.8, z - 1.36) * CFrame.Angles(0, 0, math.rad(45)), C(230, 190, 110), M.Wood)
		end
		-- Piramidinė kepurė
		p(parent, plotCF, "GatePostCap", V(3.2, 0.5, 3.2), CF(x, 11.65, z), dark, M.Wood)
		p(parent, plotCF, "GatePostCap2", V(2.2, 0.5, 2.2), CF(x, 12.1, z), dark, M.Wood)
	end
	p(parent, plotCF, "GateBeamCarved", V(width + 7, 1.8, 2.2), CF(0, 11, z), wood, M.WoodPlanks)
	-- Gontų stogelis virš sijos
	for _, side in ipairs({ -1, 1 }) do
		p(parent, plotCF, "GateRoof", V(width + 8, 0.35, 2.4), CF(0, 12.55, z + side * 0.95) * CFrame.Angles(math.rad(side * 28), 0, 0), C(95, 60, 40), M.WoodPlanks)
	end
	p(parent, plotCF, "GateRidge", V(width + 8.2, 0.35, 0.35), CF(0, 13.15, z), dark, M.Wood)
	-- Saulutė (tradicinis lietuviškas ornamentas) sijos viduryje
	p(parent, plotCF, "GateSun", V(0.15, 1.3, 1.3), CF(0, 11, z - 1.2) * CFrame.Angles(0, math.rad(90), 0), C(240, 190, 60), M.Wood, Enum.PartType.Cylinder)
	for k = 0, 7 do
		local a = k * math.pi / 4
		p(parent, plotCF, "GateSunRay", V(0.18, 0.7, 0.1), CF(math.cos(a) * 0.95, 11 + math.sin(a) * 0.95, z - 1.2) * CFrame.Angles(0, 0, a - math.pi / 2), C(240, 190, 60), M.Wood)
	end
end

local function brickGate(parent, plotCF, gateX, z, width)
	local brick = C(165, 65, 48)
	local stone = C(200, 190, 175)
	for _, side in ipairs({ -1, 1 }) do
		local x = side * gateX
		p(parent, plotCF, "GateTower", V(4, 12, 4), CF(x, 6, z), brick, M.Brick)
		p(parent, plotCF, "GateTowerBase", V(4.4, 1.2, 4.4), CF(x, 0.6, z), stone, M.Limestone)
		p(parent, plotCF, "GateTowerBand", V(4.3, 0.4, 4.3), CF(x, 11.6, z), stone, M.Limestone)
		for _, dx in ipairs({ -1.4, 1.4 }) do
			for _, dz in ipairs({ -1.4, 1.4 }) do
				p(parent, plotCF, "Crenel", V(1.1, 1.2, 1.1), CF(x + dx, 12.6, z + dz), brick, M.Brick)
			end
		end
		p(parent, plotCF, "GateWindow", V(0.6, 1.4, 0.15), CF(x, 8, z - 2.05), C(30, 22, 18), M.SmoothPlastic)
	end
	p(parent, plotCF, "GateBeamBrick", V(width + 8, 2, 3), CF(0, 11, z), brick, M.Brick)
	p(parent, plotCF, "GateArch", V(width + 4.2, 0.6, 3.2), CF(0, 9.8, z), stone, M.Limestone)
	for i = -2, 2 do
		p(parent, plotCF, "GateArchStone", V(0.5, 0.9, 3.25), CF(i * 2.2, 9.6, z), stone:Lerp(C(150, 140, 125), 0.3), M.Limestone)
	end
end

local BUILDERS = { [0] = logGate, [1] = carvedGate, [2] = brickGate }

function GateModels.Build(parent, plotCF, level, gateX, gateZ, gateWidth)
	local builder = BUILDERS[level] or logGate
	builder(parent, plotCF, gateX, gateZ, gateWidth)
end

return GateModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">GrannyModels</string><ProtectedString name="Source"><![CDATA[--[[
	GrannyModels – trijų lygių močiučių modeliai iš Parts (pagal pateiktus dizaino paveikslėlius):
	  1 – Paprasta močiutė: raudona taškuota skarelė, rudi akiniai, žalias megztinis,
	      balta palaidinė su tautiniu raštu, ruda sijonas, prijuostė, krepšys su musmirėmis, žolės pagrindas.
	  2 – Superinė močiutė: geltoni plaukai, raudoni akiniai, žalias kostiumas su „M“ ženklu,
	      raudonas apsiaustas, raudonos kelnės ir batai, iškeltas kočėlas, mėlynas pagrindas su geltonu žiedu.
	  3 – Legendinė močiutė: violetinė kepurė su aukso taškais ir karūna, auksinė mantija,
	      bordo suknelė su auksiniais rombais, vėrinys, gintarinė lazda, sklandantys aukso kubeliai,
	      violetinis pagrindas su auksiniu žiedu.
	Modelio priekis – -Z. Kojos ant Y = 0, pagrindas žemiau (Y nuo -0,4 iki 0).
	Rankos sujungtos Motor6D (RightShoulder / LeftShoulder) – klientas jas animuoja.
]]

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local NormalId = Enum.NormalId

local GrannyModels = {}

local LT_YELLOW = C(253, 185, 19)
local LT_GREEN = C(0, 106, 68)
local LT_RED = C(193, 39, 45)
local AMBER = C(255, 150, 30)
local SKIN = C(240, 200, 165)
local TORSO_CF = CF(0, 2.75, 0)
local TORSO_SIZE = V(2, 1.9, 1)
local ARM_SIZE = V(0.95, 1.9, 0.95)
local HEAD_CF = CF(0, 4.6, 0)
local HEAD_SIZE = V(1.8, 1.8, 1.8)

----------------------------------------------------------------------
-- Pagalbinės
----------------------------------------------------------------------
local function part(model, name, size, cframe, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = model
	return p
end

local function weld(base, p)
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
end

local function mesh(p, meshType)
	local m = Instance.new("SpecialMesh")
	m.MeshType = meshType
	m.Parent = p
end

local function faceSize(p, face)
	local s = p.Size
	if face == NormalId.Front or face == NormalId.Back then
		return s.X, s.Y
	elseif face == NormalId.Left or face == NormalId.Right then
		return s.Z, s.Y
	end
	return s.X, s.Z
end

-- Plona plokštelė ant detalės paviršiaus (veidai, raštai, taškai – tikros 3D dalys).
-- u – į dešinę žiūrint į paviršių, v – aukštyn (studais nuo paviršiaus centro).
local function decal(base, face, u, v, w, h, color, opts)
	opts = opts or {}
	local t = opts.Thickness or 0.04
	local s = base.Size
	local angle = math.rad(opts.Rotation or 0)
	local offset, size, spin
	if face == NormalId.Front then
		offset, size, spin = CF(-u, v, -s.Z / 2 - t / 2), V(w, h, t), CFrame.Angles(0, 0, angle)
	elseif face == NormalId.Back then
		offset, size, spin = CF(u, v, s.Z / 2 + t / 2), V(w, h, t), CFrame.Angles(0, 0, angle)
	elseif face == NormalId.Right then
		offset, size, spin = CF(s.X / 2 + t / 2, v, -u), V(t, h, w), CFrame.Angles(angle, 0, 0)
	elseif face == NormalId.Left then
		offset, size, spin = CF(-s.X / 2 - t / 2, v, u), V(t, h, w), CFrame.Angles(angle, 0, 0)
	else -- Top
		offset, size, spin = CF(u, s.Y / 2 + t / 2, v), V(w, t, h), CFrame.Angles(0, angle, 0)
	end
	local shape = nil
	if opts.Round then
		shape = Enum.PartType.Cylinder
		if face == NormalId.Front or face == NormalId.Back then
			size, spin = V(t, h, w), CFrame.Angles(0, math.rad(90), 0)
		elseif face == NormalId.Top or face == NormalId.Bottom then
			size, spin = V(t, w, h), CFrame.Angles(0, 0, math.rad(90))
		else
			size, spin = V(t, h, w), CFrame.new()
		end
	end
	local d = part(base.Parent, opts.Name or "Detail", size, base.CFrame * offset * spin, color, opts.Material or M.SmoothPlastic, shape)
	d.CastShadow = false
	if opts.WeldTo then
		weld(opts.WeldTo, d)
	end
	return d
end

-- Linija ant priekinio paviršiaus nuo taško a iki b (Vector2: u, v)
local function frontLine(base, a, b, width, color, thickness, weldTo)
	-- Priekiniame paviršiuje u atitinka -X, todėl skaičiuojam detalės koordinatėmis
	local ax, bx = -a.X, -b.X
	local dx, dy = bx - ax, b.Y - a.Y
	local length = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(-dx, dy)
	local t = thickness or 0.04
	local s = base.Size
	local cf = base.CFrame * CF((ax + bx) / 2, (a.Y + b.Y) / 2, -s.Z / 2 - t / 2) * CFrame.Angles(0, 0, angle)
	local d = part(base.Parent, "Detail", V(width, length + width * 0.6, t), cf, color, M.SmoothPlastic)
	d.CastShadow = false
	if weldTo then
		weld(weldTo, d)
	end
	return d
end

-- Taškai (skarelė, kepurė)
local function dots(p, faces, color, spacing, dotSize, weldTo)
	for _, faceId in ipairs(faces) do
		local w, h = faceSize(p, faceId)
		local cols = math.max(1, math.floor(w / spacing))
		local rows = math.max(1, math.floor(h / spacing))
		for j = 1, rows do
			local stagger = (j % 2 == 0) and 0.5 or 0
			for i = 1, cols do
				local u = -w / 2 + (i - 0.5 + stagger) * w / cols
				if u < w / 2 - dotSize / 2 then
					decal(p, faceId, u, h / 2 - (j - 0.5) * h / rows, dotSize, dotSize, color, { Round = true, Name = "Dot", Thickness = 0.03, WeldTo = weldTo })
				end
			end
		end
	end
end

-- Rombų juosta (tautinis raštas); y – 0 viršus … 1 apačia
local function diamondRow(p, faceId, color, count, y, size, weldTo)
	local w, h = faceSize(p, faceId)
	for i = 1, count do
		decal(p, faceId, -w / 2 + (i - 0.5) * w / count, h / 2 - y * h, size, size, color, { Rotation = 45, Name = "Pattern", WeldTo = weldTo })
	end
end

-- Rombų stulpelis (palaidinės juosta)
local function diamondColumn(p, faceId, color, count, size, weldTo)
	local w, h = faceSize(p, faceId)
	for i = 1, count do
		decal(p, faceId, 0, h / 2 - (i - 0.5) * h / count, size, size, color, { Rotation = 45, Name = "Pattern", WeldTo = weldTo })
	end
end

-- Veidas: akys, skruostai, šypsena ir (nebūtini) akiniai – tikros 3D dalys
local function face(head, glassesColor)
	local F = NormalId.Front
	local ink = C(40, 28, 22)
	local smile = C(150, 45, 50)
	for _, u in ipairs({ -0.32, 0.32 }) do
		decal(head, F, u, 0.02, 0.17, 0.21, ink, { Name = "Eye", Thickness = 0.03 })
		decal(head, F, u + 0.04, 0.07, 0.05, 0.05, C(255, 255, 255), { Name = "EyeShine", Thickness = 0.045 })
	end
	for _, u in ipairs({ -0.58, 0.58 }) do
		decal(head, F, u, -0.3, 0.3, 0.16, C(255, 140, 150), { Name = "Cheek", Thickness = 0.025 })
	end
	frontLine(head, Vector2.new(-0.16, -0.48), Vector2.new(0.16, -0.48), 0.08, smile)
	frontLine(head, Vector2.new(-0.16, -0.48), Vector2.new(-0.29, -0.38), 0.08, smile)
	frontLine(head, Vector2.new(0.16, -0.48), Vector2.new(0.29, -0.38), 0.08, smile)
	if glassesColor then
		local t = 0.06
		for _, u in ipairs({ -0.32, 0.32 }) do
			decal(head, F, u, 0.21, 0.5, 0.07, glassesColor, { Name = "Glasses", Thickness = t })
			decal(head, F, u, -0.17, 0.5, 0.07, glassesColor, { Name = "Glasses", Thickness = t })
			decal(head, F, u - 0.215, 0.02, 0.07, 0.38, glassesColor, { Name = "Glasses", Thickness = t })
			decal(head, F, u + 0.215, 0.02, 0.07, 0.38, glassesColor, { Name = "Glasses", Thickness = t })
		end
		decal(head, F, 0, 0.08, 0.12, 0.06, glassesColor, { Name = "Glasses", Thickness = t })
	end
end

-- Ranka su Motor6D. side: 1 = +X, -1 = -X. pose – pasukimas peties taške.
local function arm(model, torso, side, sleeveColor, handColor, pose, swingAmp, cuffColor)
	local jointName = side == 1 and "RightShoulder" or "LeftShoulder"
	local c0 = CF(side * 1.475, 0.85, 0) * pose
	local c1 = CF(0, 0.85, 0)
	local armCF = TORSO_CF * c0 * c1:Inverse()
	local sleeve = part(model, side == 1 and "RightArm" or "LeftArm", ARM_SIZE, armCF, sleeveColor, M.Fabric)
	local hand = part(model, "Hand", V(0.98, 0.45, 0.98), armCF * CF(0, -0.725, 0), handColor)
	weld(sleeve, hand)
	if cuffColor then
		local cuff = part(model, "Cuff", V(1.02, 0.16, 1.02), armCF * CF(0, -0.45, 0), cuffColor, M.Metal)
		weld(sleeve, cuff)
	end
	local motor = Instance.new("Motor6D")
	motor.Name = jointName
	motor.Part0 = torso
	motor.Part1 = sleeve
	motor.C0 = c0
	motor.C1 = c1
	motor:SetAttribute("SwingAmp", swingAmp or 0.2)
	motor:SetAttribute("SwingBias", 0)
	motor.Parent = sleeve
	return sleeve, armCF
end

local function newRig(name)
	local model = Instance.new("Model")
	model.Name = name
	local root = part(model, "HumanoidRootPart", V(2, 2, 1), TORSO_CF, C(255, 255, 255))
	root.Transparency = 1
	root.Anchored = true
	model.PrimaryPart = root
	return model, root
end

local function finish(model, root)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root and not d:FindFirstChildOfClass("WeldConstraint") and not d:FindFirstChildOfClass("Motor6D") then
			weld(root, d)
		end
	end
	model.WorldPivot = CF()
	return model
end

----------------------------------------------------------------------
-- 1. Paprasta močiutė
----------------------------------------------------------------------
local function simple()
	local model, root = newRig("Granny_1")
	local green = C(62, 120, 72)
	local red = C(200, 38, 40)
	local white = C(248, 242, 230)

	-- Pagrindas: žolė ant žemės
	part(model, "BaseDirt", V(3.2, 0.32, 3.2), CF(0, -0.24, 0), C(122, 82, 46), M.Ground)
	part(model, "BaseGrass", V(3.2, 0.1, 3.2), CF(0, -0.05, 0), C(118, 178, 84), M.Grass)

	-- Batai, sijonas, prijuostė
	for _, x in ipairs({ -0.5, 0.5 }) do
		part(model, "Shoe", V(0.95, 0.42, 1.05), CF(x, 0.21, -0.05), C(85, 52, 32))
	end
	part(model, "Skirt", V(2.1, 1.4, 1.15), CF(0, 1.1, 0), C(118, 74, 42), M.Fabric)
	local apron = part(model, "Apron", V(1.5, 1.3, 0.06), CF(0, 1.12, -0.6), white, M.Fabric)
	diamondRow(apron, NormalId.Front, red, 6, 0.82, 0.16)
	diamondRow(apron, NormalId.Front, red, 6, 0.12, 0.12)

	-- Liemuo: žalias megztinis, balta palaidinė su tautiniu raštu, sagos
	local torso = part(model, "Torso", TORSO_SIZE, TORSO_CF, green, M.Fabric)
	local blouse = part(model, "Blouse", V(0.8, 1.85, 0.06), CF(0, 2.75, -0.53), white, M.Fabric)
	diamondColumn(blouse, NormalId.Front, red, 7, 0.18)
	for i = 0, 3 do
		part(model, "Button", V(0.14, 0.14, 0.14), CF(0.55, 3.35 - i * 0.38, -0.53), white, M.SmoothPlastic, Enum.PartType.Ball)
	end
	local waist = part(model, "WaistBand", V(2.04, 0.24, 1.04), CF(0, 1.9, 0), white, M.Fabric)
	diamondRow(waist, NormalId.Front, red, 9, 0.5, 0.15)

	-- Rankos: viena į priekį, kita laiko krepšį
	arm(model, torso, 1, green, SKIN, CFrame.Angles(math.rad(30), 0, 0), 0.25)
	local basketArm, basketCF = arm(model, torso, -1, green, SKIN, CFrame.Angles(math.rad(20), 0, 0), 0.06)
	local handCF = basketCF * CF(0, -1.05, -0.2)
	local basket = part(model, "Basket", V(1.25, 0.75, 1.0), CF(handCF.Position + V(-0.35, -0.35, 0)), C(205, 160, 90), M.WoodPlanks)
	weld(basketArm, basket)
	-- Pinto krepšio raštas
	for i = 1, 3 do
		decal(basket, NormalId.Front, 0, 0.375 - i * 0.1875, 1.25, 0.06, C(150, 105, 50), { WeldTo = basketArm })
	end
	for i = 1, 4 do
		decal(basket, NormalId.Front, -0.625 + i * 0.25, 0, 0.06, 0.75, C(150, 105, 50), { WeldTo = basketArm })
	end
	local handle = part(model, "BasketHandle", V(0.12, 0.8, 0.12), basket.CFrame * CF(0, 0.7, 0), C(150, 105, 50), M.Wood)
	weld(basketArm, handle)
	for i, offset in ipairs({ V(-0.3, 0.45, -0.15), V(0.15, 0.48, 0.1), V(0.35, 0.42, -0.2) }) do
		local base = basket.CFrame * CF(offset)
		local stem = part(model, "MushroomStem", V(0.14, 0.22, 0.14), base, white)
		local cap = part(model, "MushroomCap", V(0.42, 0.24, 0.42), base * CF(0, 0.16, 0), red)
		mesh(cap, Enum.MeshType.Sphere)
		local dot = part(model, "MushroomDot", V(0.07, 0.07, 0.07), base * CF(0.06 * i - 0.1, 0.28, -0.08), white, M.SmoothPlastic, Enum.PartType.Ball)
		for _, p in ipairs({ stem, cap, dot }) do
			weld(basketArm, p)
		end
	end

	-- Galva: veidas su rudais akiniais, raudona taškuota skarelė su mazgu
	local head = part(model, "Head", HEAD_SIZE, HEAD_CF, SKIN)
	face(head, C(110, 70, 40))
	local scarfTop = part(model, "ScarfTop", V(2.0, 0.45, 2.0), CF(0, 5.6, 0.02), red, M.Fabric)
	local scarfBack = part(model, "ScarfBack", V(2.0, 1.95, 0.22), CF(0, 4.62, 0.98), red, M.Fabric)
	local scarfL = part(model, "ScarfSide", V(0.14, 1.55, 1.95), CF(0.97, 4.82, 0.02), red, M.Fabric)
	local scarfR = part(model, "ScarfSide", V(0.14, 1.55, 1.95), CF(-0.97, 4.82, 0.02), red, M.Fabric)
	dots(scarfTop, { NormalId.Top }, white, 0.42, 0.13)
	dots(scarfBack, { NormalId.Back }, white, 0.42, 0.13)
	dots(scarfL, { NormalId.Right }, white, 0.42, 0.13)
	dots(scarfR, { NormalId.Left }, white, 0.42, 0.13)
	-- Taškeliai ir ant skarelės krašto virš kaktos
	for i = 1, 5 do
		decal(scarfTop, NormalId.Front, -0.8 + (i - 1) * 0.4, 0, 0.13, 0.13, white, { Round = true, Thickness = 0.03 })
	end
	part(model, "ScarfKnot", V(0.42, 0.42, 0.2), CF(0, 3.62, -0.62) * CFrame.Angles(0, 0, math.rad(45)), C(170, 30, 35), M.Fabric)
	-- Lietuviška atributika: gintarinė sagė ir trispalvis kaspinėlis ant krepšio rankenos
	part(model, "AmberBrooch", V(0.26, 0.3, 0.1), CF(0.42, 3.35, -0.58) * CFrame.Angles(0, 0, math.rad(45)), AMBER, M.Glass)
	part(model, "BroochRim", V(0.32, 0.36, 0.06), CF(0.42, 3.35, -0.55) * CFrame.Angles(0, 0, math.rad(45)), C(200, 160, 60), M.Metal)
	local bowCF = handle.CFrame * CF(0, 0.38, -0.08)
	for i, color in ipairs({ LT_YELLOW, LT_GREEN, LT_RED }) do
		local stripe = part(model, "RibbonStripe", V(0.5, 0.07, 0.05), bowCF * CF(0, 0.07 - (i - 1) * 0.07, -0.02), color, M.Fabric)
		weld(basketArm, stripe)
	end
	for _, side in ipairs({ -1, 1 }) do
		local tail = part(model, "RibbonTail", V(0.08, 0.32, 0.04), bowCF * CF(side * 0.12, -0.2, -0.02) * CFrame.Angles(0, 0, side * math.rad(15)), LT_RED, M.Fabric)
		weld(basketArm, tail)
	end
	return finish(model, root)
end

----------------------------------------------------------------------
-- 2. Superinė močiutė
----------------------------------------------------------------------
local function super()
	local model, root = newRig("Granny_2")
	local green = C(38, 140, 72)
	local red = C(205, 42, 42)
	local darkRed = C(150, 25, 32)
	local yellow = C(255, 196, 30)

	-- Pagrindas: mėlynas su geltonu žiedu
	part(model, "Base", V(3.4, 0.36, 3.4), CF(0, -0.22, 0), C(42, 58, 100), M.SmoothPlastic)
	part(model, "BaseRing", V(0.04, 3.0, 3.0), CF(0, -0.02, 0) * CFrame.Angles(0, 0, math.rad(90)), yellow, M.Neon, Enum.PartType.Cylinder)
	part(model, "BaseRingInner", V(0.05, 2.7, 2.7), CF(0, -0.015, 0) * CFrame.Angles(0, 0, math.rad(90)), C(42, 58, 100), M.SmoothPlastic, Enum.PartType.Cylinder)
	part(model, "BaseStripe", V(3.42, 0.08, 0.1), CF(0, -0.12, -1.68), yellow, M.Neon)

	-- Batai, kelnės, diržas
	for _, x in ipairs({ -0.5, 0.5 }) do
		part(model, "Boot", V(0.95, 0.55, 1.05), CF(x, 0.275, -0.03), red)
	end
	part(model, "BootBand", V(2.02, 0.1, 1.08), CF(0, 0.6, 0), yellow, M.SmoothPlastic)
	part(model, "Legs", V(2.0, 1.1, 1.05), CF(0, 1.2, 0), red, M.Fabric)
	part(model, "LegStripe", V(2.02, 0.08, 1.07), CF(0, 0.95, 0), yellow, M.SmoothPlastic)
	part(model, "Belt", V(2.04, 0.18, 1.06), CF(0, 1.78, 0), yellow, M.SmoothPlastic)

	-- Liemuo su „M“ ženklu ir apsiaustas
	local torso = part(model, "Torso", TORSO_SIZE, TORSO_CF, green, M.Fabric)
	part(model, "EmblemRim", V(0.05, 1.3, 1.3), CF(0, 2.9, -0.52) * CFrame.Angles(0, math.rad(90), 0), red, M.SmoothPlastic, Enum.PartType.Cylinder)
	local emblem = part(model, "Emblem", V(0.07, 1.12, 1.12), CF(0, 2.9, -0.54) * CFrame.Angles(0, math.rad(90), 0), yellow, M.SmoothPlastic, Enum.PartType.Cylinder)
	-- Raudona raidė „M“ ant geltono apskritimo (tikros dalys)
	local plate = part(model, "EmblemPlate", V(1.0, 1.0, 0.02), CF(0, 2.9, -0.58), yellow, M.SmoothPlastic)
	plate.Transparency = 1
	frontLine(plate, Vector2.new(-0.26, -0.3), Vector2.new(-0.26, 0.28), 0.12, red, 0.05)
	frontLine(plate, Vector2.new(0.26, -0.3), Vector2.new(0.26, 0.28), 0.12, red, 0.05)
	frontLine(plate, Vector2.new(-0.26, 0.28), Vector2.new(0, -0.05), 0.12, red, 0.05)
	frontLine(plate, Vector2.new(0.26, 0.28), Vector2.new(0, -0.05), 0.12, red, 0.05)
	part(model, "Collar", V(2.2, 0.22, 1.2), CF(0, 3.75, 0.05), darkRed, M.Fabric)
	local cape = part(model, "Cape", V(2.15, 3.2, 0.14), CF(0, 2.15, 0.66) * CFrame.Angles(math.rad(-9), 0, 0), darkRed, M.Fabric)
	-- Lietuviška atributika: trispalvė diržo sagtis ir trispalvės juostos ant apsiausto
	part(model, "BuckleRim", V(0.82, 0.56, 0.05), CF(0, 1.78, -0.565), C(220, 180, 60), M.Metal)
	for i, color in ipairs({ LT_YELLOW, LT_GREEN, LT_RED }) do
		part(model, "BuckleStripe", V(0.7, 0.15, 0.05), CF(0, 1.93 - (i - 1) * 0.15, -0.6), color, M.SmoothPlastic)
		decal(cape, NormalId.Back, 0, -0.9 - (i - 1) * 0.22, 2.15, 0.22, color, { Name = "CapeStripe", Thickness = 0.03 })
	end

	-- Rankos: viena iškelta su kočėlu, kita nuleista; raudonos pirštinės
	local raised, raisedCF = arm(model, torso, 1, green, red, CFrame.Angles(0, 0, math.rad(155)), 0.3)
	arm(model, torso, -1, green, red, CFrame.Angles(math.rad(15), 0, math.rad(-12)), 0.2)
	-- Kočėlas skersai iškeltos rankos (kaip kortelėje)
	local pinCF = raisedCF * CF(0, -1.2, 0) * CFrame.Angles(0, 0, math.rad(-10))
	local pin = part(model, "RollingPin", V(2.4, 0.42, 0.42), pinCF, C(225, 180, 120), M.Wood, Enum.PartType.Cylinder)
	weld(raised, pin)
	for _, x in ipairs({ -1.45, 1.45 }) do
		local h = part(model, "PinHandle", V(0.5, 0.2, 0.2), pinCF * CF(x, 0, 0), C(140, 90, 50), M.Wood, Enum.PartType.Cylinder)
		weld(raised, h)
	end

	-- Galva: raudoni akiniai, geltoni plaukai
	local head = part(model, "Head", HEAD_SIZE, HEAD_CF, SKIN)
	face(head, C(220, 40, 40))
	part(model, "HairTop", V(2.0, 0.5, 2.0), CF(0, 5.55, 0.02), yellow, M.SmoothPlastic)
	part(model, "HairBack", V(2.0, 1.75, 0.3), CF(0, 4.7, 0.95), yellow, M.SmoothPlastic)
	part(model, "HairSide", V(0.15, 1.1, 1.9), CF(0.96, 5.0, 0.05), yellow, M.SmoothPlastic)
	part(model, "HairSide", V(0.15, 1.1, 1.9), CF(-0.96, 5.0, 0.05), yellow, M.SmoothPlastic)
	part(model, "HairBangs", V(2.0, 0.3, 0.14), CF(0, 5.33, -0.93), yellow, M.SmoothPlastic)
	return finish(model, root)
end

----------------------------------------------------------------------
-- 3. Legendinė močiutė
----------------------------------------------------------------------
local function legendary()
	local model, root = newRig("Granny_3")
	local maroon = C(125, 28, 50)
	local gold = C(240, 190, 55)
	local purple = C(88, 40, 145)
	local cream = C(248, 238, 218)
	local amber = C(255, 150, 30)

	-- Pagrindas: tamsiai violetinis su auksiniu žiedu ir švytėjimu
	local base = part(model, "Base", V(3.4, 0.36, 3.4), CF(0, -0.22, 0), C(48, 32, 75), M.SmoothPlastic)
	part(model, "BaseRing", V(0.04, 3.0, 3.0), CF(0, -0.02, 0) * CFrame.Angles(0, 0, math.rad(90)), gold, M.Neon, Enum.PartType.Cylinder)
	part(model, "BaseRingInner", V(0.05, 2.7, 2.7), CF(0, -0.015, 0) * CFrame.Angles(0, 0, math.rad(90)), C(48, 32, 75), M.SmoothPlastic, Enum.PartType.Cylinder)
	local glow = Instance.new("PointLight")
	glow.Color = C(255, 200, 90)
	glow.Range = 12
	glow.Brightness = 1.6
	glow.Parent = base

	-- Suknelė su auksiniais rombais
	local dress = part(model, "Dress", V(2.3, 1.8, 1.35), CF(0, 0.9, 0), maroon, M.Fabric)
	local panel = part(model, "DressPanel", V(1.1, 1.5, 0.06), CF(0, 1.0, -0.7), cream, M.Fabric)
	diamondRow(panel, NormalId.Front, maroon, 4, 0.85, 0.16)

	local hem = part(model, "DressHem", V(2.34, 0.36, 1.39), CF(0, 0.2, 0), maroon, M.Fabric)
	for _, faceId in ipairs({ NormalId.Front, NormalId.Back, NormalId.Left, NormalId.Right }) do
		diamondRow(hem, faceId, gold, 9, 0.5, 0.2)
	end
	part(model, "Belt", V(2.1, 0.2, 1.1), CF(0, 1.85, 0), gold, M.Metal)

	-- Liemuo, auksinė mantija, vėrinys
	local torso = part(model, "Torso", TORSO_SIZE, TORSO_CF, maroon, M.Fabric)
	part(model, "Mantle", V(2.45, 2.9, 0.2), CF(0, 2.45, 0.64) * CFrame.Angles(math.rad(-6), 0, 0), gold, M.Fabric)
	-- Lietuviška atributika: auksiniai Gedimino stulpai ant raudono skydo (atviroje liemens pusėje)
	do
		local F = NormalId.Front
		local u0, v0 = -0.42, -0.32
		decal(torso, F, u0, v0 + 0.04, 0.66, 0.66, gold, { Name = "ShieldRim", Thickness = 0.03 })
		decal(torso, F, u0, v0 + 0.04, 0.58, 0.58, LT_RED, { Name = "Shield", Thickness = 0.05 })
		decal(torso, F, u0, v0 - 0.28, 0.3, 0.3, LT_RED, { Name = "Shield", Thickness = 0.05, Rotation = 45 })
		local g = { Name = "Gediminas", Thickness = 0.09 }
		decal(torso, F, u0, v0 - 0.12, 0.42, 0.07, gold, g)            -- pagrindas
		decal(torso, F, u0, v0 + 0.06, 0.08, 0.32, gold, g)            -- vidurinis stulpas
		decal(torso, F, u0, v0 + 0.24, 0.26, 0.07, gold, g)            -- jo viršus
		decal(torso, F, u0 - 0.15, v0 - 0.01, 0.08, 0.2, gold, g)      -- šoniniai stulpai
		decal(torso, F, u0 + 0.15, v0 - 0.01, 0.08, 0.2, gold, g)
		decal(torso, F, u0 - 0.15, v0 + 0.11, 0.15, 0.06, gold, g)
		decal(torso, F, u0 + 0.15, v0 + 0.11, 0.15, 0.06, gold, g)
	end
	part(model, "Yoke", V(2.5, 0.34, 1.25), CF(0, 3.72, 0.05), gold, M.Fabric)
	-- Didelė auksinė mantijos dalis per priekį iki suknelės apačios
	part(model, "MantleFront", V(1.05, 3.4, 0.1), CF(-0.6, 2.0, -0.72) * CFrame.Angles(0, 0, math.rad(-4)), gold, M.Fabric)
	part(model, "Chain", V(0.9, 0.07, 0.06), CF(-0.25, 3.35, -0.53) * CFrame.Angles(0, 0, math.rad(-35)), gold, M.Metal)
	part(model, "Chain", V(0.9, 0.07, 0.06), CF(0.25, 3.35, -0.53) * CFrame.Angles(0, 0, math.rad(35)), gold, M.Metal)
	part(model, "Pendant", V(0.32, 0.32, 0.1), CF(0, 3.05, -0.56) * CFrame.Angles(0, 0, math.rad(45)), C(150, 30, 70), M.Glass)

	-- Rankos: viena laiko lazdą, kita mosteli
	local staffArm, staffArmCF = arm(model, torso, 1, maroon, SKIN, CFrame.Angles(math.rad(35), 0, 0), 0.04, gold)
	arm(model, torso, -1, maroon, SKIN, CFrame.Angles(math.rad(40), 0, math.rad(-25)), 0.22, gold)
	local handPos = (staffArmCF * CF(0, -0.75, 0)).Position
	local staff = part(model, "Staff", V(0.24, 6.3, 0.24), CF(handPos.X + 0.1, 2.95, handPos.Z), gold, M.Metal)
	weld(staffArm, staff)
	local topCF = staff.CFrame * CF(0, 3.35, 0)
	local cage = part(model, "StaffTop", V(0.75, 0.12, 0.75), topCF * CF(0, -0.4, 0), gold, M.Metal)
	local gem = part(model, "AmberGem", V(0.55, 0.65, 0.55), topCF, amber, M.Neon)
	weld(staffArm, cage)
	weld(staffArm, gem)
	for _, offset in ipairs({ V(0.32, 0, 0.32), V(-0.32, 0, 0.32), V(0.32, 0, -0.32), V(-0.32, 0, -0.32) }) do
		local bar = part(model, "StaffBar", V(0.08, 0.8, 0.08), topCF * CF(offset), gold, M.Metal)
		weld(staffArm, bar)
	end

	-- Galva: violetinė kepurė su aukso taškais ir karūna
	local head = part(model, "Head", HEAD_SIZE, HEAD_CF, SKIN)
	face(head, nil)
	local hat = part(model, "Hat", V(1.9, 1.35, 1.9), CF(0, 6.2, 0), purple, M.Fabric)
	dots(hat, { NormalId.Front, NormalId.Back, NormalId.Left, NormalId.Right }, gold, 0.38, 0.12)
	part(model, "CrownGem", V(0.34, 0.34, 0.1), CF(0, 7.05, -0.98), amber, M.Neon)
	for i = 0, 7 do
		local angle = i * math.pi / 4
		local r = 0.85
		part(model, "CrownPoint", V(0.32, 0.4, 0.32), CF(math.cos(angle) * r, 7.05, math.sin(angle) * r), gold, M.Metal)
	end
	part(model, "CrownRim", V(2.0, 0.14, 2.0), CF(0, 6.88, 0), gold, M.Metal)

	-- Sklandantys aukso kubeliai (juos judina klientas)
	local bits = { V(-1.9, 1.4, -0.6), V(1.9, 2.6, -0.4), V(-1.6, 4.2, 0.8), V(1.7, 5.4, 0.6), V(-0.8, 6.4, -1.2), V(1.2, 1.0, 1.2) }
	for i, offset in ipairs(bits) do
		local bit = part(model, "FloatBit", V(0.26, 0.26, 0.26), CF(offset) * CFrame.Angles(i, i * 0.5, 0), gold, M.Neon)
		bit.Anchored = true
		bit.CastShadow = false
	end
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(C(255, 220, 100))
	sparkles.Size = NumberSequence.new(0.35, 0)
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Rate = 6
	sparkles.Speed = NumberRange.new(0.5, 1.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LightEmission = 1
	sparkles.Parent = torso

	model = finish(model, root)
	-- Sklandantys kubeliai neprivirinami (klientas juos judina atskirai)
	for _, d in ipairs(model:GetDescendants()) do
		if d.Name == "FloatBit" then
			local w = d:FindFirstChildOfClass("WeldConstraint")
			if w then
				w:Destroy()
			end
		end
	end
	return model
end

local BUILDERS = { simple, super, legendary }

function GrannyModels.Build(level)
	local builder = BUILDERS[level] or simple
	return builder()
end

return GrannyModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">QuizQuestions</string><ProtectedString name="Source"><![CDATA[--[[
	QuizQuestions – viktorinos klausimai apie Lietuvą (laikomi TIK serveryje, kad niekas
	negalėtų pažiūrėti atsakymų). Pirmas atsakymas sąraše – TEISINGAS (žaidime jie sumaišomi).
	Pridėti naują klausimą: nukopijuok eilutę ir pakeisk tekstus abiem kalbomis.
]]

return {
	{ lt = { "Kuris miestas yra Lietuvos sostinė?", "Vilnius", "Kaunas", "Klaipėda", "Šiauliai" },
	  en = { "Which city is the capital of Lithuania?", "Vilnius", "Kaunas", "Klaipėda", "Šiauliai" } },
	{ lt = { "Kokios spalvos yra Lietuvos vėliava?", "Geltona, žalia, raudona", "Balta, mėlyna, raudona", "Žalia, balta, raudona", "Mėlyna, geltona, balta" },
	  en = { "What are the colours of the Lithuanian flag?", "Yellow, green, red", "White, blue, red", "Green, white, red", "Blue, yellow, white" } },
	{ lt = { "Iš ko daugiausia gaminami cepelinai?", "Iš bulvių", "Iš miltų", "Iš ryžių", "Iš kopūstų" },
	  en = { "What are cepelinai mostly made from?", "Potatoes", "Flour", "Rice", "Cabbage" } },
	{ lt = { "Kas suteikia šaltibarščiams rožinę spalvą?", "Burokėliai", "Braškės", "Pomidorai", "Morkos" },
	  en = { "What gives šaltibarščiai (cold soup) its pink colour?", "Beetroot", "Strawberries", "Tomatoes", "Carrots" } },
	{ lt = { "Kiek patiekalų tradiciškai būna ant Kūčių stalo?", "12", "7", "3", "20" },
	  en = { "How many dishes are traditionally on the Christmas Eve (Kūčios) table?", "12", "7", "3", "20" } },
	{ lt = { "Kada švenčiamos Joninės (Rasos)?", "Birželio 23–24 d.", "Gruodžio 24 d.", "Vasario 16 d.", "Rugsėjo 1 d." },
	  en = { "When is Joninės (Midsummer) celebrated?", "June 23–24", "December 24", "February 16", "September 1" } },
	{ lt = { "Kurio paukščio Lietuvoje gyvena labai daug ir jis laikomas nacionaliniu?", "Gandro", "Erelio", "Papūgos", "Pingvino" },
	  en = { "Which bird is very common in Lithuania and considered the national bird?", "White stork", "Eagle", "Parrot", "Penguin" } },
	{ lt = { "Kas buvo pirmasis ir vienintelis Lietuvos karalius?", "Mindaugas", "Vytautas", "Gediminas", "Kęstutis" },
	  en = { "Who was the first and only King of Lithuania?", "Mindaugas", "Vytautas", "Gediminas", "Kęstutis" } },
	{ lt = { "Kuris kunigaikštis vadinamas Didžiuoju?", "Vytautas", "Mindaugas", "Algirdas", "Jogaila" },
	  en = { "Which Grand Duke is called 'the Great'?", "Vytautas", "Mindaugas", "Algirdas", "Jogaila" } },
	{ lt = { "Kuri garsi pilis stovi saloje ežere?", "Trakų salos pilis", "Gedimino pilis", "Kauno pilis", "Biržų pilis" },
	  en = { "Which famous castle stands on an island in a lake?", "Trakai Island Castle", "Gediminas Castle", "Kaunas Castle", "Biržai Castle" } },
	{ lt = { "Kokia buvo Lietuvos valiuta prieš eurą?", "Litas", "Zlotas", "Rublis", "Markė" },
	  en = { "What was Lithuania's currency before the euro?", "Litas", "Złoty", "Ruble", "Mark" } },
	{ lt = { "Kada švenčiama Lietuvos valstybės atkūrimo diena?", "Vasario 16 d.", "Kovo 11 d.", "Liepos 6 d.", "Lapkričio 1 d." },
	  en = { "When is the Day of Restoration of the State of Lithuania?", "February 16", "March 11", "July 6", "November 1" } },
	{ lt = { "Kas švenčiama kovo 11-ąją?", "Nepriklausomybės atkūrimo diena", "Joninės", "Kūčios", "Užgavėnės" },
	  en = { "What is celebrated on March 11?", "Restoration of Independence Day", "Midsummer", "Christmas Eve", "Shrovetide" } },
	{ lt = { "Ką per Užgavėnes sudegina, kad išvarytų žiemą?", "Morę", "Eglutę", "Gandrą", "Kanklės" },
	  en = { "What do people burn at Užgavėnės (Shrovetide) to chase away winter?", "Morė (a straw figure)", "A Christmas tree", "A stork", "Kanklės" } },
	{ lt = { "Kas per Užgavėnes kovoja su Lašininiu?", "Kanapinis", "Kalėdų senelis", "Velnias", "Laumė" },
	  en = { "Who fights Lašininis (Fatty) at Užgavėnės?", "Kanapinis (Hempy)", "Santa Claus", "The Devil", "A fairy" } },
	{ lt = { "Kas yra šakotis?", "Pyragas, kepamas ant besisukančio iešmo", "Sriuba su burokėliais", "Medinis žaislas", "Liaudies šokis" },
	  en = { "What is šakotis?", "A cake baked on a rotating spit", "A beetroot soup", "A wooden toy", "A folk dance" } },
	{ lt = { "Prie kokios jūros yra Lietuva?", "Baltijos", "Juodosios", "Viduržemio", "Šiaurės" },
	  en = { "Which sea is Lithuania next to?", "The Baltic Sea", "The Black Sea", "The Mediterranean", "The North Sea" } },
	{ lt = { "Kuo garsėja Kuršių nerija?", "Aukštomis smėlio kopomis", "Ugnikalniais", "Ledynais", "Dykuma" },
	  en = { "What is the Curonian Spit famous for?", "High sand dunes", "Volcanoes", "Glaciers", "A desert" } },
	{ lt = { "Kuri upė yra ilgiausia Lietuvoje?", "Nemunas", "Neris", "Dunojus", "Vysla" },
	  en = { "Which is the longest river in Lithuania?", "Nemunas", "Neris", "Danube", "Vistula" } },
	{ lt = { "Kokia sporto šaka Lietuvoje vadinama „antrąja religija“?", "Krepšinis", "Futbolas", "Ledo ritulys", "Tenisas" },
	  en = { "Which sport is called Lithuania's 'second religion'?", "Basketball", "Football", "Ice hockey", "Tennis" } },
	{ lt = { "Kas yra sutartinės?", "Senovinės daugiabalsės lietuvių dainos", "Saldainiai", "Šventiniai drabužiai", "Žvejybos tinklai" },
	  en = { "What are sutartinės?", "Ancient Lithuanian polyphonic songs", "Sweets", "Festive clothes", "Fishing nets" } },
	{ lt = { "Prie kurio miesto yra Kryžių kalnas?", "Šiaulių", "Klaipėdos", "Alytaus", "Utenos" },
	  en = { "Near which city is the Hill of Crosses?", "Šiauliai", "Klaipėda", "Alytus", "Utena" } },
	{ lt = { "Kas yra kanklės?", "Styginis liaudies instrumentas", "Duonos rūšis", "Medžio rūšis", "Šokis ratu" },
	  en = { "What are kanklės?", "A folk string instrument", "A kind of bread", "A kind of tree", "A circle dance" } },
	{ lt = { "Kurio senovės dievo medžiu buvo laikomas ąžuolas?", "Perkūno", "Laimės", "Bangpūčio", "Žemynos" },
	  en = { "The oak tree was sacred to which ancient god?", "Perkūnas (thunder)", "Laima (fate)", "Bangpūtys (wind)", "Žemyna (earth)" } },
	{ lt = { "Kas yra margučiai?", "Dažyti Velykų kiaušiniai", "Kalėdiniai sausainiai", "Joninių vainikai", "Medinės kaukės" },
	  en = { "What are margučiai?", "Decorated Easter eggs", "Christmas cookies", "Midsummer wreaths", "Wooden masks" } },
	{ lt = { "Kaip vadinamas Lietuvos herbas?", "Vytis", "Erelis", "Liūtas", "Meška" },
	  en = { "What is the Lithuanian coat of arms called?", "Vytis (the White Knight)", "The Eagle", "The Lion", "The Bear" } },
	{ lt = { "Kurio miesto patiekalu ypač garsūs kibinai?", "Trakų", "Palangos", "Druskininkų", "Panevėžio" },
	  en = { "Kibinai pastries are especially famous in which town?", "Trakai", "Palanga", "Druskininkai", "Panevėžys" } },
	{ lt = { "Kas per Kūčias valgoma kartu su aguonų pienu?", "Kūčiukai", "Cepelinai", "Šašlykai", "Ledai" },
	  en = { "What is eaten with poppy milk on Christmas Eve?", "Kūčiukai (small biscuits)", "Cepelinai", "Barbecue", "Ice cream" } },
	{ lt = { "Ko Joninių naktį ieško miške?", "Paparčio žiedo", "Grybų", "Kiškio", "Lobio skrynios" },
	  en = { "What do people search for in the forest on Midsummer night?", "The fern flower", "Mushrooms", "A rabbit", "A treasure chest" } },
	{ lt = { "Kokia kalba yra viena seniausių gyvų indoeuropiečių kalbų?", "Lietuvių", "Anglų", "Ispanų", "Prancūzų" },
	  en = { "Which is one of the oldest living Indo-European languages?", "Lithuanian", "English", "Spanish", "French" } },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--[[
	RateLimit – ne daugiau N užklausų per sekundę vienam žaidėjui.
	Naudojimas:
	  local limiter = RateLimit.new(5)
	  if not limiter:Check(player) then return end
]]

local Players = game:GetService("Players")

local RateLimit = {}
RateLimit.__index = RateLimit

local all = {}

function RateLimit.new(perSecond)
	local self = setmetatable({ PerSecond = perSecond, Records = {} }, RateLimit)
	table.insert(all, self)
	return self
end

function RateLimit:Check(player)
	local now = os.clock()
	local record = self.Records[player]
	if not record or now - record.Start >= 1 then
		self.Records[player] = { Start = now, Count = 1 }
		return true
	end
	if record.Count >= self.PerSecond then
		return false
	end
	record.Count = record.Count + 1
	return true
end

-- Debounce: ar praėjo bent `seconds` nuo paskutinio leisto veiksmo
local Debounce = {}
Debounce.__index = Debounce

function RateLimit.debounce(seconds)
	local self = setmetatable({ Seconds = seconds, Records = {} }, Debounce)
	table.insert(all, self)
	return self
end

function Debounce:Check(player)
	local now = os.clock()
	local last = self.Records[player]
	if last and now - last < self.Seconds then
		return false
	end
	self.Records[player] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	for _, limiter in ipairs(all) do
		limiter.Records[player] = nil
	end
end)

return RateLimit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">Scenery</string><ProtectedString name="Source"><![CDATA[--[[
	Scenery – dekoracijos iš Parts: medžiai, krūmai, akmenys, gėlės, grybai, šieno kupetos,
	vežimai, fakelai, šulinys, vėjo malūnas, statinės, dėžės, vėliavos, suolai.
	Visos funkcijos: Scenery.X(parent, position, rng, ...) – position ant žemės (Y = žemės aukštis).
	Dekoracijos nedalyvauja Touched / raycast skaičiavimuose (greičiau telefonuose).
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local CYL_UP = CFrame.Angles(0, 0, math.rad(90))

local Scenery = {}

local function deco(props)
	props.CanTouch = false
	props.CanQuery = false
	-- Šešėlius meta tik kamienai ir pastatai – smulkmenos be šešėlių (greičiau telefonuose)
	if props.CastShadow == nil and not string.find(props.Name or "", "Trunk") and not string.find(props.Name or "", "Tower") then
		props.CastShadow = false
	end
	return Build.Part(props)
end

local function vary(rng, color, amount)
	local d = (rng:NextNumber() - 0.5) * (amount or 0.15)
	return color:Lerp(d > 0 and C(255, 255, 255) or C(0, 0, 0), math.abs(d))
end

----------------------------------------------------------------------
-- Medžiai
----------------------------------------------------------------------
-- Eglė: kamienas + 4 vis siaurėjantys „aukštai“
function Scenery.Pine(parent, pos, rng, scale)
	scale = scale or (0.8 + rng:NextNumber() * 0.7)
	local model = Build.Model("Pine", parent)
	local yaw = CFrame.Angles(0, rng:NextNumber() * 6.28, 0)
	deco({ Name = "Trunk", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(6, 1.3, 1.3) * scale, CFrame = CF(pos + V(0, 3 * scale, 0)) * CYL_UP, Color = C(85, 58, 35), Material = M.Wood })
	local green = vary(rng, C(45, 95, 55), 0.25)
	local tiers = { { 9, 3.5 }, { 7.2, 6.5 }, { 5.2, 9.3 }, { 3, 11.8 } }
	for i, tier in ipairs(tiers) do
		deco({
			Name = "Needles" .. i, Parent = model, Shape = Enum.PartType.Cylinder,
			Size = V(2.6, tier[1], tier[1]) * scale,
			CFrame = CF(pos + V(0, tier[2] * scale, 0)) * yaw * CYL_UP,
			Color = green:Lerp(C(0, 0, 0), i * 0.04), Material = M.Grass, CanCollide = false,
		})
	end
	deco({ Name = "Top", Parent = model, Size = V(0.8, 2, 0.8) * scale, CFrame = CF(pos + V(0, 13.6 * scale, 0)) * yaw * CFrame.Angles(0, math.rad(45), 0), Color = green, Material = M.Grass, CanCollide = false })
	return model
end

-- Beržas: baltas kamienas su juodais brūkšniais
function Scenery.Birch(parent, pos, rng, scale)
	scale = scale or (0.8 + rng:NextNumber() * 0.6)
	local model = Build.Model("Birch", parent)
	local trunkHeight = 11 * scale
	deco({ Name = "Trunk", Parent = model, Size = V(1, trunkHeight, 1) * V(scale, 1, scale), CFrame = CF(pos + V(0, trunkHeight / 2, 0)), Color = C(235, 232, 225), Material = M.SmoothPlastic })
	for i = 1, 4 do
		deco({ Name = "Mark", Parent = model, Size = V(1.05 * scale, 0.18, 0.5 * scale), CFrame = CF(pos + V(0, i * 2.3 * scale, 0)) * CFrame.Angles(0, i * 1.7, 0) * CF(0, 0, 0.3 * scale), Color = C(40, 40, 40), Material = M.SmoothPlastic, CastShadow = false })
	end
	local leaves = vary(rng, C(120, 170, 70), 0.2)
	deco({ Name = "Leaves", Parent = model, Shape = Enum.PartType.Ball, Size = V(6, 6, 6) * scale, CFrame = CF(pos + V(0, trunkHeight + 1, 0)), Color = leaves, Material = M.Grass, CanCollide = false })
	deco({ Name = "Leaves2", Parent = model, Shape = Enum.PartType.Ball, Size = V(4.4, 4.4, 4.4) * scale, CFrame = CF(pos + V(1.6 * scale, trunkHeight - 1, 0.8 * scale)), Color = leaves:Lerp(C(255, 255, 200), 0.1), Material = M.Grass, CanCollide = false })
	deco({ Name = "Leaves3", Parent = model, Shape = Enum.PartType.Ball, Size = V(4, 4, 4) * scale, CFrame = CF(pos + V(-1.4 * scale, trunkHeight - 0.5, -1 * scale)), Color = leaves, Material = M.Grass, CanCollide = false })
	return model
end

-- Ąžuolas: storas kamienas, plati laja iš kelių kamuolių
function Scenery.Oak(parent, pos, rng, scale)
	scale = scale or (0.9 + rng:NextNumber() * 0.6)
	local model = Build.Model("Oak", parent)
	deco({ Name = "Trunk", Parent = model, Size = V(2, 8, 2) * scale, CFrame = CF(pos + V(0, 4 * scale, 0)) * CFrame.Angles(0, rng:NextNumber() * 3, 0), Color = C(90, 62, 38), Material = M.Wood })
	deco({ Name = "Branch", Parent = model, Size = V(0.8, 4, 0.8) * scale, CFrame = CF(pos + V(1.2 * scale, 7 * scale, 0)) * CFrame.Angles(0, 0, math.rad(-35)), Color = C(90, 62, 38), Material = M.Wood })
	local leaves = vary(rng, C(65, 115, 45), 0.25)
	local blobs = { { 0, 10, 0, 9 }, { 3, 9, 1.5, 6.5 }, { -3, 9.3, -1, 6.5 }, { 0.5, 12.5, -1.5, 6 }, { -1, 8.5, 3, 5.5 } }
	for i, b in ipairs(blobs) do
		deco({ Name = "Leaves" .. i, Parent = model, Shape = Enum.PartType.Ball, Size = V(b[4], b[4], b[4]) * scale, CFrame = CF(pos + V(b[1], b[2], b[3]) * scale), Color = leaves:Lerp(C(0, 0, 0), (i % 3) * 0.05), Material = M.Grass, CanCollide = false })
	end
	-- Kartais su obuoliais
	if rng:NextNumber() < 0.3 then
		for i = 1, 5 do
			local angle = i * 1.25
			deco({ Name = "Apple", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.5, 0.5, 0.5), CFrame = CF(pos + V(math.cos(angle) * 4, 8 + (i % 2), math.sin(angle) * 4) * scale), Color = C(200, 30, 30), Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
		end
	end
	return model
end

function Scenery.RandomTree(parent, pos, rng, scale)
	local roll = rng:NextNumber()
	if roll < 0.45 then
		return Scenery.Pine(parent, pos, rng, scale)
	elseif roll < 0.7 then
		return Scenery.Birch(parent, pos, rng, scale)
	end
	return Scenery.Oak(parent, pos, rng, scale)
end

-- Lengvas miško medis (3 dalys) – tankiam miškui, kad nelagintų
function Scenery.ForestTree(parent, pos, rng, scale)
	scale = scale or (0.9 + rng:NextNumber() * 0.8)
	local model = Build.Model("ForestTree", parent)
	local roll = rng:NextNumber()
	if roll < 0.55 then
		-- Eglė
		local green = vary(rng, C(42, 92, 52), 0.25)
		deco({ Name = "Trunk", Parent = model, Size = V(1, 4, 1) * scale, CFrame = CF(pos + V(0, 2 * scale, 0)), Color = C(85, 58, 35), Material = M.Wood })
		deco({ Name = "Needles", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(5, 7.5, 7.5) * scale, CFrame = CF(pos + V(0, 5.5 * scale, 0)) * CYL_UP, Color = green, Material = M.Grass, CanCollide = false })
		deco({ Name = "Needles2", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(4.5, 4.4, 4.4) * scale, CFrame = CF(pos + V(0, 9.5 * scale, 0)) * CYL_UP, Color = green:Lerp(C(0, 0, 0), 0.08), Material = M.Grass, CanCollide = false })
	elseif roll < 0.8 then
		-- Beržas
		deco({ Name = "Trunk", Parent = model, Size = V(0.8, 9, 0.8) * scale, CFrame = CF(pos + V(0, 4.5 * scale, 0)), Color = C(235, 232, 225), Material = M.SmoothPlastic })
		deco({ Name = "Leaves", Parent = model, Shape = Enum.PartType.Ball, Size = V(6, 6, 6) * scale, CFrame = CF(pos + V(0, 9.5 * scale, 0)), Color = vary(rng, C(120, 170, 70), 0.2), Material = M.Grass, CanCollide = false })
		deco({ Name = "Mark", Parent = model, Size = V(0.85, 0.2, 0.4) * scale, CFrame = CF(pos + V(0, 3 * scale, 0)), Color = C(40, 40, 40), Material = M.SmoothPlastic })
	else
		-- Ąžuolas
		deco({ Name = "Trunk", Parent = model, Size = V(1.6, 6, 1.6) * scale, CFrame = CF(pos + V(0, 3 * scale, 0)), Color = C(90, 62, 38), Material = M.Wood })
		deco({ Name = "Leaves", Parent = model, Shape = Enum.PartType.Ball, Size = V(8.5, 8.5, 8.5) * scale, CFrame = CF(pos + V(0, 8 * scale, 0)), Color = vary(rng, C(65, 115, 45), 0.25), Material = M.Grass, CanCollide = false })
		deco({ Name = "Leaves2", Parent = model, Shape = Enum.PartType.Ball, Size = V(5.5, 5.5, 5.5) * scale, CFrame = CF(pos + V(2 * scale, 7 * scale, 1 * scale)), Color = vary(rng, C(70, 120, 48), 0.25), Material = M.Grass, CanCollide = false })
	end
	return model
end

-- Kalėdų eglė su žaisliukais ir žvaigžde (Kūčios, gruodis)
function Scenery.ChristmasTree(parent, pos, scale)
	scale = scale or 1
	local model = Build.Model("ChristmasTree", parent)
	deco({ Name = "Trunk", Parent = model, Size = V(1, 2, 1) * scale, CFrame = CF(pos + V(0, 1 * scale, 0)), Color = C(90, 60, 35), Material = M.Wood })
	local tiers = { { 8, 3 }, { 6.2, 5.6 }, { 4.4, 8 }, { 2.6, 10.2 } }
	for i, tier in ipairs(tiers) do
		deco({ Name = "Needles" .. i, Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2.6, tier[1], tier[1]) * scale, CFrame = CF(pos + V(0, tier[2] * scale, 0)) * CYL_UP, Color = C(35, 105, 55), Material = M.Grass })
	end
	local colors = { C(220, 40, 40), C(250, 210, 50), C(60, 120, 230), C(240, 240, 255) }
	for i = 1, 16 do
		local tier = tiers[(i % 3) + 1]
		local angle = i * 2.4
		local r = tier[1] / 2 * scale
		deco({ Name = "Ornament", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.5, 0.5, 0.5) * scale, CFrame = CF(pos + V(math.cos(angle) * r, (tier[2] - 0.6) * scale, math.sin(angle) * r)), Color = colors[(i % 4) + 1], Material = M.Neon, CanCollide = false })
	end
	local star = deco({ Name = "Star", Parent = model, Size = V(1.2, 1.2, 0.3) * scale, CFrame = CF(pos + V(0, 12 * scale, 0)) * CFrame.Angles(0, 0, math.rad(45)), Color = C(255, 215, 60), Material = M.Neon, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Color = C(255, 220, 120)
	light.Range = 16
	light.Parent = star
	return model
end

----------------------------------------------------------------------
-- Augalai ir akmenys
----------------------------------------------------------------------
function Scenery.Bush(parent, pos, rng, scale)
	scale = scale or (0.7 + rng:NextNumber() * 0.7)
	local model = Build.Model("Bush", parent)
	local green = vary(rng, C(70, 125, 50), 0.25)
	local count = 2 + rng:NextInteger(0, 2)
	for i = 1, count do
		local size = (2.2 + rng:NextNumber() * 1.6) * scale
		deco({ Name = "Leaves", Parent = model, Shape = Enum.PartType.Ball, Size = V(size, size, size), CFrame = CF(pos + V((rng:NextNumber() - 0.5) * 2.4 * scale, size * 0.35, (rng:NextNumber() - 0.5) * 2.4 * scale)), Color = green:Lerp(C(0, 0, 0), i * 0.04), Material = M.Grass, CanCollide = false, CastShadow = false })
	end
	-- Uogos
	if rng:NextNumber() < 0.35 then
		local berry = rng:NextNumber() < 0.5 and C(200, 30, 50) or C(60, 60, 160)
		for i = 1, 4 do
			deco({ Name = "Berry", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.35, 0.35, 0.35), CFrame = CF(pos + V(math.cos(i * 1.6) * 1.2 * scale, 1.4 * scale, math.sin(i * 1.6) * 1.2 * scale)), Color = berry, Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
		end
	end
	return model
end

function Scenery.Rock(parent, pos, rng, scale)
	scale = scale or (0.6 + rng:NextNumber() * 1.4)
	local model = Build.Model("Rock", parent)
	local gray = vary(rng, C(125, 122, 115), 0.2)
	deco({ Name = "Rock", Parent = model, Size = V(3, 2, 2.6) * scale, CFrame = CF(pos + V(0, 0.6 * scale, 0)) * CFrame.Angles(rng:NextNumber() * 0.5, rng:NextNumber() * 6, rng:NextNumber() * 0.5), Color = gray, Material = M.Slate })
	if rng:NextNumber() < 0.6 then
		deco({ Name = "Rock2", Parent = model, Size = V(1.6, 1.2, 1.5) * scale, CFrame = CF(pos + V(1.8 * scale, 0.4 * scale, 0.6 * scale)) * CFrame.Angles(0.3, rng:NextNumber() * 6, 0.2), Color = gray:Lerp(C(0, 0, 0), 0.1), Material = M.Slate, CastShadow = false })
	end
	if rng:NextNumber() < 0.4 then
		deco({ Name = "Moss", Parent = model, Size = V(2.2, 0.3, 1.8) * scale, CFrame = CF(pos + V(0, 1.55 * scale, 0)), Color = C(80, 130, 60), Material = M.Grass, CanCollide = false, CastShadow = false })
	end
	return model
end

local FLOWER_COLORS = { C(240, 60, 60), C(250, 220, 60), C(250, 250, 250), C(170, 90, 220), C(80, 140, 240), C(255, 140, 190) }

function Scenery.Flowers(parent, pos, rng, count)
	count = count or (4 + rng:NextInteger(0, 4))
	local model = Build.Model("Flowers", parent)
	local color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
	for _ = 1, count do
		local p = pos + V((rng:NextNumber() - 0.5) * 4, 0, (rng:NextNumber() - 0.5) * 4)
		local height = 0.8 + rng:NextNumber() * 0.6
		deco({ Name = "Stem", Parent = model, Size = V(0.12, height, 0.12), CFrame = CF(p + V(0, height / 2, 0)), Color = C(70, 140, 55), Material = M.Grass, CanCollide = false, CastShadow = false })
		deco({ Name = "Petals", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.45, 0.45, 0.45), CFrame = CF(p + V(0, height + 0.1, 0)), Color = color, Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
	end
	return model
end

function Scenery.Mushroom(parent, pos, rng)
	local model = Build.Model("Mushroom", parent)
	local red = rng:NextNumber() < 0.6
	deco({ Name = "Stem", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.8, 0.4, 0.4), CFrame = CF(pos + V(0, 0.4, 0)) * CYL_UP, Color = C(240, 235, 220), Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
	local cap = deco({ Name = "Cap", Parent = model, Size = V(1, 0.5, 1), CFrame = CF(pos + V(0, 0.85, 0)), Color = red and C(200, 40, 35) or C(150, 100, 60), Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
	Build.Mesh(cap, Enum.MeshType.Sphere)
	if red then
		for i = 1, 3 do
			deco({ Name = "Dot", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.15, 0.15, 0.15), CFrame = CF(pos + V(math.cos(i * 2.1) * 0.3, 1.05, math.sin(i * 2.1) * 0.3)), Color = C(255, 255, 255), Material = M.SmoothPlastic, CanCollide = false, CastShadow = false })
		end
	end
	return model
end

function Scenery.Reeds(parent, pos, rng)
	local model = Build.Model("Reeds", parent)
	for _ = 1, 5 do
		local p = pos + V((rng:NextNumber() - 0.5) * 2, 0, (rng:NextNumber() - 0.5) * 2)
		local h = 2 + rng:NextNumber() * 1.5
		deco({ Name = "Reed", Parent = model, Size = V(0.12, h, 0.12), CFrame = CF(p + V(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber() * 0.2, 0, rng:NextNumber() * 0.2), Color = C(110, 140, 60), Material = M.Grass, CanCollide = false, CastShadow = false })
		deco({ Name = "Cattail", Parent = model, Size = V(0.25, 0.6, 0.25), CFrame = CF(p + V(0, h, 0)), Color = C(110, 70, 40), Material = M.Fabric, CanCollide = false, CastShadow = false })
	end
	return model
end

----------------------------------------------------------------------
-- Kaimo daiktai
----------------------------------------------------------------------
function Scenery.Haystack(parent, pos, rng)
	local model = Build.Model("Haystack", parent)
	local hay = C(220, 185, 95)
	local base = deco({ Name = "Hay", Parent = model, Size = V(5, 4, 5), CFrame = CF(pos + V(0, 2, 0)), Color = hay, Material = M.Grass })
	Build.Mesh(base, Enum.MeshType.Sphere)
	local top = deco({ Name = "HayTop", Parent = model, Size = V(3.4, 3, 3.4), CFrame = CF(pos + V(0, 4.2, 0)), Color = hay:Lerp(C(255, 255, 255), 0.08), Material = M.Grass })
	Build.Mesh(top, Enum.MeshType.Sphere)
	deco({ Name = "Pole", Parent = model, Size = V(0.25, 3, 0.25), CFrame = CF(pos + V(0, 6, 0)), Color = C(110, 75, 45), Material = M.Wood })
	return model
end

function Scenery.Barrel(parent, pos, rng)
	local model = Build.Model("Barrel", parent)
	deco({ Name = "Body", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2.6, 2, 2), CFrame = CF(pos + V(0, 1.3, 0)) * CYL_UP, Color = C(130, 85, 45), Material = M.WoodPlanks })
	for _, y in ipairs({ 0.4, 2.2 }) do
		deco({ Name = "Hoop", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.2, 2.08, 2.08), CFrame = CF(pos + V(0, y, 0)) * CYL_UP, Color = C(70, 70, 75), Material = M.Metal, CastShadow = false })
	end
	return model
end

function Scenery.Crate(parent, pos, rng, size)
	size = size or 2.2
	local model = Build.Model("Crate", parent)
	deco({ Name = "Crate", Parent = model, Size = V(size, size, size), CFrame = CF(pos + V(0, size / 2, 0)) * CFrame.Angles(0, rng:NextNumber() * 1.5, 0), Color = C(160, 115, 65), Material = M.WoodPlanks })
	return model
end

function Scenery.Torch(parent, pos, height)
	height = height or 7
	local model = Build.Model("Torch", parent)
	deco({ Name = "Pole", Parent = model, Size = V(0.5, height, 0.5), CFrame = CF(pos + V(0, height / 2, 0)), Color = C(80, 55, 32), Material = M.Wood })
	deco({ Name = "Bowl", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.6, 1.3, 1.3), CFrame = CF(pos + V(0, height + 0.2, 0)) * CYL_UP, Color = C(60, 60, 65), Material = M.Metal })
	local flame = deco({ Name = "Flame", Parent = model, Size = V(0.5, 0.5, 0.5), CFrame = CF(pos + V(0, height + 0.8, 0)), Transparency = 1, CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = 2
	fire.Heat = 5
	fire.Parent = flame
	local light = Instance.new("PointLight")
	light.Color = C(255, 160, 70)
	light.Range = 16
	light.Brightness = 1.6
	light.Shadows = false
	light.Parent = flame
	return model
end

function Scenery.Banner(parent, pos, height)
	height = height or 10
	local model = Build.Model("Banner", parent)
	deco({ Name = "Pole", Parent = model, Size = V(0.4, height, 0.4), CFrame = CF(pos + V(0, height / 2, 0)), Color = C(90, 70, 50), Material = M.Wood })
	deco({ Name = "Finial", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.7, 0.7, 0.7), CFrame = CF(pos + V(0, height + 0.3, 0)), Color = C(230, 190, 60), Material = M.Metal })
	local stripes = { C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }
	for i, color in ipairs(stripes) do
		deco({ Name = "Stripe" .. i, Parent = model, Size = V(0.1, 1, 3.2), CFrame = CF(pos + V(0, height - 0.6 - (i - 1), 1.8)), Color = color, Material = M.Fabric, CanCollide = false })
	end
	return model
end

function Scenery.Bench(parent, cframe)
	local model = Build.Model("Bench", parent)
	deco({ Name = "Seat", Parent = model, Size = V(5, 0.4, 1.4), CFrame = cframe * CF(0, 1.4, 0), Color = C(140, 95, 55), Material = M.WoodPlanks })
	deco({ Name = "Back", Parent = model, Size = V(5, 1.2, 0.3), CFrame = cframe * CF(0, 2.3, 0.6), Color = C(140, 95, 55), Material = M.WoodPlanks })
	for _, x in ipairs({ -2.1, 2.1 }) do
		deco({ Name = "Leg", Parent = model, Size = V(0.4, 1.4, 1.2), CFrame = cframe * CF(x, 0.7, 0), Color = C(80, 55, 32), Material = M.Wood })
	end
	return model
end

function Scenery.Cart(parent, cframe)
	local model = Build.Model("Cart", parent)
	deco({ Name = "Bed", Parent = model, Size = V(4, 0.5, 6), CFrame = cframe * CF(0, 2, 0), Color = C(130, 88, 48), Material = M.WoodPlanks })
	for _, x in ipairs({ -2, 2 }) do
		deco({ Name = "Side", Parent = model, Size = V(0.3, 1.2, 6), CFrame = cframe * CF(x, 2.8, 0), Color = C(110, 72, 40), Material = M.WoodPlanks })
		deco({ Name = "Wheel", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.4, 3.2, 3.2), CFrame = cframe * CF(x * 1.12, 1.6, 0.8), Color = C(80, 55, 32), Material = M.Wood })
	end
	deco({ Name = "Handle", Parent = model, Size = V(0.3, 0.3, 4), CFrame = cframe * CF(0, 2, -4.5), Color = C(110, 72, 40), Material = M.Wood })
	for i = 1, 6 do
		deco({ Name = "Potato", Parent = model, Size = V(1.1, 0.85, 0.9), CFrame = cframe * CF(-1 + (i % 3), 2.7 + math.floor(i / 4) * 0.5, -1.5 + i * 0.5), Color = C(170, 122, 72), Material = M.Sand, CastShadow = false })
	end
	for _, part in ipairs(model:GetChildren()) do
		if part.Name == "Potato" then
			Build.Mesh(part, Enum.MeshType.Sphere)
		end
	end
	return model
end

function Scenery.Well(parent, pos)
	local model = Build.Model("Well", parent)
	deco({ Name = "Wall", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(3, 5, 5), CFrame = CF(pos + V(0, 1.5, 0)) * CYL_UP, Color = C(130, 128, 120), Material = M.Cobblestone })
	deco({ Name = "Water", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.2, 4, 4), CFrame = CF(pos + V(0, 2.6, 0)) * CYL_UP, Color = C(60, 110, 160), Material = M.Glass, Transparency = 0.2, CanCollide = false })
	for _, x in ipairs({ -2.2, 2.2 }) do
		deco({ Name = "Post", Parent = model, Size = V(0.4, 5, 0.4), CFrame = CF(pos + V(x, 4.5, 0)), Color = C(90, 62, 38), Material = M.Wood })
	end
	deco({ Name = "Roof1", Parent = model, Size = V(5.6, 0.3, 2.4), CFrame = CF(pos + V(0, 7.4, -0.9)) * CFrame.Angles(math.rad(35), 0, 0), Color = C(150, 50, 40), Material = M.WoodPlanks })
	deco({ Name = "Roof2", Parent = model, Size = V(5.6, 0.3, 2.4), CFrame = CF(pos + V(0, 7.4, 0.9)) * CFrame.Angles(math.rad(-35), 0, 0), Color = C(150, 50, 40), Material = M.WoodPlanks })
	deco({ Name = "Crank", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(4.4, 0.4, 0.4), CFrame = CF(pos + V(0, 5.5, 0)), Color = C(110, 72, 40), Material = M.Wood })
	deco({ Name = "Bucket", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.9, 0.9, 0.9), CFrame = CF(pos + V(0, 4.2, 0)) * CYL_UP, Color = C(120, 80, 45), Material = M.WoodPlanks })
	return model
end

-- Vėjo malūnas: sparnai sukasi (kliente, žymė "Spinner"). facing – kryptis, į kurią atsukti sparnai
function Scenery.Windmill(parent, pos, facing)
	local model = Build.Model("Windmill", parent)
	local look = CFrame.lookAt(pos, pos + V(facing.X, 0, facing.Z))
	local tiers = { { 9, 5 }, { 7.6, 13 }, { 6.2, 20 } }
	for i, tier in ipairs(tiers) do
		deco({ Name = "Tower" .. i, Parent = model, Size = V(tier[1], 8, tier[1]), CFrame = look * CF(0, tier[2] - 1, 0), Color = C(235, 228, 210), Material = M.Plaster })
	end
	deco({ Name = "Door", Parent = model, Size = V(2.6, 4, 0.3), CFrame = look * CF(0, 2, -4.6), Color = C(100, 62, 32), Material = M.Wood })
	deco({ Name = "Roof", Parent = model, Size = V(7, 4, 7), CFrame = look * CF(0, 25.5, 0), Color = C(140, 50, 40), Material = M.WoodPlanks })
	deco({ Name = "RoofTop", Parent = model, Size = V(4, 2.5, 4), CFrame = look * CF(0, 28.5, 0), Color = C(140, 50, 40), Material = M.WoodPlanks })
	local hubPos = (look * CF(0, 22, -4.4)).Position
	local hub = deco({
		Name = "Hub", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(1.6, 2.4, 2.4),
		CFrame = CFrame.lookAt(hubPos, hubPos + look.LookVector) * CFrame.Angles(0, math.rad(90), 0),
		Color = C(90, 62, 38), Material = M.Wood, Tags = { "Spinner" }, Attributes = { SpinSpeed = 0.8 },
	})
	local blades = {
		{ V(0.3, 15, 2.4), CF(0.6, 8, 0) }, { V(0.3, 15, 2.4), CF(0.6, -8, 0) },
		{ V(0.3, 2.4, 15), CF(0.6, 0, 8) }, { V(0.3, 2.4, 15), CF(0.6, 0, -8) },
	}
	for i, blade in ipairs(blades) do
		local part = deco({ Name = "Blade" .. i, Parent = model, Size = blade[1], CFrame = hub.CFrame * blade[2], Color = C(225, 215, 190), Material = M.Fabric, Anchored = false, CanCollide = false, Massless = true })
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hub
		weld.Part1 = part
		weld.Parent = part
	end
	return model
end

return Scenery
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">TitleItems</string><ProtectedString name="Source"><![CDATA[--[[
	TitleItems – atributika pagal rebirth titulą (dėvima ant veikėjo, matoma visiems).
	Kuo aukštesnis titulas, tuo daugiau daiktų atrakinta (jie kaupiasi):
	  Virtuvės padavėjas (0)    – baltas prijuostė su tautiniu raštu (iki Bajoro)
	  Cepelinų meistras (1)     – medinis šaukštas prie diržo
	  Kaimo šefas (3)           – aukšta šefo kepurė (iki karūnos)
	  Močiutės anūkas (5)       – megztas šalikas su tautiniu raštu
	  Bajoras (10)              – raudonas apsiaustas (prijuostė nusiimama)
	  Kunigaikštis (25)         – auksinė grandinė su Vyčio medalionu ir kardas prie šono
	  Vytautas Didysis (50)     – auksu apvadžiotas apsiaustas (+ karūna iš RebirthService)

	TitleItems.Apply(character, rebirths) – perpiešia aplanką "TitleItems" veikėjuje.
	TitleItems.Unlocked(rebirths) – sąrašas { Key = "TitleItem_..." } (pranešimams).
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local RED = C(193, 39, 45)
local GREEN = C(0, 106, 68)
local YELLOW = C(253, 185, 19)
local GOLD = C(240, 195, 60)

local TitleItems = {}

-- Daiktų sąrašas: nuo kiek rebirth ir iki kiek (Until – neįskaitant)
TitleItems.List = {
	{ Id = "Apron", At = 0, Until = 10, Key = "TitleItem_Apron" },
	{ Id = "Spoon", At = 1, Key = "TitleItem_Spoon" },
	{ Id = "ChefHat", At = 3, Until = 50, Key = "TitleItem_ChefHat" },
	{ Id = "Scarf", At = 5, Key = "TitleItem_Scarf" },
	{ Id = "Cape", At = 10, Key = "TitleItem_Cape" },
	{ Id = "Medallion", At = 25, Key = "TitleItem_Medallion" },
	{ Id = "Sword", At = 25, Key = "TitleItem_Sword" },
}

local function attach(folder, anchor, name, size, offset, color, material, shape, meshType)
	local part = Build.Part({
		Name = name, Parent = folder, Size = size, CFrame = anchor.CFrame * offset, Color = color,
		Material = material or M.SmoothPlastic, Shape = shape, Anchored = false, CanCollide = false,
		CanQuery = false, CanTouch = false, Massless = true, CastShadow = false,
	})
	if meshType then
		Build.Mesh(part, meshType)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = part
	weld.Parent = part
	return part
end

local BUILD = {}

BUILD.Apron = function(folder, torso, lower)
	local anchor = lower or torso
	local y = lower and 0 or -0.6
	attach(folder, anchor, "TitleApron", V(1.5, 1.3, 0.08), CF(0, y - 0.15, -anchor.Size.Z / 2 - 0.05), C(248, 246, 238), M.Fabric)
	for i = 0, 4 do
		local color = i % 2 == 0 and RED or GREEN
		attach(folder, anchor, "TitleApronPattern", V(0.2, 0.2, 0.04), CF(-0.5 + i * 0.25, y - 0.65, -anchor.Size.Z / 2 - 0.1) * CFrame.Angles(0, 0, math.rad(45)), color, M.Fabric)
	end
	attach(folder, torso, "TitleApronStrap", V(1.2, 0.12, 0.06), CF(0, -0.2, -torso.Size.Z / 2 - 0.04), C(248, 246, 238), M.Fabric)
end

BUILD.Spoon = function(folder, torso, lower)
	local anchor = lower or torso
	local side = anchor.Size.X / 2 + 0.08
	local y = lower and 0 or -0.7
	attach(folder, anchor, "TitleSpoonHandle", V(0.12, 1.4, 0.12), CF(side, y, 0.1) * CFrame.Angles(0, 0, math.rad(-12)), C(190, 140, 80), M.Wood)
	attach(folder, anchor, "TitleSpoonBowl", V(0.38, 0.5, 0.16), CF(side + 0.15, y - 0.75, 0.1), C(190, 140, 80), M.Wood, nil, Enum.MeshType.Sphere)
end

BUILD.ChefHat = function(folder, _, _, head)
	if not head then
		return
	end
	attach(folder, head, "TitleChefBand", V(0.5, 1.3, 1.3), CF(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), C(250, 250, 250), M.Fabric, Enum.PartType.Cylinder)
	attach(folder, head, "TitleChefPuff", V(1.6, 1.3, 1.6), CF(0, 1.45, 0), C(255, 255, 255), M.Fabric, nil, Enum.MeshType.Sphere)
end

BUILD.Scarf = function(folder, torso)
	local top = torso.Size.Y / 2
	attach(folder, torso, "TitleScarf", V(1.4, 0.35, 1.15), CF(0, top - 0.05, 0), RED, M.Fabric)
	attach(folder, torso, "TitleScarfEnd", V(0.35, 1.1, 0.1), CF(0.35, top - 0.65, -torso.Size.Z / 2 - 0.08), RED, M.Fabric)
	for i = 0, 2 do
		attach(folder, torso, "TitleScarfStripe", V(0.36, 0.1, 0.11), CF(0.35, top - 0.35 - i * 0.3, -torso.Size.Z / 2 - 0.09), i == 1 and GREEN or YELLOW, M.Fabric)
	end
end

local function cape(folder, torso, trim)
	local top = torso.Size.Y / 2
	attach(folder, torso, "TitleCape", V(1.9, 2.8, 0.1), CF(0, top - 1.45, torso.Size.Z / 2 + 0.12) * CFrame.Angles(math.rad(6), 0, 0), C(150, 25, 35), M.Fabric)
	attach(folder, torso, "TitleCapeCollar", V(1.9, 0.3, 0.5), CF(0, top - 0.05, torso.Size.Z / 2 - 0.05), trim and GOLD or C(245, 240, 230), trim and M.Metal or M.Fabric)
	if trim then
		attach(folder, torso, "TitleCapeTrim", V(1.92, 0.18, 0.12), CF(0, top - 2.85, torso.Size.Z / 2 + 0.27) * CFrame.Angles(math.rad(6), 0, 0), GOLD, M.Metal)
	end
end

BUILD.Cape = function(folder, torso, _, _, rebirths)
	cape(folder, torso, rebirths >= 50)
end

BUILD.Medallion = function(folder, torso)
	local top = torso.Size.Y / 2
	local front = -torso.Size.Z / 2 - 0.07
	for i = -3, 3 do
		attach(folder, torso, "TitleChain", V(0.14, 0.14, 0.06), CF(i * 0.16, top - 0.25 - (3 - math.abs(i)) * 0.09, front), GOLD, M.Metal)
	end
	attach(folder, torso, "TitleMedallion", V(0.12, 0.5, 0.5), CF(0, top - 0.75, front - 0.02) * CFrame.Angles(0, math.rad(90), 0), GOLD, M.Metal, Enum.PartType.Cylinder)
	attach(folder, torso, "TitleMedallionVytis", V(0.25, 0.28, 0.04), CF(0, top - 0.75, front - 0.1), RED, M.SmoothPlastic)
end

BUILD.Sword = function(folder, torso, lower)
	local anchor = lower or torso
	local side = -(anchor.Size.X / 2 + 0.1)
	local y = lower and -0.3 or -1
	attach(folder, anchor, "TitleScabbard", V(0.2, 2.2, 0.3), CF(side, y - 0.6, 0.15) * CFrame.Angles(math.rad(-15), 0, math.rad(8)), C(70, 40, 25), M.Wood)
	attach(folder, anchor, "TitleHilt", V(0.6, 0.12, 0.14), CF(side, y + 0.55, -0.15) * CFrame.Angles(math.rad(-15), 0, math.rad(8)), GOLD, M.Metal)
	attach(folder, anchor, "TitleGrip", V(0.12, 0.45, 0.12), CF(side, y + 0.8, -0.22) * CFrame.Angles(math.rad(-15), 0, math.rad(8)), C(110, 60, 30), M.Fabric)
end

local function isActive(item, rebirths)
	return rebirths >= item.At and (not item.Until or rebirths < item.Until)
end

function TitleItems.Apply(character, rebirths)
	rebirths = rebirths or 0
	local old = character:FindFirstChild("TitleItems")
	if old then
		old:Destroy()
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	local lower = character:FindFirstChild("LowerTorso")
	local head = character:FindFirstChild("Head")
	local folder = Instance.new("Model")
	folder.Name = "TitleItems"
	for _, item in ipairs(TitleItems.List) do
		if isActive(item, rebirths) and BUILD[item.Id] then
			pcall(BUILD[item.Id], folder, torso, lower, head, rebirths)
		end
	end
	folder.Parent = character
end

-- Daiktai, atrakinti būtent šiuo rebirth (kai titulas pasikeičia)
function TitleItems.NewlyUnlocked(oldRebirths, newRebirths)
	local list = {}
	for _, item in ipairs(TitleItems.List) do
		if item.At > (oldRebirths or 0) and item.At <= newRebirths then
			table.insert(list, item)
		end
	end
	return list
end

return TitleItems
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">ZoneThemes</string><ProtectedString name="Source"><![CDATA[--[[
	ZoneThemes – kiekvienos linijos zonos galas (ten, kur prasideda konvejeris).
	Kiekviena linija turi vientisą „pastato fasadą“ zonos gale, o konvejeris išeina pro
	angą viduryje – atrodo, lyg produktai atkeliauja iš močiutės trobos, pilies, virtuvės...
	Šonuose nieko nemėtoma, kad netrukdytų mygtukams ir mašinoms.

	Build(lineId, parent, laneCFrame): laneCFrame – linijos centro CFrame zonos paviršiuje
	(X – skersai linijos, Z – išilgai, -Z – produktų judėjimo kryptis).
	Fasadas stovi tarp Z = 52.5 ir 56 (zonos galas), plotis ~19 studų.
]]

local Build = require(script.Parent:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local ZoneThemes = {}

local CYL_UP = CFrame.Angles(0, 0, math.rad(90))
local OPENING = 3.0          -- angos pusplotis (konvejeris ~2.5)
local OPENING_H = 4.6        -- angos aukštis
local WALL_Z = 54.8          -- fasado sienos centras
local HALF = 9.6             -- zonos pusplotis

local function part(parent, lane, props, x, y, z, rot)
	props.Parent = parent
	local cf = lane * CF(x, y, z)
	if rot then
		cf = cf * rot
	end
	props.CFrame = cf
	props.CanQuery = false
	return Build.Part(props)
end

-- Siena per visą plotį su anga konvejeriui viduryje
local function wallWithOpening(parent, lane, height, color, material, thickness)
	thickness = thickness or 1.2
	local sideWidth = HALF - OPENING
	for _, side in ipairs({ -1, 1 }) do
		part(parent, lane, { Name = "Wall", Size = V(sideWidth, height, thickness), Color = color, Material = material }, side * (OPENING + sideWidth / 2), height / 2, WALL_Z)
	end
	part(parent, lane, { Name = "WallTop", Size = V(OPENING * 2, height - OPENING_H, thickness), Color = color, Material = material }, 0, OPENING_H + (height - OPENING_H) / 2, WALL_Z)
	-- Tamsus angos vidus (gilumas)
	part(parent, lane, { Name = "OpeningShadow", Size = V(OPENING * 2, OPENING_H, 0.2), Color = C(25, 18, 12), Material = M.SmoothPlastic, CanCollide = false }, 0, OPENING_H / 2, WALL_Z + thickness / 2 + 0.1)
end

local function light(parentPart, color, range, brightness)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range
	pointLight.Brightness = brightness or 1
	pointLight.Shadows = false
	pointLight.Parent = parentPart
	return pointLight
end

-- Langas su mėlynomis langinėmis (tradicinė lietuviška troba)
local function cottageWindow(parent, lane, x, y)
	part(parent, lane, { Name = "WindowFrame", Size = V(2.4, 2.2, 0.3), Color = C(245, 240, 225), Material = M.Wood }, x, y, WALL_Z - 0.65)
	part(parent, lane, { Name = "WindowGlass", Size = V(1.9, 1.7, 0.1), Color = C(255, 215, 140), Material = M.Neon, Transparency = 0.35 }, x, y, WALL_Z - 0.82)
	part(parent, lane, { Name = "WindowCross", Size = V(0.14, 1.7, 0.08), Color = C(245, 240, 225), Material = M.Wood }, x, y, WALL_Z - 0.88)
	part(parent, lane, { Name = "WindowCross", Size = V(1.9, 0.14, 0.08), Color = C(245, 240, 225), Material = M.Wood }, x, y, WALL_Z - 0.88)
	for _, side in ipairs({ -1, 1 }) do
		part(parent, lane, { Name = "Shutter", Size = V(0.9, 2.2, 0.15), Color = C(55, 95, 160), Material = M.Wood }, x + side * 1.7, y, WALL_Z - 0.7)
	end
end

----------------------------------------------------------------------
-- Cepelinai: močiutės rąstinė troba su krosnimi ir bulvių maišais
----------------------------------------------------------------------
local function cepelinai(parent, lane)
	local logColor = C(120, 80, 45)
	-- Rąstai (horizontalūs, su tamsesniais tarpais)
	wallWithOpening(parent, lane, 7.2, logColor, M.Wood)
	for row = 0, 5 do
		local y = 1.2 + row * 1.2
		if y < OPENING_H then
			local width = HALF - OPENING
			for _, side in ipairs({ -1, 1 }) do
				part(parent, lane, { Name = "LogLine", Size = V(width, 0.12, 0.1), Color = C(80, 50, 28), Material = M.Wood, CanCollide = false }, side * (OPENING + width / 2), y, WALL_Z - 0.62)
			end
		else
			part(parent, lane, { Name = "LogLine", Size = V(HALF * 2, 0.12, 0.1), Color = C(80, 50, 28), Material = M.Wood, CanCollide = false }, 0, y, WALL_Z - 0.62)
		end
	end
	-- Durų staktos ir stogelis
	for _, side in ipairs({ -1, 1 }) do
		part(parent, lane, { Name = "DoorPost", Size = V(0.5, OPENING_H + 0.4, 0.5), Color = C(90, 58, 30), Material = M.Wood }, side * (OPENING + 0.25), (OPENING_H + 0.4) / 2, WALL_Z - 0.7)
	end
	part(parent, lane, { Name = "Lintel", Size = V(OPENING * 2 + 1.2, 0.6, 0.6), Color = C(90, 58, 30), Material = M.Wood }, 0, OPENING_H + 0.3, WALL_Z - 0.7)
	part(parent, lane, { Name = "Roof", Size = V(HALF * 2 + 0.6, 0.5, 3), Color = C(150, 120, 70), Material = M.Grass }, 0, 7.6, WALL_Z - 0.4, CFrame.Angles(math.rad(-18), 0, 0))
	cottageWindow(parent, lane, -6.6, 4.2)
	-- Balta molinė krosnis kairėje, matosi ugnis
	part(parent, lane, { Name = "Oven", Size = V(3.2, 3.2, 2.2), Color = C(235, 230, 215), Material = M.Plaster }, -6.6, 1.6, WALL_Z - 1.7)
	part(parent, lane, { Name = "OvenMouthFrame", Size = V(1.6, 1.2, 0.2), Color = C(60, 45, 35), Material = M.Brick }, -6.6, 1.4, WALL_Z - 2.85)
	local fire = part(parent, lane, { Name = "OvenFire", Size = V(1.2, 0.8, 0.1), Color = C(255, 120, 30), Material = M.Neon }, -6.6, 1.3, WALL_Z - 2.92)
	light(fire, C(255, 150, 60), 10, 1.2)
	part(parent, lane, { Name = "Chimney", Size = V(1.2, 4.4, 1.2), Color = C(235, 230, 215), Material = M.Plaster }, -7.6, 9, WALL_Z)
	-- Bulvių maišai ir pintinė dešinėje
	for i = 0, 2 do
		local sack = part(parent, lane, { Name = "PotatoSack", Size = V(1.7, 2.1, 1.5), Color = C(190, 165, 115), Material = M.Fabric }, 4.6 + i * 1.75, 1.05, WALL_Z - 1.6)
		Build.Mesh(sack, Enum.MeshType.Sphere, V(1, 1, 1))
		part(parent, lane, { Name = "SackTie", Size = V(0.7, 0.4, 0.7), Color = C(160, 135, 90), Material = M.Fabric }, 4.6 + i * 1.75, 2.2, WALL_Z - 1.6)
	end
	part(parent, lane, { Name = "Basket", Shape = Enum.PartType.Cylinder, Size = V(0.9, 1.8, 1.8), Color = C(170, 125, 70), Material = M.WoodPlanks }, 4.4, 0.45, WALL_Z - 3.2, CYL_UP)
	for i = 0, 3 do
		local potato = part(parent, lane, { Name = "Potato", Size = V(0.7, 0.55, 0.6), Color = C(175, 128, 75), Material = M.Sand }, 4.1 + (i % 2) * 0.55, 1.0 + math.floor(i / 2) * 0.25, WALL_Z - 3.4 + (i % 3) * 0.3)
		Build.Mesh(potato, Enum.MeshType.Sphere)
	end
end

----------------------------------------------------------------------
-- Kibinai: Trakų pilies vartai (raudonos plytos, du bokštai, vartų grotos)
----------------------------------------------------------------------
local function castleTower(parent, lane, x, z)
	local brick = C(165, 65, 48)
	part(parent, lane, { Name = "Tower", Shape = Enum.PartType.Cylinder, Size = V(10, 4.2, 4.2), Color = brick, Material = M.Brick }, x, 5, z, CYL_UP)
	part(parent, lane, { Name = "TowerRing", Shape = Enum.PartType.Cylinder, Size = V(0.6, 4.6, 4.6), Color = C(140, 50, 38), Material = M.Brick }, x, 10.1, z, CYL_UP)
	-- Kūginis stogas iš mažėjančių cilindrų
	for i = 0, 5 do
		local d = 4.6 - i * 0.75
		part(parent, lane, { Name = "TowerRoof", Shape = Enum.PartType.Cylinder, Size = V(0.75, d, d), Color = C(120, 35, 30), Material = M.Slate }, x, 10.7 + i * 0.7, z, CYL_UP)
	end
	part(parent, lane, { Name = "TowerSpire", Size = V(0.2, 1.8, 0.2), Color = C(230, 190, 60), Material = M.Metal }, x, 15.6, z)
	part(parent, lane, { Name = "Pennant", Size = V(1.2, 0.6, 0.05), Color = C(253, 185, 19), Material = M.Fabric }, x + 0.7, 16.1, z)
	part(parent, lane, { Name = "ArrowSlit", Size = V(0.3, 1.2, 0.2), Color = C(30, 20, 15), Material = M.SmoothPlastic }, x, 6.5, z - 2.1)
end

local function kibinai(parent, lane)
	local brick = C(165, 65, 48)
	wallWithOpening(parent, lane, 7, brick, M.Brick, 1.4)
	for i = -3, 3 do
		if i ~= 0 then
			part(parent, lane, { Name = "Crenel", Size = V(1.1, 1.2, 1.4), Color = brick, Material = M.Brick }, i * 1.9, 7.6, WALL_Z)
		end
	end
	-- Arka virš vartų ir pakeltos grotos
	part(parent, lane, { Name = "Arch", Size = V(OPENING * 2 + 1, 0.8, 1.6), Color = C(200, 190, 175), Material = M.Limestone }, 0, OPENING_H + 0.4, WALL_Z - 0.1)
	for i = -2, 2 do
		part(parent, lane, { Name = "PortcullisBar", Size = V(0.18, 1.4, 0.18), Color = C(60, 60, 65), Material = M.Metal }, i * 1.2, OPENING_H - 0.6, WALL_Z - 0.75)
	end
	part(parent, lane, { Name = "PortcullisBeam", Size = V(OPENING * 2, 0.18, 0.18), Color = C(60, 60, 65), Material = M.Metal }, 0, OPENING_H - 1.25, WALL_Z - 0.75)
	castleTower(parent, lane, -7.5, WALL_Z - 0.6)
	castleTower(parent, lane, 7.5, WALL_Z - 0.6)
	-- Fakelai prie vartų
	for _, side in ipairs({ -1, 1 }) do
		part(parent, lane, { Name = "TorchHolder", Size = V(0.3, 1, 0.3), Color = C(60, 60, 65), Material = M.Metal }, side * 4, 3.4, WALL_Z - 0.85)
		local flame = part(parent, lane, { Name = "TorchFlame", Size = V(0.4, 0.5, 0.4), Color = C(255, 150, 40), Material = M.Neon, CanCollide = false }, side * 4, 4.1, WALL_Z - 0.85)
		light(flame, C(255, 160, 70), 9, 1)
	end
	-- Gedimino stulpų vėliavos ant sienos
	for _, side in ipairs({ -1, 1 }) do
		part(parent, lane, { Name = "Banner", Size = V(1.4, 2.6, 0.1), Color = C(170, 30, 35), Material = M.Fabric }, side * 4.6, 5.6, WALL_Z - 0.75)
		part(parent, lane, { Name = "BannerSign", Size = V(0.7, 0.7, 0.05), Color = C(240, 195, 60), Material = M.Metal }, side * 4.6, 5.8, WALL_Z - 0.82)
	end
end

----------------------------------------------------------------------
-- Šaltibarščiai: vasaros virtuvėlė (veranda) su stalu, dubeniu, kefyru, burokėliais
----------------------------------------------------------------------
local function saltibarsciai(parent, lane)
	local plank = C(235, 225, 200)
	wallWithOpening(parent, lane, 6.4, plank, M.WoodPlanks, 0.8)
	part(parent, lane, { Name = "Trim", Size = V(HALF * 2, 0.4, 0.3), Color = C(100, 160, 95), Material = M.Wood }, 0, 6.5, WALL_Z - 0.45)
	part(parent, lane, { Name = "Awning", Size = V(HALF * 2 + 0.4, 0.25, 2.6), Color = C(230, 110, 170), Material = M.Fabric }, 0, 7.1, WALL_Z - 1.2, CFrame.Angles(math.rad(-15), 0, 0))
	for i = -4, 4 do
		part(parent, lane, { Name = "AwningStripe", Size = V(1, 0.27, 2.62), Color = C(250, 245, 245), Material = M.Fabric }, i * 2.1, 7.1, WALL_Z - 1.2, CFrame.Angles(math.rad(-15), 0, 0))
	end
	-- Langas su languota užuolaida
	part(parent, lane, { Name = "WindowGlass", Size = V(2.6, 2, 0.1), Color = C(180, 220, 240), Material = M.Glass, Transparency = 0.2 }, 6.4, 4.2, WALL_Z - 0.45)
	part(parent, lane, { Name = "Curtain", Size = V(2.6, 0.7, 0.12), Color = C(220, 60, 70), Material = M.Fabric }, 6.4, 4.9, WALL_Z - 0.55)
	-- Stalas kairėje su dideliu šaltibarščių dubeniu
	part(parent, lane, { Name = "TableTop", Size = V(4.4, 0.3, 2.2), Color = C(140, 95, 55), Material = M.WoodPlanks }, -6.5, 2.6, WALL_Z - 1.8)
	for _, x in ipairs({ -8.4, -4.6 }) do
		part(parent, lane, { Name = "TableLeg", Size = V(0.3, 2.5, 0.3), Color = C(110, 72, 40), Material = M.Wood }, x, 1.25, WALL_Z - 1.8)
	end
	part(parent, lane, { Name = "Tablecloth", Size = V(4.5, 0.06, 2.3), Color = C(250, 250, 250), Material = M.Fabric }, -6.5, 2.78, WALL_Z - 1.8)
	local bowl = part(parent, lane, { Name = "BigBowl", Size = V(2, 0.9, 2), Color = C(245, 245, 240), Material = M.SmoothPlastic }, -7, 3.15, WALL_Z - 1.8)
	Build.Mesh(bowl, Enum.MeshType.Sphere, V(1, 1, 1))
	part(parent, lane, { Name = "Soup", Shape = Enum.PartType.Cylinder, Size = V(0.1, 1.75, 1.75), Color = C(240, 105, 170), Material = M.SmoothPlastic }, -7, 3.5, WALL_Z - 1.8, CYL_UP)
	local egg = part(parent, lane, { Name = "EggHalf", Size = V(0.45, 0.2, 0.35), Color = C(255, 250, 240), Material = M.SmoothPlastic }, -7.3, 3.58, WALL_Z - 1.7)
	Build.Mesh(egg, Enum.MeshType.Sphere)
	part(parent, lane, { Name = "Yolk", Shape = Enum.PartType.Ball, Size = V(0.2, 0.2, 0.2), Color = C(255, 200, 40), Material = M.SmoothPlastic }, -7.3, 3.66, WALL_Z - 1.7)
	part(parent, lane, { Name = "Dill", Size = V(0.5, 0.06, 0.4), Color = C(80, 160, 70), Material = M.Grass }, -6.7, 3.57, WALL_Z - 1.9)
	-- Kefyro ąsotis ir burokėliai
	part(parent, lane, { Name = "KefirJug", Shape = Enum.PartType.Cylinder, Size = V(1.3, 0.8, 0.8), Color = C(250, 250, 245), Material = M.SmoothPlastic }, -5.3, 3.4, WALL_Z - 1.6, CYL_UP)
	part(parent, lane, { Name = "KefirLid", Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.6, 0.6), Color = C(60, 120, 200), Material = M.SmoothPlastic }, -5.3, 4.1, WALL_Z - 1.6, CYL_UP)
	part(parent, lane, { Name = "BeetCrate", Size = V(2.6, 1.1, 1.6), Color = C(170, 125, 70), Material = M.WoodPlanks }, 5.8, 0.55, WALL_Z - 1.4)
	for i = 0, 5 do
		local bx = 4.9 + (i % 3) * 0.9
		local bz = WALL_Z - 1.75 + math.floor(i / 3) * 0.7
		part(parent, lane, { Name = "Beet", Shape = Enum.PartType.Ball, Size = V(0.75, 0.75, 0.75), Color = C(130, 20, 55), Material = M.SmoothPlastic }, bx, 1.35, bz)
		part(parent, lane, { Name = "BeetLeaf", Size = V(0.12, 0.6, 0.35), Color = C(80, 150, 60), Material = M.Grass, CanCollide = false }, bx, 1.95, bz)
	end
	-- Agurkai ir krapai indelyje
	part(parent, lane, { Name = "DillPot", Shape = Enum.PartType.Cylinder, Size = V(0.8, 0.8, 0.8), Color = C(190, 100, 60), Material = M.Brick }, 8.4, 0.4, WALL_Z - 1.4, CYL_UP)
	for i = 0, 2 do
		part(parent, lane, { Name = "DillSprig", Size = V(0.15, 1.1, 0.15), Color = C(90, 170, 70), Material = M.Grass, CanCollide = false }, 8.25 + i * 0.15, 1.3, WALL_Z - 1.4, CFrame.Angles(0, 0, math.rad(-15 + i * 15)))
	end
end

----------------------------------------------------------------------
-- Šakotis: šventinė kepykla – židinys su sukamu iešmu ir šakočiai ant stalo
----------------------------------------------------------------------
local function sakotisCake(parent, lane, x, y, z, scale)
	local dough = C(220, 165, 75)
	local crust = C(170, 105, 40)
	local layers = 6
	for i = 0, layers - 1 do
		local d = (1.5 - i * 0.18) * scale
		local ly = y + (0.25 + i * 0.45) * scale
		part(parent, lane, { Name = "SakotisLayer", Shape = Enum.PartType.Cylinder, Size = V(0.45 * scale, d, d), Color = i % 2 == 0 and dough or crust, Material = M.SmoothPlastic, CanCollide = false }, x, ly, z, CYL_UP)
		-- „Šakos“ – išsikišę traškūs dygliai aplink
		local spikes = 7 - math.floor(i / 2)
		for k = 0, spikes - 1 do
			local a = math.rad(k * 360 / spikes + i * 23)
			local r = d / 2 + 0.15 * scale
			part(parent, lane, { Name = "SakotisSpike", Size = V(0.18 * scale, 0.18 * scale, 0.45 * scale), Color = crust, Material = M.SmoothPlastic, CanCollide = false },
				x + math.cos(a) * r, ly - 0.05 * scale, z + math.sin(a) * r, CFrame.Angles(0, -a + math.rad(90), 0) * CFrame.Angles(math.rad(-25), 0, 0))
		end
	end
	part(parent, lane, { Name = "SakotisTop", Shape = Enum.PartType.Ball, Size = V(0.35, 0.35, 0.35) * scale, Color = crust, Material = M.SmoothPlastic, CanCollide = false }, x, y + (0.25 + layers * 0.45) * scale, z)
end

local function sakotis(parent, lane)
	-- Fachverkinė kepyklos siena: kreminis tinkas ir tamsios sijos
	wallWithOpening(parent, lane, 7, C(240, 228, 200), M.Plaster, 1)
	for _, x in ipairs({ -9.2, -6.2, 6.2, 9.2 }) do
		part(parent, lane, { Name = "Beam", Size = V(0.45, 7, 0.2), Color = C(85, 55, 30), Material = M.Wood }, x, 3.5, WALL_Z - 0.55)
	end
	part(parent, lane, { Name = "BeamTop", Size = V(HALF * 2, 0.45, 0.2), Color = C(85, 55, 30), Material = M.Wood }, 0, 6.9, WALL_Z - 0.55)
	part(parent, lane, { Name = "BeamMid", Size = V(HALF * 2, 0.35, 0.2), Color = C(85, 55, 30), Material = M.Wood }, 0, OPENING_H + 0.2, WALL_Z - 0.55)
	-- Kairėje: plytinis židinys su ugnimi ir sukamu iešmu (šakotis kepamas sukant virš ugnies)
	part(parent, lane, { Name = "Hearth", Size = V(5, 1, 2.6), Color = C(120, 60, 45), Material = M.Brick }, -6.4, 0.5, WALL_Z - 1.9)
	part(parent, lane, { Name = "HearthBack", Size = V(5, 4, 0.6), Color = C(120, 60, 45), Material = M.Brick }, -6.4, 2.5, WALL_Z - 0.8)
	local fireBase = part(parent, lane, { Name = "Fire", Size = V(1, 1, 1), Transparency = 1, CanCollide = false }, -6.4, 1.3, WALL_Z - 1.9)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 5
	fire.Parent = fireBase
	light(fireBase, C(255, 150, 60), 10, 1.2)
	for _, x in ipairs({ -8.6, -4.2 }) do
		part(parent, lane, { Name = "SpitPost", Size = V(0.3, 3.4, 0.3), Color = C(60, 60, 65), Material = M.Metal }, x, 2.7, WALL_Z - 1.9)
	end
	part(parent, lane, {
		Name = "Spit", Shape = Enum.PartType.Cylinder, Size = V(3.6, 1.5, 1.5), Color = C(225, 170, 80), Material = M.SmoothPlastic,
		Tags = { "Spinner" }, Attributes = { SpinSpeed = 1.2 },
	}, -6.4, 3.6, WALL_Z - 1.9)
	-- Dešinėje: stalas su šakočiais ant padėklų ir šventiniu kaspinu
	part(parent, lane, { Name = "TableTop", Size = V(5, 0.3, 2.2), Color = C(140, 95, 55), Material = M.WoodPlanks }, 6.3, 2.6, WALL_Z - 1.8)
	for _, x in ipairs({ 4.1, 8.5 }) do
		part(parent, lane, { Name = "TableLeg", Size = V(0.3, 2.5, 0.3), Color = C(110, 72, 40), Material = M.Wood }, x, 1.25, WALL_Z - 1.8)
	end
	part(parent, lane, { Name = "Tablecloth", Size = V(5.1, 0.06, 2.3), Color = C(250, 250, 245), Material = M.Fabric }, 6.3, 2.78, WALL_Z - 1.8)
	part(parent, lane, { Name = "ClothStripe", Size = V(5.12, 0.07, 0.4), Color = C(200, 50, 50), Material = M.Fabric }, 6.3, 2.79, WALL_Z - 2.6)
	sakotisCake(parent, lane, 5.2, 2.81, WALL_Z - 1.8, 1)
	sakotisCake(parent, lane, 7.5, 2.81, WALL_Z - 1.8, 0.8)
end

----------------------------------------------------------------------
-- Auksinis Cepelinas: karališka auksinė salė su Vytauto Didžiojo statula
----------------------------------------------------------------------
local function auksinis(parent, lane)
	local gold = C(240, 195, 60)
	local marble = C(240, 235, 225)
	wallWithOpening(parent, lane, 7.6, marble, M.Marble, 1.2)
	part(parent, lane, { Name = "GoldTrim", Size = V(HALF * 2, 0.4, 0.3), Color = gold, Material = M.Metal }, 0, 7.4, WALL_Z - 0.7)
	part(parent, lane, { Name = "GoldBase", Size = V(HALF * 2, 0.5, 0.3), Color = gold, Material = M.Metal }, 0, 0.25, WALL_Z - 0.7)
	-- Dvi auksinės kolonos prie angos
	for _, side in ipairs({ -1, 1 }) do
		local x = side * (OPENING + 0.9)
		part(parent, lane, { Name = "Column", Shape = Enum.PartType.Cylinder, Size = V(6.6, 1.2, 1.2), Color = gold, Material = M.Metal }, x, 3.6, WALL_Z - 1, CYL_UP)
		part(parent, lane, { Name = "ColumnCap", Size = V(1.6, 0.4, 1.6), Color = gold, Material = M.Metal }, x, 7.1, WALL_Z - 1)
		part(parent, lane, { Name = "ColumnBase", Size = V(1.6, 0.4, 1.6), Color = gold, Material = M.Metal }, x, 0.2, WALL_Z - 1)
	end
	-- Gintariniai langai šonuose
	for _, x in ipairs({ -7, 7 }) do
		local amber = part(parent, lane, { Name = "AmberWindow", Size = V(2, 3, 0.15), Color = C(255, 160, 40), Material = M.Neon, Transparency = 0.25 }, x, 4, WALL_Z - 0.68)
		part(parent, lane, { Name = "AmberFrame", Size = V(2.4, 3.4, 0.1), Color = gold, Material = M.Metal }, x, 4, WALL_Z - 0.62)
		light(amber, C(255, 180, 80), 10, 0.8)
	end
	-- Vytauto Didžiojo statula ant sienos viršaus, virš angos
	part(parent, lane, { Name = "StatuePedestal", Size = V(3, 1, 2), Color = marble, Material = M.Marble }, 0, 8.1, WALL_Z)
	part(parent, lane, { Name = "StatueLegs", Size = V(1.4, 1.8, 0.8), Color = gold, Material = M.Metal }, 0, 9.5, WALL_Z)
	part(parent, lane, { Name = "StatueBody", Size = V(1.9, 2, 1), Color = gold, Material = M.Metal }, 0, 11.4, WALL_Z)
	local head = part(parent, lane, { Name = "StatueHead", Shape = Enum.PartType.Ball, Size = V(1.1, 1.1, 1.1), Color = gold, Material = M.Metal }, 0, 12.95, WALL_Z)
	part(parent, lane, { Name = "StatueCrown", Size = V(1.1, 0.45, 1.1), Color = C(255, 220, 90), Material = M.Neon }, 0, 13.65, WALL_Z)
	part(parent, lane, { Name = "StatueCape", Size = V(2.1, 2.8, 0.25), Color = C(160, 30, 40), Material = M.Fabric }, 0, 11, WALL_Z + 0.6)
	part(parent, lane, { Name = "StatueSword", Size = V(0.25, 3, 0.25), Color = C(220, 220, 230), Material = M.Metal }, 1.4, 11.4, WALL_Z - 0.5, CFrame.Angles(0, 0, math.rad(-20)))
	light(head, C(255, 210, 120), 18, 1)
end

local BUILDERS = {
	Cepelinai = cepelinai,
	Kibinai = kibinai,
	Saltibarsciai = saltibarsciai,
	Sakotis = sakotis,
	AuksinisCepelinas = auksinis,
}

-- Šakočio modelis (naudojamas ir kitur)
ZoneThemes.SakotisCake = sakotisCake

function ZoneThemes.Build(lineId, parent, laneCFrame)
	local builder = BUILDERS[lineId]
	if builder then
		builder(parent, laneCFrame)
	end
end

return ZoneThemes
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Script" referent="RBX41"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Main – serverio paleidimas.
	Kiekvienas servisas (ServerScriptService/Services) turi :Init(S) ir :Start().
	S – visų servisų lentelė, todėl servisai vienas kito nereikalauja per require
	(taip išvengiama ciklinių priklausomybių).
]]

local ServerScriptService = game:GetService("ServerScriptService")

local servicesFolder = ServerScriptService:WaitForChild("Services")

-- Paleidimo eilė svarbi: duomenys -> šablonai -> žemėlapis -> sklypai -> likusios sistemos
local ORDER = {
	"DataService",
	"TemplateBuilder",
	"MapBuilder",
	"PlotService",
	"MonetizationService",
	"BonusService",
	"EventService",
	"TycoonService",
	"GrannyService",
	"WeaponService",
	"QuizService",
	"RadioService",
	"JailService",
	"GearService",
	"RebirthService",
	"LeaderboardService",
	"AdminService",
}

local S = {}

for _, name in ipairs(ORDER) do
	local module = servicesFolder:WaitForChild(name)
	local ok, result = pcall(require, module)
	if ok then
		S[name] = result
	else
		task.spawn(error, "[Main] Nepavyko įkelti " .. name .. ": " .. tostring(result))
	end
end

for _, name in ipairs(ORDER) do
	local service = S[name]
	if service and service.Init then
		local ok, err = pcall(service.Init, service, S)
		if not ok then
			task.spawn(error, "[Main] " .. name .. ":Init klaida: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local service = S[name]
	if service and service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			task.spawn(error, "[Main] " .. name .. ":Start klaida: " .. tostring(err))
		end
	end
end

-- Kai visi servisai paleisti, prijungiami žaidėjai (DataService įkelia jų duomenis)
S.DataService:BeginPlayers()
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX59"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">AdminService</string><ProtectedString name="Source"><![CDATA[--[[
	AdminService – administratoriaus komandos.
	Kas gali naudoti:
	  - Roblox Studio: visi (testavimui);
	  - tikrame žaidime: TIK žaidimo savininkas (game.CreatorId) ir Settings.AdminUserIds žaidėjai.
	Kitiems žaidėjams komandos nieko nedaro.

	Komandos (rašyk į pokalbį):
	  /givemoney Jonas 5000      – duoti litų kitam žaidėjui (vardo pradžia, "all" – visiems)
	  /addmoney 1000000          – pridėti litų sau
	  /takemoney Jonas 5000      – atimti litų iš žaidėjo ("all" – iš visų; daugiau nei turi – lieka 0)
	  /setrebirths 5             – nustatyti rebirth skaičių (gamykla perstatoma)
	  /event lietus|cepelinas|jonines|stop
	  /givepass DoubleMoney|FastDroppers|GrannyHelp|VIP|OfflineIncome
	  /product SmallBag|BigBag|PotatoRain|Boost3
	  /resetdata                 – ištrinti savo progresą
	  /jail Jonas / /unjail Jonas – pasodinti nusikaltėlį ant kėdės miške / paleisti
	  /mage 1234567890           – radijas „Magė“ groja muziką pagal kodą (/mage stop, /mage volume 0.5)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Monetization = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("Monetization"))
local Settings = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("Settings"))

local AdminService = {}
local S

local EVENT_NAMES = {
	lietus = "PotatoRain", cepelinas = "BigCepelinas", jonines = "Jonines",
	laume = "Fairy", ziema = "Winter", varzybos = "Contest", mociute = "SkyGranny",
}

local function reply(player, text)
	ReplicatedStorage.Remotes.Notify:FireClient(player, "__raw", { text = "[Admin] " .. text }, {}, {}, "info")
end

-- Ar žaidėjas gali naudoti admin komandas
function AdminService:IsAdmin(player)
	if RunService:IsStudio() then
		return true
	end
	for _, id in ipairs(Settings.AdminUserIds or {}) do
		if player.UserId == id then
			return true
		end
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	-- Grupės žaidimas: grupės savininkas (rangas 255)
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 255
end

-- Randa žaidėjus pagal vardo pradžią (Name arba DisplayName); "all" – visi
local function findTargets(query)
	local list = {}
	query = string.lower(query or "")
	if query == "" then
		return list
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if query == "all" or string.sub(string.lower(other.Name), 1, #query) == query or string.sub(string.lower(other.DisplayName), 1, #query) == query then
			table.insert(list, other)
		end
	end
	return list
end

function AdminService:Run(player, message)
	if not self:IsAdmin(player) then
		return
	end
	local args = string.split(message, " ")
	local command = string.lower(args[1] or "")
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	print("[Admin] " .. player.Name .. ": " .. message)

	if command == "/givemoney" then
		local targets = findTargets(args[2])
		local amount = tonumber(args[3])
		if #targets == 0 or not amount or amount <= 0 then
			reply(player, "/givemoney <vardas|all> <suma>, pvz. /givemoney Jonas 5000")
			return
		end
		for _, target in ipairs(targets) do
			if S.DataService:AddMoney(target, amount, false) then
				ReplicatedStorage.Remotes.Notify:FireClient(target, "__raw", { text = "🎁 +" .. amount .. " Lt" }, {}, {}, "success")
				reply(player, target.Name .. " +" .. amount .. " Lt")
			end
		end
	elseif command == "/takemoney" then
		local targets = findTargets(args[2])
		local amount = tonumber(args[3])
		if #targets == 0 or not amount or amount <= 0 or amount ~= amount then
			reply(player, "/takemoney <vardas|all> <suma>, pvz. /takemoney Jonas 5000")
			return
		end
		for _, target in ipairs(targets) do
			local targetData = S.DataService:Get(target)
			if targetData then
				local taken = math.min(amount, targetData.money)
				targetData.money = targetData.money - taken
				S.DataService:UpdateStats(target)
				ReplicatedStorage.Remotes.Notify:FireClient(target, "__raw", { text = "💸 -" .. math.floor(taken) .. " Lt" }, {}, {}, "error")
				reply(player, target.Name .. " -" .. math.floor(taken) .. " Lt (liko " .. math.floor(targetData.money) .. ")")
			end
		end
	elseif command == "/addmoney" then
		local amount = tonumber(args[2])
		if amount and amount > 0 then
			S.DataService:AddMoney(player, amount, false)
			reply(player, "+" .. amount .. " Lt")
		end
	elseif command == "/setrebirths" then
		local count = tonumber(args[2])
		if count and count >= 0 then
			data.rebirths = math.floor(count)
			S.DataService:UpdateStats(player)
			S.TycoonService:BuildPlot(player)
			S.RebirthService:ApplyTitle(player)
			reply(player, "rebirths = " .. data.rebirths)
		end
	elseif command == "/event" then
		local which = string.lower(args[2] or "")
		if which == "stop" then
			S.EventService:StopEvent()
			reply(player, "event stopped")
		elseif EVENT_NAMES[which] then
			S.EventService:StopEvent()
			S.EventService:StartEvent(EVENT_NAMES[which], nil, true)
			reply(player, "event " .. EVENT_NAMES[which])
		else
			reply(player, "/event lietus|cepelinas|jonines|laume|ziema|varzybos|mociute|stop")
		end
	elseif command == "/jail" or command == "/unjail" then
		local targets = findTargets(args[2])
		if #targets == 0 or string.lower(args[2] or "") == "all" then
			reply(player, command .. " <vardas>")
			return
		end
		for _, target in ipairs(targets) do
			if command == "/jail" then
				S.JailService:Jail(target)
				reply(player, "jailed: " .. target.Name)
			else
				S.JailService:Release(target)
				reply(player, "released: " .. target.Name)
			end
		end
	elseif command == "/mage" then
		local arg = string.lower(args[2] or "")
		if arg == "stop" then
			S.RadioService:Stop()
			reply(player, "Magė: stop")
		elseif arg == "volume" then
			reply(player, "Magė volume = " .. S.RadioService:SetVolume(args[3]))
		else
			local ok, result = S.RadioService:Play(player, args[2])
			reply(player, ok and ("Magė ♪ " .. result) or "/mage <kodas> | /mage stop | /mage volume 0.5")
		end
	elseif command == "/quiz" then
		if S.QuizService:StartQuiz() then
			reply(player, "quiz started")
		else
			reply(player, "quiz already running")
		end
	elseif command == "/givepass" then
		local name = args[2]
		if name and Monetization.GamePasses[name] then
			S.MonetizationService:GrantPass(player, name)
			reply(player, "pass " .. name)
		else
			reply(player, "/givepass DoubleMoney|FastDroppers|GrannyHelp|VIP|OfflineIncome")
		end
	elseif command == "/product" then
		local name = args[2]
		if name and Monetization.Products[name] then
			S.MonetizationService:GrantProduct(player, name)
		else
			reply(player, "/product SmallBag|BigBag|PotatoRain|Boost3")
		end
	elseif command == "/resetdata" then
		data.money = 0
		data.totalEarned = 0
		data.rebirths = 0
		data.purchases = {}
		data.grannies = {}
		data.globalUpgrades = {}
		data.tutorialDone = false
		data.boostRemaining = 0
		data.radio = { recent = {} }
		player:SetAttribute("CanUseRadio", self:IsAdmin(player))
		data.dailyStreak = 0
		data.lastDaily = 0
		S.DataService:SyncAttributes(player)
		S.TycoonService:BuildPlot(player)
		S.RebirthService:ApplyTitle(player)
		reply(player, "data reset")
	end
end

function AdminService:Init(services)
	S = services
end

function AdminService:Start()
	if RunService:IsStudio() then
		print("[AdminService] Studio admin komandos įjungtos: /givemoney, /addmoney, /setrebirths, /event, /givepass, /product, /resetdata")
	end

	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local folder = Instance.new("Folder")
		folder.Name = "AdminCommands"
		folder.Parent = TextChatService
		for _, name in ipairs({ "givemoney", "takemoney", "addmoney", "setrebirths", "event", "quiz", "mage", "jail", "unjail", "givepass", "product", "resetdata" }) do
			local command = Instance.new("TextChatCommand")
			command.Name = "Admin_" .. name
			command.PrimaryAlias = "/" .. name
			pcall(function()
				command.AutocompleteVisible = false -- kiti žaidėjai komandų pasiūlymų nemato
			end)
			command.Parent = folder
			command.Triggered:Connect(function(source, text)
				local player = Players:GetPlayerByUserId(source.UserId)
				if player then
					self:Run(player, text)
				end
			end)
		end
	else
		local function hook(player)
			player.Chatted:Connect(function(message)
				if string.sub(message, 1, 1) == "/" then
					self:Run(player, message)
				end
			end)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			hook(player)
		end
		Players.PlayerAdded:Connect(hook)
	end
end

return AdminService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">BonusService</string><ProtectedString name="Source"><![CDATA[--[[
	BonusService – nemokami bonusai:
	  - Grupės bonusas (+10 % pajamų, jei žaidėjas Roblox grupėje; GroupId – Config/Monetization)
	  - Kasdienis prizas kas 24 val.: 5 min. pajamų × serijos daugiklis (1–7 d.)
	  - ×3 boost'o laikmatis (mažėja tik žaidžiant, išsaugomas)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Monetization = require(Config:WaitForChild("Monetization"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RateLimit = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("RateLimit"))

local D = Settings.Daily

local BonusService = {}
local S
local inGroup = {}
local limiter = RateLimit.new(Settings.RemoteRateLimit)

function BonusService:IsInGroup(player)
	return inGroup[player] == true
end

function BonusService:ClaimDaily(player)
	local data = S.DataService:Get(player)
	if not data then
		return { Success = false }
	end
	local now = os.time()
	local since = now - data.lastDaily
	if data.lastDaily > 0 and since < D.Cooldown then
		return { Success = false, Wait = D.Cooldown - since }
	end
	if data.lastDaily > 0 and since <= D.StreakResetAfter then
		data.dailyStreak = math.min(data.dailyStreak + 1, #D.StreakMultipliers)
	else
		data.dailyStreak = 1
	end
	data.lastDaily = now
	local multiplier = D.StreakMultipliers[data.dailyStreak]
	local base = math.max(D.MinReward, S.TycoonService:GetIncomePerSecond(player) * D.IncomeSeconds)
	local amount = base * multiplier
	S.DataService:AddMoney(player, amount, true)
	player:SetAttribute("DailyStreak", data.dailyStreak)
	player:SetAttribute("LastDaily", data.lastDaily)
	S.DataService:Notify(player, "DailyGot", nil, nil, { amount = amount }, "success")
	return { Success = true, Amount = amount, Streak = data.dailyStreak }
end

function BonusService:Init(services)
	S = services
end

function BonusService:Start()
	Remotes.ClaimDaily.OnServerInvoke = function(player)
		if not limiter:Check(player) then
			return { Success = false }
		end
		return self:ClaimDaily(player)
	end

	S.DataService:OnPlayerLoaded(function(player, data)
		-- Praleista diena – serija nusinuliuoja (rodoma UI)
		if data.lastDaily > 0 and os.time() - data.lastDaily > D.StreakResetAfter then
			data.dailyStreak = 0
			player:SetAttribute("DailyStreak", 0)
		end
		if Monetization.GroupId ~= 0 then
			local ok, result = pcall(function()
				return player:IsInGroupAsync(Monetization.GroupId)
			end)
			if ok and result then
				inGroup[player] = true
				S.DataService:Notify(player, "GroupBonus", nil, nil, nil, "success")
				S.TycoonService:UpdateIncome(player)
			end
		end
	end)

	-- Boost'o laikmatis
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = S.DataService:Get(player)
				if data and data.boostRemaining > 0 then
					data.boostRemaining = math.max(0, data.boostRemaining - 1)
					player:SetAttribute("BoostRemaining", data.boostRemaining)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.defer(function()
			inGroup[player] = nil
		end)
	end)
end

return BonusService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DataService – žaidėjų duomenų įkėlimas ir išsaugojimas (DataStore).

	- Savas DataStore wrapper'is su UpdateAsync, pakartojimais ir session lock'u
	  (kad tas pats žaidėjas dviejuose serveriuose neperrašytų duomenų).
	- Autosave kas Settings.AutosaveInterval s, išsaugojimas išeinant ir BindToClose.
	- Jei DataStore nepasiekiamas (pvz. nepublikuotas place Studio), žaidimas veikia
	  „offline“ režimu: viskas veikia, tik neišsaugoma (Output lange – įspėjimas).
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Texts = require(Config:WaitForChild("Texts"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))
local Calc = require(Shared:WaitForChild("Calc"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RateLimit = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("RateLimit"))

local DataService = {}
DataService.Profiles = {}         -- [player] = duomenų lentelė
DataService.SessionStart = {}     -- [player] = os.time()

local S
local dataStore = nil
local storeState = "pending"      -- "pending" | "online" | "offline"
local loadedCallbacks = {}
local removingCallbacks = {}
local settingsLimiter = RateLimit.new(Settings.RemoteRateLimit)

----------------------------------------------------------------------
-- Duomenų struktūra (bendro failo 9 skyrius + vėlesnių etapų laukai)
----------------------------------------------------------------------
local function defaultData()
	return {
		version = Settings.DataVersion,
		money = Settings.StartingMoney,
		totalEarned = 0,
		rebirths = 0,
		purchases = {},           -- { ["Cepelinai_3"] = true }
		grannies = {},            -- { Cepelinai = 2 }
		globalUpgrades = {},      -- { DropperSpeed = 1, Flag = true, StorkNest = true, ... }
		dailyStreak = 0,
		lastDaily = 0,
		lastOnline = 0,
		settings = { music = true, sfx = true, beeps = true, lang = "en", langChosen = false },
		tutorialDone = false,
		cosmetics = { skins = {} },
		badges = {},
		receipts = {},            -- { [PurchaseId] = os.time() }
		receiptOrder = {},        -- PurchaseId sąrašas (seniausi pirmi)
		boostRemaining = 0,       -- ×3 boost'o likęs laikas (s)
		weapons = {},             -- { Spoon = true } – nupirkti ginklai (lieka po rebirth)
		radio = { recent = {} },
		jailed = false,           -- /jail bausmė (tęsiasi ir grįžus)  -- radijo „Magė“ neseniai grotos dainos { {id=, name=} }
		stats = { itemsSold = 0, playTime = 0, joins = 0 },
	}
end

-- Užpildo trūkstamus laukus (pvz. senesnis išsaugojimas be naujų laukų)
local function reconcile(target, template)
	for key, value in pairs(template) do
		if target[key] == nil then
			if type(value) == "table" then
				local copy = {}
				for k, v in pairs(value) do
					copy[k] = v
				end
				target[key] = copy
			else
				target[key] = value
			end
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

-- Migracijos: MIGRATIONS[n] paverčia n versijos duomenis n+1 versija
local MIGRATIONS = {
	-- 1 -> 2: konvejeris sujungtas su pirmu bulvių maišu, todėl Cepelinų pirkiniai pernumeruoti
	-- (senas Cepelinai_2 = konvejeris išmetamas, seni 3..10 tampa 2..9)
	[1] = function(data)
		-- Tik senoji schema turėjo Cepelinai_10 (naujoje jų 9)
		if not data.purchases["Cepelinai_10"] then
			return
		end
		local old = data.purchases
		local new = {}
		for id, value in pairs(old) do
			local n = tonumber(string.match(id, "^Cepelinai_(%d+)$"))
			if not n then
				new[id] = value
			elseif n == 1 then
				new[id] = value
			elseif n >= 3 then
				new["Cepelinai_" .. (n - 1)] = value
			end
		end
		data.purchases = new
	end,
}

local function migrate(data)
	data.version = data.version or 1
	while data.version < Settings.DataVersion do
		local step = MIGRATIONS[data.version]
		if not step then
			break
		end
		step(data)
		data.version = data.version + 1
	end
	reconcile(data, defaultData())
	return data
end

local function keyFor(player)
	return "Player_" .. player.UserId
end

local function isLockedByOther(record)
	return record and record.sessionLock
		and record.sessionLock.jobId ~= game.JobId
		and os.time() - (record.sessionLock.time or 0) < Settings.SessionLockStale
end

local function waitForStore()
	while storeState == "pending" do
		task.wait(0.1)
	end
end

----------------------------------------------------------------------
-- Įkėlimas / išsaugojimas
----------------------------------------------------------------------
local function loadData(player)
	waitForStore()
	if storeState ~= "online" then
		return defaultData()
	end
	local key = keyFor(player)
	for attempt = 1, Settings.LoadRetries do
		local result = nil
		local isLastAttempt = attempt == Settings.LoadRetries
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				-- Kitas serveris dar laiko užraktą: laukiam (paskutinį kartą – perimam)
				if isLockedByOther(old) and not isLastAttempt then
					return nil
				end
				local data = old or defaultData()
				data.sessionLock = { jobId = game.JobId, time = os.time() }
				result = data
				return data
			end)
		end)
		if ok and result then
			return result
		end
		if not ok then
			warn("[DataService] Įkėlimo klaida (" .. attempt .. "): " .. tostring(err))
		end
		task.wait(Settings.RetryDelay * attempt)
	end
	return nil
end

function DataService:Save(player, release)
	local data = self.Profiles[player]
	if not data then
		return false
	end
	data.lastOnline = os.time()
	if storeState ~= "online" then
		return true -- offline režimas: nėra kur saugoti
	end
	local key = keyFor(player)
	for attempt = 1, Settings.SaveRetries do
		local blocked = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(old)
				if isLockedByOther(old) then
					blocked = true
					return nil
				end
				if release then
					data.sessionLock = nil
				else
					data.sessionLock = { jobId = game.JobId, time = os.time() }
				end
				return data
			end)
		end)
		if ok and not blocked then
			return true
		end
		if blocked then
			warn("[DataService] " .. player.Name .. " duomenis užrakino kitas serveris – neišsaugota.")
			return false
		end
		warn("[DataService] Išsaugojimo klaida (" .. attempt .. "): " .. tostring(err))
		task.wait(Settings.RetryDelay)
	end
	return false
end

function DataService:IsOnline()
	return storeState == "online"
end

----------------------------------------------------------------------
-- Prieiga kitiems servisams
----------------------------------------------------------------------
function DataService:Get(player)
	return self.Profiles[player]
end

function DataService:OnPlayerLoaded(callback)
	table.insert(loadedCallbacks, callback)
	for player, data in pairs(self.Profiles) do
		task.spawn(callback, player, data)
	end
end

function DataService:OnPlayerRemoving(callback)
	table.insert(removingCallbacks, callback)
end

function DataService:GetLang(player)
	local data = self.Profiles[player]
	return (data and data.settings.lang) or "en"
end

function DataService:Text(player, key, args)
	return Texts.Get(self:GetLang(player), key, args)
end

-- Pranešimas žaidėjui (klientas išverčia pagal raktą)
-- args – paprasti tekstai; keys – reikšmės, kurios pačios yra teksto raktai; nums – skaičiai
function DataService:Notify(player, key, args, keys, nums, kind)
	Remotes.Notify:FireClient(player, key, args or {}, keys or {}, nums or {}, kind or "info")
end

function DataService:UpdateStats(player)
	local data = self.Profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Money", data.money)
	player:SetAttribute("TotalEarned", data.totalEarned)
	player:SetAttribute("Rebirths", data.rebirths)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Litai.Value = NumberFormat.Format(data.money)
		leaderstats.Rebirth.Value = data.rebirths
		leaderstats.Titulas.Value = Texts.Get(data.settings.lang, Calc.GetTitleKey(data.rebirths))
	end
end

-- Prideda litų. earned = true – skaičiuojama į totalEarned (pardavimai, prizai)
function DataService:AddMoney(player, amount, earned)
	local data = self.Profiles[player]
	if not data or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false
	end
	data.money = data.money + amount
	if earned then
		data.totalEarned = data.totalEarned + amount
	end
	player:SetAttribute("Money", data.money)
	player:SetAttribute("TotalEarned", data.totalEarned)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Litai.Value = NumberFormat.Format(data.money)
	end
	return true
end

function DataService:SpendMoney(player, amount)
	local data = self.Profiles[player]
	if not data or type(amount) ~= "number" or amount < 0 then
		return false
	end
	if data.money < amount then
		return false
	end
	data.money = data.money - amount
	self:UpdateStats(player)
	return true
end

function DataService:SyncAttributes(player)
	local data = self.Profiles[player]
	if not data then
		return
	end
	player:SetAttribute("Lang", data.settings.lang)
	player:SetAttribute("Music", data.settings.music)
	player:SetAttribute("Sfx", data.settings.sfx)
	player:SetAttribute("Beeps", data.settings.beeps ~= false)
	player:SetAttribute("TutorialDone", data.tutorialDone)
	player:SetAttribute("DailyStreak", data.dailyStreak)
	player:SetAttribute("LastDaily", data.lastDaily)
	player:SetAttribute("BoostRemaining", data.boostRemaining)
	self:UpdateStats(player)
end

----------------------------------------------------------------------
-- Žaidėjai
----------------------------------------------------------------------
local function createLeaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local litai = Instance.new("StringValue")
	litai.Name = "Litai"
	litai.Parent = folder
	local rebirth = Instance.new("IntValue")
	rebirth.Name = "Rebirth"
	rebirth.Parent = folder
	local title = Instance.new("StringValue")
	title.Name = "Titulas"
	title.Parent = folder
	folder.Parent = player
end

function DataService:_onPlayerAdded(player)
	local data = loadData(player)
	if not data then
		player:Kick("Nepavyko įkelti duomenų. Prisijunk iš naujo. / Could not load your data, please rejoin.")
		return
	end
	migrate(data)

	if not player.Parent then
		-- Žaidėjas išėjo, kol krovėsi duomenys – atlaisvinam užraktą
		self.Profiles[player] = data
		self:Save(player, true)
		self.Profiles[player] = nil
		return
	end

	-- Pradinė kalba pagal LocalizationService (lietuvių -> LT, kitaip EN)
	if not data.settings.langChosen then
		local locale = string.lower(player.LocaleId or "")
		if string.sub(locale, 1, 2) == "lt" then
			data.settings.lang = "lt"
		else
			data.settings.lang = "en"
		end
	end
	data.stats.joins = data.stats.joins + 1

	self.Profiles[player] = data
	self.SessionStart[player] = os.time()
	createLeaderstats(player)
	self:SyncAttributes(player)
	player:SetAttribute("DataLoaded", true)

	for _, callback in ipairs(loadedCallbacks) do
		task.spawn(callback, player, data)
	end
end

function DataService:_onPlayerRemoving(player)
	local data = self.Profiles[player]
	if not data then
		return
	end
	for _, callback in ipairs(removingCallbacks) do
		local ok, err = pcall(callback, player, data)
		if not ok then
			warn("[DataService] OnPlayerRemoving klaida: " .. tostring(err))
		end
	end
	local started = self.SessionStart[player]
	if started then
		data.stats.playTime = data.stats.playTime + (os.time() - started)
		self.SessionStart[player] = nil
	end
	self:Save(player, true)
	self.Profiles[player] = nil
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function DataService:Init(services)
	S = services
end

function DataService:Start()
	-- Patikrinam, ar DataStore pasiekiamas
	task.spawn(function()
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore(Settings.DataStoreName)
		end)
		if ok and store then
			local pingOk, err = pcall(function()
				return store:GetAsync("__ping")
			end)
			if pingOk then
				dataStore = store
				storeState = "online"
				return
			end
			warn("[DataService] DataStore nepasiekiamas – progresas NEBUS išsaugotas. "
				.. "Publikuok place ir įjunk Game Settings → Security → Enable Studio Access to API Services. ("
				.. tostring(err) .. ")")
		else
			warn("[DataService] DataStore nepasiekiamas: " .. tostring(store))
		end
		storeState = "offline"
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(Settings.AutosaveInterval)
			for player in pairs(self.Profiles) do
				task.spawn(function()
					self:Save(player, false)
				end)
			end
		end
	end)

	-- Serverio išjungimas: išsaugom visus
	game:BindToClose(function()
		if RunService:IsStudio() and storeState ~= "online" then
			return
		end
		local pending = 0
		for player in pairs(self.Profiles) do
			pending = pending + 1
			task.spawn(function()
				self:Save(player, true)
				pending = pending - 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)

	-- Nustatymų keitimas iš kliento (muzika, garsai, kalba)
	Remotes.ChangeSetting.OnServerEvent:Connect(function(player, key, value)
		if not settingsLimiter:Check(player) then
			return
		end
		local data = self.Profiles[player]
		if not data then
			return
		end
		if (key == "music" or key == "sfx" or key == "beeps") and type(value) == "boolean" then
			data.settings[key] = value
		elseif key == "lang" and (value == "en" or value == "lt") then
			data.settings.lang = value
			data.settings.langChosen = true
		elseif key == "systemLocale" and type(value) == "string" then
			-- Įrenginio (Windows / telefono) kalba: jei lietuviška ir žaidėjas pats kalbos dar nesirinko – LT
			if not data.settings.langChosen and string.sub(string.lower(value), 1, 2) == "lt" then
				data.settings.lang = "lt"
			else
				return
			end
		else
			return
		end
		self:SyncAttributes(player)
	end)

	-- Tutorial baigtas
	Remotes.TutorialDone.OnServerEvent:Connect(function(player)
		if not settingsLimiter:Check(player) then
			return
		end
		local data = self.Profiles[player]
		if data and not data.tutorialDone then
			data.tutorialDone = true
			player:SetAttribute("TutorialDone", true)
		end
	end)
end

-- Kviečiama iš Main, kai visi servisai paleisti
function DataService:BeginPlayers()
	Players.PlayerAdded:Connect(function(player)
		self:_onPlayerAdded(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_onPlayerRemoving(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			self:_onPlayerAdded(player)
		end)
	end
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--[[
	EventService – serverio eventai (vienu metu daugiausia vienas):
	  PotatoRain   – dropper'iai meta dvigubai dažniau, kliente krenta dekoratyvios bulvės
	  BigCepelinas – lobby nusileidžia milžiniškas cepelinas; pirmas paspaudęs gauna 300 s pajamų, kiti – 30 s
	  Jonines      – ×2 pinigai, vakarinis dangus, laužai, paparčio žiedas (pagal Lietuvos laiką)
	  Fairy        – Laumės dovana: laumė pasirodo miške, pirmas radęs gauna atsitiktinį norą
	  Winter       – Žiemos pūga: lėtesni konvejeriai, ×3 pinigai, Kūčiukų dovana turguje
	  Contest      – Močiučių varžybos: kas per 3 min. parduos daugiausiai
	  SkyGranny    – Dangaus močiutė: milžiniška močiutė toli danguje kočėlu kviečia auksinius cepelinus
	Dabartinis eventas matomas ReplicatedStorage atributuose CurrentEvent / EventEndsAt,
	laumės norų „buff'ai“ – BuffId / BuffEndsAt.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local Scenery = require(Lib:WaitForChild("Scenery"))
local GrannyModels = require(Lib:WaitForChild("GrannyModels"))

local E = Settings.Events
local V = Vector3.new
local C = Color3.fromRGB
local CF = CFrame.new

local EventService = {}
local S
local current = nil              -- { Id, EndsAt, Manual, Objects, ... }
local nextAt = {}                -- [eventId] = os.clock() laikas, kada kitas atsitiktinis
local buff = nil                 -- { Id, EndsAt, Money, Drop } – laumės noras
local pendingRain = 0
local eventToken = 0
local RANDOM_EVENTS = { "PotatoRain", "BigCepelinas", "Fairy", "Winter", "Contest", "SkyGranny" }            -- nupirkti Bulvių lietūs, laukiantys eilėje
local savedLighting = nil
local random = Random.new()

----------------------------------------------------------------------
-- Lietuvos laikas (UTC+2, vasarą UTC+3: nuo paskutinio kovo sekmadienio iki paskutinio spalio sekmadienio 01:00 UTC)
----------------------------------------------------------------------
local function weekday(timestamp)
	-- 0 = sekmadienis (1970-01-01 buvo ketvirtadienis)
	return (math.floor(timestamp / 86400) + 4) % 7
end

local function lastSunday(year, month)
	local day31 = DateTime.fromUniversalTime(year, month, 31, 1, 0, 0).UnixTimestamp
	return day31 - weekday(day31) * 86400
end

function EventService:GetLithuanianTime(now)
	now = now or os.time()
	local year = DateTime.fromUnixTimestamp(now):ToUniversalTime().Year
	local dst = now >= lastSunday(year, 3) and now < lastSunday(year, 10)
	local offset = (dst and 3 or 2) * 3600
	local localTs = now + offset
	local t = DateTime.fromUnixTimestamp(localTs):ToUniversalTime()
	return { Year = t.Year, Month = t.Month, Day = t.Day, Hour = t.Hour, Minute = t.Minute, Second = t.Second, Weekday = weekday(localTs) }
end

-- Diena (LT laiku), kurią Joninės jau įvyko – kad sustabdytos neprasidėtų iš naujo
local joninesDoneDay = nil

local function markJoninesDone(self)
	local lt = self:GetLithuanianTime()
	joninesDoneDay = string.format("%d-%d-%d", lt.Year, lt.Month, lt.Day)
end

-- Ar dabar Joninių laikas? Grąžina likusias sekundes arba nil
function EventService:GetJoninesRemaining()
	local lt = self:GetLithuanianTime()
	local isDay = false
	for _, d in ipairs(E.Jonines.Days) do
		if lt.Month == d.Month and lt.Day == d.Day then
			isDay = true
		end
	end
	if E.Jonines.Weekends and (lt.Weekday == 0 or lt.Weekday == 6) then
		isDay = true
	end
	if not isDay then
		return nil
	end
	-- Šiandien jau buvo (arba admin sustabdė) – antrą kartą nebepaleidžiam
	if joninesDoneDay == string.format("%d-%d-%d", lt.Year, lt.Month, lt.Day) then
		return nil
	end
	local secondsSinceStart = (lt.Hour - E.Jonines.StartHourLT) * 3600 + lt.Minute * 60 + lt.Second
	if secondsSinceStart >= 0 and secondsSinceStart < E.Jonines.Duration then
		return E.Jonines.Duration - secondsSinceStart
	end
	return nil
end

----------------------------------------------------------------------
-- Daugikliai (naudoja Calc per TycoonService:GetContext)
----------------------------------------------------------------------
local function buffActive()
	return buff and workspace:GetServerTimeNow() < buff.EndsAt
end

function EventService:GetDropMultiplier()
	local m = 1
	if current and current.Id == "PotatoRain" then
		m = E.PotatoRain.DropSpeedMultiplier
	end
	if buffActive() then
		m = m * (buff.Drop or 1)
	end
	return m
end

function EventService:GetMoneyMultiplier()
	local m = 1
	if current and current.Id == "Jonines" then
		m = E.Jonines.MoneyMultiplier
	elseif current and current.Id == "Winter" then
		m = E.Winter.MoneyMultiplier
	end
	if buffActive() then
		m = m * (buff.Money or 1)
	end
	return m
end

local function refreshIncome()
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService:Get(player) then
			S.TycoonService:UpdateIncome(player)
		end
	end
end

function EventService:SetBuff(id, duration, money, drop)
	buff = { Id = id, EndsAt = workspace:GetServerTimeNow() + duration, Money = money, Drop = drop }
	ReplicatedStorage:SetAttribute("BuffId", id)
	ReplicatedStorage:SetAttribute("BuffEndsAt", buff.EndsAt)
	refreshIncome()
end

function EventService:GetCurrent()
	return current and current.Id or nil
end

----------------------------------------------------------------------
-- Eventų pradžia / pabaiga
----------------------------------------------------------------------
local function setReplicated(id, endsAt)
	ReplicatedStorage:SetAttribute("CurrentEvent", id or "")
	ReplicatedStorage:SetAttribute("EventEndsAt", endsAt or 0)
end

local function isDecember()
	return EventService:GetLithuanianTime().Month == 12
end

local function scheduleNext(id)
	local cfg = E[id]
	if not cfg or not cfg.MinGap then
		return
	end
	local minGap, maxGap = cfg.MinGap, cfg.MaxGap
	if id == "Winter" and isDecember() then
		minGap, maxGap = cfg.DecemberMinGap, cfg.DecemberMaxGap
	end
	nextAt[id] = os.clock() + random:NextNumber(minGap, maxGap)
end

local function tweenLighting(target)
	if not savedLighting then
		savedLighting = {
			ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient, FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd,
		}
	end
	TweenService:Create(Lighting, TweenInfo.new(4), {
		ClockTime = target.ClockTime, Brightness = target.Brightness, Ambient = target.Ambient,
		OutdoorAmbient = target.OutdoorAmbient, FogColor = target.FogColor, FogEnd = target.FogEnd,
	}):Play()
end

local function startJoninesVisuals(objects)
	savedLighting = {
		ClockTime = Lighting.ClockTime, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient, FogColor = Lighting.FogColor, FogEnd = Lighting.FogEnd,
	}
	local target = E.Jonines.Lighting
	TweenService:Create(Lighting, TweenInfo.new(4), {
		ClockTime = target.ClockTime, Brightness = target.Brightness, Ambient = target.Ambient,
		OutdoorAmbient = target.OutdoorAmbient, FogColor = target.FogColor, FogEnd = target.FogEnd,
	}):Play()
	local folder = Build.Folder("JoninesDecor", workspace)
	table.insert(objects, folder)
	for _, position in ipairs(S.MapBuilder.Anchors.Bonfires or {}) do
		for i = 0, 5 do
			local angle = i * 60
			Build.Part({ Name = "Log", Parent = folder, Size = V(0.6, 0.6, 4), CFrame = CF(position + V(0, 0.4, 0)) * CFrame.Angles(0, math.rad(angle), math.rad(25)), Color = C(90, 60, 35), Material = Enum.Material.Wood })
		end
		local core = Build.Part({ Name = "Bonfire", Parent = folder, Size = V(1, 1, 1), CFrame = CF(position + V(0, 1.2, 0)), Transparency = 1, CanCollide = false })
		local fire = Instance.new("Fire")
		fire.Size = 8
		fire.Heat = 12
		fire.Parent = core
		local light = Instance.new("PointLight")
		light.Color = C(255, 150, 60)
		light.Range = 30
		light.Brightness = 3
		light.Parent = core
	end
	local fern = S.MapBuilder.Anchors.FernSpot
	if fern then
		for i = 0, 4 do
			local angle = math.rad(i * 72)
			Build.Part({ Name = "FernLeaf", Parent = folder, Size = V(0.3, 0.2, 3), CFrame = CF(fern + V(math.cos(angle) * 1.4, 0.6, math.sin(angle) * 1.4)) * CFrame.Angles(0, -angle + math.rad(90), math.rad(15)), Color = C(50, 140, 50), Material = Enum.Material.Grass })
		end
		local flower = Build.Part({ Name = "FernFlower", Parent = folder, Shape = Enum.PartType.Ball, Size = V(1.2, 1.2, 1.2), CFrame = CF(fern + V(0, 2, 0)), Color = C(255, 120, 230), Material = Enum.Material.Neon, CanCollide = false })
		local glow = Instance.new("PointLight")
		glow.Color = C(255, 140, 230)
		glow.Range = 16
		glow.Brightness = 3
		glow.Parent = flower
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = C(255, 180, 240)
		sparkles.Parent = flower
	end
end

local function stopJoninesVisuals()
	if savedLighting then
		TweenService:Create(Lighting, TweenInfo.new(4), savedLighting):Play()
		savedLighting = nil
	end
end

function EventService:GrantIncome(player, seconds, minimum)
	local amount = math.max(minimum or 0, S.TycoonService:GetIncomePerSecond(player) * seconds)
	S.DataService:AddMoney(player, amount, true)
	return amount
end

local function spawnBigCepelinas(objects)
	local spot = S.MapBuilder.Anchors.BigCepelinasSpot or V(0, 1, 24)
	local cfg = E.BigCepelinas
	local body = Build.Part({ Name = "BigCepelinas", Parent = workspace, Size = V(16, 9, 9), CFrame = CF(spot + V(0, cfg.DropHeight, 0)), Color = C(225, 220, 205), Material = Enum.Material.SmoothPlastic, CanCollide = true })
	Build.Mesh(body, Enum.MeshType.Sphere)
	table.insert(objects, body)
	local cream = Build.Part({ Name = "SourCream", Parent = body, Size = V(6, 1.5, 5), CFrame = body.CFrame * CF(0, 4.3, 0), Color = C(250, 250, 245), Material = Enum.Material.SmoothPlastic, Anchored = false, CanCollide = false, Massless = true })
	Build.Mesh(cream, Enum.MeshType.Sphere)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = cream
	weld.Parent = cream
	for i = 1, 6 do
		local crackling = Build.Part({ Name = "Crackling", Parent = body, Size = V(0.8, 0.5, 0.8), CFrame = body.CFrame * CF(-2.5 + i * 0.8, 5, (i % 2) - 0.5), Color = C(160, 100, 50), Material = Enum.Material.Sand, Anchored = false, CanCollide = false, Massless = true })
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = crackling
		w.Parent = crackling
	end
	Build.Billboard(body, { Name = "Name", TextKey = "BigCepelinasName", Size = UDim2.fromScale(14, 2.5), Offset = V(0, 9, 0), MaxDistance = 400, AlwaysOnTop = true, Color = C(255, 230, 140) })
	TweenService:Create(body, TweenInfo.new(cfg.FallTime, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { CFrame = CF(spot + V(0, 4.5, 0)) }):Play()

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Grab / Pagauti"
	prompt.ObjectText = "Big Cepelinas"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = body

	local claimed = false
	prompt.Triggered:Connect(function(winner)
		if claimed or not S.DataService:Get(winner) then
			return
		end
		claimed = true
		local won = EventService:GrantIncome(winner, cfg.WinnerSeconds, cfg.MinReward)
		S.DataService:Notify(winner, "BigCepelinasWin", nil, nil, { amount = won }, "success")
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= winner and S.DataService:Get(other) then
				local amount = EventService:GrantIncome(other, cfg.OthersSeconds, cfg.MinReward * cfg.OthersSeconds / cfg.WinnerSeconds)
				S.DataService:Notify(other, "BigCepelinasOther", { name = winner.DisplayName }, nil, { amount = amount }, "info")
			end
		end
		Remotes.BigCepelinasBurst:FireAllClients(body.Position)
		EventService:StopEvent()
	end)
end

----------------------------------------------------------------------
-- Laumės dovana
----------------------------------------------------------------------
local WISHES = { { "Money2x", 3 }, { "Gold", 3 }, { "Speed2x", 3 }, { "BigHeads", 1 } }

local function pickWish()
	local total = 0
	for _, w in ipairs(WISHES) do
		total = total + w[2]
	end
	local roll = random:NextNumber(0, total)
	for _, w in ipairs(WISHES) do
		roll = roll - w[2]
		if roll <= 0 then
			return w[1]
		end
	end
	return WISHES[1][1]
end

local function bigHeads()
	local cfg = E.Fairy
	local changed = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local scale = humanoid and humanoid:FindFirstChild("HeadScale")
		if scale and scale:IsA("NumberValue") then
			table.insert(changed, { scale, scale.Value })
			scale.Value = cfg.BigHeadsScale
		end
	end
	task.delay(cfg.BigHeadsDuration, function()
		for _, entry in ipairs(changed) do
			if entry[1].Parent then
				entry[1].Value = entry[2]
			end
		end
	end)
end

local function spawnFairy(objects)
	local cfg = E.Fairy
	local spot = S.MapBuilder:RandomFreeSpot(random) or V(random:NextNumber(-200, 200), 0, random:NextNumber(-200, 200))
	local folder = Build.Folder("Fairy", workspace)
	table.insert(objects, folder)
	local base = CF(spot + V(0, 3.5, 0))
	local body = Build.Part({ Name = "FairyBody", Parent = folder, Size = V(1, 1.6, 1), CFrame = base, Color = C(220, 255, 230), Material = Enum.Material.Neon })
	Build.Mesh(body, Enum.MeshType.Sphere)
	local head = Build.Part({ Name = "FairyHead", Parent = folder, Shape = Enum.PartType.Ball, Size = V(0.8, 0.8, 0.8), CFrame = base * CF(0, 1.15, 0), Color = C(255, 225, 200), Material = Enum.Material.SmoothPlastic, Anchored = false, CanCollide = false, Massless = true })
	local crown = Build.Part({ Name = "FlowerCrown", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.9, 0.9), CFrame = base * CF(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 150, 210), Material = Enum.Material.Neon, Anchored = false, CanCollide = false, Massless = true })
	local attached = { head, crown }
	for _, side in ipairs({ -1, 1 }) do
		local wing = Build.Part({ Name = "Wing", Parent = folder, Size = V(1.6, 1.4, 0.05), CFrame = base * CF(side * 0.8, 0.5, 0.45) * CFrame.Angles(0, side * math.rad(25), side * math.rad(20)), Color = C(170, 240, 255), Material = Enum.Material.Neon, Transparency = 0.45, Anchored = false, CanCollide = false, Massless = true })
		Build.Mesh(wing, Enum.MeshType.Sphere)
		table.insert(attached, wing)
	end
	for _, p in ipairs(attached) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
	end
	local light = Instance.new("PointLight")
	light.Color = C(190, 255, 220)
	light.Range = 22
	light.Brightness = 3
	light.Parent = body
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = C(200, 255, 230)
	sparkles.Parent = body
	-- Aukštas šviesos stulpas, kad laumę būtų galima rasti iš toli
	Build.Part({ Name = "FairyBeam", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(160, 2.5, 2.5), CFrame = CF(spot + V(0, 80, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(180, 255, 220), Material = Enum.Material.Neon, Transparency = 0.7, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	TweenService:Create(body, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = base * CF(0, 1.2, 0) }):Play()

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Wish / Norėti"
	prompt.ObjectText = "🧚 Laumė"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	local used = false
	prompt.Triggered:Connect(function(winner)
		if used or not S.DataService:Get(winner) then
			return
		end
		used = true
		local wish = pickWish()
		if wish == "Money2x" then
			EventService:SetBuff("Money2x", cfg.WishMoney.Duration, cfg.WishMoney.Multiplier, 1)
		elseif wish == "Speed2x" then
			EventService:SetBuff("Speed2x", cfg.WishSpeed.Duration, 1, cfg.WishSpeed.Multiplier)
		elseif wish == "Gold" then
			local amount = EventService:GrantIncome(winner, cfg.WishGoldSeconds, cfg.MinReward)
			S.DataService:Notify(winner, "BigCepelinasWin", nil, nil, { amount = amount }, "success")
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= winner and S.DataService:Get(other) then
					EventService:GrantIncome(other, cfg.OthersSeconds, cfg.MinReward / 4)
				end
			end
		elseif wish == "BigHeads" then
			bigHeads()
		end
		for _, player in ipairs(Players:GetPlayers()) do
			S.DataService:Notify(player, "FairyWish_" .. wish, { name = winner.DisplayName }, nil, nil, "success")
		end
		Remotes.MachineBuilt:FireAllClients(body.Position)
		EventService:StopEvent()
	end)
end

----------------------------------------------------------------------
-- Žiemos pūga / Kūčios
----------------------------------------------------------------------
local savedTerrainColors = nil

local function startWinter(objects)
	local cfg = E.Winter
	tweenLighting(cfg.Lighting)
	pcall(function()
		local terrain = workspace.Terrain
		savedTerrainColors = {
			Grass = terrain:GetMaterialColor(Enum.Material.Grass),
			LeafyGrass = terrain:GetMaterialColor(Enum.Material.LeafyGrass),
		}
		terrain:SetMaterialColor(Enum.Material.Grass, cfg.SnowColor)
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, cfg.SnowColor)
	end)
	S.TycoonService:SetConveyorFactor(cfg.ConveyorFactor)
	-- Kūčiukų stalas turguje
	local spot = S.MapBuilder.Anchors.FernSpot or V(-12, 1, 21)
	local folder = Build.Folder("KuciukaiStand", workspace)
	table.insert(objects, folder)
	local top = Build.Part({ Name = "Table", Parent = folder, Size = V(4, 0.4, 2.6), CFrame = CF(spot + V(0, 2.6, 0)), Color = C(140, 95, 55), Material = Enum.Material.WoodPlanks })
	Build.Part({ Name = "Cloth", Parent = folder, Size = V(4.1, 0.08, 2.7), CFrame = CF(spot + V(0, 2.84, 0)), Color = C(245, 245, 240), Material = Enum.Material.Fabric })
	for _, x in ipairs({ -1.7, 1.7 }) do
		Build.Part({ Name = "Leg", Parent = folder, Size = V(0.3, 2.4, 2.2), CFrame = CF(spot + V(x, 1.2, 0)), Color = C(100, 65, 35), Material = Enum.Material.Wood })
	end
	local bowl = Build.Part({ Name = "Bowl", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(0.6, 2, 2), CFrame = CF(spot + V(-0.6, 3.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(190, 60, 50), Material = Enum.Material.SmoothPlastic })
	for i = 1, 8 do
		local a = i * math.pi / 4
		Build.Part({ Name = "Kuciukas", Parent = folder, Shape = Enum.PartType.Ball, Size = V(0.35, 0.35, 0.35), CFrame = CF(spot + V(-0.6 + math.cos(a) * 0.55, 3.55, math.sin(a) * 0.55)), Color = C(220, 180, 120), Material = Enum.Material.Sand })
	end
	Scenery.ChristmasTree(folder, spot + V(1.3, 2.88, 0), 0.35)
	Build.Sign(top, { Name = "Sign", Text = "🎄 Kūčiukai", Size = UDim2.fromScale(6, 1.6), Offset = V(0, 3.4, 0), MaxDistance = 120 })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Gift / Dovana"
	prompt.ObjectText = "Kūčiukai"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = bowl
	local taken = {}
	prompt.Triggered:Connect(function(player)
		if not S.DataService:Get(player) then
			return
		end
		if taken[player.UserId] then
			S.DataService:Notify(player, "KuciukaiTaken", nil, nil, nil, "info")
			return
		end
		taken[player.UserId] = true
		local amount = EventService:GrantIncome(player, cfg.GiftSeconds, cfg.GiftMin)
		S.DataService:Notify(player, "KuciukaiGift", nil, nil, { amount = amount }, "success")
	end)
end

local function stopWinter()
	stopJoninesVisuals()
	pcall(function()
		if savedTerrainColors then
			workspace.Terrain:SetMaterialColor(Enum.Material.Grass, savedTerrainColors.Grass)
			workspace.Terrain:SetMaterialColor(Enum.Material.LeafyGrass, savedTerrainColors.LeafyGrass)
			savedTerrainColors = nil
		end
	end)
	S.TycoonService:SetConveyorFactor(1)
end

----------------------------------------------------------------------
-- Dangaus močiutė: milžiniška močiutė toli danguje kočėlu kviečia auksinius cepelinus
----------------------------------------------------------------------
local savedAtmosphere = nil

local function groundY(x, z)
	local y = 1
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local exclude = {}
		local map = workspace:FindFirstChild("Map")
		local nature = map and map:FindFirstChild("Nature")
		if nature then
			table.insert(exclude, nature)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				table.insert(exclude, player.Character)
			end
		end
		params.FilterDescendantsInstances = exclude
		local hit = workspace:Raycast(V(x, 300, z), V(0, -400, 0), params)
		if hit then
			y = hit.Position.Y
		end
	end)
	return y
end

-- Kur nukris auksinis cepelinas: dažniau šalia žaidėjų, kitaip – bet kur žaidimo zonoje
local function pickDropSpot(cfg)
	local players = Players:GetPlayers()
	if #players > 0 and random:NextNumber() < cfg.NearPlayerChance then
		local player = players[random:NextInteger(1, #players)]
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local a = random:NextNumber() * math.pi * 2
			local r = random:NextNumber(cfg.NearMin, cfg.NearMax)
			local x, z = root.Position.X + math.cos(a) * r, root.Position.Z + math.sin(a) * r
			return V(x, groundY(x, z), z)
		end
	end
	local a = random:NextNumber() * math.pi * 2
	local r = random:NextNumber(20, cfg.MaxRadius)
	local x, z = math.cos(a) * r, math.sin(a) * r
	return V(x, groundY(x, z), z)
end

local function dropGoldenCepelinas(cfg, token)
	local spot = pickDropSpot(cfg)
	local folder = Build.Folder("GoldenCepelinas", workspace)
	folder:SetAttribute("SkyGrannyToken", token)
	local body = Build.Part({ Name = "GoldenCepelinas", Parent = folder, Size = V(3.4, 1.8, 2), CFrame = CF(spot + V(0, cfg.DropHeight, 0)) * CFrame.Angles(0, random:NextNumber() * 6.28, 0), Color = C(255, 205, 50), Material = Enum.Material.Metal, CanCollide = false })
	Build.Mesh(body, Enum.MeshType.Sphere)
	local glow = Instance.new("PointLight")
	glow.Color = C(255, 210, 90)
	glow.Range = 14
	glow.Brightness = 2
	glow.Parent = body
	local trail = Instance.new("Sparkles")
	trail.SparkleColor = C(255, 230, 120)
	trail.Parent = body
	local landCF = CF(spot + V(0, 1.1, 0)) * CFrame.Angles(0, random:NextNumber() * 6.28, 0)
	local tween = TweenService:Create(body, TweenInfo.new(cfg.FallTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = landCF })
	tween:Play()
	tween.Completed:Connect(function()
		if not folder.Parent then
			return
		end
		-- Šviečianti auksinė vieta, kur nukrito
		local disk = Build.Part({ Name = "GoldenGlow", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(0.2, 7, 7), CFrame = CF(spot + V(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 200, 60), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, CanQuery = false, CanTouch = false })
		local beam = Build.Part({ Name = "GoldenBeam", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(40, 1.6, 1.6), CFrame = CF(spot + V(0, 20, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 220, 110), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
		local light = Instance.new("PointLight")
		light.Color = C(255, 200, 80)
		light.Range = 20
		light.Brightness = 3
		light.Parent = disk
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Pick up / Paimti"
		prompt.ObjectText = "Golden Cepelinas"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = body
		local taken = false
		prompt.Triggered:Connect(function(player)
			if taken or not S.DataService:Get(player) then
				return
			end
			taken = true
			local amount = EventService:GrantIncome(player, cfg.RewardSeconds, cfg.MinReward)
			S.DataService:Notify(player, "GoldenCepelinasFound", nil, nil, { amount = amount }, "success")
			Remotes.BigCepelinasBurst:FireAllClients(body.Position)
			folder:Destroy()
		end)
		beam.Name = "GoldenBeam"
		disk.Name = "GoldenGlow"
	end)
end

local function startSkyGranny(objects, state)
	local cfg = E.SkyGranny
	tweenLighting(cfg.Lighting)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		savedAtmosphere = { Density = atmosphere.Density, Color = atmosphere.Color, Decay = atmosphere.Decay }
		TweenService:Create(atmosphere, TweenInfo.new(4), cfg.Atmosphere):Play()
	end
	-- Milžiniška pirmo lygio močiutė toli už žemėlapio krašto, stovi ant debesų
	local model = GrannyModels.Build(1)
	model.Name = "SkyGranny"
	local rightArm = model:FindFirstChild("RightArm")
	if rightArm then
		-- Kočėlas dešinėje rankoje – laikomas kaip lazda
		local pinCF = rightArm.CFrame * CF(0, -1.7, 0) * CFrame.Angles(0, 0, math.rad(90))
		local pin = Build.Part({ Name = "RollingPin", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(3.2, 0.42, 0.42), CFrame = pinCF, Color = C(215, 175, 115), Material = Enum.Material.Wood, Anchored = false })
		for _, side in ipairs({ -1, 1 }) do
			local handle = Build.Part({ Name = "PinHandle", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.7, 0.22, 0.22), CFrame = pinCF * CF(side * 1.95, 0, 0), Color = C(150, 105, 60), Material = Enum.Material.Wood, Anchored = false })
			local w = Instance.new("WeldConstraint")
			w.Part0 = pin
			w.Part1 = handle
			w.Parent = handle
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = rightArm
		weld.Part1 = pin
		weld.Parent = pin
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
	pcall(function()
		model:ScaleTo(cfg.Scale)
	end)
	local angle = math.rad(cfg.Angle)
	local position = V(math.cos(angle) * cfg.Distance, cfg.BaseY, math.sin(angle) * cfg.Distance)
	-- Kojos ant debesų (BaseY aukštyje), ne liemuo
	Build.PlaceOnFloor(model, CFrame.lookAt(position, V(0, cfg.BaseY, 0)))
	model.Parent = workspace
	table.insert(objects, model)
	-- Debesys po kojomis
	local clouds = Build.Folder("SkyGrannyClouds", workspace)
	table.insert(objects, clouds)
	for i = 1, 9 do
		local a = i * 0.7
		local size = random:NextNumber(40, 70)
		local cloud = Build.Part({ Name = "Cloud", Parent = clouds, Size = V(size * 1.6, size * 0.55, size), CFrame = CF(position + V(math.cos(a) * 45, random:NextNumber(-8, 6), math.sin(a) * 45)), Color = C(255, 245, 250), Material = Enum.Material.SmoothPlastic, Transparency = 0.15, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
		Build.Mesh(cloud, Enum.MeshType.Sphere)
	end
	-- Kočėlo smūgiai į dangų ir auksinių cepelinų lietus
	local token = (state.Token or 0)
	task.spawn(function()
		task.wait(cfg.FirstStrike)
		while current == state do
			model:SetAttribute("StrikeAt", workspace:GetServerTimeNow())
			task.wait(1.1)
			if current ~= state then
				break
			end
			for _ = 1, random:NextInteger(cfg.PerStrike[1], cfg.PerStrike[2]) do
				dropGoldenCepelinas(cfg, token)
				task.wait(0.35)
			end
			task.wait(random:NextNumber(cfg.StrikeEvery[1], cfg.StrikeEvery[2]))
		end
	end)
end

local function stopSkyGranny(state)
	stopJoninesVisuals()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere and savedAtmosphere then
		TweenService:Create(atmosphere, TweenInfo.new(4), savedAtmosphere):Play()
		savedAtmosphere = nil
	end
	-- Nukritę, bet nepaimti cepelinai dar kurį laiką lieka, paskui dingsta
	local token = state.Token or 0
	task.delay(E.SkyGranny.Grace, function()
		for _, child in ipairs(workspace:GetChildren()) do
			if child.Name == "GoldenCepelinas" and child:GetAttribute("SkyGrannyToken") == token then
				child:Destroy()
			end
		end
	end)
end

----------------------------------------------------------------------
-- Močiučių varžybos
----------------------------------------------------------------------
-- Varžybose dalyvauja tik paspaudę „Dalyvauti“ (kiti nerodomi lentelėje ir negauna prizų)
function EventService:RecordSale(player, amount)
	if current and current.Id == "Contest" and current.Joined[player] then
		current.Scores[player] = (current.Scores[player] or 0) + amount
	end
end

local function contestRanking(state)
	local list = {}
	for player, score in pairs(state.Scores) do
		if player.Parent then
			table.insert(list, { Player = player, Score = score })
		end
	end
	table.sort(list, function(a, b)
		return a.Score > b.Score
	end)
	return list
end

local function sendContestUpdate(state)
	local ranking = contestRanking(state)
	local top = {}
	for i = 1, math.min(3, #ranking) do
		top[i] = { Name = ranking[i].Player.DisplayName, Score = ranking[i].Score }
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local rank, score = 0, state.Scores[player] or 0
		for i, entry in ipairs(ranking) do
			if entry.Player == player then
				rank = i
			end
		end
		Remotes.ContestUpdate:FireClient(player, top, score, rank, state.EndsAt, state.Joined[player] == true)
	end
end

local function giveChefHat(player, duration)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = character:FindFirstChild("ChefHat")
	if old then
		old:Destroy()
	end
	local hat = Instance.new("Model")
	hat.Name = "ChefHat"
	local band = Build.Part({ Name = "Band", Parent = hat, Shape = Enum.PartType.Cylinder, Size = V(0.5, 1.35, 1.35), CFrame = head.CFrame * CF(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(250, 250, 250), Material = Enum.Material.Fabric, Anchored = false, CanCollide = false, Massless = true })
	local puff = Build.Part({ Name = "Puff", Parent = hat, Shape = Enum.PartType.Ball, Size = V(1.7, 1.7, 1.7), CFrame = head.CFrame * CF(0, 1.45, 0), Color = C(255, 255, 255), Material = Enum.Material.Fabric, Anchored = false, CanCollide = false, Massless = true })
	for _, p in ipairs({ band, puff }) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = head
		w.Part1 = p
		w.Parent = p
	end
	hat.Parent = character
	game:GetService("Debris"):AddItem(hat, duration)
end

local function finishContest(state)
	local cfg = E.Contest
	local ranking = contestRanking(state)
	for i = 1, math.min(3, #ranking) do
		local player = ranking[i].Player
		local amount = EventService:GrantIncome(player, cfg.PrizeSeconds[i], cfg.PrizeMin[i])
		S.DataService:Notify(player, "ContestPrize", nil, nil, { amount = amount, rank = i }, "success")
	end
	if ranking[1] then
		giveChefHat(ranking[1].Player, cfg.HatDuration)
		for _, player in ipairs(Players:GetPlayers()) do
			S.DataService:Notify(player, "ContestWinner", { name = ranking[1].Player.DisplayName }, nil, nil, "success")
		end
	end
	Remotes.ContestUpdate:FireAllClients(nil)
end

-- Paleidžia eventą. duration – nebūtina (Joninėms – likęs laikas)
function EventService:StartEvent(id, duration, manual)
	if current then
		return false
	end
	local objects = {}
	if id == "PotatoRain" then
		duration = duration or E.PotatoRain.Duration
	elseif id == "BigCepelinas" then
		duration = duration or E.BigCepelinas.Duration
		spawnBigCepelinas(objects)
	elseif id == "Jonines" then
		duration = duration or E.Jonines.Duration
		startJoninesVisuals(objects)
	elseif id == "Fairy" then
		duration = duration or E.Fairy.Duration
		spawnFairy(objects)
	elseif id == "Winter" then
		duration = duration or E.Winter.Duration
		startWinter(objects)
	elseif id == "Contest" then
		duration = duration or E.Contest.Duration
	elseif id == "SkyGranny" then
		duration = duration or E.SkyGranny.Duration
	else
		return false
	end
	local endsAt = workspace:GetServerTimeNow() + duration
	eventToken = eventToken + 1
	current = { Id = id, EndsAt = endsAt, Manual = manual == true, Objects = objects, Scores = {}, Joined = {}, Token = eventToken }
	if id == "SkyGranny" then
		startSkyGranny(objects, current)
	end
	setReplicated(id, endsAt)
	Remotes.EventStarted:FireAllClients(id, endsAt)
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService:Get(player) then
			S.TycoonService:UpdateIncome(player)
		end
	end
	return true
end

function EventService:StopEvent()
	if not current then
		return
	end
	local id = current.Id
	for _, object in ipairs(current.Objects) do
		if object.Parent then
			object:Destroy()
		end
	end
	local state = current
	if id == "Jonines" then
		stopJoninesVisuals()
		markJoninesDone(self)
	elseif id == "Winter" then
		stopWinter()
	elseif id == "Contest" then
		finishContest(state)
	elseif id == "SkyGranny" then
		stopSkyGranny(state)
	end
	current = nil
	setReplicated(nil, nil)
	Remotes.EventEnded:FireAllClients(id)
	scheduleNext(id)
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService:Get(player) then
			S.TycoonService:UpdateIncome(player)
		end
	end
end

-- Developer product „Šventinis Bulvių lietus“: jei dabar vyksta kitas eventas – eilėje
function EventService:QueuePotatoRain()
	if not current then
		self:StartEvent("PotatoRain")
	else
		pendingRain = pendingRain + 1
	end
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function EventService:Init(services)
	S = services
	Remotes.ContestJoin.OnServerEvent:Connect(function(player)
		if not current or current.Id ~= "Contest" or current.Joined[player] or not S.DataService:Get(player) then
			return
		end
		current.Joined[player] = true
		current.Scores[player] = 0
		S.DataService:Notify(player, "ContestJoined", nil, nil, nil, "success")
		sendContestUpdate(current)
	end)
end

function EventService:RunLoop()
	local first = random:NextNumber(E.FirstEventDelay[1], E.FirstEventDelay[2])
	for i, id in ipairs(RANDOM_EVENTS) do
		-- Pirmieji eventai išdėstomi, kad neprasidėtų visi iš karto
		nextAt[id] = os.clock() + first + (i - 1) * random:NextNumber(90, 180) + random:NextNumber(0, E[id].MinGap / 3)
	end
	local lastJoninesCheck = 0
	local lastContestUpdate = 0
	while true do
		task.wait(1)
		local now = os.clock()
		-- Laumės noro pabaiga
		if buff and workspace:GetServerTimeNow() >= buff.EndsAt then
			buff = nil
			ReplicatedStorage:SetAttribute("BuffId", "")
			ReplicatedStorage:SetAttribute("BuffEndsAt", 0)
			refreshIncome()
		end
		if current then
			if current.Id == "Contest" and now - lastContestUpdate >= E.Contest.UpdateInterval then
				lastContestUpdate = now
				sendContestUpdate(current)
			end
			if workspace:GetServerTimeNow() >= current.EndsAt then
				self:StopEvent()
			end
		else
			-- Joninės turi pirmenybę
			if now - lastJoninesCheck >= E.Jonines.CheckInterval then
				lastJoninesCheck = now
				local remaining = self:GetJoninesRemaining()
				if remaining then
					self:StartEvent("Jonines", remaining)
				end
			end
			if not current then
				if pendingRain > 0 then
					pendingRain = pendingRain - 1
					self:StartEvent("PotatoRain")
				else
					-- Paleidžiam tą atsitiktinį eventą, kurio laikas atėjo anksčiausiai
					local dueId, dueAt = nil, math.huge
					for _, id in ipairs(RANDOM_EVENTS) do
						if nextAt[id] and nextAt[id] <= now and nextAt[id] < dueAt then
							dueId, dueAt = id, nextAt[id]
						end
					end
					if dueId then
						self:StartEvent(dueId)
						scheduleNext(dueId)
					end
				end
			end
		end
	end
end

function EventService:Start()
	setReplicated(nil, nil)
	ReplicatedStorage:SetAttribute("BuffId", "")
	ReplicatedStorage:SetAttribute("BuffEndsAt", 0)
	-- Gruodį turguje stovi Kalėdų eglė
	if isDecember() then
		local spot = S.MapBuilder.Anchors.ChristmasSpot
		if spot then
			local folder = Build.Folder("ChristmasDecor", workspace)
			Scenery.ChristmasTree(folder, spot, 1)
		end
	end
	task.spawn(function()
		self:RunLoop()
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">GearService</string><ProtectedString name="Source"><![CDATA[--[[
	GearService – daiktai kuprinėje (Tool be Handle):
	  „Magė“      – radijas tiems, kas jį turi (savininkas arba nusipirkęs už 20B).
	                Išsitraukus – radijas atsiduria ant dešinio peties, o ranka jį prilaiko
	                (IKControl nukreipia plaštaką į radiją). Paspaudus – atsidaro valdymo langas.
	  Ženklas     – tik savininkui: lentelė ant kotelio iškelta virš galvos su užrašu
	                Settings.Sign.Text (dideliu šriftu, matosi visiems).

	Daiktai prisegami prie liemens (Weld), o IKControl serveryje sukuriamas Humanoide –
	jis replikuojasi ir kiekvienas klientas ranką „pastato“ pats, todėl pozą mato visi.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local GearService = {}
local S

----------------------------------------------------------------------
-- Pagalbinės
----------------------------------------------------------------------
local function torsoOf(character)
	return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
end

local function newTool(name, tip)
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = tip or name
	return tool
end

-- Dalis prisegama prie liemens per Weld su tikslia vieta (offset – liemens koordinatėmis)
local function welded(model, torso, props, offset)
	props.Parent = model
	props.Anchored = false
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.Massless = true
	props.CFrame = torso.CFrame * offset
	local part = Build.Part(props)
	local weld = Instance.new("Weld")
	weld.Part0 = torso
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
	return part
end

-- Ranka laiko daiktą: IKControl veda dešinę plaštaką į taikinį
local function holdWithRightHand(character, target, name)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local upperArm = character:FindFirstChild("RightUpperArm")
	local hand = character:FindFirstChild("RightHand")
	if not humanoid or not upperArm or not hand then
		return nil -- R6 – daiktas tiesiog prisegtas
	end
	local ik = Instance.new("IKControl")
	ik.Name = name
	ik.Type = Enum.IKControlType.Position
	ik.ChainRoot = upperArm
	ik.EndEffector = hand
	ik.Target = target
	ik.Weight = 1
	ik.Priority = 1
	ik.Parent = humanoid
	return ik
end

local function clearGear(character, name)
	local old = character:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local ik = humanoid and humanoid:FindFirstChild(name .. "IK")
	if ik then
		ik:Destroy()
	end
end

----------------------------------------------------------------------
-- Magė ant peties
----------------------------------------------------------------------
local function equipMage(character)
	clearGear(character, "MageOnShoulder")
	local torso = torsoOf(character)
	if not torso then
		return
	end
	local model = Instance.new("Model")
	model.Name = "MageOnShoulder"
	local top = torso.Size.Y / 2
	local side = torso.Size.X / 2
	-- Radijas guli ant peties: ilgoji ašis – į priekį/atgal, garsiakalbiai į šoną (+X)
	local base = CF(side, top + 0.62, 0.05)
	local wood = C(105, 62, 32)
	local body = welded(model, torso, { Name = "MageBody", Size = V(0.7, 1.15, 2.1), Color = wood, Material = M.Wood }, base)
	welded(model, torso, { Name = "MageGrille", Size = V(0.08, 0.85, 1.25), Color = C(225, 200, 150), Material = M.Fabric }, base * CF(0.36, -0.02, 0.28))
	for i, color in ipairs({ C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }) do
		welded(model, torso, { Name = "MageStripe", Size = V(0.09, 0.08, 1.25), Color = color, Material = M.SmoothPlastic }, base * CF(0.37, -0.38 + (i - 1) * 0.08, 0.28))
	end
	welded(model, torso, { Name = "MageDial", Size = V(0.08, 0.3, 0.5), Color = C(255, 190, 90), Material = M.Neon }, base * CF(0.36, 0.25, -0.62))
	welded(model, torso, { Name = "MageKnob", Shape = Enum.PartType.Cylinder, Size = V(0.12, 0.25, 0.25), Color = C(230, 190, 90), Material = M.Metal }, base * CF(0.4, -0.2, -0.62))
	welded(model, torso, { Name = "MageHandle", Size = V(0.15, 0.15, 1.3), Color = C(60, 40, 25), Material = M.Wood }, base * CF(0, 0.72, 0))
	welded(model, torso, { Name = "MageAntenna", Size = V(0.06, 1.4, 0.06), Color = C(190, 190, 195), Material = M.Metal }, base * CF(-0.15, 1.2, -0.85) * CFrame.Angles(math.rad(-20), 0, 0))
	-- Natos, kai Magė groja
	local notes = Instance.new("ParticleEmitter")
	notes.Name = "Notes"
	notes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	notes.Color = ColorSequence.new(C(255, 220, 120), C(255, 150, 200))
	notes.Size = NumberSequence.new(0.2)
	notes.Lifetime = NumberRange.new(0.8, 1.4)
	notes.Speed = NumberRange.new(1, 2)
	notes.Rate = 4
	notes.Enabled = (ReplicatedStorage:GetAttribute("RadioId") or "") ~= ""
	notes.Parent = body
	-- Taikinys plaštakai: išorinis apatinis radijo kampas (ranka prilaiko iš šono)
	local grip = Instance.new("Attachment")
	grip.Name = "HandGrip"
	grip.Position = V(0.55, -0.45, 0.3)
	grip.Parent = body
	model.Parent = character
	local ik = holdWithRightHand(character, grip, "MageOnShoulderIK")
	if ik then
		ik.Name = "MageOnShoulderIK"
	end
end

----------------------------------------------------------------------
-- Ženklas virš galvos
----------------------------------------------------------------------
local function signFace(board, face, faceName)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignText_" .. faceName
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.Text = Settings.Sign.Text
	label.TextColor3 = C(200, 30, 35)
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
end

local function equipSign(character)
	clearGear(character, "BigSign")
	local torso = torsoOf(character)
	if not torso then
		return
	end
	local model = Instance.new("Model")
	model.Name = "BigSign"
	local top = torso.Size.Y / 2
	local side = torso.Size.X / 2
	-- Kotelis šalia dešinio peties, lentelė aukštai virš galvos
	local pole = welded(model, torso, { Name = "SignPole", Size = V(0.22, 5.2, 0.22), Color = C(120, 80, 45), Material = M.Wood }, CF(side + 0.55, top + 1.6, -0.35))
	local board = welded(model, torso, { Name = "SignBoard", Size = V(5.4, 2.3, 0.18), Color = C(250, 246, 235), Material = M.WoodPlanks }, CF(side - 0.6, top + 4.6, -0.35))
	welded(model, torso, { Name = "SignFrame", Size = V(5.7, 2.6, 0.12), Color = C(90, 58, 30), Material = M.Wood }, CF(side - 0.6, top + 4.6, -0.27))
	signFace(board, Enum.NormalId.Front, "Front")
	signFace(board, Enum.NormalId.Back, "Back")
	local grip = Instance.new("Attachment")
	grip.Name = "HandGrip"
	grip.Position = V(0, -1.1, 0)
	grip.Parent = pole
	model.Parent = character
	local ik = holdWithRightHand(character, grip, "BigSignIK")
	if ik then
		ik.Name = "BigSignIK"
	end
end

----------------------------------------------------------------------
-- Daiktų išdalijimas
----------------------------------------------------------------------
local function giveTools(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local function has(name)
		return backpack:FindFirstChild(name) or (player.Character and player.Character:FindFirstChild(name))
	end
	if S.RadioService:CanUse(player) and not has("Magė") then
		local tool = newTool("Magė", "📻 " .. Settings.Radio.Name)
		tool.Equipped:Connect(function()
			if player.Character then
				equipMage(player.Character)
			end
		end)
		tool.Unequipped:Connect(function()
			if player.Character then
				clearGear(player.Character, "MageOnShoulder")
			end
		end)
		tool.Activated:Connect(function()
			if S.RadioService:CanUse(player) then
				Remotes.OpenWindow:FireClient(player, "Radio")
			end
		end)
		tool.Parent = backpack
	end
	if S.AdminService:IsAdmin(player) and not has("Ženklas") then
		local tool = newTool("Ženklas", Settings.Sign.Text)
		tool.Equipped:Connect(function()
			if player.Character then
				equipSign(player.Character)
			end
		end)
		tool.Unequipped:Connect(function()
			if player.Character then
				clearGear(player.Character, "BigSign")
			end
		end)
		tool.Parent = backpack
	end
end

function GearService:Refresh(player)
	giveTools(player)
end

function GearService:Init(services)
	S = services
end

function GearService:Start()
	local function onPlayer(player)
		player.CharacterAdded:Connect(function()
			task.delay(1.5, function()
				if player.Parent and S.DataService:Get(player) then
					giveTools(player)
				end
			end)
		end)
		player:GetAttributeChangedSignal("CanUseRadio"):Connect(function()
			giveTools(player)
		end)
		task.spawn(function()
			for _ = 1, 30 do
				if S.DataService:Get(player) or not player.Parent then
					break
				end
				task.wait(1)
			end
			if player.Parent and S.DataService:Get(player) then
				giveTools(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	-- Natos ant peties, kai Magė groja
	ReplicatedStorage:GetAttributeChangedSignal("RadioId"):Connect(function()
		local playing = (ReplicatedStorage:GetAttribute("RadioId") or "") ~= ""
		for _, player in ipairs(Players:GetPlayers()) do
			local gear = player.Character and player.Character:FindFirstChild("MageOnShoulder")
			local body = gear and gear:FindFirstChild("MageBody")
			local notes = body and body:FindFirstChild("Notes")
			if notes then
				notes.Enabled = playing
			end
		end
	end)
end

return GearService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">GrannyService</string><ProtectedString name="Source"><![CDATA[--[[
	GrannyService – močiutės darbuotojos (po vieną kiekvienai linijai, 3 lygiai).
	- R15 rig'as su skarele ir prijuoste (jei nepavyksta sukurti – paprasta močiutė iš Parts).
	- Klientas animuoja rankas ir rodo kalbos burbulą (atributas "Phrase").
	- Kainos ir efektai – Settings.Grannies, formulės – Calc.
	Savo modelį gali įdėti į ServerStorage/Templates/Machines pavadinimu "Granny"
	(jame turi būti HumanoidRootPart, Head, o skarelė/prijuostė – dalys "Scarf" ir "Apron").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local ProductLines = require(Config:WaitForChild("ProductLines"))
local Texts = require(Config:WaitForChild("Texts"))
local Calc = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Calc"))
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local GrannyModels = require(Lib:WaitForChild("GrannyModels"))

local G = Settings.Grannies
local L = Settings.Layout
local CF = CFrame.new
local V = Vector3.new
local C = Color3.fromRGB

local GrannyService = {}
local S
local records = {}                 -- [player] = { [lineId] = { Model = ..., NextAt = ... } }
local random = Random.new()

----------------------------------------------------------------------
-- Modeliai (Lib/GrannyModels). Savo modelį gali įdėti į ServerStorage/Templates/Machines
-- pavadinimu "Granny_1", "Granny_2" arba "Granny_3".
----------------------------------------------------------------------
local function getTemplate(level)
	local machines = ServerStorage:WaitForChild("Templates"):WaitForChild("Machines")
	local name = "Granny_" .. level
	local template = machines:FindFirstChild(name)
	if not template then
		template = GrannyModels.Build(level)
		template.Name = name
		template.Parent = machines
	end
	return template
end

----------------------------------------------------------------------
-- Statymas sklype
----------------------------------------------------------------------
function GrannyService:GetLevel(player, lineId)
	local data = S.DataService:Get(player)
	if not data then
		return 0
	end
	return Calc.GetGrannyLevel(data, lineId, S.TycoonService:GetContext(player))
end

-- Kitas perkamas lygis ir kaina (nil – maksimalus lygis arba linija užrakinta)
function GrannyService:GetNextLevel(player, lineId)
	local data = S.DataService:Get(player)
	if not data or not Calc.IsLineUnlocked(data, lineId) then
		return nil
	end
	local nextLevel = self:GetLevel(player, lineId) + 1
	local price = Calc.GetGrannyPrice(lineId, nextLevel)
	if not price then
		return nil
	end
	return nextLevel, price
end

function GrannyService:BuildLine(player, lineId, animate)
	local plot = S.PlotService:GetPlot(player)
	if not plot then
		return
	end
	for _, name in ipairs({ "Granny_" .. lineId, "GrannyTable_" .. lineId }) do
		local old = plot.Machines:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	records[player] = records[player] or {}
	records[player][lineId] = nil

	local data = S.DataService:Get(player)
	if not data or not Calc.IsLineUnlocked(data, lineId) then
		return
	end
	local x = S.PlotService:GetLaneX(lineId) + L.GrannyX
	local tableModel = S.TemplateBuilder:CloneMachine("GrannyTable")
	if tableModel then
		tableModel.Name = "GrannyTable_" .. lineId
		tableModel:PivotTo(plot.CFrame * CF(x, L.ZoneTopY, L.GrannyZ))
		tableModel.Parent = plot.Machines
	end

	local level = self:GetLevel(player, lineId)
	if level <= 0 then
		return
	end
	local granny = getTemplate(level):Clone()
	granny.Name = "Granny_" .. lineId
	local root = granny:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = true
	end
	granny:SetAttribute("Level", level)
	granny:SetAttribute("Phrase", "")
	if animate then
		-- Klientas parodo nusileidimą iš dangaus
		granny:SetAttribute("ArriveAt", workspace:GetServerTimeNow())
	end
	-- Stovi už stalo, veidu į konvejerį (+X)
	local position = (plot.CFrame * CF(x - L.GrannyStandOffset, L.ZoneTopY, L.GrannyZ)).Position
	local facing = position + plot.CFrame.RightVector
	granny.Parent = plot.Machines
	Build.PlaceOnFloor(granny, CFrame.lookAt(position, Vector3.new(facing.X, position.Y, facing.Z)))
	local head = granny:FindFirstChild("Head")
	if head then
		local top = level == 3 and 4.2 or 2.6
		Build.Billboard(head, { Name = "GrannyStars", Text = string.rep("★", level) .. string.rep("☆", 3 - level), Size = UDim2.fromScale(3, 0.9), Offset = V(0, top + 2.0, 0), MaxDistance = 60, Color = C(255, 205, 60) })
		Build.Billboard(head, { Name = "GrannyName", TextKey = "Granny_" .. level, Size = UDim2.fromScale(6, 1.2), Offset = V(0, top + 1.1, 0), MaxDistance = 60, Font = Enum.Font.Fondamento })
		-- Ką močiutė duoda (greitis / vertė)
		Build.Billboard(head, { Name = "GrannyEffect", TextKey = "GrannyEffect_" .. level, Size = UDim2.fromScale(8, 1), Offset = V(0, top, 0), MaxDistance = 60, Font = Enum.Font.Merriweather, Color = C(170, 255, 140) })
	end
	CollectionService:AddTag(granny, "Granny")
	records[player][lineId] = { Model = granny, NextAt = os.clock() + random:NextNumber(G.PhraseMin, G.PhraseMax) }
end

function GrannyService:BuildForPlayer(player)
	for _, lineId in ipairs(ProductLines.Order) do
		task.spawn(function()
			self:BuildLine(player, lineId)
		end)
	end
end

function GrannyService:Purchase(player, lineId)
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local level, price = self:GetNextLevel(player, lineId)
	if not level then
		return
	end
	if not S.TycoonService:TrySpend(player, price) then
		return
	end
	data.grannies[lineId] = level
	self:BuildLine(player, lineId, true)
	S.DataService:Notify(player, "GrannyHired", nil, { granny = "Granny_" .. level, line = "Line_" .. lineId }, nil, "success")
	S.TycoonService:RefreshButtons(player)
	S.TycoonService:UpdateIncome(player)
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function GrannyService:Init(services)
	S = services
end

function GrannyService:Start()
	-- Šablonai sukuriami iš anksto (matosi ServerStorage žaidžiant)
	for level = 1, #G.Levels do
		getTemplate(level)
	end

	-- Kalbos burbulai: kas 20–40 s atsitiktinė frazė (tekstą klientas parenka pagal savo kalbą)
	local phraseCount = #Texts.en.GrannyPhrases
	task.spawn(function()
		local nonce = 0
		while true do
			task.wait(1)
			local now = os.clock()
			for _, lines in pairs(records) do
				for _, rec in pairs(lines) do
					if rec.Model.Parent and now >= rec.NextAt then
						nonce = nonce + 1
						rec.Model:SetAttribute("Phrase", math.random(1, phraseCount) .. ":" .. nonce)
						rec.NextAt = now + random:NextNumber(G.PhraseMin, G.PhraseMax)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		records[player] = nil
	end)
end

return GrannyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">JailService</string><ProtectedString name="Source"><![CDATA[--[[
	JailService – bausmė nusikaltusiam žaidėjui (tik savininkas / admin):
	  /jail <vardas>    – žaidėjas nukeliamas į miško aikštelę, pasodinamas ant kėdės,
	                      aplink jį sukasi močiutės ir kočėlais „auklėja“ (tik animacija, be žalos).
	                      Jis negali nei vaikščioti, nei šokti, nei teleportuotis; išėjus ir grįžus –
	                      vėl atsiduria ant kėdės (data.jailed išsaugoma).
	  /unjail <vardas>  – paleidžia ir nukelia į turgų.

	Močiučių sukimąsi ir smūgius rodo klientai (EffectsController, žymė "JailGranny"),
	serveris tik pastato kamerą ir kas pusę sekundės prižiūri, kad kalinys sėdėtų.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local GrannyModels = require(Lib:WaitForChild("GrannyModels"))

local J = Settings.Jail
local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local JailService = {}
local S
local cells = {}          -- [userId] = { Folder, Seat, Center, Index }
local usedIndex = {}

local function cellCenter(index)
	local a = math.rad(J.Angle + (index - 1) * 6)
	local r = J.Radius
	return V(math.cos(a) * r, 0, math.sin(a) * r)
end

local function clearTrees(center, radius)
	local map = workspace:FindFirstChild("Map")
	local nature = map and map:FindFirstChild("Nature")
	if not nature then
		return
	end
	for _, child in ipairs(nature:GetChildren()) do
		local ok, pivot = pcall(function()
			return child:GetPivot()
		end)
		if ok and pivot then
			local p = pivot.Position
			if V(p.X - center.X, 0, p.Z - center.Z).Magnitude < radius then
				child:Destroy()
			end
		end
	end
end

local function buildCell(index)
	local center = cellCenter(index)
	clearTrees(center, 16)
	local folder = Build.Folder("JailCell_" .. index, workspace)
	local facing = CFrame.lookAt(center, V(0, 0, 0))
	-- Pievelė ir kelmas-ženklas
	Build.Part({ Name = "Clearing", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(0.3, 26, 26), CFrame = CF(center + V(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(95, 125, 60), Material = M.Grass, CanCollide = true })
	-- Medinė kėdė
	local seatCF = facing * CF(0, 1.6, 0)
	local seat = Instance.new("Seat")
	seat.Name = "JailSeat"
	seat.Size = V(2.2, 0.4, 2.2)
	seat.CFrame = seatCF
	seat.Anchored = true
	seat.Color = C(120, 80, 45)
	seat.Material = M.WoodPlanks
	seat.Parent = folder
	for _, x in ipairs({ -0.95, 0.95 }) do
		for _, z in ipairs({ -0.95, 0.95 }) do
			Build.Part({ Name = "ChairLeg", Parent = folder, Size = V(0.3, 1.5, 0.3), CFrame = facing * CF(x, 0.75, z), Color = C(90, 58, 30), Material = M.Wood })
		end
	end
	Build.Part({ Name = "ChairBack", Parent = folder, Size = V(2.2, 2.6, 0.3), CFrame = facing * CF(0, 3.1, 1.05), Color = C(120, 80, 45), Material = M.WoodPlanks })
	Build.Part({ Name = "ChairTop", Parent = folder, Size = V(2.5, 0.35, 0.4), CFrame = facing * CF(0, 4.5, 1.05), Color = C(90, 58, 30), Material = M.Wood })
	local signPost = Build.Part({ Name = "SignPost", Parent = folder, Size = V(0.4, 5, 0.4), CFrame = facing * CF(5, 2.5, -6), Color = C(90, 58, 30), Material = M.Wood })
	Build.Sign(signPost, { Name = "JailSign", TextKey = "JailSign", Size = UDim2.fromScale(8, 2), Offset = V(0, 3.5, 0), MaxDistance = 120 })
	-- Močiutės aplink (klientai suka ratu ir animuoja smūgius)
	for i = 1, J.Grannies do
		local level = ((i - 1) % 3) + 1
		local granny = GrannyModels.Build(level)
		granny.Name = "JailGranny"
		-- Pirma pastatom ant žemės (kojos ant aikštelės), tik tada duodam kočėlą
		local a = (i - 1) * (2 * math.pi / J.Grannies)
		local pos = V(center.X + math.cos(a) * J.CircleRadius, 0.3, center.Z + math.sin(a) * J.CircleRadius)
		Build.PlaceOnFloor(granny, CFrame.lookAt(pos, V(center.X, pos.Y, center.Z)))
		local rightArm = granny:FindFirstChild("RightArm")
		if rightArm then
			local pinCF = rightArm.CFrame * CF(0, -1.7, 0) * CFrame.Angles(0, 0, math.rad(90))
			local pin = Build.Part({ Name = "RollingPin", Parent = granny, Shape = Enum.PartType.Cylinder, Size = V(2.6, 0.38, 0.38), CFrame = pinCF, Color = C(215, 175, 115), Material = M.Wood, Anchored = false, CanCollide = false })
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = rightArm
			weld.Part1 = pin
			weld.Parent = pin
		end
		for _, d in ipairs(granny:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		granny:SetAttribute("CenterX", center.X)
		granny:SetAttribute("CenterZ", center.Z)
		granny:SetAttribute("Phase", a)
		granny:SetAttribute("SeatY", seatCF.Position.Y)
		granny.Parent = folder
		CollectionService:AddTag(granny, "JailGranny")
	end
	return { Folder = folder, Seat = seat, Center = center, Index = index }
end

local function getCell(player)
	local cell = cells[player.UserId]
	if cell and cell.Folder.Parent then
		return cell
	end
	local index = 1
	while usedIndex[index] do
		index = index + 1
	end
	usedIndex[index] = true
	cell = buildCell(index)
	cells[player.UserId] = cell
	return cell
end

local function freeCell(userId)
	local cell = cells[userId]
	if cell then
		usedIndex[cell.Index] = nil
		cell.Folder:Destroy()
		cells[userId] = nil
	end
end

local function lockMovement(humanoid, locked)
	humanoid.WalkSpeed = locked and 0 or 16
	humanoid.JumpPower = locked and 0 or 50
	humanoid.JumpHeight = locked and 0 or 7.2
	humanoid.UseJumpPower = true
end

-- Pasodina ant kėdės (jei dar nesėdi)
local function seatPrisoner(player)
	local cell = cells[player.UserId]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not cell or not humanoid or not root then
		return
	end
	lockMovement(humanoid, true)
	humanoid:UnequipTools()
	if humanoid.SeatPart ~= cell.Seat then
		humanoid.Sit = false
		character:PivotTo(cell.Seat.CFrame * CF(0, 2, 0))
		cell.Seat:Sit(humanoid)
	end
end

function JailService:IsJailed(player)
	local data = S.DataService:Get(player)
	return data ~= nil and data.jailed == true
end

function JailService:Jail(player)
	local data = S.DataService:Get(player)
	if not data then
		return false
	end
	data.jailed = true
	player:SetAttribute("Jailed", true)
	getCell(player)
	seatPrisoner(player)
	S.DataService:Notify(player, "JailYou", nil, nil, nil, "error")
	return true
end

function JailService:Release(player)
	local data = S.DataService:Get(player)
	if data then
		data.jailed = false
	end
	player:SetAttribute("Jailed", false)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Sit = false
		lockMovement(humanoid, false)
	end
	freeCell(player.UserId)
	if character then
		task.delay(0.2, function()
			if character.Parent then
				character:PivotTo(S.MapBuilder:GetLobbySpawnCFrame())
			end
		end)
	end
	S.DataService:Notify(player, "JailReleased", nil, nil, nil, "success")
	return true
end

function JailService:Init(services)
	S = services
end

function JailService:Start()
	local function onPlayer(player)
		player.CharacterAdded:Connect(function()
			task.delay(1, function()
				if self:IsJailed(player) then
					getCell(player)
					seatPrisoner(player)
				end
			end)
		end)
		task.spawn(function()
			-- Grįžus į žaidimą bausmė tęsiasi
			for _ = 1, 30 do
				if S.DataService:Get(player) or not player.Parent then
					break
				end
				task.wait(1)
			end
			if player.Parent and self:IsJailed(player) then
				player:SetAttribute("Jailed", true)
				getCell(player)
				task.wait(1)
				seatPrisoner(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		freeCell(player.UserId)
	end)
	-- Prižiūrėtojas: kalinys visada ant kėdės
	task.spawn(function()
		while true do
			task.wait(0.5)
			for userId, cell in pairs(cells) do
				local player = Players:GetPlayerByUserId(userId)
				if player and player.Character then
					local root = player.Character:FindFirstChild("HumanoidRootPart")
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					if root and humanoid and (humanoid.SeatPart ~= cell.Seat or (root.Position - cell.Seat.Position).Magnitude > 6) then
						seatPrisoner(player)
					end
				end
			end
		end
	end)
end

return JailService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--[[
	LeaderboardService – dvi lyderių lentos lobby (OrderedDataStore, top 10):
	  daugiausia uždirbta per visą laiką (totalEarned) ir daugiausia rebirth.
	Atnaujinama kas Settings.Leaderboard.RefreshInterval s.
	Pirmosios vietos savininkas (jei yra serveryje) gauna titulą virš vardo ir pokalbyje:
	  „👑 #1 Turtingiausias“ (daugiausia uždirbta) ir „🔁 #1 Rebirth karalius“.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local NumberFormat = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormat"))
local Build = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Build"))

local LB = Settings.Leaderboard
local C = Color3.fromRGB

local LeaderboardService = {}
local S
local boards = {}
local nameCache = {}
local warned = false

local function getName(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	return "#" .. tostring(userId)
end

local function createBoard(part, titleKey)
	if not part then
		return nil
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = C(232, 211, 162)
	frame.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = C(92, 58, 30)
	stroke.Thickness = 10
	stroke.Parent = frame

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(0.9, 0.14)
	title.Position = UDim2.fromScale(0.05, 0.02)
	title.Font = Enum.Font.Fondamento
	title.TextScaled = true
	title.TextColor3 = C(110, 30, 25)
	title.Parent = frame
	Build.Localize(title, titleKey)

	local rows = {}
	for i = 1, LB.Top do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. i
		row.BackgroundTransparency = 1
		row.Size = UDim2.fromScale(0.9, 0.075)
		row.Position = UDim2.fromScale(0.05, 0.17 + (i - 1) * 0.08)
		row.Font = Enum.Font.Merriweather
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = C(60, 35, 15)
		row.Text = ""
		row.Parent = frame
		rows[i] = row
	end
	local empty = rows[1]
	Build.Localize(empty, "LB_Empty")
	return { Rows = rows }
end

local function render(board, entries, formatter)
	if not board then
		return
	end
	for i, row in ipairs(board.Rows) do
		local entry = entries[i]
		if entry then
			row:SetAttribute("TextKey", nil)
			row.Text = string.format("%d. %s – %s", i, getName(tonumber(entry.key)), formatter(entry.value))
		elseif i == 1 then
			row:SetAttribute("TextKey", "LB_Empty")
		else
			row.Text = ""
		end
	end
end

local function refresh(store, field, board, formatter)
	for _, player in ipairs(Players:GetPlayers()) do
		local data = S.DataService:Get(player)
		if data then
			pcall(function()
				store:SetAsync(tostring(player.UserId), math.floor(data[field]))
			end)
		end
	end
	local ok, result = pcall(function()
		return store:GetSortedAsync(false, LB.Top):GetCurrentPage()
	end)
	if ok then
		render(board, result, formatter)
		local first = result[1]
		if first and (tonumber(first.value) or 0) > 0 then
			return tonumber(first.key)
		end
		return 0
	elseif not warned then
		warned = true
		warn("[Leaderboard] OrderedDataStore nepasiekiamas: " .. tostring(result))
	end
	return nil
end

----------------------------------------------------------------------
-- #1 titulai virš vardo
----------------------------------------------------------------------
local topMoneyId, topRebirthId = 0, 0

local function applyTopTag(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("TopTitleGui")
	if old then
		old:Destroy()
	end
	local money = player.UserId == topMoneyId
	local rebirth = player.UserId == topRebirthId
	player:SetAttribute("TopMoney", money)
	player:SetAttribute("TopRebirth", rebirth)
	if not money and not rebirth then
		return
	end
	local key = (money and rebirth) and "TopTitle_Both" or (money and "TopTitle_Money" or "TopTitle_Rebirth")
	Build.Billboard(head, { Name = "TopTitleGui", TextKey = key, Size = UDim2.fromScale(10, 1.3), Offset = Vector3.new(0, 3.6, 0), MaxDistance = 150, Color = C(255, 200, 40) })
end

function LeaderboardService:SetTop(moneyId, rebirthId)
	if moneyId then
		topMoneyId = moneyId
	end
	if rebirthId then
		topRebirthId = rebirthId
	end
	ReplicatedStorage:SetAttribute("TopMoneyUserId", topMoneyId)
	ReplicatedStorage:SetAttribute("TopRebirthUserId", topRebirthId)
	for _, player in ipairs(Players:GetPlayers()) do
		applyTopTag(player)
	end
end

function LeaderboardService:Init(services)
	S = services
end

function LeaderboardService:Start()
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.delay(1.2, function()
				applyTopTag(player)
			end)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function()
			task.delay(1.2, function()
				applyTopTag(player)
			end)
		end)
	end
	boards.Total = createBoard(S.MapBuilder.Anchors.LeaderboardTotal, "LB_Total")
	boards.Rebirths = createBoard(S.MapBuilder.Anchors.LeaderboardRebirths, "LB_Rebirths")

	task.spawn(function()
		local ok, totalStore, rebirthStore = pcall(function()
			return DataStoreService:GetOrderedDataStore(LB.TotalStore), DataStoreService:GetOrderedDataStore(LB.RebirthStore)
		end)
		if not ok then
			warn("[Leaderboard] Nepavyko gauti OrderedDataStore: " .. tostring(totalStore))
			return
		end
		task.wait(LB.FirstRefresh)
		while true do
			if S.DataService:IsOnline() then
				local moneyId = refresh(totalStore, "totalEarned", boards.Total, function(v)
					return NumberFormat.Money(v)
				end)
				local rebirthId = refresh(rebirthStore, "rebirths", boards.Rebirths, function(v)
					return tostring(v)
				end)
				self:SetTop(moneyId, rebirthId)
			end
			task.wait(LB.RefreshInterval)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MapBuilder – sukuria žemėlapį iš Parts serverio starte:
	  - žolės pagrindas, keliai į sklypus
	  - Lobby „Kaimo turgus“: fontanas su cepelino statula (spawn), Močiutės trobelė,
	    lyderių lentos, Gedimino pilies bokšto maketas, medžiai, gandrų lizdai, tvoros,
	    VIP šaltibarščių baseinas, vietos eventams.
	Jei Workspace jau yra modelis "Lobby" (pvz. pasidarei gražesnį), naujas nekuriamas,
	bet jame turi būti dalys: LobbySpawn, BigCepelinasSpot, Bonfire1, Bonfire2, FernSpot,
	RebirthHutDoor, VIPZone, VIPBarriers (Folder), LeaderboardTotal, LeaderboardRebirths.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Lighting = game:GetService("Lighting")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local Scenery = require(Lib:WaitForChild("Scenery"))

local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material
local MAP = Settings.Map

local LOBBY_Y = 1           -- lobby ir sklypų grindų aukštis
local WOOD = C(122, 82, 46)
local DARK_WOOD = C(78, 50, 26)
local STONE = C(128, 126, 120)
local LEAVES = C(60, 110, 45)

local MapBuilder = {}
MapBuilder.Anchors = {}

local placed = {}               -- užimtos vietos dekoracijoms: { pozicija, spindulys }

local function polar(angleDeg, radius, y)
	local a = math.rad(angleDeg)
	return V(math.cos(a) * radius, y or LOBBY_Y, math.sin(a) * radius)
end

-- Sklypo i kampas (laipsniais)
function MapBuilder:GetPlotAngle(index)
	return (index - 1) * (360 / Settings.PlotCount)
end

-- Sklypo CFrame: centras grindų paviršiuje, -Z (LookVector) į lobby
function MapBuilder:GetPlotCFrame(index)
	local position = polar(self:GetPlotAngle(index), MAP.PlotRingRadius, LOBBY_Y)
	return CFrame.lookAt(position, V(0, LOBBY_Y, 0))
end

----------------------------------------------------------------------
-- Dekoracijos
----------------------------------------------------------------------
local function tree(parent, position, scale)
	scale = scale or 1
	table.insert(placed, { V(position.X, 0, position.Z), 5 * scale })
	local model = Build.Model("Tree", parent)
	Build.Part({ Name = "Trunk", Parent = model, Size = V(1.6, 8, 1.6) * scale, CFrame = CF(position + V(0, 4 * scale, 0)), Color = DARK_WOOD, Material = M.Wood })
	Build.Part({ Name = "Leaves", Parent = model, Shape = Enum.PartType.Ball, Size = V(8, 8, 8) * scale, CFrame = CF(position + V(0, 9.5 * scale, 0)), Color = LEAVES, Material = M.Grass })
	Build.Part({ Name = "Leaves2", Parent = model, Shape = Enum.PartType.Ball, Size = V(5.5, 5.5, 5.5) * scale, CFrame = CF(position + V(1.5, 12 * scale, 1)), Color = C(70, 125, 50), Material = M.Grass })
end

local function storkNest(parent, position)
	table.insert(placed, { V(position.X, 0, position.Z), 3 })
	local model = Build.Model("StorkNest", parent)
	Build.Part({ Name = "Pole", Parent = model, Size = V(0.8, 14, 0.8), CFrame = CF(position + V(0, 7, 0)), Color = C(90, 75, 60), Material = M.Wood })
	Build.Part({ Name = "Nest", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(1.2, 4, 4), CFrame = CF(position + V(0, 14.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(120, 95, 60), Material = M.Grass })
	-- Gandras
	Build.Part({ Name = "StorkBody", Parent = model, Size = V(1.2, 1.2, 2), CFrame = CF(position + V(0, 15.8, 0)), Color = C(245, 245, 245), Material = M.SmoothPlastic })
	Build.Part({ Name = "StorkWing", Parent = model, Size = V(1.3, 0.5, 1.4), CFrame = CF(position + V(0, 16.2, -0.4)), Color = C(25, 25, 25), Material = M.SmoothPlastic })
	Build.Part({ Name = "StorkNeck", Parent = model, Size = V(0.4, 1.4, 0.4), CFrame = CF(position + V(0, 16.8, 0.9)), Color = C(245, 245, 245), Material = M.SmoothPlastic })
	Build.Part({ Name = "StorkBeak", Parent = model, Size = V(0.25, 0.25, 1.1), CFrame = CF(position + V(0, 17.4, 1.5)), Color = C(230, 80, 40), Material = M.SmoothPlastic })
end

local function fenceSegment(parent, a, b, baseY)
	baseY = baseY or LOBBY_Y
	local mid = (a + b) / 2
	local length = (b - a).Magnitude
	for _, y in ipairs({ 1.1, 2.3 }) do
		Build.Part({ Name = "Rail", Parent = parent, Size = V(0.35, 0.35, length), CFrame = CFrame.lookAt(V(mid.X, baseY + y, mid.Z), V(b.X, baseY + y, b.Z)), Color = WOOD, Material = M.Wood, CanQuery = false, CanTouch = false })
	end
	Build.Part({ Name = "Post", Parent = parent, Size = V(0.7, 3, 0.7), CFrame = CF(a.X, baseY + 1.5, a.Z), Color = DARK_WOOD, Material = M.Wood, CanQuery = false, CanTouch = false })
end

local function gediminasTower(parent, position)
	local model = Build.Model("GediminasTower", parent)
	local brick = C(160, 70, 50)
	Build.Part({ Name = "Hill", Parent = model, Shape = Enum.PartType.Ball, Size = V(14, 14, 14), CFrame = CF(position + V(0, -3, 0)), Color = C(90, 130, 60), Material = M.Grass })
	Build.Part({ Name = "Base", Parent = model, Size = V(6, 6, 6), CFrame = CF(position + V(0, 6, 0)), Color = brick, Material = M.Brick })
	Build.Part({ Name = "Mid", Parent = model, Size = V(5, 5, 5), CFrame = CF(position + V(0, 11.5, 0)), Color = brick, Material = M.Brick })
	Build.Part({ Name = "Top", Parent = model, Size = V(4.4, 2.4, 4.4), CFrame = CF(position + V(0, 15.2, 0)), Color = brick, Material = M.Brick })
	for _, dx in ipairs({ -1.6, 0, 1.6 }) do
		for _, dz in ipairs({ -1.6, 1.6 }) do
			Build.Part({ Name = "Crenel", Parent = model, Size = V(0.9, 0.9, 0.9), CFrame = CF(position + V(dx, 16.8, dz)), Color = brick, Material = M.Brick })
		end
	end
	Build.Part({ Name = "FlagPole", Parent = model, Size = V(0.25, 4, 0.25), CFrame = CF(position + V(0, 18.4, 0)), Color = C(80, 80, 80), Material = M.Metal })
	local stripes = { C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }
	for i, color in ipairs(stripes) do
		Build.Part({ Name = "Flag" .. i, Parent = model, Size = V(0.05, 0.5, 2.2), CFrame = CF(position + V(0, 20 - (i - 1) * 0.5, 1.2)), Color = color, Material = M.Fabric })
	end
end

local function rebirthHut(parent, position)
	local model = Build.Model("RebirthHut", parent)
	local center = CFrame.lookAt(position, V(0, position.Y, 0))
	local function at(x, y, z)
		return center * CF(x, y, z)
	end
	Build.Part({ Name = "Floor", Parent = model, Size = V(12, 0.6, 10), CFrame = at(0, 0.3, 0), Color = DARK_WOOD, Material = M.WoodPlanks })
	Build.Part({ Name = "BackWall", Parent = model, Size = V(12, 7, 0.8), CFrame = at(0, 4, 4.6), Color = WOOD, Material = M.Wood })
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "SideWall", Parent = model, Size = V(0.8, 7, 10), CFrame = at(side * 5.6, 4, 0), Color = WOOD, Material = M.Wood })
		Build.Part({ Name = "FrontWall", Parent = model, Size = V(3.8, 7, 0.8), CFrame = at(side * 4.1, 4, -4.6), Color = WOOD, Material = M.Wood })
		Build.Wedge({ Name = "Roof", Parent = model, Size = V(13, 4, 6), CFrame = at(0, 9.5, side * 2.9) * CFrame.Angles(0, side == 1 and math.rad(180) or 0, 0), Color = C(150, 50, 40), Material = M.WoodPlanks })
	end
	Build.Part({ Name = "Lintel", Parent = model, Size = V(4.4, 1.6, 0.8), CFrame = at(0, 6.7, -4.6), Color = WOOD, Material = M.Wood })
	Build.Part({ Name = "Chimney", Parent = model, Size = V(1.6, 4, 1.6), CFrame = at(3.5, 11, 2), Color = STONE, Material = M.Cobblestone })
	local smoke = Instance.new("Smoke")
	smoke.Opacity = 0.1
	smoke.RiseVelocity = 4
	smoke.Parent = model:FindFirstChild("Chimney")
	local window = Build.Part({ Name = "Window", Parent = model, Size = V(2, 2, 0.2), CFrame = at(0, 5, 4.1), Color = C(255, 210, 120), Material = M.Neon })
	window.Transparency = 0.2
	local door = Build.Part({ Name = "RebirthHutDoor", Parent = model, Size = V(3.6, 5.6, 0.4), CFrame = at(0, 3.4, -4.6), Color = C(100, 60, 30), Material = M.Wood, CanCollide = false, Transparency = 0.3 })
	Build.Sign(model:FindFirstChild("Lintel"), { Name = "HutSign", TextKey = "RebirthHut", Size = UDim2.fromScale(9, 2), Offset = V(0, 6, 0), MaxDistance = 120 })
	return door
end

local function leaderboard(parent, name, position)
	local model = Build.Model(name, parent)
	local cf = CFrame.lookAt(position, V(0, position.Y, 0))
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "Post", Parent = model, Size = V(1, 14, 1), CFrame = cf * CF(side * 7.5, 7, 0.6), Color = DARK_WOOD, Material = M.Wood })
	end
	local board = Build.Part({ Name = name, Parent = model, Size = V(14, 11, 0.6), CFrame = cf * CF(0, 8, 0), Color = C(232, 211, 162), Material = M.WoodPlanks })
	Build.Part({ Name = "Roof", Parent = model, Size = V(16, 0.8, 2.4), CFrame = cf * CF(0, 14.2, 0.3), Color = C(150, 50, 40), Material = M.WoodPlanks })
	return board
end

local function vipPool(parent, position)
	local model = Build.Model("VIPPool", parent)
	local size = 9                  -- mažas, kad netrukdytų vaikščioti po turgų
	Build.Part({ Name = "PoolFloor", Parent = model, Size = V(size, 0.4, size), CFrame = CF(position + V(0, 0.2, 0)), Color = STONE, Material = M.Slate })
	local water = Build.Part({ Name = "Saltibarsciai", Parent = model, Size = V(size - 2, 1, size - 2), CFrame = CF(position + V(0, 0.9, 0)), Color = C(255, 105, 180), Material = M.Glass, Transparency = 0.25, CanCollide = false })
	water.Reflectance = 0.1
	local barriers = Build.Folder("VIPBarriers", model)
	for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		local offset = V(d[1] * size / 2, 3, d[2] * size / 2)
		local wallSize = (d[1] ~= 0) and V(0.4, 6, size) or V(size, 6, 0.4)
		Build.Part({ Name = "Barrier", Parent = barriers, Size = wallSize, CFrame = CF(position + offset), Color = C(255, 150, 210), Material = M.ForceField, Transparency = 0.5 })
		local rimSize = (d[1] ~= 0) and V(1, 1.2, size + 1) or V(size + 1, 1.2, 1)
		Build.Part({ Name = "Rim", Parent = model, Size = rimSize, CFrame = CF(position + V(d[1] * size / 2, 0.6, d[2] * size / 2)), Color = C(235, 230, 215), Material = M.Marble })
	end
	local zone = Build.Part({ Name = "VIPZone", Parent = model, Size = V(size - 1, 6, size - 1), CFrame = CF(position + V(0, 3, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
	Build.Sign(water, { Name = "VIPSign", Text = "👑 VIP", Size = UDim2.fromScale(5, 1.6), Offset = V(0, 7, 0), MaxDistance = 100 })
	return zone, barriers
end

-- Kalvė (ginklų parduotuvė): grąžina CFrame, kurio -Z žiūri į turgaus centrą
local function smithy(parent, position)
	local model = Build.Model("WeaponShop", parent)
	local cf = CFrame.lookAt(position, V(0, position.Y, 0))
	local function at(x, y, z)
		return cf * CF(x, y, z)
	end
	local stoneC = C(110, 105, 100)
	Build.Part({ Name = "Floor", Parent = model, Size = V(14, 0.6, 9), CFrame = at(0, 0.3, 0), Color = C(120, 115, 108), Material = M.Slate })
	Build.Part({ Name = "BackWall", Parent = model, Size = V(14, 7, 1), CFrame = at(0, 3.8, 4), Color = stoneC, Material = M.Cobblestone })
	for _, x in ipairs({ -6.5, 6.5 }) do
		Build.Part({ Name = "Post", Parent = model, Size = V(0.8, 7, 0.8), CFrame = at(x, 3.8, -3.8), Color = DARK_WOOD, Material = M.Wood })
	end
	Build.Part({ Name = "Roof", Parent = model, Size = V(15, 0.6, 10), CFrame = at(0, 7.6, 0) * CFrame.Angles(math.rad(-8), 0, 0), Color = C(140, 55, 40), Material = M.WoodPlanks })
	-- Žaizdras su ugnimi
	local forge = Build.Part({ Name = "Forge", Parent = model, Size = V(3.4, 2.4, 2.4), CFrame = at(-4, 1.8, 2.4), Color = C(90, 85, 80), Material = M.Cobblestone })
	local coals = Build.Part({ Name = "Coals", Parent = model, Size = V(2.6, 0.3, 1.6), CFrame = at(-4, 3.1, 2.4), Color = C(255, 110, 30), Material = M.Neon })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Parent = coals
	local light = Instance.new("PointLight")
	light.Color = C(255, 140, 60)
	light.Range = 14
	light.Brightness = 1.5
	light.Parent = coals
	Build.Part({ Name = "Chimney", Parent = model, Size = V(1.6, 4, 1.6), CFrame = at(-4, 9, 3.4), Color = stoneC, Material = M.Cobblestone })
	-- Priekalas
	Build.Part({ Name = "AnvilBase", Parent = model, Size = V(1, 1.6, 1), CFrame = at(1, 1.4, 1.5), Color = C(70, 50, 30), Material = M.Wood })
	Build.Part({ Name = "Anvil", Parent = model, Size = V(2.4, 0.7, 1.1), CFrame = at(1, 2.55, 1.5), Color = C(55, 55, 60), Material = M.Metal })
	-- Lentyna su ginklų pavyzdžiais
	Build.Part({ Name = "Rack", Parent = model, Size = V(4.5, 0.3, 0.8), CFrame = at(4.5, 4.5, 3.3), Color = C(130, 88, 48), Material = M.WoodPlanks })
	Build.Part({ Name = "SampleSpoon", Parent = model, Size = V(0.25, 2.6, 0.25), CFrame = at(3.2, 3.2, 3.3), Color = C(205, 165, 105), Material = M.Wood })
	Build.Part({ Name = "SamplePin", Parent = model, Size = V(0.6, 3, 0.6), CFrame = at(4.5, 3.1, 3.3), Color = C(220, 185, 130), Material = M.Wood })
	Build.Part({ Name = "SamplePan", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.2, 2.2, 2.2), CFrame = at(5.9, 3.3, 3.3) * CFrame.Angles(0, math.rad(90), 0), Color = C(45, 45, 48), Material = M.Metal })
	local signPart = Build.Part({ Name = "SignBoard", Parent = model, Size = V(6, 1.4, 0.3), CFrame = at(0, 6.6, -4.3), Color = C(130, 88, 48), Material = M.WoodPlanks })
	Build.Sign(signPart, { Name = "ShopSign", TextKey = "WeaponShop", Size = UDim2.fromScale(10, 2.2), Offset = V(0, 2.2, 0), MaxDistance = 120 })
	return cf
end

local function fountain(parent)
	local model = Build.Model("Fountain", parent)
	Build.Part({ Name = "Basin", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2, 16, 16), CFrame = CF(0, LOBBY_Y + 1, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = STONE, Material = M.Cobblestone })
	Build.Part({ Name = "Water", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.4, 14, 14), CFrame = CF(0, LOBBY_Y + 2.05, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(80, 150, 210), Material = M.Glass, Transparency = 0.3, CanCollide = false })
	Build.Part({ Name = "Pedestal", Parent = model, Size = V(3, 5, 3), CFrame = CF(0, LOBBY_Y + 4.5, 0), Color = C(200, 195, 185), Material = M.Marble })
	local statue = Build.Part({ Name = "CepelinasStatue", Parent = model, Size = V(7, 4, 4), CFrame = CF(0, LOBBY_Y + 9, 0) * CFrame.Angles(0, math.rad(30), math.rad(10)), Color = C(215, 210, 200), Material = M.Marble })
	Build.Mesh(statue, Enum.MeshType.Sphere)
	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(C(170, 210, 255))
	spray.Size = NumberSequence.new(0.4, 0)
	spray.Lifetime = NumberRange.new(1, 1.5)
	spray.Rate = 25
	spray.Speed = NumberRange.new(8, 10)
	spray.SpreadAngle = Vector2.new(25, 25)
	spray.Acceleration = V(0, -18, 0)
	spray.Parent = model:FindFirstChild("Pedestal")
	Build.Sign(statue, { Name = "LobbySign", TextKey = "Lobby", Size = UDim2.fromScale(12, 2.6), Offset = V(0, 5, 0), MaxDistance = 200 })
end

local function marketStall(parent, position, color)
	local model = Build.Model("MarketStall", parent)
	local cf = CFrame.lookAt(position, V(0, position.Y, 0))
	Build.Part({ Name = "Counter", Parent = model, Size = V(6, 2.6, 2.4), CFrame = cf * CF(0, 1.3, 0), Color = WOOD, Material = M.WoodPlanks })
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "Post", Parent = model, Size = V(0.4, 6, 0.4), CFrame = cf * CF(side * 2.8, 3, 1), Color = DARK_WOOD, Material = M.Wood })
	end
	Build.Part({ Name = "Awning", Parent = model, Size = V(7, 0.3, 3.4), CFrame = cf * CF(0, 6.1, 0.4) * CFrame.Angles(math.rad(-12), 0, 0), Color = color, Material = M.Fabric })
	for i = -2, 2 do
		Build.Part({ Name = "Potato", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.9, 0.9, 0.9), CFrame = cf * CF(i * 1, 2.9, -0.3), Color = C(150, 105, 60), Material = M.Sand })
	end
end

----------------------------------------------------------------------
-- Statyba
----------------------------------------------------------------------
local function buildLobby(lobby)
	local R = MAP.LobbyRadius
	Build.Part({ Name = "Plaza", Parent = lobby, Shape = Enum.PartType.Cylinder, Size = V(1, R * 2, R * 2), CFrame = CF(0, LOBBY_Y - 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(150, 145, 135), Material = M.Cobblestone })

	fountain(lobby)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	-- Nematoma, plokščia, be kolizijos: žaidėjai atsiranda ant turgaus grindinio
	spawn.Size = V(8, 0.2, 8)
	spawn.CFrame = CF(0, LOBBY_Y + 0.1, 14)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.CanTouch = false
	spawn.CastShadow = false
	spawn.Parent = lobby

	-- Objektai tarp kelių (kampai 30 + 60k)
	local door = rebirthHut(lobby, polar(30, 32))
	local total = leaderboard(lobby, "LeaderboardTotal", polar(90, 38))
	gediminasTower(lobby, polar(150, 33))
	local vipZone, vipBarriers = vipPool(lobby, polar(210, 39))
	local rebirths = leaderboard(lobby, "LeaderboardRebirths", polar(270, 38))
	MapBuilder.Anchors.WeaponShopCFrame = smithy(lobby, polar(330, 34))
	marketStall(lobby, polar(150, 18), C(60, 120, 200))

	local spots = Build.Folder("EventSpots", lobby)
	local function spot(name, position)
		return Build.Part({ Name = name, Parent = spots, Size = V(1, 1, 1), CFrame = CF(position), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	end
	spot("BigCepelinasSpot", polar(260, 24))
	spot("Bonfire1", polar(0, 26))
	spot("Bonfire2", polar(180, 26))
	spot("FernSpot", polar(120, 24))
	spot("ChristmasSpot", polar(90, 27))

	-- Tvora aplink turgų (paliekant tarpus keliams)
	local fence = Build.Folder("Fence", lobby)
	local count = Settings.PlotCount
	for i = 1, count do
		local start = MapBuilder:GetPlotAngle(i) + 9
		local finish = MapBuilder:GetPlotAngle(i) + 360 / count - 9
		local stepCount = 6
		for s = 0, stepCount - 1 do
			local a = start + (finish - start) * s / stepCount
			local b = start + (finish - start) * (s + 1) / stepCount
			fenceSegment(fence, polar(a, R - 1), polar(b, R - 1))
		end
	end

	-- Medžiai ir gandrų lizdai
	local decor = Build.Folder("Decor", lobby)
	for i = 1, count do
		local mid = MapBuilder:GetPlotAngle(i) + 180 / count
		tree(decor, polar(mid - 12, R + 10, 0), 1.1)
		tree(decor, polar(mid + 14, R + 16, 0), 0.9)
		if i % 2 == 0 then
			storkNest(decor, polar(mid + 4, R + 4, 0))
		end
	end

	MapBuilder.Anchors.LobbySpawn = spawn
	MapBuilder.Anchors.RebirthHutDoor = door
	MapBuilder.Anchors.LeaderboardTotal = total
	MapBuilder.Anchors.LeaderboardRebirths = rebirths
	MapBuilder.Anchors.VIPZone = vipZone
	MapBuilder.Anchors.VIPBarriers = vipBarriers
end

local function findAnchors(lobby)
	local function find(name)
		return lobby:FindFirstChild(name, true)
	end
	MapBuilder.Anchors.LobbySpawn = MapBuilder.Anchors.LobbySpawn or find("LobbySpawn")
	MapBuilder.Anchors.RebirthHutDoor = MapBuilder.Anchors.RebirthHutDoor or find("RebirthHutDoor")
	MapBuilder.Anchors.LeaderboardTotal = MapBuilder.Anchors.LeaderboardTotal or find("LeaderboardTotal")
	MapBuilder.Anchors.LeaderboardRebirths = MapBuilder.Anchors.LeaderboardRebirths or find("LeaderboardRebirths")
	MapBuilder.Anchors.VIPZone = MapBuilder.Anchors.VIPZone or find("VIPZone")
	MapBuilder.Anchors.VIPBarriers = MapBuilder.Anchors.VIPBarriers or find("VIPBarriers")
	local function pos(name, fallback)
		local part = find(name)
		return part and part.Position or fallback
	end
	if not MapBuilder.Anchors.WeaponShopCFrame then
		local shop = find("WeaponShop")
		local floor = shop and shop:FindFirstChild("Floor")
		if floor then
			MapBuilder.Anchors.WeaponShopCFrame = CFrame.lookAt(floor.Position, V(0, floor.Position.Y, 0))
		end
	end
	MapBuilder.Anchors.BigCepelinasSpot = pos("BigCepelinasSpot", polar(260, 24))
	MapBuilder.Anchors.Bonfires = { pos("Bonfire1", polar(0, 26)), pos("Bonfire2", polar(180, 26)) }
	MapBuilder.Anchors.FernSpot = pos("FernSpot", polar(120, 24))
	MapBuilder.Anchors.ChristmasSpot = pos("ChristmasSpot", polar(90, 27))
end

function MapBuilder:GetLobbySpawnCFrame()
	local spawn = self.Anchors.LobbySpawn
	if spawn then
		return spawn.CFrame + V(0, 3, 0)
	end
	return CF(0, LOBBY_Y + 4, 14)
end

function MapBuilder:Init() end

----------------------------------------------------------------------
-- Apšvietimas ir atmosfera
----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.4
	Lighting.GlobalShadows = true
	Lighting.Ambient = C(95, 85, 75)
	Lighting.OutdoorAmbient = C(140, 135, 125)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local function ensure(className, props)
		local object = Lighting:FindFirstChildOfClass(className) or Instance.new(className)
		for key, value in pairs(props) do
			object[key] = value
		end
		object.Parent = Lighting
	end
	ensure("Atmosphere", { Density = 0.28, Offset = 0.15, Color = C(200, 215, 230), Decay = C(110, 115, 130), Glare = 0.15, Haze = 1.1 })
	ensure("BloomEffect", { Intensity = 0.35, Size = 24, Threshold = 1.7 })
	ensure("ColorCorrectionEffect", { Saturation = 0.15, Contrast = 0.07, Brightness = 0.02, TintColor = C(255, 248, 235) })
	ensure("SunRaysEffect", { Intensity = 0.05, Spread = 0.6 })
	pcall(function()
		local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Parent = workspace.Terrain
	end)
end

----------------------------------------------------------------------
-- Ar vieta laisva (ne sklype, ne lobby, ne ant kelio, ne ant kitos dekoracijos)
----------------------------------------------------------------------

local function isFree(position, radius)
	local flat = V(position.X, 0, position.Z)
	local distance = flat.Magnitude
	if distance < MAP.LobbyRadius + 4 + radius or distance > MAP.GroundSize / 2 - 8 then
		return false
	end
	local half = Settings.Layout.PlotSize / 2
	for i = 1, Settings.PlotCount do
		local lp = MapBuilder:GetPlotCFrame(i):PointToObjectSpace(V(position.X, LOBBY_Y, position.Z))
		if math.abs(lp.X) < half + 5 + radius and lp.Z > -half - 20 - radius and lp.Z < half + 5 + radius then
			return false
		end
		-- kelias iš lobby į sklypą
		local angle = math.rad(MapBuilder:GetPlotAngle(i))
		local dir = V(math.cos(angle), 0, math.sin(angle))
		local along = flat:Dot(dir)
		if along > 0 and along < MAP.PlotRingRadius then
			local across = (flat - dir * along).Magnitude
			if across < MAP.PathWidth / 2 + 3 + radius then
				return false
			end
		end
	end
	for _, other in ipairs(placed) do
		if (other[1] - flat).Magnitude < other[2] + radius then
			return false
		end
	end
	return true
end

-- Atsitiktinė laisva vieta miške (laumei): ne sklype, ne kelyje, ne ant medžio
function MapBuilder:RandomFreeSpot(rng, minR, maxR)
	rng = rng or Random.new()
	minR = minR or 70
	maxR = maxR or (MAP.GroundSize / 2 - 30)
	for _ = 1, 60 do
		local position = polar(rng:NextNumber() * 360, minR + rng:NextNumber() * (maxR - minR), 0)
		if isFree(position, 2.5) then
			return position
		end
	end
	return nil
end

local function reserve(position, radius)
	table.insert(placed, { V(position.X, 0, position.Z), radius })
end

local spotCounter = 0
local function findSpot(rng, radius, minR, maxR, tries)
	-- Kas 25 dekoracijas trumpa pauzė, kad serveris nestrigtų generuojant mišką
	spotCounter = spotCounter + 1
	if spotCounter % 25 == 0 then
		task.wait()
	end
	for _ = 1, tries or 40 do
		local angle = rng:NextNumber() * 360
		local r = minR + rng:NextNumber() * (maxR - minR)
		local position = polar(angle, r, 0)
		if isFree(position, radius) then
			reserve(position, radius)
			return position
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Žemė (Terrain žolė), keliai, tvenkinys
----------------------------------------------------------------------
local function buildGround(map, rng)
	local ok = pcall(function()
		local terrain = workspace.Terrain
		terrain:FillBlock(CF(0, -6, 0), V(MAP.GroundSize, 12, MAP.GroundSize), M.Grass)
		-- Žolės įvairovė
		for _ = 1, 40 do
			local p = polar(rng:NextNumber() * 360, 60 + rng:NextNumber() * (MAP.GroundSize / 2 - 80), -2)
			terrain:FillCylinder(CF(p), 4, 10 + rng:NextNumber() * 25, rng:NextNumber() < 0.6 and M.LeafyGrass or M.Ground)
		end
		pcall(function()
			terrain.Decoration = false -- žolės stiebeliai prasikiša pro sklypų grindis ir mygtukus
		end)
		terrain.WaterColor = C(60, 120, 150)
		terrain.WaterTransparency = 0.5
		terrain.WaterWaveSize = 0.1
	end)
	if not ok then
		Build.Part({ Name = "Ground", Parent = map, Size = V(MAP.GroundSize, 2, MAP.GroundSize), CFrame = CF(0, -1, 0), Color = MAP.GrassColor, Material = M.Grass })
	end

	-- Keliai iš lobby į sklypus, su tvorelėmis ir fakelais
	local fromR = MAP.LobbyRadius - 2
	local toR = MAP.PlotRingRadius - Settings.Layout.PlotSize / 2
	local pathDecor = Build.Folder("PathDecor", map)
	for i = 1, Settings.PlotCount do
		local angle = MapBuilder:GetPlotAngle(i)
		local a = polar(angle, fromR, 0.3)
		local b = polar(angle, toR, 0.3)
		Build.Part({ Name = "Path", Parent = map, Size = V(MAP.PathWidth, 0.6, (b - a).Magnitude), CFrame = CFrame.lookAt((a + b) / 2, b), Color = C(150, 120, 80), Material = M.Ground })
		-- Akmenukai kelio pakraščiuose
		for step = 0, 6 do
			local r = fromR + 6 + step * 9
			for _, side in ipairs({ -1, 1 }) do
				local p = polar(angle + side * math.deg((MAP.PathWidth / 2 + 0.8) / r), r, 0)
				Build.Part({ Name = "EdgeStone", Parent = pathDecor, Size = V(1.2, 0.6, 1), CFrame = CF(p + V(0, 0.3, 0)) * CFrame.Angles(0, rng:NextNumber() * 3, 0), Color = C(140, 135, 125), Material = M.Slate, CanQuery = false, CanTouch = false, CastShadow = false })
			end
		end
		-- Tvorelės ir fakelai
		local fenceStart, fenceEnd = fromR + 8, toR - 4
		for _, side in ipairs({ -1, 1 }) do
			local prev = nil
			for r = fenceStart, fenceEnd, 8 do
				local p = polar(angle + side * math.deg((MAP.PathWidth / 2 + 2.5) / r), r, 0)
				if prev then
					fenceSegment(pathDecor, V(prev.X, 0, prev.Z), V(p.X, 0, p.Z), 0)
				end
				prev = p
			end
			Scenery.Torch(pathDecor, polar(angle + side * math.deg((MAP.PathWidth / 2 + 2.5) / (toR - 6)), toR - 6, 0), 6)
		end
	end
end

local function buildPond(map, rng)
	local center = findSpot(rng, 28, 260, 340, 80)
	if not center then
		return nil
	end
	local radius = 20
	pcall(function()
		local terrain = workspace.Terrain
		terrain:FillCylinder(CF(center + V(0, -4, 0)), 8, radius, M.Air)
		terrain:FillCylinder(CF(center + V(0, -7.5, 0)), 3, radius + 2, M.Sand)
		terrain:FillCylinder(CF(center + V(0, -3.8, 0)), 5.4, radius, M.Water)
		terrain:FillCylinder(CF(center + V(0, -1.5, 0)), 3, radius + 3, M.Sand)
		terrain:FillCylinder(CF(center + V(0, -3.8, 0)), 5.4, radius, M.Water)
	end)
	local folder = Build.Folder("Pond", map)
	for i = 1, 7 do
		local angle = rng:NextNumber() * 6.28
		local r = rng:NextNumber() * (radius - 4)
		Build.Part({ Name = "LilyPad", Parent = folder, Shape = Enum.PartType.Cylinder, Size = V(0.15, 2.4, 2.4), CFrame = CF(center + V(math.cos(angle) * r, -1.15, math.sin(angle) * r)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(70, 150, 60), Material = M.Grass, CanCollide = false, CanQuery = false, CanTouch = false })
	end
	for i = 1, 12 do
		local angle = i * 30 + rng:NextNumber() * 10
		local p = center + V(math.cos(math.rad(angle)) * (radius + 3), 0, math.sin(math.rad(angle)) * (radius + 3))
		if i % 3 == 0 then
			Scenery.Rock(folder, p, rng, 1)
		else
			Scenery.Reeds(folder, p, rng)
		end
	end
	-- Medinis lieptas
	local dir = (V(0, 0, 0) - V(center.X, 0, center.Z)).Unit
	local start = center + dir * (radius + 2)
	local pierCF = CFrame.lookAt(start, start - dir)
	Build.Part({ Name = "Pier", Parent = folder, Size = V(3.5, 0.4, 12), CFrame = pierCF * CF(0, 0.3, -5), Color = C(140, 95, 55), Material = M.WoodPlanks })
	for _, x in ipairs({ -1.5, 1.5 }) do
		for _, z in ipairs({ -2, -6, -10 }) do
			Build.Part({ Name = "PierPost", Parent = folder, Size = V(0.5, 4, 0.5), CFrame = pierCF * CF(x, -1.5, z), Color = C(90, 62, 38), Material = M.Wood })
		end
	end
	return center
end

----------------------------------------------------------------------
-- Žemėlapio pakraščiai: kalvų žiedas, upelis, laukai (javai, linai, rapsai)
----------------------------------------------------------------------
local hillBalls = {}        -- { Center = Vector3, Radius = number }

-- Kalvų paviršiaus aukštis (x, z) – pagal sudėtus Terrain rutulius
local function hillHeight(x, z)
	local best = 0
	for _, ball in ipairs(hillBalls) do
		local dx, dz = x - ball.Center.X, z - ball.Center.Z
		local d2 = dx * dx + dz * dz
		local r2 = ball.Radius * ball.Radius
		if d2 < r2 then
			local h = ball.Center.Y + math.sqrt(r2 - d2)
			if h > best then
				best = h
			end
		end
	end
	return best
end

local function buildHills(rng)
	local E = MAP.Edges
	hillBalls = {}
	local seed = rng:NextNumber() * 100
	for row = 1, 2 do
		local baseR = row == 1 and E.HillInnerR or E.HillOuterR
		local step = row == 1 and 4 or 5
		for a = 0, 359, step do
			local n = math.noise(a * 0.05, row * 3.1, seed)
			local radius = (row == 1 and 38 or 60) + n * 18 + rng:NextNumber() * 10
			local r = baseR + n * 18 + rng:NextNumber() * 8
			local peak = (row == 1 and 0.42 or 0.62) * radius + n * 8
			local center = polar(a, r, peak - radius)
			table.insert(hillBalls, { Center = center, Radius = radius })
		end
	end
	pcall(function()
		local terrain = workspace.Terrain
		for i, ball in ipairs(hillBalls) do
			terrain:FillBall(ball.Center, ball.Radius, M.Grass)
			if i % 20 == 0 then
				task.wait()
			end
		end
		-- Pievų įvairovė ant šlaitų ir uolėtos viršūnės
		for i, ball in ipairs(hillBalls) do
			local top = ball.Center + V(0, ball.Radius, 0)
			if top.Y > E.RockyAbove then
				terrain:FillBall(top + V(0, -3, 0), 9 + rng:NextNumber() * 6, M.Rock)
			elseif i % 3 == 0 then
				terrain:FillBall(top + V(rng:NextNumber() * 20 - 10, -4, rng:NextNumber() * 20 - 10), 12, M.LeafyGrass)
			end
		end
	end)
end

local function populateHills(nature, rng)
	local E = MAP.Edges
	local placedHere = 0
	for k = 1, E.HillTrees * 3 do
		if placedHere >= E.HillTrees then
			break
		end
		local a = rng:NextNumber() * 360
		local r = E.HillInnerR - 30 + rng:NextNumber() * (E.HillOuterR - E.HillInnerR + 70)
		local p = polar(a, r, 0)
		local h = hillHeight(p.X, p.Z)
		if h > 2 and h < E.RockyAbove then
			Scenery.ForestTree(nature, V(p.X, h - 0.6, p.Z), rng, 1 + rng:NextNumber() * 0.8)
			placedHere = placedHere + 1
		end
		if k % 30 == 0 then
			task.wait()
		end
	end
	for k = 1, E.HillRocks do
		local a = rng:NextNumber() * 360
		local r = E.HillInnerR - 20 + rng:NextNumber() * (E.HillOuterR - E.HillInnerR + 50)
		local p = polar(a, r, 0)
		local h = hillHeight(p.X, p.Z)
		if h > 1 then
			Scenery.Rock(nature, V(p.X, h - 0.5, p.Z), rng, 1 + rng:NextNumber() * 1.5)
		end
		if k % 30 == 0 then
			task.wait()
		end
	end
	-- Vėjo malūnai ant kalvų viršūnių (matosi iš toli)
	for i = 0, E.HillWindmills - 1 do
		local a = 25 + i * (360 / E.HillWindmills)
		local bestP, bestH = nil, 0
		for t = 0, 8 do
			local p = polar(a + t * 1.5, E.HillInnerR + 10 + t * 6, 0)
			local h = hillHeight(p.X, p.Z)
			if h > bestH and h < E.RockyAbove + 6 then
				bestP, bestH = p, h
			end
		end
		if bestP then
			Scenery.Windmill(nature, V(bestP.X, bestH - 0.5, bestP.Z), -V(bestP.X, 0, bestP.Z).Unit)
		end
	end
end

-- Vingiuojantis upelis nuo kalvų iki tvenkinio
local function buildStream(map, rng, pondCenter)
	if not pondCenter then
		return
	end
	local E = MAP.Edges
	local outward = V(pondCenter.X, 0, pondCenter.Z).Unit
	local side = V(-outward.Z, 0, outward.X)
	local start = outward * (E.HillInnerR + 10)
	local finish = V(pondCenter.X, 0, pondCenter.Z) + outward * 16
	local length = (start - finish).Magnitude
	local steps = math.floor(length / 3)
	local folder = Build.Folder("Stream", map)
	pcall(function()
		local terrain = workspace.Terrain
		for i = 0, steps do
			local t = i / steps
			local p = finish:Lerp(start, t) + side * math.sin(t * math.pi * 3.2) * 18
			local width = 4.2 + math.sin(t * 7) * 0.8
			terrain:FillBall(V(p.X, -1.2, p.Z), width + 1.5, M.Air)
			terrain:FillBall(V(p.X, -6.2, p.Z), width + 1, M.Sand)
			terrain:FillBall(V(p.X, -4.6, p.Z), width, M.Water)
			reserve(p, width + 4)
			if i % 12 == 0 then
				task.wait()
			end
			-- Akmenukai ir švendrai pakrantėse
			if i % 9 == 4 then
				local bank = p + side * (width + 2.5) * (i % 2 == 0 and 1 or -1)
				Scenery.Reeds(folder, bank, rng)
			elseif i % 13 == 6 then
				Scenery.Rock(folder, p + side * (width + 2.2), rng, 0.6)
			end
		end
	end)
	-- Medinis tiltelis per upelio vidurį
	local t = 0.5
	local mid = finish:Lerp(start, t) + side * math.sin(t * math.pi * 3.2) * 18
	local dir = (finish:Lerp(start, t + 0.02) + side * math.sin((t + 0.02) * math.pi * 3.2) * 18 - mid).Unit
	local bridgeCF = CFrame.lookAt(mid, mid + V(-dir.Z, 0, dir.X))
	Build.Part({ Name = "Bridge", Parent = folder, Size = V(4, 0.5, 13), CFrame = bridgeCF * CF(0, 0.6, 0), Color = C(140, 95, 55), Material = M.WoodPlanks })
	for _, x in ipairs({ -2, 2 }) do
		Build.Part({ Name = "BridgeRail", Parent = folder, Size = V(0.3, 1, 13), CFrame = bridgeCF * CF(x, 1.35, 0), Color = C(110, 72, 40), Material = M.Wood })
	end
end

-- Laukai: javai, linai (mėlyni žiedai), rapsai (geltoni)
local FIELD_TYPES = {
	{ Name = "Wheat", Stem = C(215, 185, 95), Top = C(235, 205, 110), Height = 1.8 },
	{ Name = "Flax", Stem = C(110, 150, 75), Top = C(110, 140, 230), Height = 1.2 },
	{ Name = "Rapeseed", Stem = C(100, 145, 60), Top = C(250, 225, 40), Height = 1.5 },
}

local function buildField(parent, center, kind, rng)
	local model = Build.Model("Field_" .. kind.Name, parent)
	local cf = CFrame.lookAt(center, V(0, center.Y, 0))
	local w, d = 38, 26
	Build.Part({ Name = "Soil", Parent = model, Size = V(w + 2, 0.4, d + 2), CFrame = cf * CF(0, 0.2, 0), Color = C(105, 75, 45), Material = M.Ground, CanCollide = false })
	local rows = 10
	for i = 0, rows - 1 do
		local z = -d / 2 + 1.3 + i * (d - 2.6) / (rows - 1)
		Build.Part({ Name = "Row", Parent = model, Size = V(w, kind.Height, 1.5), CFrame = cf * CF(0, 0.4 + kind.Height / 2, z), Color = kind.Stem, Material = M.Grass, CanCollide = false, CastShadow = false })
		Build.Part({ Name = "RowTop", Parent = model, Size = V(w, 0.35, 1.7), CFrame = cf * CF(0, 0.4 + kind.Height + 0.1, z), Color = kind.Top, Material = M.Grass, CanCollide = false, CastShadow = false })
	end
	-- Tvorelė iš karčių aplink
	for _, x in ipairs({ -w / 2 - 1.5, w / 2 + 1.5 }) do
		Build.Part({ Name = "FenceRail", Parent = model, Size = V(0.3, 0.3, d + 3), CFrame = cf * CF(x, 1, 0), Color = C(120, 85, 50), Material = M.Wood })
	end
	if kind.Name == "Wheat" then
		-- Kaliausė ir šieno ritiniai
		local s = cf * CF(4, 0, 0)
		Build.Part({ Name = "ScarecrowPole", Parent = model, Size = V(0.35, 5, 0.35), CFrame = s * CF(0, 2.5, 0), Color = C(110, 75, 45), Material = M.Wood })
		Build.Part({ Name = "ScarecrowArms", Parent = model, Size = V(4, 0.3, 0.3), CFrame = s * CF(0, 3.8, 0), Color = C(110, 75, 45), Material = M.Wood })
		Build.Part({ Name = "ScarecrowShirt", Parent = model, Size = V(1.6, 1.6, 0.6), CFrame = s * CF(0, 3.4, 0), Color = C(180, 60, 50), Material = M.Fabric })
		Build.Part({ Name = "ScarecrowHead", Parent = model, Shape = Enum.PartType.Ball, Size = V(1, 1, 1), CFrame = s * CF(0, 4.8, 0), Color = C(220, 190, 120), Material = M.Fabric })
		Build.Part({ Name = "ScarecrowHat", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.2, 1.8, 1.8), CFrame = s * CF(0, 5.25, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(200, 170, 90), Material = M.Grass })
		for k = 1, 3 do
			Build.Part({ Name = "HayBale", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2.4, 2.6, 2.6), CFrame = cf * CF(-w / 2 - 5, 1.3, -8 + k * 4) * CFrame.Angles(0, math.rad(90), 0), Color = C(220, 190, 100), Material = M.Grass })
		end
	end
end

local function buildFields(map, rng)
	local E = MAP.Edges
	local folder = Build.Folder("Fields", map)
	for i = 1, E.Fields do
		local center = findSpot(rng, 26, E.FieldMinR, E.FieldMaxR, 60)
		if center then
			buildField(folder, center, FIELD_TYPES[(i - 1) % #FIELD_TYPES + 1], rng)
		end
	end
end

-- Žemės įvairovė: daugiau žolės atspalvių, sausos žolės ir dobilų lopų
local function groundVariety(rng)
	pcall(function()
		local terrain = workspace.Terrain
		terrain:SetMaterialColor(M.Grass, C(96, 142, 62))
		terrain:SetMaterialColor(M.LeafyGrass, C(82, 128, 52))
		terrain:SetMaterialColor(M.Ground, C(120, 95, 62))
		for i = 1, MAP.Edges.GroundPatches do
			local p = polar(rng:NextNumber() * 360, 60 + rng:NextNumber() * (MAP.Edges.HillInnerR - 80), -2)
			local roll = rng:NextNumber()
			local material = roll < 0.55 and M.LeafyGrass or (roll < 0.8 and M.Ground or M.Mud)
			if isFree(p, 2) then
				terrain:FillCylinder(CF(p), 4, 8 + rng:NextNumber() * 22, material)
			end
			if i % 40 == 0 then
				task.wait()
			end
		end
	end)
end

----------------------------------------------------------------------
-- Miškas ir kaimo detalės aplink
----------------------------------------------------------------------
local function populate(map, rng)
	local nature = Build.Folder("Nature", map)
	local half = MAP.GroundSize / 2

	-- Vėjo malūnai
	for _ = 1, 2 do
		local p = findSpot(rng, 14, 240, 320, 60)
		if p then
			Scenery.Windmill(nature, p, -V(p.X, 0, p.Z).Unit)
		end
	end
	-- Ūkio kampeliai: šieno kupetos ir vežimai
	for _ = 1, 4 do
		local p = findSpot(rng, 12, 230, 340, 40)
		if p then
			Scenery.Cart(nature, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber() * 6.28, 0))
			for k = 1, 3 do
				local hp = p + V(math.cos(k * 2.1) * 8, 0, math.sin(k * 2.1) * 8)
				Scenery.Haystack(nature, hp, rng)
			end
		end
	end
	-- Labai tankus miškas visur aplink (lengvesni medžiai – mažiau dalių); toliau – kalvos
	for _ = 1, MAP.ForestTrees do
		local p = findSpot(rng, 2.6, 250, MAP.Edges.HillInnerR - 25, 6)
		if p then
			Scenery.ForestTree(nature, p, rng, 1 + rng:NextNumber() * 0.9)
		end
	end
	-- Medžiai tarp sklypų ir prie kelių
	for _ = 1, MAP.MidTrees do
		local p = findSpot(rng, 3.5, MAP.LobbyRadius + 8, 270, 6)
		if p then
			Scenery.RandomTree(nature, p, rng)
		end
	end
	-- Krūmai, akmenys, gėlės, grybai
	for _ = 1, 110 do
		local p = findSpot(rng, 2, MAP.LobbyRadius + 6, half - 10, 5)
		if p then
			Scenery.Bush(nature, p, rng)
		end
	end
	for _ = 1, 50 do
		local p = findSpot(rng, 2.5, MAP.LobbyRadius + 6, half - 10, 5)
		if p then
			Scenery.Rock(nature, p, rng)
		end
	end
	for _ = 1, 70 do
		local p = findSpot(rng, 1.5, MAP.LobbyRadius + 4, half - 20, 5)
		if p then
			Scenery.Flowers(nature, p, rng)
		end
	end
	for _ = 1, 30 do
		local p = findSpot(rng, 0.8, 200, half - 10, 5)
		if p then
			Scenery.Mushroom(nature, p, rng)
		end
	end
end

----------------------------------------------------------------------
-- Papildomos lobby detalės
----------------------------------------------------------------------
local function decorateLobby(lobby, rng)
	local folder = Build.Folder("Details", lobby)
	local R = MAP.LobbyRadius
	-- Fakelai ir vėliavos aplink turgaus aikštę
	for i = 0, 11 do
		local angle = 15 + i * 30
		if i % 2 == 0 then
			Scenery.Torch(folder, polar(angle, R - 3, LOBBY_Y), 7)
		else
			Scenery.Banner(folder, polar(angle, R - 3, LOBBY_Y), 11)
		end
	end
	-- Suolai prie fontano
	for _, angle in ipairs({ 30, 150, 210, 330 }) do
		local p = polar(angle, 12.5, LOBBY_Y)
		Scenery.Bench(folder, CFrame.lookAt(p, V(0, LOBBY_Y, 0)) * CFrame.Angles(0, math.rad(180), 0))
	end
	-- Tvarkingai išdėstyti prekystaliai (po vieną tarp kelių) su statinėmis šalia
	marketStall(folder, polar(60, 20, LOBBY_Y), C(230, 180, 40))
	marketStall(folder, polar(240, 20, LOBBY_Y), C(60, 140, 70))
	for _, angle in ipairs({ 60, 150, 240 }) do
		Scenery.Barrel(folder, polar(angle + 12, 21, LOBBY_Y), rng)
	end
	-- Gėlių vazonai
	for _, angle in ipairs({ 0, 60, 120, 180, 240, 300 }) do
		local p = polar(angle, 9.5, LOBBY_Y)
		Build.Part({ Name = "Planter", Parent = folder, Size = V(2.2, 1.2, 2.2), CFrame = CF(p + V(0, 0.6, 0)), Color = C(150, 80, 50), Material = M.Brick, CanQuery = false, CanTouch = false })
		Scenery.Flowers(folder, p + V(0, 1.2, 0), rng, 4)
	end
end

function MapBuilder:Start()
	local rng = Random.new(1987)
	setupLighting()
	local map = workspace:FindFirstChild("Map")
	if not map then
		map = Build.Folder("Map", workspace)
		buildGround(map, rng)
	end

	local lobby = workspace:FindFirstChild("Lobby")
	if not lobby then
		lobby = Build.Model("Lobby", workspace)
		buildLobby(lobby)
		decorateLobby(lobby, rng)
	end
	findAnchors(lobby)

	if not map:FindFirstChild("Nature") then
		task.spawn(function()
			local pondCenter = buildPond(map, rng)
			buildStream(map, rng, pondCenter)
			buildFields(map, rng)
			groundVariety(rng)
			buildHills(rng)
			populate(map, rng)
			populateHills(map:FindFirstChild("Nature"), rng)
		end)
	end
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationService – gamepass'ai, developer products, badge'ai, offline pajamos, VIP zona.
	ID – Config/Monetization (kol 0, pirkti negalima; Studio testams – /givepass).

	ProcessReceipt: kiekvienas PurchaseId išsaugomas žaidėjo duomenyse, todėl produktas
	nepasikartoja ir nedingsta; PurchaseGranted grąžinamas tik po sėkmingo išsaugojimo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Monetization = require(Config:WaitForChild("Monetization"))
local Calc = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Calc"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MonetizationService = {}
local S
local passCache = {}             -- [player] = { DoubleMoney = true, ... }
local passReady = {}             -- [player] = true, kai patikrinta
local EMPTY = {}

----------------------------------------------------------------------
-- Gamepass'ai
----------------------------------------------------------------------
function MonetizationService:GetPasses(player)
	return passCache[player] or EMPTY
end

function MonetizationService:HasPass(player, name)
	return (passCache[player] or EMPTY)[name] == true
end

local function passNameById(id)
	for name, pass in pairs(Monetization.GamePasses) do
		if pass.Id ~= 0 and pass.Id == id then
			return name
		end
	end
	return nil
end

local function productNameById(id)
	for name, product in pairs(Monetization.Products) do
		if product.Id ~= 0 and product.Id == id then
			return name
		end
	end
	return nil
end

-- Pritaiko gamepass'ą iš karto (po pirkimo arba /givepass)
function MonetizationService:GrantPass(player, name)
	passCache[player] = passCache[player] or {}
	if passCache[player][name] then
		return
	end
	passCache[player][name] = true
	player:SetAttribute("Pass_" .. name, true)
	if name == "GrannyHelp" then
		S.GrannyService:BuildForPlayer(player)
		S.TycoonService:RefreshButtons(player)
	end
	S.TycoonService:UpdateIncome(player)
end

local function loadPasses(player)
	local cache = {}
	for name, pass in pairs(Monetization.GamePasses) do
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns then
				cache[name] = true
			elseif not ok then
				warn("[Monetization] Nepavyko patikrinti gamepass " .. name .. ": " .. tostring(owns))
			end
		end
	end
	-- Jei jau buvo suteikta (pvz. /givepass), neprarandam
	for name, value in pairs(passCache[player] or EMPTY) do
		cache[name] = value
	end
	passCache[player] = cache
	for name in pairs(Monetization.GamePasses) do
		player:SetAttribute("Pass_" .. name, cache[name] == true)
	end
	passReady[player] = true
end

----------------------------------------------------------------------
-- Badge'ai
----------------------------------------------------------------------
function MonetizationService:AwardBadge(player, key)
	local data = S.DataService:Get(player)
	if data then
		data.badges[key] = true
	end
	local id = Settings.Badges[key]
	if not id or id == 0 then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			BadgeService:AwardBadgeAsync(player.UserId, id)
		end)
		if not ok then
			warn("[Monetization] Badge klaida: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Developer products
----------------------------------------------------------------------
function MonetizationService:GrantProduct(player, name)
	local product = Monetization.Products[name]
	if not product then
		return false
	end
	local data = S.DataService:Get(player)
	if name == "SmallBag" or name == "BigBag" then
		local amount = math.max(product.MinReward, S.TycoonService:GetIncomePerSecond(player) * product.IncomeSeconds)
		S.DataService:AddMoney(player, amount, true)
	elseif name == "PotatoRain" then
		S.EventService:QueuePotatoRain()
	elseif name == "Boost3" then
		data.boostRemaining = data.boostRemaining + product.Duration
		player:SetAttribute("BoostRemaining", data.boostRemaining)
		S.TycoonService:UpdateIncome(player)
	end
	S.DataService:Notify(player, "PurchaseThanks", nil, { item = "Product_" .. name }, nil, "success")
	return true
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = S.DataService:Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)

	-- Jau apdorotas: tik užtikrinam, kad išsaugota
	if data.receipts[purchaseId] then
		if S.DataService:Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local name = productNameById(receipt.ProductId)
	if not name then
		warn("[Monetization] Nežinomas produktas: " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not MonetizationService:GrantProduct(player, name) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	data.receipts[purchaseId] = os.time()
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > Monetization.ReceiptHistory do
		local oldest = table.remove(data.receiptOrder, 1)
		data.receipts[oldest] = nil
	end

	if S.DataService:Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Išsaugoti nepavyko: Roblox pakartos, o PurchaseId jau pažymėtas – prizas nebus duotas antrą kartą
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

----------------------------------------------------------------------
-- Offline pajamos
----------------------------------------------------------------------
local function grantOffline(player, data, lastOnline)
	if not MonetizationService:HasPass(player, "OfflineIncome") or lastOnline <= 0 then
		return
	end
	local elapsed = math.min(os.time() - lastOnline, Settings.Offline.MaxSeconds)
	if elapsed < Settings.Offline.MinSeconds then
		return
	end
	local ctx = S.TycoonService:GetContext(player)
	ctx.eventDropMult = 1
	ctx.eventMoneyMult = 1
	ctx.boost = false
	local amount = Calc.GetIncomePerSecond(data, ctx) * elapsed * Settings.Offline.Share
	if amount > 0 then
		S.DataService:AddMoney(player, amount, true)
		Remotes.OpenWindow:FireClient(player, "Offline", amount)
	end
end

----------------------------------------------------------------------
-- VIP zona
----------------------------------------------------------------------
local function setupVipZone()
	local zone = S.MapBuilder.Anchors.VIPZone
	if not zone then
		return
	end
	zone.CanTouch = true
	zone.Touched:Connect(function(hit)
		local player = S.PlotService:GetPlayerFromHit(hit)
		if player and not MonetizationService:HasPass(player, "VIP") then
			local character = player.Character
			if character then
				character:PivotTo(S.MapBuilder:GetLobbySpawnCFrame())
				S.DataService:Notify(player, "VIPOnly", nil, nil, nil, "error")
			end
		end
	end)
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function MonetizationService:Init(services)
	S = services
end

function MonetizationService:Start()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local name = passNameById(passId)
		if name then
			self:GrantPass(player, name)
			S.DataService:Notify(player, "PurchaseThanks", nil, { item = "Pass_" .. name }, nil, "success")
		end
	end)

	S.DataService:OnPlayerLoaded(function(player, data)
		local lastOnline = data.lastOnline
		loadPasses(player)
		if player.Parent then
			S.TycoonService:UpdateIncome(player)
			if self:HasPass(player, "GrannyHelp") and S.PlotService:GetPlot(player) then
				S.GrannyService:BuildForPlayer(player)
				S.TycoonService:RefreshButtons(player)
			end
			grantOffline(player, data, lastOnline)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		task.defer(function()
			passCache[player] = nil
			passReady[player] = nil
		end)
	end)

	setupVipZone()
end

return MonetizationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[--[[
	PlotService – sklypų sukūrimas, priskyrimas (Claim), valymas ir zonų išvaizda.
	Vienas žaidėjas – vienas sklypas. Išėjus sklypas išvalomas ir atlaisvinamas.
	Grįžusiam žaidėjui (jau turinčiam progreso) sklypas priskiriamas automatiškai.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local ProductLines = require(Config:WaitForChild("ProductLines"))
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local GateModels = require(Lib:WaitForChild("GateModels"))
local ZoneThemes = require(Lib:WaitForChild("ZoneThemes"))
local RateLimit = require(Lib:WaitForChild("RateLimit"))

local L = Settings.Layout
local CF = CFrame.new

local PlotService = {}
PlotService.Plots = {}          -- [index] = plot įrašas
PlotService.ByPlayer = {}       -- [player] = plot įrašas

local S
local claimDebounce = RateLimit.debounce(1)
local pendingClaims = {}        -- [player] = plot (paspausta, kol dar kraunasi duomenys)

----------------------------------------------------------------------
-- Pagalbinės
----------------------------------------------------------------------
function PlotService:GetLaneX(lineId)
	return L.FirstLaneX - (ProductLines.Lines[lineId].Index - 1) * L.LaneSpacing
end

-- Linijos centro CFrame zonos paviršiuje (Z – sklypo lokali ašis)
function PlotService:GetLaneCFrame(plot, lineId)
	return plot.CFrame * CF(self:GetLaneX(lineId), L.ZoneTopY, 0)
end

function PlotService:GetPlot(player)
	return self.ByPlayer[player]
end

function PlotService:GetPlayerFromHit(hit)
	local character = hit and hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return Players:GetPlayerFromCharacter(character)
end

function PlotService:GetSpawnCFrame(plot)
	return plot.CFrame * CF(0, 3, L.SpawnZ) * CFrame.Angles(0, math.rad(180), 0)
end

function PlotService:TeleportToPlot(player)
	local plot = self.ByPlayer[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if plot and root then
		character:PivotTo(self:GetSpawnCFrame(plot))
	end
end

----------------------------------------------------------------------
-- Išvaizda
----------------------------------------------------------------------
function PlotService:SetOwnerSign(plot)
	local beam = plot.Model:FindFirstChild("GateBeam")
	local sign = beam and beam:FindFirstChild("OwnerSign")
	local label = sign and sign:FindFirstChild("Text", true)
	if not label then
		return
	end
	if plot.Owner then
		label:SetAttribute("TextKey", "PlotOf")
		label:SetAttribute("Arg_name", plot.Owner.DisplayName)
	else
		label:SetAttribute("TextKey", "FreePlot")
		label:SetAttribute("Arg_name", nil)
	end
	local claimPad = plot.Model:FindFirstChild("ClaimPad")
	if claimPad then
		claimPad.Transparency = plot.Owner and 1 or 0
		claimPad.CanCollide = plot.Owner == nil
		local claimLabel = claimPad:FindFirstChild("ClaimLabel")
		if claimLabel then
			claimLabel.Enabled = plot.Owner == nil
		end
		local prompt = claimPad:FindFirstChild("ClaimPrompt")
		if prompt then
			prompt.Enabled = plot.Owner == nil
		end
	end
end

function PlotService:ApplySkin(plot, skinName)
	local skin = Settings.Skins[skinName] or Settings.Skins.Default
	local floor = plot.Model:FindFirstChild("Floor")
	if floor then
		floor.Color = skin.Floor
		floor.Material = skin.FloorMaterial
	end
	local fence = plot.Model:FindFirstChild("Fence")
	if fence then
		for _, part in ipairs(fence:GetChildren()) do
			if part:IsA("BasePart") then
				part.Color = skin.Fence
				part.Material = skin.FenceMaterial
			end
		end
	end
end

-- Zona: užrakinta (pusiau permatoma su užrašu) arba atrakinta (temos spalvos + dekoracijos)
function PlotService:SetZoneUnlocked(plot, lineId, unlocked)
	local line = ProductLines.Lines[lineId]
	local zones = plot.Model:FindFirstChild("Zones")
	local zone = zones and zones:FindFirstChild("Zone_" .. lineId)
	local decorFolder = plot.Decor:FindFirstChild(lineId)
	if decorFolder then
		decorFolder:Destroy()
	end
	if zone then
		local oldSign = zone:FindFirstChild("LockedSign")
		if oldSign then
			oldSign:Destroy()
		end
		if unlocked then
			zone.Transparency = 0
			zone.Color = line.Theme.Floor
			zone.Material = line.Theme.FloorMaterial
		else
			zone.Transparency = 0.6
			zone.Color = Color3.fromRGB(200, 200, 200)
			zone.Material = Enum.Material.SmoothPlastic
			if line.UnlockedBy then
				Build.Sign(zone, { Name = "LockedSign", TextKey = "ZoneLocked", Keys = { item = line.UnlockedBy }, Size = UDim2.fromScale(14, 3), Offset = Vector3.new(0, 5, 0), MaxDistance = 150 })
			end
		end
	end
	if unlocked then
		local folder = Build.Folder(lineId, plot.Decor)
		ZoneThemes.Build(lineId, folder, self:GetLaneCFrame(plot, lineId))
	end
end

-- Vartų išvaizda pagal lygį (0 – rąstai, 1 – dailidės, 2 – plytos)
function PlotService:ApplyGate(plot, level)
	level = level or 0
	if plot.GateLevel == level and plot.Model:FindFirstChild("Gate") then
		return
	end
	plot.GateLevel = level
	local old = plot.Model:FindFirstChild("Gate")
	if old then
		old:Destroy()
	end
	local folder = Build.Folder("Gate", plot.Model)
	GateModels.Build(folder, plot.CFrame, level, L.GateWidth / 2 + 2, L.GateZ, L.GateWidth)
end

-- Išvalo viską, kas pastatyta (mašinos, mygtukai, dekoracijos, žaliavos)
function PlotService:ClearPlot(plot)
	for _, folder in ipairs({ plot.Machines, plot.Buttons, plot.Decor, plot.Items }) do
		folder:ClearAllChildren()
	end
	for _, lineId in ipairs(ProductLines.Order) do
		self:SetZoneUnlocked(plot, lineId, false)
	end
	self:ApplySkin(plot, "Default")
	self:ApplyGate(plot, 0)
end

----------------------------------------------------------------------
-- Claim / Release
----------------------------------------------------------------------
function PlotService:Claim(player, plot)
	local data = S.DataService:Get(player)
	if not data then
		S.DataService:Notify(player, "DataNotLoaded")
		return false
	end
	if self.ByPlayer[player] then
		if self.ByPlayer[player] ~= plot then
			S.DataService:Notify(player, "AlreadyHavePlot", nil, nil, nil, "error")
		end
		return false
	end
	if plot.Owner then
		S.DataService:Notify(player, "PlotTaken", nil, nil, nil, "error")
		return false
	end
	plot.Owner = player
	plot.Model:SetAttribute("OwnerId", player.UserId)
	self.ByPlayer[player] = plot
	player:SetAttribute("PlotIndex", plot.Index)
	self:SetOwnerSign(plot)
	local ok, err = xpcall(function()
		S.TycoonService:BuildPlot(player, false)
	end, debug.traceback)
	if not ok then
		warn("[PlotService] Klaida statant gamyklą: " .. tostring(err))
	end
	S.DataService:Notify(player, "PlotClaimed", nil, nil, nil, "success")
	return true
end

-- Žaidėjas užlipo ant Claim mygtuko / paspaudė „E“
function PlotService:TryClaim(player, plot)
	if not claimDebounce:Check(player) then
		return
	end
	-- Jau turi sklypą: kitų sklypų Claim mygtukai jam paslėpti ir neveikia
	if self.ByPlayer[player] then
		return
	end
	if plot.Owner then
		S.DataService:Notify(player, "PlotTaken", nil, nil, nil, "error")
		return
	end
	if not S.DataService:Get(player) then
		-- Duomenys dar kraunasi: sklypas bus priskirtas, kai tik įsikels
		pendingClaims[player] = plot
		return
	end
	self:Claim(player, plot)
end

function PlotService:ClaimFirstFree(player)
	for _, plot in ipairs(self.Plots) do
		if not plot.Owner then
			return self:Claim(player, plot)
		end
	end
	return false
end

function PlotService:Release(player)
	local plot = self.ByPlayer[player]
	if not plot then
		return
	end
	S.TycoonService:StopPlayer(player)
	self.ByPlayer[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerId", 0)
	self:ClearPlot(plot)
	self:SetOwnerSign(plot)
	if player.Parent then
		player:SetAttribute("PlotIndex", 0)
	end
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function PlotService:Init(services)
	S = services
end

function PlotService:Start()
	local container = workspace:FindFirstChild("Plots") or Build.Folder("Plots", workspace)
	for index = 1, Settings.PlotCount do
		local model = S.TemplateBuilder:ClonePlot()
		model.Name = "Plot_" .. index
		local cframe = S.MapBuilder:GetPlotCFrame(index)
		model:PivotTo(cframe)
		model:SetAttribute("Index", index)
		model:SetAttribute("OwnerId", 0)
		local plot = {
			Index = index,
			Model = model,
			CFrame = cframe,
			Owner = nil,
			Machines = Build.Folder("Machines", model),
			Buttons = Build.Folder("Buttons", model),
			Decor = Build.Folder("Decor", model),
			Items = Build.Folder("Items", model),
		}
		model.Parent = container
		self.Plots[index] = plot
		self:ClearPlot(plot)
		self:SetOwnerSign(plot)

		local function onTouched(hit)
			local player = self:GetPlayerFromHit(hit)
			if player then
				self:TryClaim(player, plot)
			end
		end
		for _, name in ipairs({ "ClaimPad", "ClaimZone" }) do
			local part = model:FindFirstChild(name)
			if part then
				part.Touched:Connect(onTouched)
			end
		end
		local pad = model:FindFirstChild("ClaimPad")
		local prompt = pad and pad:FindFirstChild("ClaimPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				self:TryClaim(player, plot)
			end)
		end
	end

	-- Grįžęs žaidėjas su progresu gauna sklypą automatiškai
	S.DataService:OnPlayerLoaded(function(player, data)
		local pending = pendingClaims[player]
		pendingClaims[player] = nil
		if pending and not pending.Owner and not self.ByPlayer[player] then
			self:Claim(player, pending)
			return
		end
		if data.tutorialDone or next(data.purchases) ~= nil or data.rebirths > 0 then
			if self:ClaimFirstFree(player) then
				local function teleport()
					task.wait(0.5)
					self:TeleportToPlot(player)
				end
				if player.Character then
					task.spawn(teleport)
				else
					local connection
					connection = player.CharacterAdded:Connect(function()
						connection:Disconnect()
						teleport()
					end)
				end
			end
		end
	end)

	-- Claim pagal žaidėjo poziciją (nepriklauso nuo fizikos Touched įvykių)
	task.spawn(function()
		while true do
			task.wait(Settings.ButtonCheckRate)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and not self.ByPlayer[player] then
					for _, plot in ipairs(self.Plots) do
						local pad = plot.Model:FindFirstChild("ClaimPad")
						if pad and not plot.Owner then
							local offset = root.Position - pad.Position
							if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 4.5 and offset.Y > -2 and offset.Y < 8 then
								self:TryClaim(player, plot)
							end
						end
					end
				end
			end
		end
	end)

	S.DataService:OnPlayerRemoving(function(player)
		self:Release(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		pendingClaims[player] = nil
	end)
end

return PlotService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">QuizService</string><ProtectedString name="Source"><![CDATA[--[[
	QuizService – „Viktorina apie Lietuvą“: kas kelias minutes visiems iššoka klausimas.
	Teisingai atsakęs gauna litų. Atsakymai tikrinami TIK serveryje (klientas teisingo
	atsakymo nežino), kiekvienas gali atsakyti tik vieną kartą.
	Klausimai – ServerScriptService/Lib/QuizQuestions, nustatymai – Settings.Quiz.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Questions = require(Lib:WaitForChild("QuizQuestions"))
local RateLimit = require(Lib:WaitForChild("RateLimit"))

local Q = Settings.Quiz

local QuizService = {}
local S
local current = nil               -- { Id, Index, Order, EndsAt, Answered }
local quizCounter = 0
local lastIndex = nil
local random = Random.new()
local limiter = RateLimit.new(Settings.RemoteRateLimit)

local function shuffledOrder()
	local order = { 1, 2, 3, 4 }
	for i = #order, 2, -1 do
		local j = random:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	return order
end

local function payloadFor(player)
	local lang = S.DataService:GetLang(player)
	local q = Questions[current.Index][lang] or Questions[current.Index].en
	local answers = {}
	for i, original in ipairs(current.Order) do
		answers[i] = q[original + 1]
	end
	return { Id = current.Id, Question = q[1], Answers = answers, EndsAt = current.EndsAt }
end

local function correctText(player)
	local lang = S.DataService:GetLang(player)
	local q = Questions[current.Index][lang] or Questions[current.Index].en
	return q[2]
end

function QuizService:IsActive()
	return current ~= nil
end

function QuizService:StartQuiz(index)
	if current or #Questions == 0 then
		return false
	end
	if not index then
		repeat
			index = random:NextInteger(1, #Questions)
		until index ~= lastIndex or #Questions == 1
	end
	lastIndex = index
	quizCounter = quizCounter + 1
	current = {
		Id = quizCounter,
		Index = index,
		Order = shuffledOrder(),
		EndsAt = workspace:GetServerTimeNow() + Q.Duration,
		Answered = {},
	}
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService:Get(player) then
			Remotes.QuizStart:FireClient(player, payloadFor(player))
		end
	end
	local quiz = current
	task.delay(Q.Duration + 0.5, function()
		if current ~= quiz then
			return
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if S.DataService:Get(player) and not quiz.Answered[player] then
				Remotes.QuizResult:FireClient(player, quiz.Id, nil, 0, correctText(player))
			end
		end
		current = nil
	end)
	return true
end

function QuizService:Answer(player, quizId, choice)
	if not current or quizId ~= current.Id or current.Answered[player] then
		return
	end
	if type(choice) ~= "number" or choice < 1 or choice > 4 or choice ~= math.floor(choice) then
		return
	end
	if workspace:GetServerTimeNow() > current.EndsAt + 1 then
		return
	end
	current.Answered[player] = true
	local correct = current.Order[choice] == 1
	local reward = 0
	if correct then
		reward = math.max(Q.MinReward, S.TycoonService:GetIncomePerSecond(player) * Q.RewardSeconds)
		S.DataService:AddMoney(player, reward, true)
	end
	Remotes.QuizResult:FireClient(player, current.Id, correct, reward, correctText(player))
end

function QuizService:Init(services)
	S = services
end

function QuizService:Start()
	Remotes.QuizAnswer.OnServerEvent:Connect(function(player, quizId, choice)
		if limiter:Check(player) then
			self:Answer(player, quizId, choice)
		end
	end)
	task.spawn(function()
		task.wait(random:NextNumber(Q.FirstDelay[1], Q.FirstDelay[2]))
		while true do
			self:StartQuiz()
			task.wait(random:NextNumber(Q.MinGap, Q.MaxGap))
		end
	end)
end

return QuizService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">RadioService</string><ProtectedString name="Source"><![CDATA[--[[
	RadioService – radijas „Magė“ turgaus aikštėje.
	Savininkas (ir Settings.AdminUserIds) valdo nemokamai; kiti žaidėjai gali radiją nusipirkti
	už Settings.Radio.Price litų (pirkinys lieka visam laikui, ir po rebirth).
	Prie radijo paspaudi E ir įvedi muzikos kodą (ID) iš Creator Store → Audio. Muzika groja VISIEMS serveryje vietoj fono muzikos, kol
	ją sustabdai. Žaidėjai, kurie nustatymuose išjungė muziką, radijo negirdi.

	Būsena replikuojama ReplicatedStorage atributais:
	  RadioId        – "rbxassetid://123..." arba "" (radijas tyli)
	  RadioName      – dainos pavadinimas
	  RadioStartedAt – serverio laikas, kada pradėta (vėliau prisijungę girdi tą pačią vietą)
	  RadioVolume    – garsumas 0.1–1

	Komandos pokalbyje (tik savininkui): /mage 1234567890, /mage stop, /mage volume 0.5
	Neseniai grotos dainos išsaugomos žaidėjo duomenyse (data.radio.recent), pirkinys – data.radio.owned.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local RateLimit = require(Lib:WaitForChild("RateLimit"))

local R = Settings.Radio
local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local RadioService = {}
local S
local limiter = RateLimit.new(4)
local radioModel = nil

----------------------------------------------------------------------
-- Kas gali valdyti radiją
----------------------------------------------------------------------
function RadioService:CanUse(player)
	if S.AdminService ~= nil and S.AdminService:IsAdmin(player) then
		return true
	end
	local data = S.DataService:Get(player)
	return data ~= nil and data.radio ~= nil and data.radio.owned == true
end

-- Nusipirkti radiją už litus. Grąžina true, jei dabar gali naudoti.
function RadioService:Purchase(player)
	if self:CanUse(player) then
		return true
	end
	local data = S.DataService:Get(player)
	if not data then
		return false
	end
	if not S.DataService:SpendMoney(player, R.Price) then
		Remotes.Notify:FireClient(player, "RadioTooExpensive", {}, {}, { price = R.Price }, "error")
		return false
	end
	data.radio = data.radio or { recent = {} }
	data.radio.owned = true
	player:SetAttribute("CanUseRadio", true)
	Remotes.Notify:FireClient(player, "RadioBought", {}, {}, {}, "success")
	return true
end

----------------------------------------------------------------------
-- Radijo modelis
----------------------------------------------------------------------
local function buildRadio(parent, position)
	local model = Build.Model("MageRadio", parent)
	local cf = CFrame.lookAt(position, V(0, position.Y, 0))
	local wood = C(105, 62, 32)
	local darkWood = C(70, 40, 20)
	-- Staliukas
	Build.Part({ Name = "Table", Parent = model, Size = V(5, 0.4, 3), CFrame = cf * CF(0, 2.6, 0), Color = darkWood, Material = M.WoodPlanks })
	for _, x in ipairs({ -2.1, 2.1 }) do
		for _, z in ipairs({ -1.1, 1.1 }) do
			Build.Part({ Name = "Leg", Parent = model, Size = V(0.35, 2.4, 0.35), CFrame = cf * CF(x, 1.2, z), Color = darkWood, Material = M.Wood })
		end
	end
	-- Korpusas (senovinis medinis radijas)
	local body = Build.Part({ Name = "Body", Parent = model, Size = V(4, 2.8, 2), CFrame = cf * CF(0, 4.2, 0), Color = wood, Material = M.Wood })
	Build.Part({ Name = "Top", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2, 2.4, 4), CFrame = cf * CF(0, 5.6, 0) * CFrame.Angles(0, math.rad(90), 0), Color = wood, Material = M.Wood })
	-- Garsiakalbio audinys ir lietuviška trispalvė juostelė
	Build.Part({ Name = "Grille", Parent = model, Size = V(2.2, 1.9, 0.16), CFrame = cf * CF(-0.65, 4.4, -1.06), Color = C(225, 200, 150), Material = M.Fabric })
	for i, color in ipairs({ C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }) do
		Build.Part({ Name = "Stripe", Parent = model, Size = V(3.6, 0.2, 0.12), CFrame = cf * CF(0, 3.25 - (i - 1) * 0.2, -1.06), Color = color, Material = M.SmoothPlastic })
	end
	-- Skalė (šviečia, kai groja) ir rankenėlės
	local dial = Build.Part({ Name = "Dial", Parent = model, Size = V(1.2, 0.6, 0.16), CFrame = cf * CF(1.2, 4.9, -1.06), Color = C(255, 190, 90), Material = M.SmoothPlastic })
	for _, y in ipairs({ 4.25, 3.7 }) do
		Build.Part({ Name = "Knob", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.3, 0.5, 0.5), CFrame = cf * CF(1.2, y, -1.15) * CFrame.Angles(0, math.rad(90), 0), Color = C(230, 190, 90), Material = M.Metal })
	end
	-- Antena
	Build.Part({ Name = "Antenna", Parent = model, Size = V(0.1, 2.6, 0.1), CFrame = cf * CF(1.3, 6.9, 0.4) * CFrame.Angles(0, 0, math.rad(-20)), Color = C(190, 190, 195), Material = M.Metal })
	Build.Part({ Name = "AntennaTip", Parent = model, Shape = Enum.PartType.Ball, Size = V(0.25, 0.25, 0.25), CFrame = cf * CF(1.75, 8.1, 0.4), Color = C(190, 190, 195), Material = M.Metal })
	model.PrimaryPart = body

	-- Užrašas virš radijo: pavadinimas ir kas dabar groja
	local _, title = Build.Billboard(body, { Name = "Title", Size = UDim2.fromScale(7, 1.5), Offset = V(0, 4.2, 0), Text = "📻 " .. R.Name, MaxDistance = 80 })
	title.TextColor3 = C(255, 225, 120)
	local _, now = Build.Billboard(body, { Name = "NowPlaying", Size = UDim2.fromScale(9, 1), Offset = V(0, 2.9, 0), Text = "", MaxDistance = 60, Font = Enum.Font.Merriweather })

	-- Natos, kai groja
	local notes = Instance.new("ParticleEmitter")
	notes.Name = "Notes"
	notes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	notes.Color = ColorSequence.new(C(255, 220, 120), C(255, 150, 200))
	notes.Size = NumberSequence.new(0.35)
	notes.Lifetime = NumberRange.new(1.2, 2)
	notes.Speed = NumberRange.new(1.5, 2.5)
	notes.SpreadAngle = Vector2.new(35, 35)
	notes.EmissionDirection = Enum.NormalId.Top
	notes.Rate = 6
	notes.Enabled = false
	notes.Parent = body

	-- E: savininkui – atidaro valdymą, kitiems – nupirkti (tekstą klientas pakeičia pagal CanUseRadio)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RadioPrompt"
	prompt.ActionText = R.Name
	prompt.ObjectText = "📻"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = body

	return model, dial, now, notes, prompt
end

local dialPart, nowLabel, notesEmitter

local function refreshModel()
	local playing = (ReplicatedStorage:GetAttribute("RadioId") or "") ~= ""
	if dialPart then
		dialPart.Material = playing and M.Neon or M.SmoothPlastic
	end
	if notesEmitter then
		notesEmitter.Enabled = playing
	end
	if nowLabel then
		nowLabel.Text = playing and ("♪ " .. (ReplicatedStorage:GetAttribute("RadioName") or "")) or ""
	end
end

----------------------------------------------------------------------
-- Valdymas
----------------------------------------------------------------------
local function recentList(player)
	local data = S.DataService:Get(player)
	if not data then
		return {}
	end
	data.radio = data.radio or {}
	data.radio.recent = data.radio.recent or {}
	return data.radio.recent
end

local function remember(player, id, name)
	local list = recentList(player)
	for i = #list, 1, -1 do
		if list[i].id == id then
			table.remove(list, i)
		end
	end
	table.insert(list, 1, { id = id, name = name })
	while #list > R.MaxRecent do
		table.remove(list)
	end
end

-- Iš teksto ištraukia ID: tinka "123", "rbxassetid://123" ar nuoroda su skaičiumi
function RadioService.ParseId(text)
	local digits = string.match(tostring(text or ""), "(%d+)")
	if not digits or #digits < 4 or #digits > 20 then
		return nil
	end
	return digits
end

function RadioService:Play(player, text)
	local digits = RadioService.ParseId(text)
	if not digits then
		return false, "RadioBadId"
	end
	local name = "#" .. digits
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfoAsync(tonumber(digits), Enum.InfoType.Asset)
	end)
	if ok and type(info) == "table" then
		if info.AssetTypeId and info.AssetTypeId ~= 3 then
			return false, "RadioNotAudio"
		end
		if type(info.Name) == "string" and info.Name ~= "" then
			name = string.sub(info.Name, 1, 60)
		end
	end
	ReplicatedStorage:SetAttribute("RadioName", name)
	ReplicatedStorage:SetAttribute("RadioStartedAt", workspace:GetServerTimeNow())
	ReplicatedStorage:SetAttribute("RadioId", "rbxassetid://" .. digits)
	refreshModel()
	if player then
		remember(player, digits, name)
	end
	return true, name
end

function RadioService:Stop()
	ReplicatedStorage:SetAttribute("RadioId", "")
	ReplicatedStorage:SetAttribute("RadioName", "")
	refreshModel()
end

function RadioService:SetVolume(volume)
	volume = math.clamp(tonumber(volume) or R.Volume, 0.1, 1)
	volume = math.floor(volume * 10 + 0.5) / 10
	ReplicatedStorage:SetAttribute("RadioVolume", volume)
	return volume
end

-- Klientas → serveris (RemoteFunction RadioControl)
local function onControl(player, action, value)
	if not limiter:Check(player) then
		return { ok = false, err = "RadioSlow" }
	end
	if not RadioService:CanUse(player) then
		return { ok = false, err = "RadioNotAllowed" }
	end
	local result = { ok = true }
	if action == "play" then
		local ok, nameOrErr = RadioService:Play(player, value)
		result.ok = ok
		if ok then
			result.name = nameOrErr
		else
			result.err = nameOrErr
		end
	elseif action == "stop" then
		RadioService:Stop()
	elseif action == "volume" then
		local current = ReplicatedStorage:GetAttribute("RadioVolume") or R.Volume
		local delta = tonumber(value) or 0
		result.volume = RadioService:SetVolume(current + math.clamp(delta, -0.5, 0.5))
	elseif action ~= "open" then
		return { ok = false }
	end
	local recent = {}
	for i, entry in ipairs(recentList(player)) do
		recent[i] = { id = entry.id, name = entry.name }
	end
	result.recent = recent
	return result
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function RadioService:Init(services)
	S = services
end

function RadioService:Start()
	ReplicatedStorage:SetAttribute("RadioId", "")
	ReplicatedStorage:SetAttribute("RadioName", "")
	ReplicatedStorage:SetAttribute("RadioStartedAt", 0)
	ReplicatedStorage:SetAttribute("RadioVolume", R.Volume)

	local lobby = workspace:FindFirstChild("Lobby")
	if lobby then
		local existing = lobby:FindFirstChild("MageRadio")
		if existing then
			existing:Destroy()
		end
		local a = math.rad(R.Angle)
		local model, dial, now, notes, prompt = buildRadio(lobby, V(math.cos(a) * R.Radius, 1, math.sin(a) * R.Radius))
		radioModel = model
		dialPart, nowLabel, notesEmitter = dial, now, notes
		prompt.Triggered:Connect(function(player)
			if RadioService:Purchase(player) then
				Remotes.OpenWindow:FireClient(player, "Radio")
			end
		end)
	end

	Remotes.RadioControl.OnServerInvoke = onControl

	-- Klientui: ar žaidėjas jau turi radiją (E mygtuko tekstas „Magė“ arba „Pirkti“)
	local function mark(player)
		task.spawn(function()
			for _ = 1, 30 do
				if S.DataService:Get(player) or not player.Parent then
					break
				end
				task.wait(1)
			end
			if player.Parent then
				player:SetAttribute("CanUseRadio", RadioService:CanUse(player))
			end
		end)
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in ipairs(Players:GetPlayers()) do
		mark(player)
	end
end

function RadioService:GetModel()
	return radioModel
end

return RadioService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX55"><Properties><string name="Name">RebirthService</string><ProtectedString name="Source"><![CDATA[--[[
	RebirthService – „Močiutės palaiminimas“.
	- Pirmas rebirth: atrakinta Šaltibarščių linija + 1 000 000 Lt; kiti: ankstesnė kaina × 3.
	- Daugiklis: 1 + 0,5 × rebirth skaičius.
	- Išsitrina: litai, pirkiniai, močiutės, bendri patobulinimai.
	- Lieka: rebirth skaičius, gamepass'ai, badge'ai, kosmetika, statistika.
	- Titulai ir apdovanojimai – Settings.Rebirth.
	Užklausos: Remotes.RequestRebirth:InvokeServer("info" | "confirm")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Calc = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Calc"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local TitleItems = require(Lib:WaitForChild("TitleItems"))
local RateLimit = require(Lib:WaitForChild("RateLimit"))

local V = Vector3.new
local C = Color3.fromRGB

local RebirthService = {}
local S
local limiter = RateLimit.new(Settings.RemoteRateLimit)
local busy = {}

function RebirthService:GetInfo(player)
	local data = S.DataService:Get(player)
	if not data then
		return nil
	end
	local nextReward = Calc.GetNextReward(data.rebirths)
	local cost = Calc.GetRebirthCost(data.rebirths)
	local requirementMet = Calc.IsLineUnlocked(data, Settings.Rebirth.RequiredLine)
	return {
		Rebirths = data.rebirths,
		Cost = cost,
		Money = data.money,
		RequirementMet = requirementMet,
		CanRebirth = requirementMet and data.money >= cost,
		CurrentMultiplier = Calc.GetRebirthMultiplier(data.rebirths),
		NewMultiplier = Calc.GetRebirthMultiplier(data.rebirths + 1),
		TitleKey = Calc.GetTitleKey(data.rebirths),
		NextTitleKey = Calc.GetTitleKey(data.rebirths + 1),
		NextRewardAt = nextReward and nextReward.At or nil,
		NextRewardKey = nextReward and nextReward.Key or nil,
	}
end

----------------------------------------------------------------------
-- Titulas virš galvos ir karūna
----------------------------------------------------------------------
function RebirthService:ApplyTitle(player)
	local character = player.Character
	local data = S.DataService:Get(player)
	local head = character and character:FindFirstChild("Head")
	if not head or not data then
		return
	end
	local old = head:FindFirstChild("TitleGui")
	if old then
		old:Destroy()
	end
	Build.Billboard(head, { Name = "TitleGui", TextKey = Calc.GetTitleKey(data.rebirths), Size = UDim2.fromScale(7, 1.1), Offset = V(0, 2.4, 0), MaxDistance = 80, Color = C(255, 215, 120) })
	-- Titulo atributika (prijuostė, šaukštas, šefo kepurė, šalikas, apsiaustas, medalionas, kardas)
	TitleItems.Apply(character, data.rebirths)

	local oldCrown = character:FindFirstChild("RoyalCrown")
	if oldCrown then
		oldCrown:Destroy()
	end
	local hasCrown = false
	for _, reward in ipairs(Settings.Rebirth.Rewards) do
		if reward.Type == "Crown" and data.rebirths >= reward.At then
			hasCrown = true
		end
	end
	if hasCrown then
		local crown = Instance.new("Model")
		crown.Name = "RoyalCrown"
		local base = Build.Part({ Name = "Band", Parent = crown, Shape = Enum.PartType.Cylinder, Size = V(0.5, 1.4, 1.4), CFrame = head.CFrame * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 205, 50), Material = Enum.Material.Metal, Anchored = false, CanCollide = false, Massless = true })
		for i = 0, 4 do
			local angle = math.rad(i * 72)
			Build.Part({ Name = "Spike", Parent = crown, Size = V(0.2, 0.45, 0.2), CFrame = head.CFrame * CFrame.new(math.cos(angle) * 0.6, 1.25, math.sin(angle) * 0.6), Color = C(255, 205, 50), Material = Enum.Material.Metal, Anchored = false, CanCollide = false, Massless = true })
		end
		Build.Part({ Name = "Gem", Parent = crown, Shape = Enum.PartType.Ball, Size = V(0.3, 0.3, 0.3), CFrame = head.CFrame * CFrame.new(0, 0.85, -0.7), Color = C(200, 30, 40), Material = Enum.Material.Neon, Anchored = false, CanCollide = false, Massless = true })
		for _, part in ipairs(crown:GetChildren()) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = head
			weld.Part1 = part
			weld.Parent = part
		end
		crown.PrimaryPart = base
		crown.Parent = character
	end
end

----------------------------------------------------------------------
-- Rebirth
----------------------------------------------------------------------
function RebirthService:DoRebirth(player)
	local data = S.DataService:Get(player)
	if not data or busy[player] then
		return false, "Busy"
	end
	local info = self:GetInfo(player)
	if not info.RequirementMet then
		return false, "RebirthRequirement"
	end
	if not info.CanRebirth then
		return false, "RebirthNotEnough"
	end
	busy[player] = true

	-- Išsitrina
	data.money = 0
	data.purchases = {}
	data.grannies = {}
	data.globalUpgrades = {}
	data.rebirths = data.rebirths + 1

	-- Apdovanojimai (visi pasiekti, nes jie nuolatiniai)
	for _, reward in ipairs(Settings.Rebirth.Rewards) do
		if data.rebirths >= reward.At then
			if reward.Type == "StartMoney" then
				data.money = math.max(data.money, reward.Amount)
			elseif reward.Type == "Skin" then
				data.cosmetics.skins[reward.Skin] = true
			elseif reward.Type == "Crown" then
				data.cosmetics.crown = true
				if reward.Badge then
					S.MonetizationService:AwardBadge(player, reward.Badge)
				end
			end
		end
	end

	S.DataService:UpdateStats(player)
	if S.PlotService:GetPlot(player) then
		S.TycoonService:BuildPlot(player)
		S.PlotService:TeleportToPlot(player)
	end
	self:ApplyTitle(player)
	for _, item in ipairs(TitleItems.NewlyUnlocked(data.rebirths - 1, data.rebirths)) do
		S.DataService:Notify(player, "TitleItemUnlocked", nil, { item = item.Key }, nil, "success")
	end
	S.TycoonService:UpdateIncome(player)
	Remotes.RebirthDone:FireClient(player, data.rebirths, Calc.GetRebirthMultiplier(data.rebirths), Calc.GetTitleKey(data.rebirths))
	task.spawn(function()
		S.DataService:Save(player, false)
	end)
	busy[player] = nil
	return true, "RebirthDone"
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function RebirthService:Init(services)
	S = services
end

function RebirthService:Start()
	Remotes.RequestRebirth.OnServerInvoke = function(player, action)
		if not limiter:Check(player) then
			return nil
		end
		if action == "info" then
			return self:GetInfo(player)
		elseif action == "confirm" then
			local ok, key = self:DoRebirth(player)
			return { Success = ok, Key = key, Info = self:GetInfo(player) }
		end
		return nil
	end

	-- Močiutės trobelė lobby
	local door = S.MapBuilder.Anchors.RebirthHutDoor
	if door then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Rebirth"
		prompt.ObjectText = "👵"
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = door
		prompt.Triggered:Connect(function(player)
			Remotes.OpenWindow:FireClient(player, "Rebirth")
		end)
	end

	local function setupCharacter(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			self:ApplyTitle(player)
		end)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		setupCharacter(player)
	end
	Players.PlayerAdded:Connect(setupCharacter)

	S.DataService:OnPlayerLoaded(function(player)
		if player.Character then
			self:ApplyTitle(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		busy[player] = nil
	end)
end

return RebirthService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX56"><Properties><string name="Name">TemplateBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	TemplateBuilder – modelių šablonai ServerStorage/Templates.

	Kodas modelius randa PAGAL PAVADINIMĄ:
	  Templates/Plot                     – sklypas (Floor, Fence, GateBeam, ClaimPad, PlotSpawn, Zones/Zone_<Linija>)
	  Templates/Machines/Dropper_<Linija> – dropper'is (turi turėti dalį "DropPoint")
	  Templates/Machines/Conveyor_<Linija> – konvejeris (dalis "Belt")
	  Templates/Machines/Sell_<Linija>   – pardavimo langelis
	  Templates/Machines/<pirkinio ID>   – upgrader'is / statula (pvz. "Cepelinai_3")
	  Templates/Machines/GrannyTable, Shelf, Flag
	  Templates/Items/Item_<Linija>      – žaliava (viena Part)
	Jei modelio nėra – sugeneruojamas paprastas placeholder'is iš Parts.
	Norėdamas pakeisti gražesniu: įdėk savo modelį tuo pačiu pavadinimu (Pivot – apačios centre,
	konvejerio kryptis -Z).
]]

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local ProductLines = require(Config:WaitForChild("ProductLines"))
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Build = require(Lib:WaitForChild("Build"))
local Scenery = require(Lib:WaitForChild("Scenery"))
local DecorModels = require(Lib:WaitForChild("DecorModels"))

local L = Settings.Layout
local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local M = Enum.Material

local WOOD = C(122, 82, 46)
local DARK_WOOD = C(78, 50, 26)
local STONE = C(128, 126, 120)
local GOLD = C(255, 200, 50)

local TemplateBuilder = {}

local templates, machines, items

local function ensureFolder(parent, name, className)
	local folder = parent:FindFirstChild(name)
	if not folder then
		folder = Instance.new(className or "Folder")
		folder.Name = name
		folder.Parent = parent
	end
	return folder
end

local function finish(model, parent)
	model.WorldPivot = CF()
	model.Parent = parent
	return model
end

----------------------------------------------------------------------
-- Sklypas
----------------------------------------------------------------------
local function buildPlot(model)
	local half = L.PlotSize / 2
	local skin = Settings.Skins.Default

	Build.Part({ Name = "Floor", Parent = model, Size = V(L.PlotSize, 1, L.PlotSize), CFrame = CF(0, -0.5, 0), Color = skin.Floor, Material = skin.FloorMaterial })

	-- Tvora
	local fence = Build.Folder("Fence", model)
	local gateHalf = L.GateWidth / 2 + 2
	local step = 10
	local function post(x, z)
		Build.Part({ Name = "Post", Parent = fence, Size = V(1, 4, 1), CFrame = CF(x, 2, z), Color = skin.Fence, Material = skin.FenceMaterial })
	end
	local function rail(a, b)
		local mid = (a + b) / 2
		local length = (b - a).Magnitude
		for _, y in ipairs({ 1.4, 2.9 }) do
			Build.Part({ Name = "Rail", Parent = fence, Size = V(0.4, 0.4, length), CFrame = CFrame.lookAt(V(mid.X, y, mid.Z), V(b.X, y, b.Z)), Color = skin.Fence, Material = skin.FenceMaterial })
		end
	end
	for i = -half, half - step, step do
		-- galas (+Z), šonai (±X)
		rail(V(i, 0, half), V(i + step, 0, half))
		rail(V(half, 0, i), V(half, 0, i + step))
		rail(V(-half, 0, i), V(-half, 0, i + step))
		post(i, half)
		post(half, i)
		post(-half, i)
		-- priekis (-Z) su vartais
		if i + step <= -gateHalf or i >= gateHalf then
			rail(V(i, 0, -half), V(i + step, 0, -half))
		end
		if i <= -gateHalf or i >= gateHalf then
			post(i, -half)
		end
	end
	post(half, half)

	-- Vartų išvaizdą (rąstai → dailidės → plytos) stato PlotService:ApplyGate (Lib/GateModels).
	-- Nematoma sija lieka kaip užrašo „Laisvas sklypas / savininkas“ laikiklis.
	local beam = Build.Part({ Name = "GateBeam", Parent = model, Size = V(L.GateWidth + 8, 2, 3), CFrame = CF(0, 11, L.GateZ), Color = DARK_WOOD, Material = M.Wood, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	Build.Sign(beam, { Name = "OwnerSign", TextKey = "FreePlot", Size = UDim2.fromScale(16, 3.2), Offset = V(0, 3.2, 0), MaxDistance = 250 })

	-- Akmeninė aikštelė prieš vartus ir Claim mygtukas ant jos
	Build.Part({ Name = "Porch", Parent = model, Size = V(L.GateWidth + 10, 1, 14), CFrame = CF(0, -0.5, -half - 7), Color = STONE, Material = M.Slate })
	local pad = Build.Part({
		Name = "ClaimPad", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.5, 7, 7),
		CFrame = CF(0, 0.25, L.ClaimPadZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C(70, 170, 70), Material = M.Neon,
	})
	Build.Billboard(pad, { Name = "ClaimLabel", TextKey = "ClaimHere", Size = UDim2.fromScale(7, 2), Offset = V(0, 3, 0), Color = C(200, 255, 170), MaxDistance = 150 })
	-- Aukšta nematoma zona virš mygtuko: Touched suveikia vos įėjus (net užšokus)
	Build.Part({ Name = "ClaimZone", Parent = model, Size = V(8, 7, 8), CFrame = CF(0, 3.5, L.ClaimPadZ), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = true })
	-- Atsarginis būdas: paspausti „E“ / bakstelėti telefone
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClaimPrompt"
	prompt.ActionText = "Claim / Pasiimti"
	prompt.ObjectText = "🏠"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad

	Build.Part({ Name = "PlotSpawn", Parent = model, Size = V(2, 1, 2), CFrame = CF(0, 3, L.SpawnZ), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })

	-- Dekoracijos sklype
	local decor = Build.Folder("PlotDecor", model)
	local rng = Random.new(42)
	for _, side in ipairs({ -1, 1 }) do
		-- Fakelai ant vartų bokštų
		Scenery.Torch(decor, V(side * gateHalf, 12, L.GateZ), 1.6)
		-- Kabančios trispalvės po vartų sija
		local stripes = { C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }
		for i, color in ipairs(stripes) do
			Build.Part({ Name = "Flag", Parent = decor, Size = V(2.4, 1.1, 0.1), CFrame = CF(side * 4.2, 9.5 - (i - 1) * 1.1, L.GateZ - 1.6), Color = color, Material = M.Fabric, CanCollide = false, CanQuery = false, CanTouch = false })
		end
		-- Beržiukai ir krūmai palei šonines tvoras
		for index = 0, 8 do
			local z = -34 + index * 11
			local x = side * (half - 5)
			if index % 2 == 0 then
				Scenery.Birch(decor, V(x, 0, z), rng, 0.55)
			else
				Scenery.Bush(decor, V(x, 0, z), rng, 0.9)
			end
		end
	end
	-- Krūmai palei galinę tvorą
	for x = -50, 50, 12 do
		Scenery.Bush(decor, V(x, 0, half - 2.5), rng, 0.7)
	end
	-- Ūkio kampelis kairėje nuo vartų
	Scenery.Barrel(decor, V(-16, 0, -56), rng)
	Scenery.Barrel(decor, V(-18.6, 0, -55.4), rng)
	Scenery.Crate(decor, V(-16.5, 0, -52.5), rng)
	Scenery.Crate(decor, V(-16.5, 2.2, -52.5), rng, 1.6)
	Scenery.Haystack(decor, V(-52, 0, -53), rng)
	Scenery.Cart(decor, CF(-44, 0, -50) * CFrame.Angles(0, math.rad(70), 0))
	-- Bulvių daržas
	for row = 0, 2 do
		local z = -57 + row * 3.2
		Build.Part({ Name = "GardenBed", Parent = decor, Size = V(12, 0.5, 2.2), CFrame = CF(-29, 0.25, z), Color = C(95, 65, 40), Material = M.Ground, CanQuery = false, CanTouch = false })
		for i = 0, 4 do
			Build.Part({ Name = "PotatoPlant", Parent = decor, Shape = Enum.PartType.Ball, Size = V(1.3, 1.3, 1.3), CFrame = CF(-34 + i * 2.5, 1, z), Color = C(80, 140, 60), Material = M.Grass, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
			if i % 2 == 0 then
				Build.Part({ Name = "PotatoFlower", Parent = decor, Shape = Enum.PartType.Ball, Size = V(0.35, 0.35, 0.35), CFrame = CF(-34 + i * 2.5, 1.7, z), Color = C(235, 225, 250), Material = M.SmoothPlastic, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
			end
		end
	end
	-- Gėlės prie vartų
	Scenery.Flowers(decor, V(-12, 0, -57), rng, 5)
	Scenery.Flowers(decor, V(12, 0, -57), rng, 5)

	-- Zonos
	local zones = Build.Folder("Zones", model)
	local length = L.ZoneMaxZ - L.ZoneMinZ
	for index, lineId in ipairs(ProductLines.Order) do
		local x = L.FirstLaneX - (index - 1) * L.LaneSpacing
		Build.Part({
			Name = "Zone_" .. lineId, Parent = zones, Size = V(L.LaneSpacing - 0.4, L.ZoneTopY, length),
			CFrame = CF(x, L.ZoneTopY / 2, L.ZoneMinZ + length / 2),
			Color = C(200, 200, 200), Material = M.SmoothPlastic, Transparency = 0.6,
		})
	end
end

----------------------------------------------------------------------
-- Mašinos
----------------------------------------------------------------------
local function buildDropper(model, line)
	for _, x in ipairs({ -2.9, 2.9 }) do
		Build.Part({ Name = "Post", Parent = model, Size = V(0.6, 10, 0.6), CFrame = CF(x, 5, 0), Color = WOOD, Material = M.Wood })
	end
	Build.Part({ Name = "TopBeam", Parent = model, Size = V(6.4, 0.6, 0.8), CFrame = CF(0, 10.1, 0), Color = WOOD, Material = M.Wood })
	Build.Part({ Name = "Sack", Parent = model, Size = V(3.6, 3, 3.6), CFrame = CF(0, 8.2, 0), Color = line.Theme.Machine, Material = M.Fabric })
	Build.Part({ Name = "SackTop", Parent = model, Size = V(2.2, 0.8, 2.2), CFrame = CF(0, 10, 0), Color = line.Theme.Machine, Material = M.Fabric })
	Build.Part({ Name = "Chute", Parent = model, Size = V(1.8, 1.4, 1.8), CFrame = CF(0, 6.1, 0), Color = DARK_WOOD, Material = M.Wood })
	Build.Part({ Name = "DropPoint", Parent = model, Size = V(0.5, 0.5, 0.5), CFrame = CF(0, L.DropSpawnHeight, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
end

local function buildConveyor(model, line)
	local length = L.ConveyorStartZ - L.ConveyorEndZ
	Build.Part({
		Name = "Belt", Parent = model, Size = V(L.ConveyorWidth, L.ConveyorHeight, length),
		CFrame = CF(0, L.ConveyorHeight / 2, 0), Color = line.Theme.Belt, Material = line.Theme.BeltMaterial,
		Transparency = line.Theme.BeltTransparency, Tags = { "ConveyorBelt" },
	})
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "Rail", Parent = model, Size = V(0.4, 0.6, length), CFrame = CF(side * (L.ConveyorWidth / 2 + 0.2), L.ConveyorHeight + 0.1, 0), Color = line.Theme.Accent, Material = M.Wood })
	end
	Build.Part({ Name = "EndCap", Parent = model, Size = V(L.ConveyorWidth + 0.8, 0.8, 0.4), CFrame = CF(0, L.ConveyorHeight + 0.2, length / 2 + 0.2), Color = line.Theme.Accent, Material = M.Wood })
	-- Metaliniai šonai (rėmas) su varžtais
	local metal = C(85, 85, 90)
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "Skirt", Parent = model, Size = V(0.25, L.ConveyorHeight, length), CFrame = CF(side * (L.ConveyorWidth / 2 + 0.13), L.ConveyorHeight / 2, 0), Color = metal, Material = M.DiamondPlate, CanQuery = false, CanTouch = false })
		for i = 0, 4 do
			local z = -length / 2 + 4 + i * (length - 8) / 4
			Build.Part({ Name = "Bolt", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.4, 0.4), CFrame = CF(side * (L.ConveyorWidth / 2 + 0.3), L.ConveyorHeight / 2, z), Color = C(190, 190, 195), Material = M.Metal, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
		end
	end
	-- Velenai abiejuose galuose (be kolizijos, kad netrukdytų produktams)
	for _, z in ipairs({ length / 2, -length / 2 }) do
		Build.Part({ Name = "Roller", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(L.ConveyorWidth + 0.7, L.ConveyorHeight + 0.2, L.ConveyorHeight + 0.2), CFrame = CF(0, L.ConveyorHeight / 2, z), Color = metal, Material = M.Metal, CanCollide = false, CanQuery = false, CanTouch = false })
	end
end

local function buildSell(model, line)
	-- Langelis atsuktas į +Z (iš ten atvažiuoja produktai)
	Build.Part({ Name = "Back", Parent = model, Size = V(5.6, 4.4, 0.6), CFrame = CF(0, 2.2, -1.9), Color = DARK_WOOD, Material = M.Wood })
	for _, side in ipairs({ -1, 1 }) do
		Build.Part({ Name = "Side", Parent = model, Size = V(0.6, 4.4, 4.4), CFrame = CF(side * 2.5, 2.2, 0), Color = DARK_WOOD, Material = M.Wood })
	end
	Build.Part({ Name = "Roof", Parent = model, Size = V(6.4, 0.6, 5), CFrame = CF(0, 4.7, 0), Color = line.Theme.Accent, Material = M.WoodPlanks })
	Build.Part({ Name = "Inside", Parent = model, Size = V(4.4, 4, 3.6), CFrame = CF(0, 2, -0.2), Color = C(30, 20, 12), Material = M.SmoothPlastic, CanCollide = false })
	for i = 1, 3 do
		Build.Part({ Name = "Coin", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.3, 1.2, 1.2), CFrame = CF(-1.6 + i * 0.6, 5.1 + i * 0.05, 1) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD, Material = M.Metal })
	end
	local roof = model:FindFirstChild("Roof")
	Build.Sign(roof, { Name = "SellSign", TextKey = "Sell", Size = UDim2.fromScale(6, 1.6), Offset = V(0, 2.2, 0), MaxDistance = 80 })
end

local function opText(purchase)
	local amount = purchase.Amount
	if amount == math.floor(amount) then
		amount = string.format("%d", amount)
	else
		amount = string.gsub(string.format("%.1f", amount), "%.", ",")
	end
	if purchase.Op == "Mul" then
		return "×" .. amount
	end
	return "+" .. amount
end

local function buildUpgrader(model, line, purchase)
	local color = purchase.ItemColor or line.Theme.Machine
	for _, x in ipairs({ -3.1, 3.1 }) do
		Build.Part({ Name = "Post", Parent = model, Size = V(0.8, 6, 0.8), CFrame = CF(x, 3, 0), Color = WOOD, Material = M.Wood })
	end
	local beam = Build.Part({ Name = "Beam", Parent = model, Size = V(7, 0.8, 1.4), CFrame = CF(0, 6.4, 0), Color = line.Theme.Accent, Material = M.WoodPlanks })
	Build.Part({ Name = "Zone", Parent = model, Size = V(L.ConveyorWidth + 0.4, 3, 1.6), CFrame = CF(0, 2.7, 0), Color = color, Material = M.Neon, Transparency = 0.6, CanCollide = false, CanQuery = false, CanTouch = false })

	-- Viršutinė „mašinos“ dalis – skiriasi pagal tipą
	if purchase.Op == "Mul" then
		Build.Part({ Name = "Gear", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(1, 3, 3), CFrame = CF(0, 8.3, 0), Color = STONE, Material = M.Metal, Tags = { "Spinner" }, Attributes = { SpinSpeed = 1.5 } })
	else
		Build.Part({ Name = "Funnel", Parent = model, Size = V(2.4, 2, 2.4), CFrame = CF(0, 7.8, 0), Color = color, Material = M.SmoothPlastic })
	end

	-- Ypatingos detalės
	if purchase.Id == "Cepelinai_6" or purchase.Id == "AuksinisCepelinas_5" then
		local pot = Build.Part({ Name = "Pot", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2.6, 3.6, 3.6), CFrame = CF(2.2, 8.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = C(60, 60, 65), Material = M.Metal, Tags = { "Bubbling" } })
		local steam = Instance.new("Smoke")
		steam.Color = C(240, 240, 240)
		steam.Opacity = 0.15
		steam.RiseVelocity = 3
		steam.Size = 1.5
		steam.Parent = pot
	elseif purchase.Id == "Sakotis_2" then
		Build.Part({ Name = "Spit", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(6.4, 1.6, 1.6), CFrame = CF(0, 5.2, 0), Color = C(220, 170, 80), Material = M.SmoothPlastic, Tags = { "Spinner" }, Attributes = { SpinSpeed = 2 } })
	elseif purchase.Id == "Sakotis_3" or purchase.Id == "Kibinai_4" then
		local fire = Instance.new("Fire")
		fire.Size = 3
		fire.Heat = 4
		fire.Parent = beam
	end

	Build.Billboard(beam, { Name = "OpLabel", Text = opText(purchase), Size = UDim2.fromScale(3, 1.4), Offset = V(0, 3.4, 0), Color = C(255, 230, 120), MaxDistance = 70 })
	Build.Billboard(beam, { Name = "NameLabel", TextKey = purchase.Id, Size = UDim2.fromScale(8, 1.1), Offset = V(0, 2.1, 0), Font = Enum.Font.Merriweather, MaxDistance = 50 })
end

local function buildStatue(model)
	Build.Part({ Name = "Pedestal", Parent = model, Size = V(7, 3, 7), CFrame = CF(0, 1.5, 0), Color = C(235, 230, 220), Material = M.Marble })
	Build.Part({ Name = "PedestalTop", Parent = model, Size = V(6, 0.6, 6), CFrame = CF(0, 3.3, 0), Color = GOLD, Material = M.Metal })
	local body = Build.Part({ Name = "Cepelinas", Parent = model, Size = V(9, 5, 5), CFrame = CF(0, 6.1, 0), Color = GOLD, Material = M.Metal })
	Build.Mesh(body, Enum.MeshType.Sphere)
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 18
	light.Brightness = 2
	light.Parent = body
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = C(255, 230, 120)
	sparkles.Parent = body
	Build.Billboard(body, { Name = "NameLabel", TextKey = "AuksinisCepelinas_7", Size = UDim2.fromScale(12, 2), Offset = V(0, 5, 0), Color = GOLD, MaxDistance = 200 })
end

local function buildGrannyTable(model)
	Build.Part({ Name = "Top", Parent = model, Size = V(2.6, 0.4, 4.4), CFrame = CF(0, 3, 0), Color = WOOD, Material = M.WoodPlanks })
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1.8, 1.8 }) do
			Build.Part({ Name = "Leg", Parent = model, Size = V(0.4, 2.8, 0.4), CFrame = CF(x, 1.4, z), Color = DARK_WOOD, Material = M.Wood })
		end
	end
	Build.Part({ Name = "Bowl", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(0.8, 1.6, 1.6), CFrame = CF(0, 3.6, -0.8) * CFrame.Angles(0, 0, math.rad(90)), Color = C(200, 200, 205), Material = M.Metal })
	Build.Part({ Name = "RollingPin", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(2, 0.4, 0.4), CFrame = CF(0, 3.4, 1.2) * CFrame.Angles(0, math.rad(90), 0), Color = C(210, 170, 110), Material = M.Wood })
end

local function buildShelf(model)
	for _, x in ipairs({ -6, 6 }) do
		Build.Part({ Name = "Side", Parent = model, Size = V(0.6, 7, 1.6), CFrame = CF(x, 3.5, 0), Color = DARK_WOOD, Material = M.Wood })
	end
	for _, y in ipairs({ 1, 3.4, 5.8 }) do
		Build.Part({ Name = "Board", Parent = model, Size = V(12, 0.4, 1.6), CFrame = CF(0, y, 0), Color = WOOD, Material = M.WoodPlanks })
	end
	local colors = { C(200, 60, 60), C(60, 140, 60), C(230, 200, 70), C(150, 90, 50) }
	for i = 1, 8 do
		local x = -5 + (i - 1) * 1.4
		local y = (i % 2 == 0) and 4.1 or 1.7
		Build.Part({ Name = "Jar", Parent = model, Shape = Enum.PartType.Cylinder, Size = V(1.1, 0.9, 0.9), CFrame = CF(x, y, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = colors[(i % 4) + 1], Material = M.Glass, Transparency = 0.2 })
	end
	local top = Build.Part({ Name = "TopBoard", Parent = model, Size = V(12.6, 0.5, 2), CFrame = CF(0, 7.2, 0), Color = DARK_WOOD, Material = M.Wood })
	Build.Sign(top, { Name = "ShelfSign", TextKey = "Shelf", Size = UDim2.fromScale(10, 1.8), Offset = V(0, 2, 0), MaxDistance = 80 })
end

local function buildFlag(model)
	Build.Part({ Name = "Pole", Parent = model, Size = V(0.4, 10, 0.4), CFrame = CF(0, 5, 0), Color = C(90, 70, 50), Material = M.Wood })
	local stripes = { C(253, 185, 19), C(0, 106, 68), C(193, 39, 45) }
	for i, color in ipairs(stripes) do
		Build.Part({ Name = "Stripe" .. i, Parent = model, Size = V(0.1, 0.9, 4.5), CFrame = CF(0, 9.6 - (i - 1) * 0.9, 2.45), Color = color, Material = M.Fabric })
	end
end

----------------------------------------------------------------------
-- Žaliavos
----------------------------------------------------------------------
local MESH_TYPES = { Sphere = Enum.MeshType.Sphere, Cylinder = Enum.MeshType.Cylinder, Block = Enum.MeshType.Brick }

function TemplateBuilder:ApplyItemMesh(part, meshName)
	local old = part:FindFirstChildOfClass("SpecialMesh")
	if old then
		old:Destroy()
	end
	local meshType = MESH_TYPES[meshName]
	if meshType and meshName ~= "Block" then
		Build.Mesh(part, meshType)
	end
end

-- Smulki dekoratyvinė dalis, privirinta prie žaliavos (be fizikos)
local function addDetail(root, name, size, offset, color, material, meshType)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or root.Material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = root.CFrame * offset
	if meshType then
		Build.Mesh(part, meshType)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = root
	return part
end
TemplateBuilder.AddDetail = addDetail

-- Gumbuota bulvė su „akutėmis“
local function potatoDetails(root, bumpColor, eyeColor, eyeMaterial)
	local SPHERE = Enum.MeshType.Sphere
	addDetail(root, "Detail", V(0.85, 0.75, 0.8), CF(0.42, 0.12, 0.18), bumpColor, nil, SPHERE)
	addDetail(root, "Detail", V(0.8, 0.7, 0.75), CF(-0.45, -0.08, -0.2), bumpColor, nil, SPHERE)
	addDetail(root, "Detail", V(0.6, 0.55, 0.6), CF(0.05, 0.28, -0.32), bumpColor, nil, SPHERE)
	local eyes = { CF(0.55, 0.3, 0.45), CF(-0.2, 0.45, 0.35), CF(-0.6, 0.15, -0.45), CF(0.25, -0.2, -0.58), CF(0.7, -0.15, -0.1) }
	for _, offset in ipairs(eyes) do
		addDetail(root, "Detail", V(0.16, 0.12, 0.16), offset, eyeColor, eyeMaterial or Enum.Material.SmoothPlastic, SPHERE)
	end
end

local STYLE_DETAILS = {
	Potato = function(root)
		potatoDetails(root, C(160, 113, 66), C(105, 70, 38))
	end,
	GoldenPotato = function(root)
		potatoDetails(root, C(245, 195, 55), C(255, 140, 20), Enum.Material.Neon)
	end,
	Dough = function(root)
		-- Miltų dulkės viršuje
		addDetail(root, "Detail", V(0.95, 0.22, 0.95), CF(0.08, 0.5, 0.05), C(252, 250, 244), Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
		addDetail(root, "Detail", V(0.4, 0.15, 0.4), CF(-0.4, 0.42, 0.3), C(252, 250, 244), Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
	end,
	Beet = function(root)
		-- Šaknelė apačioje ir lapai viršuje
		addDetail(root, "Detail", V(0.25, 0.5, 0.25), CF(0, -0.75, 0), C(100, 18, 45), nil, Enum.MeshType.Sphere)
		addDetail(root, "Detail", V(0.18, 0.5, 0.18), CF(0, 0.75, 0), C(110, 40, 60), Enum.Material.SmoothPlastic)
		addDetail(root, "Detail", V(0.12, 0.9, 0.5), CF(0.15, 1.1, 0) * CFrame.Angles(0, 0, math.rad(-25)), C(70, 150, 60), Enum.Material.Grass, Enum.MeshType.Sphere)
		addDetail(root, "Detail", V(0.12, 0.9, 0.5), CF(-0.15, 1.05, 0.05) * CFrame.Angles(0, math.rad(40), math.rad(25)), C(80, 165, 65), Enum.Material.Grass, Enum.MeshType.Sphere)
	end,
	Batter = function(root)
		-- Kiaušinio trynys ir sūkurys
		addDetail(root, "Detail", V(0.75, 0.35, 0.75), CF(0, 0.45, 0), C(255, 240, 170), Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
		addDetail(root, "Detail", V(0.35, 0.25, 0.35), CF(0.1, 0.62, 0.05), C(255, 170, 30), Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
	end,
}

local function buildItem(lineId)
	local def = ProductLines.Lines[lineId].Item
	local part = Instance.new("Part")
	part.Name = "Item_" .. lineId
	part.Size = def.Size
	part.Color = def.Color
	part.Material = def.Material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanQuery = false
	part.CastShadow = false
	part.CanTouch = false
	TemplateBuilder:ApplyItemMesh(part, def.Mesh)
	local details = STYLE_DETAILS[def.Style or ""]
	if details then
		details(part)
	end
	part.Parent = items
	return part
end

----------------------------------------------------------------------
-- Vieša API
----------------------------------------------------------------------
local builders = {}

local function registerMachines()
	for _, lineId in ipairs(ProductLines.Order) do
		local line = ProductLines.Lines[lineId]
		builders["Dropper_" .. lineId] = function(model) buildDropper(model, line) end
		builders["Conveyor_" .. lineId] = function(model) buildConveyor(model, line) end
		builders["Sell_" .. lineId] = function(model) buildSell(model, line) end
		for _, purchase in ipairs(line.Purchases) do
			if purchase.Type == "Upgrader" then
				builders[purchase.Id] = function(model) buildUpgrader(model, line, purchase) end
			elseif purchase.Type == "Decoration" then
				builders[purchase.Id] = function(model) buildStatue(model) end
			end
		end
	end
	builders.GrannyTable = buildGrannyTable
	builders.Shelf = buildShelf
	builders.Flag = buildFlag
	for name, builder in pairs(DecorModels) do
		builders[name] = builder
	end
end

local function ensureMachine(name)
	local existing = machines:FindFirstChild(name)
	if existing then
		return existing
	end
	local builder = builders[name]
	if not builder then
		warn("[TemplateBuilder] Nežinomas šablonas: " .. tostring(name))
		return nil
	end
	local model = Instance.new("Model")
	model.Name = name
	builder(model)
	return finish(model, machines)
end

-- Grąžina mašinos modelio kopiją (dar be Parent)
function TemplateBuilder:CloneMachine(name)
	local template = ensureMachine(name)
	if not template then
		return nil
	end
	local clone = template:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return clone
end

function TemplateBuilder:CloneItem(lineId)
	local template = items:FindFirstChild("Item_" .. lineId) or buildItem(lineId)
	return template:Clone()
end

function TemplateBuilder:ClonePlot()
	return templates:FindFirstChild("Plot"):Clone()
end

function TemplateBuilder:Init()
	templates = ensureFolder(ServerStorage, "Templates")
	machines = ensureFolder(templates, "Machines")
	items = ensureFolder(templates, "Items")
	registerMachines()
end

function TemplateBuilder:Start()
	local plot = templates:FindFirstChild("Plot")
	if not plot then
		plot = Instance.new("Model")
		plot.Name = "Plot"
		plot.Parent = templates
	end
	if #plot:GetChildren() == 0 then
		buildPlot(plot)
		plot.WorldPivot = CF()
	end
	-- Sukuriam trūkstamus šablonus iš anksto (kad būtų matyti ServerStorage žaidžiant)
	for name in pairs(builders) do
		ensureMachine(name)
	end
	for _, lineId in ipairs(ProductLines.Order) do
		if not items:FindFirstChild("Item_" .. lineId) then
			buildItem(lineId)
		end
	end
end

return TemplateBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX57"><Properties><string name="Name">TycoonService</string><ProtectedString name="Source"><![CDATA[--[[
	TycoonService – universali gamybos sistema visoms linijoms:
	dropper'iai, konvejeris, upgrader'iai, pardavimo langelis, pirkimo mygtukai ant grindų.
	Linijos skiriasi tik konfigūracija (Config/ProductLines).

	Žaliavų judėjimas tikrinamas serveryje pagal poziciją (patikimiau nei Touched):
	kai objektas pravažiuoja upgrader'io vietą – pritaikomas efektas (vieną kartą),
	kai pasiekia pardavimo langelį – parduodamas savininkui.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local ProductLines = require(Config:WaitForChild("ProductLines"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Calc = require(Shared:WaitForChild("Calc"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Lib = script.Parent.Parent:WaitForChild("Lib")
local FoodLooks = require(Lib:WaitForChild("FoodLooks"))
local Build = require(Lib:WaitForChild("Build"))
local RateLimit = require(Lib:WaitForChild("RateLimit"))

local L = Settings.Layout
local CF = CFrame.new
local V = Vector3.new

local UPGRADER_WINDOW = 3          -- studai: upgrader'is suveikia tik ką tik pravažiavus jo vietą
local RISE_DEPTH = 8               -- iš kokio gylio „iškyla“ nauja mašina
local RISE_TIME = 0.7

local TycoonService = {}
local S
local states = {}                  -- [player] = būsena
local purchaseDebounce = RateLimit.debounce(Settings.PurchaseDebounce)
local buttonInfo = setmetatable({}, { __mode = "k" })   -- [mygtuko Part] = info
local insideButton = {}            -- [player] = { Pad = mygtukas, At = laikas }, kol stovi ant mygtuko
local BUTTON_RETRY = 1             -- s; stovint ant to paties mygtuko bandoma pirkti iš naujo
local notifyDebounce = RateLimit.debounce(2)

----------------------------------------------------------------------
-- Kontekstas (gamepass'ai, eventai, boost'ai)
----------------------------------------------------------------------
function TycoonService:GetContext(player)
	local data = S.DataService:Get(player)
	local passes = S.MonetizationService:GetPasses(player)
	return {
		eventDropMult = S.EventService:GetDropMultiplier(),
		eventMoneyMult = S.EventService:GetMoneyMultiplier(),
		doublePass = passes.DoubleMoney == true,
		fastPass = passes.FastDroppers == true,
		grannyPass = passes.GrannyHelp == true,
		vip = passes.VIP == true,
		group = S.BonusService:IsInGroup(player),
		boost = data ~= nil and data.boostRemaining > 0,
	}
end

function TycoonService:GetIncomePerSecond(player)
	local data = S.DataService:Get(player)
	if not data then
		return 0
	end
	return Calc.GetIncomePerSecond(data, self:GetContext(player))
end

function TycoonService:UpdateIncome(player)
	player:SetAttribute("IncomePerSec", self:GetIncomePerSecond(player))
end

function TycoonService:GetState(player)
	return states[player]
end

----------------------------------------------------------------------
-- Mašinų statymas
----------------------------------------------------------------------
local conveyorFactor = 1            -- Žiemos pūgos metu konvejeriai lėtesni

local function setBelt(model, plotCFrame)
	local belt = model:FindFirstChild("Belt", true)
	if belt then
		belt.AssemblyLinearVelocity = plotCFrame.LookVector * Settings.ConveyorSpeed * conveyorFactor
	end
end

-- Pakeičia visų konvejerių greitį (1 = įprastas)
function TycoonService:SetConveyorFactor(factor)
	conveyorFactor = factor
	for _, state in pairs(states) do
		for _, model in ipairs(state.Plot.Machines:GetChildren()) do
			if string.sub(model.Name, 1, 9) == "Conveyor_" then
				setBelt(model, state.Plot.CFrame)
			end
		end
	end
end

-- Pastato mašiną. localCF – sklypo lokaliose koordinatėse. animate – iškyla iš žemės.
function TycoonService:PlaceMachine(state, templateName, localCF, name, animate)
	local model = S.TemplateBuilder:CloneMachine(templateName)
	if not model then
		return nil
	end
	model.Name = name
	local plotCF = state.Plot.CFrame
	local target = plotCF * localCF
	model.Parent = state.Plot.Machines

	if animate then
		model:PivotTo(target * CF(0, -RISE_DEPTH, 0))
		local value = Instance.new("NumberValue")
		value.Value = 0
		value.Changed:Connect(function(alpha)
			if model.Parent then
				model:PivotTo(target * CF(0, -RISE_DEPTH * (1 - alpha), 0))
			end
		end)
		local tween = TweenService:Create(value, TweenInfo.new(RISE_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 })
		tween.Completed:Connect(function()
			value:Destroy()
			if model.Parent then
				model:PivotTo(target)
				setBelt(model, plotCF)
			end
		end)
		tween:Play()
		Remotes.MachineBuilt:FireClient(state.Player, target.Position)
	else
		model:PivotTo(target)
	end
	setBelt(model, plotCF)
	return model
end

function TycoonService:PlaceBase(state, lineId, animate)
	local x = S.PlotService:GetLaneX(lineId)
	local midZ = (L.ConveyorStartZ + L.ConveyorEndZ) / 2
	self:PlaceMachine(state, "Conveyor_" .. lineId, CF(x, L.ZoneTopY, midZ), "Conveyor_" .. lineId, animate)
	self:PlaceMachine(state, "Sell_" .. lineId, CF(x, L.ZoneTopY, L.SellZ), "Sell_" .. lineId, animate)
	state.Lines[lineId].HasBase = true
end

function TycoonService:PlaceDropper(state, lineId, slot, animate)
	local x = S.PlotService:GetLaneX(lineId)
	local localCF = CF(x, L.ZoneTopY, L.DropperZ[slot])
	local model = self:PlaceMachine(state, "Dropper_" .. lineId, localCF, "Dropper_" .. lineId .. "_" .. slot, animate)
	-- Kritimo taškas (pagal modelio DropPoint dalį, jei yra)
	local dropCF = state.Plot.CFrame * localCF * CF(0, L.DropSpawnHeight, 0)
	local point = model and model:FindFirstChild("DropPoint", true)
	if model and point then
		local target = state.Plot.CFrame * localCF
		-- Santykinis poslinkis nuo modelio pivot (nepriklauso nuo „iškilimo“ animacijos)
		local offset = model:GetPivot():ToObjectSpace(point.CFrame)
		dropCF = target * offset
	end
	local rec = state.Lines[lineId]
	rec.DropPoints[slot] = dropCF
	rec.Timers[slot] = 0
end

function TycoonService:PlaceUpgrader(state, purchase, animate)
	local x = S.PlotService:GetLaneX(purchase.Line)
	self:PlaceMachine(state, purchase.Id, CF(x, L.ZoneTopY, L.UpgraderZ[purchase.Slot]), purchase.Id, animate)
	state.Lines[purchase.Line].Upgraders[purchase.Slot] = purchase
end

function TycoonService:PlaceDecoration(state, purchase, animate)
	local x = S.PlotService:GetLaneX(purchase.Line)
	-- Pasukta 90°, kad ilgas auksinis cepelinas eitų išilgai linijos ir nekabotų virš kitų mygtukų
	self:PlaceMachine(state, purchase.Id, CF(x, L.ZoneTopY, L.StatueZ) * CFrame.Angles(0, math.rad(90), 0), purchase.Id, animate)
end

function TycoonService:PlaceShelf(state, animate)
	if state.Plot.Machines:FindFirstChild("Shelf") then
		return
	end
	self:PlaceMachine(state, "Shelf", CF(L.ShelfX, 0, L.ShelfZ), "Shelf", animate)
end

function TycoonService:PlaceFlag(state, animate)
	if state.Plot.Machines:FindFirstChild("Flag") then
		return
	end
	local x = -(L.GateWidth / 2 + 2)
	self:PlaceMachine(state, "Flag", CF(x, 12, L.GateZ), "Flag", animate)
end

-- Sklypo puošmena iš lentynos (Settings.GlobalUpgrades.Decor)
function TycoonService:PlaceDecor(state, decorId, animate)
	if decorId == "Flag" then
		self:PlaceFlag(state, animate)
		return
	end
	if state.Plot.Machines:FindFirstChild(decorId) then
		return
	end
	for _, decor in ipairs(Settings.GlobalUpgrades.Decor) do
		if decor.Id == decorId and decor.Pos then
			self:PlaceMachine(state, decorId, CF(decor.Pos[1], 0, decor.Pos[2]), decorId, animate)
		end
	end
end

-- Pastato visą liniją pagal būseną (Calc.GetLineState)
function TycoonService:BuildLine(state, lineId, lineState, animate)
	state.Lines[lineId] = { DropPoints = {}, Timers = {}, Backlog = {}, Upgraders = {}, HasBase = false, ValueBonus = 1, ItemCount = 0 }
	if lineState.HasBase then
		self:PlaceBase(state, lineId, animate)
	end
	for slot = 1, lineState.Droppers do
		self:PlaceDropper(state, lineId, slot, animate)
	end
	for _, purchase in ipairs(lineState.Upgraders) do
		self:PlaceUpgrader(state, purchase, animate)
	end
end

----------------------------------------------------------------------
-- Visos gamyklos atkūrimas (prisijungus, po rebirth)
----------------------------------------------------------------------
function TycoonService:BuildPlot(player)
	local plot = S.PlotService:GetPlot(player)
	local data = S.DataService:Get(player)
	if not plot or not data then
		return
	end
	self:StopPlayer(player)
	S.PlotService:ClearPlot(plot)

	local state = { Player = player, Plot = plot, Lines = {}, Items = {}, ItemCount = 0, IncomeMult = 1 }
	states[player] = state

	S.PlotService:ApplySkin(plot, Calc.GetSkin(data.rebirths))
	S.PlotService:ApplyGate(plot, data.globalUpgrades.Gate or 0)
	for _, lineId in ipairs(ProductLines.Order) do
		local lineState = Calc.GetLineState(data, lineId)
		S.PlotService:SetZoneUnlocked(plot, lineId, lineState.Unlocked)
		if lineState.Unlocked then
			self:BuildLine(state, lineId, lineState, false)
			for _, purchase in ipairs(ProductLines.Lines[lineId].Purchases) do
				if purchase.Type == "Decoration" and data.purchases[purchase.Id] then
					self:PlaceDecoration(state, purchase, false)
				end
			end
		end
	end
	if Calc.IsShelfUnlocked(data) then
		self:PlaceShelf(state, false)
	end
	for _, decor in ipairs(Settings.GlobalUpgrades.Decor) do
		if data.globalUpgrades[decor.Id] then
			self:PlaceDecor(state, decor.Id, false)
		end
	end
	S.GrannyService:BuildForPlayer(player)
	self:RefreshButtons(player)
	self:UpdateIncome(player)
end

function TycoonService:StopPlayer(player)
	local state = states[player]
	if not state then
		return
	end
	for _, rec in ipairs(state.Items) do
		if rec.Part.Parent then
			rec.Part:Destroy()
		end
	end
	states[player] = nil
end

----------------------------------------------------------------------
-- Pirkimo mygtukai
----------------------------------------------------------------------
function TycoonService:GetButtonPosition(purchase)
	local x = S.PlotService:GetLaneX(purchase.Line)
	local y = L.ZoneTopY + 0.25
	local side = x + L.ButtonSideOffset
	if purchase.Type == "Dropper" then
		return V(side, y, L.DropperZ[purchase.Slot])
	elseif purchase.Type == "Base" then
		return V(side, y, L.BaseButtonZ)
	elseif purchase.Type == "Upgrader" then
		return V(side, y, L.UpgraderZ[purchase.Slot])
	end
	return V(x, y, L.UnlockButtonZ)
end

function TycoonService:CreateButton(state, localPosition, info)
	local radius = L.ButtonRadius
	local pad = Build.Part({
		Name = "Button_" .. info.Id,
		Parent = state.Plot.Buttons,
		Shape = Enum.PartType.Cylinder,
		Size = V(0.8, radius * 2, radius * 2),
		CFrame = state.Plot.CFrame * CF(localPosition + V(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(200, 60, 50),
		Material = Enum.Material.SmoothPlastic,
		Tags = { "BuyButton" },
		Attributes = { Price = info.Price, OwnerId = state.Player.UserId, ButtonKind = info.Kind, ButtonId = info.Id },
	})
	-- Medinis apvadas
	Build.Part({
		Name = "Rim",
		Parent = pad,
		Shape = Enum.PartType.Cylinder,
		Size = V(0.5, radius * 2 + 0.8, radius * 2 + 0.8),
		CFrame = pad.CFrame * CF(-0.2, 0, 0),
		Color = Color3.fromRGB(92, 58, 30),
		Material = Enum.Material.Wood,
		CanCollide = false,
		CanTouch = false,
	})
	-- Didelis šviečiantis apskritimas ant žemės (klientas nuspalvina: žalias – gali pirkti, raudonas – trūksta)
	Build.Part({
		Name = "Glow",
		Parent = pad,
		Shape = Enum.PartType.Cylinder,
		Size = V(0.12, radius * 2 + 1.2, radius * 2 + 1.2),
		CFrame = pad.CFrame * CF(-0.36, 0, 0),
		Color = Color3.fromRGB(200, 60, 50),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	})
	Build.Sign(pad, { Name = "NameSign", TextKey = info.TextKey, Size = UDim2.fromScale(7.5, 2), Offset = V(0, 4.4, 0), MaxDistance = 70 })
	if info.Price > 0 then
		Build.Billboard(pad, { Name = "PriceLabel", TextKey = "MoneyAmount", Nums = { amount = info.Price }, Size = UDim2.fromScale(6, 1.4), Offset = V(0, 2.6, 0), MaxDistance = 70, Color = Color3.fromRGB(255, 225, 120) })
	else
		Build.Billboard(pad, { Name = "PriceLabel", TextKey = "Free", Size = UDim2.fromScale(6, 1.4), Offset = V(0, 2.6, 0), MaxDistance = 70, Color = Color3.fromRGB(170, 255, 150) })
	end
	-- Pirkimas užlipus tikrinamas serveryje pagal poziciją (CheckButtons), o čia – atsarginis „E“ mygtukas
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy / Pirkti"
	prompt.ObjectText = ""
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		self:OnButtonTouched(player, state, info)
	end)
	buttonInfo[pad] = info
	return pad
end

-- Ar žaidėjas stovi ant savo sklypo mygtuko? Perkama tik UŽLIPUS (ne stovint vietoje),
-- kad naujas mygtukas toje pačioje vietoje nenupirktų savaime.
function TycoonService:CheckButtons()
	for player, state in pairs(states) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local onButton = nil
		if root and humanoid and humanoid.Health > 0 then
			for _, pad in ipairs(state.Plot.Buttons:GetChildren()) do
				if buttonInfo[pad] then
					local offset = root.Position - pad.Position
					local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
					if flat <= L.ButtonRadius + 0.8 and offset.Y > -1.5 and offset.Y < Settings.ButtonHeight then
						onButton = pad
						break
					end
				end
			end
		end
		local now = os.clock()
		local inside = insideButton[player]
		if onButton then
			if not inside then
				-- Ką tik užlipo
				insideButton[player] = { Pad = onButton, At = now }
				self:OnButtonTouched(player, state, buttonInfo[onButton])
			elseif inside.Pad == onButton and now - inside.At >= BUTTON_RETRY then
				-- Vis dar stovi ant to paties (pvz. laukė, kol užteks litų)
				inside.At = now
				self:OnButtonTouched(player, state, buttonInfo[onButton])
			end
			-- Naujas mygtukas toje pačioje vietoje (po pirkimo) neperkamas, kol nenulips
		else
			insideButton[player] = nil
		end
	end
end

function TycoonService:RefreshButtons(player)
	local state = states[player]
	local data = S.DataService:Get(player)
	if not state or not data then
		return
	end
	state.Plot.Buttons:ClearAllChildren()
	for _, lineId in ipairs(ProductLines.Order) do
		if Calc.IsLineUnlocked(data, lineId) then
			local purchase = Calc.GetNextPurchase(data, lineId)
			if purchase then
				self:CreateButton(state, self:GetButtonPosition(purchase), { Kind = "Line", Id = purchase.Id, Price = purchase.Price, TextKey = purchase.Id })
			end
			local level, price = S.GrannyService:GetNextLevel(player, lineId)
			if level then
				local x = S.PlotService:GetLaneX(lineId) + L.GrannyButtonX
				self:CreateButton(state, V(x, L.ZoneTopY + 0.25, L.GrannyButtonZ), { Kind = "Granny", Id = "Granny_" .. lineId, LineId = lineId, Price = price, TextKey = "Granny_" .. level })
			end
		end
	end
	for _, upgrade in ipairs(Calc.GetAvailableGlobalUpgrades(data)) do
		local x = L.ShelfButtonsX[upgrade.Slot]
		self:CreateButton(state, V(x, 0.25, L.ShelfButtonsZ), { Kind = "Global", Id = upgrade.Id, Price = upgrade.Price, TextKey = "Global_" .. upgrade.Id })
	end
end

function TycoonService:OnButtonTouched(player, state, info)
	if state.Player ~= player then
		if notifyDebounce:Check(player) then
			S.DataService:Notify(player, "NotYourPlot", nil, nil, nil, "error")
		end
		return
	end
	if states[player] ~= state then
		return
	end
	if not purchaseDebounce:Check(player) then
		return
	end
	if info.Kind == "Line" then
		self:PurchaseLine(player, info.Id)
	elseif info.Kind == "Granny" then
		S.GrannyService:Purchase(player, info.LineId)
	elseif info.Kind == "Global" then
		self:PurchaseGlobal(player, info.Id)
	end
end

-- Bando nurašyti litus; jei trūksta – praneša kiek
function TycoonService:TrySpend(player, price)
	local data = S.DataService:Get(player)
	if not data then
		return false
	end
	if data.money < price then
		if notifyDebounce:Check(player) then
			S.DataService:Notify(player, "NotEnough", nil, nil, { amount = math.ceil(price - data.money) }, "error")
		end
		return false
	end
	return S.DataService:SpendMoney(player, price)
end

----------------------------------------------------------------------
-- Pirkimai
----------------------------------------------------------------------
function TycoonService:PurchaseLine(player, purchaseId)
	local state = states[player]
	local data = S.DataService:Get(player)
	local purchase = ProductLines.ById[purchaseId]
	if not state or not data or not purchase then
		return
	end
	-- Griežta eilė: galima pirkti tik kitą linijos pirkinį
	if Calc.GetNextPurchase(data, purchase.Line) ~= purchase then
		return
	end
	if not self:TrySpend(player, purchase.Price) then
		return
	end
	data.purchases[purchase.Id] = true

	if purchase.Type == "Dropper" then
		if purchase.IncludesBase and not state.Lines[purchase.Line].HasBase then
			self:PlaceBase(state, purchase.Line, true)
		end
		self:PlaceDropper(state, purchase.Line, purchase.Slot, true)
	elseif purchase.Type == "Base" then
		self:PlaceBase(state, purchase.Line, true)
	elseif purchase.Type == "Upgrader" then
		self:PlaceUpgrader(state, purchase, true)
	elseif purchase.Type == "Unlock" then
		local target = purchase.Unlocks
		S.PlotService:SetZoneUnlocked(state.Plot, target, true)
		self:BuildLine(state, target, Calc.GetLineState(data, target), true)
		S.GrannyService:BuildLine(player, target)
		if Calc.IsShelfUnlocked(data) then
			self:PlaceShelf(state, true)
		end
		S.DataService:Notify(player, "LineUnlocked", nil, { line = "Line_" .. target }, nil, "success")
	elseif purchase.Type == "Decoration" then
		self:PlaceDecoration(state, purchase, true)
		if purchase.Badge then
			S.MonetizationService:AwardBadge(player, purchase.Badge)
		end
		S.DataService:Notify(player, "GoldenStatueDone", nil, nil, nil, "success")
	end

	S.DataService:Notify(player, "Bought", nil, { item = purchase.Id }, nil, "success")
	self:RefreshButtons(player)
	self:UpdateIncome(player)
end

function TycoonService:PurchaseGlobal(player, upgradeId)
	local state = states[player]
	local data = S.DataService:Get(player)
	if not state or not data then
		return
	end
	local entry = nil
	for _, upgrade in ipairs(Calc.GetAvailableGlobalUpgrades(data)) do
		if upgrade.Id == upgradeId then
			entry = upgrade
		end
	end
	if not entry then
		return
	end
	if not self:TrySpend(player, entry.Price) then
		return
	end
	if entry.Kind == "DropperSpeed" then
		data.globalUpgrades.DropperSpeed = entry.Level
		Remotes.MachineBuilt:FireClient(player, (state.Plot.CFrame * CF(L.ShelfX, 4, L.ShelfZ)).Position)
	elseif entry.Kind == "Gate" then
		data.globalUpgrades.Gate = entry.Level
		S.PlotService:ApplyGate(state.Plot, entry.Level)
		Remotes.MachineBuilt:FireClient(player, (state.Plot.CFrame * CF(0, 6, L.GateZ)).Position)
	elseif entry.Kind == "Decor" then
		data.globalUpgrades[entry.Id] = true
		self:PlaceDecor(state, entry.Id, true)
	end
	S.DataService:Notify(player, "Bought", nil, { item = "Global_" .. entry.Id }, nil, "success")
	self:RefreshButtons(player)
	self:UpdateIncome(player)
end

----------------------------------------------------------------------
-- Žaliavos: atsiradimas, upgrader'iai, pardavimas
----------------------------------------------------------------------
function TycoonService:SpawnItem(state, lineId, dropCF, valueFactor)
	local line = ProductLines.Lines[lineId]
	local item = S.TemplateBuilder:CloneItem(lineId)
	item.Anchored = false
	item.CanQuery = false
	item.CanTouch = false
	item.CastShadow = false
	item:SetAttribute("Value", line.Item.Value)
	item:SetAttribute("Owner", state.Player.UserId)
	item:SetAttribute("Line", lineId)
	-- Pirma į Workspace (kad suvirintos detalės judėtų kartu), tada į vietą
	item.Parent = state.Plot.Items
	item.CFrame = dropCF * CF((math.random() - 0.5) * 0.6, 0, 0) * CFrame.Angles(0, math.random() * 6.28, 0)
	pcall(function()
		item:SetNetworkOwner(nil)
	end)
	table.insert(state.Items, {
		Part = item,
		Line = lineId,
		Born = os.clock(),
		Value = line.Item.Value,
		Factor = valueFactor,
		Applied = {},
	})
	state.ItemCount = state.ItemCount + 1
	local lineRec = state.Lines[lineId]
	if lineRec then
		lineRec.ItemCount = (lineRec.ItemCount or 0) + 1
	end
end

local function applyLook(part, purchase)
	-- Tikroviškas vaizdas po apdorojimo (Lib/FoodLooks)
	if purchase.ItemLook and FoodLooks.Apply(part, purchase.ItemLook) then
		return
	end
	-- Pirmas apdorojimas: žalios žaliavos detalės (gumbai, lapai) dingsta
	for _, child in ipairs(part:GetChildren()) do
		if child.Name == "Detail" then
			child:Destroy()
		end
	end
	if purchase.ItemColor then
		part.Color = purchase.ItemColor
	end
	if purchase.ItemMaterial then
		part.Material = purchase.ItemMaterial
	end
	if purchase.ItemSize then
		part.Size = purchase.ItemSize
	end
	if purchase.ItemMesh then
		S.TemplateBuilder:ApplyItemMesh(part, purchase.ItemMesh)
	end
	-- Priedas viršuje (grietinė, glajus, antspaudas, kaspinas...)
	if purchase.ItemTopping then
		local old = part:FindFirstChild("Topping")
		if old then
			old:Destroy()
		end
		local size = part.Size
		S.TemplateBuilder.AddDetail(part, "Topping", Vector3.new(size.X * 0.65, math.max(0.25, size.Y * 0.3), size.Z * 0.65),
			CF(0, size.Y / 2, 0), purchase.ItemTopping, Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
	end
end

function TycoonService:SellItem(state, data, rec)
	local player = state.Player
	if rec.Part:GetAttribute("Owner") ~= player.UserId then
		return
	end
	local lineRec = state.Lines[rec.Line]
	local amount = rec.Value * rec.Factor * (lineRec and lineRec.ValueBonus or 1) * state.IncomeMult
	S.DataService:AddMoney(player, amount, true)
	S.EventService:RecordSale(player, amount)
	data.stats.itemsSold = data.stats.itemsSold + 1
	local x = S.PlotService:GetLaneX(rec.Line)
	local position = (state.Plot.CFrame * CF(x, L.ZoneTopY + 5.5, L.SellZ)).Position
	Remotes.ItemSold:FireClient(player, amount, position)
end

function TycoonService:ProcessItems(state, data)
	local plotCF = state.Plot.CFrame
	local now = os.clock()
	local items = state.Items
	local i = 1
	while i <= #items do
		local rec = items[i]
		local part = rec.Part
		local remove = false
		if not part.Parent or now - rec.Born > Settings.ItemLifetime then
			remove = true
		else
			local lp = plotCF:PointToObjectSpace(part.Position)
			local lineRec = state.Lines[rec.Line]
			if lp.Y < Settings.FallKillDepth then
				remove = true
			elseif lineRec and math.abs(lp.X - S.PlotService:GetLaneX(rec.Line)) <= Settings.ItemLaneTolerance then
				-- Upgrader'is suveikia, kai produktas kerta jo liniją (patikima net serveriui strigus)
				local lastZ = rec.LastZ or (lp.Z + UPGRADER_WINDOW)
				for slot = 1, #L.UpgraderZ do
					local purchase = lineRec.Upgraders[slot]
					if purchase and not rec.Applied[slot] then
						local z = L.UpgraderZ[slot]
						if lp.Z <= z and lastZ >= z - 0.01 then
							rec.Applied[slot] = true
							rec.Value = Calc.ApplyUpgrade(rec.Value, purchase)
							part:SetAttribute("Value", rec.Value)
							part:SetAttribute("Upg_" .. purchase.Id, true)
							applyLook(part, purchase)
						end
					end
				end
				rec.LastZ = lp.Z
				if lineRec.HasBase and lp.Z <= L.SellTriggerZ and lp.Y < L.ConveyorHeight + 4 then
					self:SellItem(state, data, rec)
					remove = true
				end
			end
		end
		if remove then
			if part.Parent then
				part:Destroy()
			end
			items[i] = items[#items]
			items[#items] = nil
			state.ItemCount = state.ItemCount - 1
			local removedLine = state.Lines[rec.Line]
			if removedLine and removedLine.ItemCount then
				removedLine.ItemCount = math.max(0, removedLine.ItemCount - 1)
			end
		else
			i = i + 1
		end
	end
end

function TycoonService:TickState(state, dt)
	local player = state.Player
	local data = S.DataService:Get(player)
	if not data then
		return
	end
	local ctx = self:GetContext(player)
	state.IncomeMult = Calc.GetIncomeMultiplier(data, ctx)

	-- Kiekviena linija gauna savo dalį vietų, kad viena linija neužimtų visų (ir kitos nesustotų)
	local activeLines = 0
	for _, rec in pairs(state.Lines) do
		if next(rec.DropPoints) ~= nil then
			activeLines = activeLines + 1
		end
	end
	local perLine = math.max(Settings.MinItemsPerLine, math.floor(Settings.MaxItemsPerPlot / math.max(1, activeLines)))

	for lineId, rec in pairs(state.Lines) do
		if next(rec.DropPoints) ~= nil then
			local interval, valueFactor = Calc.GetDropInterval(data, lineId, ctx)
			rec.ValueBonus = Calc.GetLineValueBonus(data, lineId, ctx)
			for slot, dropCF in pairs(rec.DropPoints) do
				local timer = (rec.Timers[slot] or 0) + dt
				if timer >= interval then
					timer = timer - interval
					if timer > interval then
						timer = 0
					end
					if (rec.ItemCount or 0) < perLine and state.ItemCount < Settings.MaxItemsPerPlot + Settings.MinItemsPerLine then
						-- Jei anksčiau vietų nebuvo, praleisti produktai pridedami prie šio vertės (pajamos nedingsta)
						local backlog = rec.Backlog[slot] or 0
						rec.Backlog[slot] = 0
						self:SpawnItem(state, lineId, dropCF, valueFactor * (1 + backlog))
					else
						rec.Backlog[slot] = math.min((rec.Backlog[slot] or 0) + 1, 20)
					end
				end
				rec.Timers[slot] = timer
			end
		end
	end
	self:ProcessItems(state, data)
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function TycoonService:Init(services)
	S = services
end

function TycoonService:Start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator < Settings.ItemTickRate then
			return
		end
		local step = accumulator
		accumulator = 0
		for _, state in pairs(states) do
			local ok, err = pcall(self.TickState, self, state, step)
			if not ok then
				warn("[TycoonService] " .. tostring(err))
			end
		end
	end)

	-- Mygtukų tikrinimas pagal žaidėjo poziciją
	task.spawn(function()
		while true do
			task.wait(Settings.ButtonCheckRate)
			local ok, err = pcall(self.CheckButtons, self)
			if not ok then
				warn("[TycoonService] CheckButtons: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		insideButton[player] = nil
	end)

	-- Pajamų per sekundę atnaujinimas UI
	task.spawn(function()
		while true do
			task.wait(Settings.IncomeUpdateRate)
			for _, player in ipairs(Players:GetPlayers()) do
				if S.DataService:Get(player) then
					self:UpdateIncome(player)
				end
			end
		end
	end)
end

return TycoonService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX58"><Properties><string name="Name">WeaponService</string><ProtectedString name="Source"><![CDATA[--[[
	WeaponService – ginklai, perkami už litus lobby kalvėje (šaukštas, kočėlas, keptuvė).
	- Ginklu galima nustumti kitus žaidėjus (nežeidžia). Lobby (turgus) – saugi zona.
	- Nupirkti ginklai išsaugomi (data.weapons) ir lieka po rebirth.
	- Pirkimas: užlipti ant mygtuko kalvėje arba paspausti E.
	Kainos, jėga, atstumas ir pertrauka – Settings.Weapons.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = ReplicatedStorage:WaitForChild("Config")
local Settings = require(Config:WaitForChild("Settings"))
local Texts = require(Config:WaitForChild("Texts"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Build = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Build"))

local W = Settings.Weapons
local V = Vector3.new
local CF = CFrame.new
local C = Color3.fromRGB

local WeaponService = {}
local S
local defsById = {}
local pads = {}                  -- { Part = pad, Def = def }
local inside = {}                -- [player] = pad
local cooldowns = {}             -- [player] = { [id] = os.clock() }

for _, def in ipairs(W.Items) do
	defsById[def.Id] = def
end

----------------------------------------------------------------------
-- Įrankių (Tool) modeliai iš Parts
----------------------------------------------------------------------
local GRIP_ROTATION = CFrame.Angles(math.rad(90), math.rad(90), 0)

local function part(parent, handle, name, size, offset, color, material, meshType)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Wood
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = handle.CFrame * offset
	if meshType then
		Build.Mesh(p, meshType)
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

local function makeTool(def, lang)
	local tool = Instance.new("Tool")
	tool.Name = Texts.Get(lang, "Weapon_" .. def.Id)
	tool.ToolTip = Texts.Get(lang, "WeaponHint")
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("WeaponId", def.Id)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.CFrame = CF()

	local gripZ
	if def.Id == "Spoon" then
		handle.Size = V(0.3, 0.3, 3.2)
		handle.Color = C(205, 165, 105)
		handle.Material = Enum.Material.Wood
		handle.Parent = tool
		part(tool, handle, "Bowl", V(0.95, 0.3, 1.25), CF(0, 0, 2.05), C(205, 165, 105), Enum.Material.Wood, Enum.MeshType.Sphere)
		gripZ = -1.25
	elseif def.Id == "RollingPin" then
		handle.Size = V(0.8, 0.8, 3)
		handle.Color = C(220, 185, 130)
		handle.Material = Enum.Material.Wood
		handle.Parent = tool
		for _, z in ipairs({ -1.85, 1.85 }) do
			part(tool, handle, "End", V(0.35, 0.35, 0.7), CF(0, 0, z), C(160, 110, 60), Enum.Material.Wood)
		end
		gripZ = -1.85
	elseif def.Id == "Broom" then
		handle.Size = V(0.25, 0.25, 4.4)
		handle.Color = C(140, 95, 55)
		handle.Material = Enum.Material.Wood
		handle.Parent = tool
		part(tool, handle, "Binding", V(0.45, 0.45, 0.3), CF(0, 0, 2.2), C(170, 40, 40), Enum.Material.Fabric)
		local bristles = part(tool, handle, "Bristles", V(1.5, 0.35, 1.3), CF(0, 0, 3.0), C(225, 190, 100), Enum.Material.Grass)
		Build.Mesh(bristles, Enum.MeshType.Sphere)
		gripZ = -1.6
	elseif def.Id == "CepelinasCannon" then
		handle.Size = V(0.35, 0.6, 1.2)
		handle.Color = C(90, 60, 35)
		handle.Material = Enum.Material.Wood
		handle.Parent = tool
		local barrel = part(tool, handle, "Barrel", V(2.4, 0.75, 0.75), CF(0, 0.45, 1.0) * CFrame.Angles(0, math.rad(90), 0), C(60, 60, 65), Enum.Material.Metal)
		barrel.Shape = Enum.PartType.Cylinder
		part(tool, handle, "Ring", V(0.9, 0.9, 0.15), CF(0, 0.45, 2.1), C(220, 180, 60), Enum.Material.Metal)
		local ammo = part(tool, handle, "Ammo", V(0.55, 0.55, 0.85), CF(0, 0.45, 2.35), C(225, 220, 200), Enum.Material.SmoothPlastic, Enum.MeshType.Sphere)
		ammo.Name = "Ammo"
		gripZ = -0.3
	elseif def.Id == "SakotisClub" then
		handle.Size = V(0.32, 0.32, 1.8)
		handle.Color = C(120, 80, 45)
		handle.Material = Enum.Material.Wood
		handle.Parent = tool
		for i = 0, 4 do
			local radius = 1.3 - i * 0.2
			local layer = part(tool, handle, "Layer", V(0.45, radius, radius), CF(0, 0, 1.2 + i * 0.45) * CFrame.Angles(0, math.rad(90), 0), C(215, 160, 70), Enum.Material.SmoothPlastic)
			layer.Shape = Enum.PartType.Cylinder
			for k = 0, 3 do
				local a = k * math.pi / 2 + i * 0.4
				part(tool, handle, "Spike", V(0.18, 0.18, 0.3), CF(math.cos(a) * radius / 2, math.sin(a) * radius / 2, 1.2 + i * 0.45), C(150, 95, 40), Enum.Material.SmoothPlastic)
			end
		end
		gripZ = -0.6
	elseif def.Id == "AmberStaff" then
		handle.Size = V(0.22, 0.22, 4.6)
		handle.Color = C(240, 190, 55)
		handle.Material = Enum.Material.Metal
		handle.Parent = tool
		part(tool, handle, "Gem", V(0.6, 0.6, 0.7), CF(0, 0, 2.7), C(255, 150, 30), Enum.Material.Neon)
		for _, o in ipairs({ V(0.32, 0.32, 0), V(-0.32, 0.32, 0), V(0.32, -0.32, 0), V(-0.32, -0.32, 0) }) do
			part(tool, handle, "Cage", V(0.08, 0.08, 0.9), CF(o.X, o.Y, 2.7), C(240, 190, 55), Enum.Material.Metal)
		end
		gripZ = -1.6
	else -- Pan
		handle.Size = V(0.3, 0.3, 2.4)
		handle.Color = C(40, 40, 42)
		handle.Material = Enum.Material.Metal
		handle.Parent = tool
		local pan = part(tool, handle, "Pan", V(0.25, 2.6, 2.6), CF(0, 0, 2.4) * CFrame.Angles(0, 0, math.rad(90)), C(45, 45, 48), Enum.Material.Metal)
		pan.Shape = Enum.PartType.Cylinder
		gripZ = -0.85
	end
	tool.Grip = CF(0, 0, gripZ) * GRIP_ROTATION
	tool:SetAttribute("BaseGripZ", gripZ)
	return tool
end

----------------------------------------------------------------------
-- Davimas, pirkimas
----------------------------------------------------------------------
local function hasTool(player, id)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("WeaponId") == id then
					return true
				end
			end
		end
	end
	return false
end

function WeaponService:GiveTools(player)
	local data = S.DataService:Get(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not backpack then
		return
	end
	for _, def in ipairs(W.Items) do
		if data.weapons[def.Id] and not hasTool(player, def.Id) then
			local tool = makeTool(def, data.settings.lang)
			tool.Activated:Connect(function()
				self:Swing(player, tool, def)
			end)
			tool.Parent = backpack
		end
	end
end

function WeaponService:Purchase(player, id)
	local data = S.DataService:Get(player)
	local def = defsById[id]
	if not data or not def then
		return
	end
	if data.weapons[id] then
		S.DataService:Notify(player, "WeaponOwned", nil, { item = "Weapon_" .. id }, nil, "info")
		self:GiveTools(player)
		return
	end
	if not S.TycoonService:TrySpend(player, def.Price) then
		return
	end
	data.weapons[id] = true
	player:SetAttribute("Weapon_" .. id, true)
	self:GiveTools(player)
	S.DataService:Notify(player, "Bought", nil, { item = "Weapon_" .. id }, nil, "success")
end

----------------------------------------------------------------------
-- Mostas ir nustūmimas
----------------------------------------------------------------------
local function inSafeZone(position)
	return Vector3.new(position.X, 0, position.Z).Magnitude < W.SafeZoneRadius
end

function WeaponService:Swing(player, tool, def)
	cooldowns[player] = cooldowns[player] or {}
	local now = os.clock()
	if now - (cooldowns[player][def.Id] or 0) < def.Cooldown then
		return
	end
	cooldowns[player][def.Id] = now

	-- Mosto animacija (pasukama rankena)
	local baseZ = tool:GetAttribute("BaseGripZ") or 0
	tool.Grip = CF(0, 0, baseZ) * GRIP_ROTATION * CFrame.Angles(0, 0, math.rad(-80))
	task.delay(0.2, function()
		if tool.Parent then
			tool.Grip = CF(0, 0, baseZ) * GRIP_ROTATION
		end
	end)

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or inSafeZone(root.Position) then
		return
	end
	if def.Kind == "Projectile" then
		self:FireProjectile(player, root, def)
	elseif def.Kind == "Area" then
		self:AreaBlast(player, root, def)
	else
		local look = root.CFrame.LookVector
		for _, other, otherRoot in self:Targets(player) do
			local offset = otherRoot.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			if flat.Magnitude <= def.Range and flat.Magnitude > 0.01 and flat.Unit:Dot(look) > (def.Arc or 0.2) then
				self:Push(player, other, flat.Unit, def.Force)
			end
		end
	end
end

-- Kiti gyvi žaidėjai už saugios zonos: iteratorius (indeksas, žaidėjas, HumanoidRootPart)
function WeaponService:Targets(player)
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local otherChar = other.Character
			local otherRoot = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
			local humanoid = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
			if otherRoot and humanoid and humanoid.Health > 0 and not inSafeZone(otherRoot.Position) then
				table.insert(list, { other, otherRoot })
			end
		end
	end
	local i = 0
	return function()
		i = i + 1
		local entry = list[i]
		if entry then
			return i, entry[1], entry[2]
		end
	end
end

function WeaponService:Push(player, other, direction, force)
	local velocity = direction * force + Vector3.new(0, force * 0.45, 0)
	Remotes.Knockback:FireClient(other, velocity)
	S.DataService:Notify(other, "WeaponHit", { name = player.DisplayName }, nil, nil, "error")
end

-- Cepelinų patranka: skrendantis cepelinas, nustumia pirmą pataikytą žaidėją
function WeaponService:FireProjectile(player, root, def)
	local look = root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then
		return
	end
	flatLook = flatLook.Unit
	local start = root.Position + flatLook * 2.5 + Vector3.new(0, 1, 0)
	local ball = Instance.new("Part")
	ball.Name = "FlyingCepelinas"
	ball.Size = V(1.1, 1.1, 1.7)
	ball.Color = C(225, 220, 200)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CFrame = CFrame.lookAt(start, start + flatLook)
	Build.Mesh(ball, Enum.MeshType.Sphere)
	local cream = Instance.new("Part")
	cream.Name = "Cream"
	cream.Size = V(0.7, 0.3, 0.9)
	cream.Color = C(252, 250, 245)
	cream.Anchored = true
	cream.CanCollide = false
	cream.CanQuery = false
	cream.CanTouch = false
	cream.CFrame = ball.CFrame * CF(0, 0.55, 0)
	Build.Mesh(cream, Enum.MeshType.Sphere)
	ball.Parent = workspace
	cream.Parent = ball
	local travelled = 0
	task.spawn(function()
		while travelled < def.Range and ball.Parent do
			local dt = task.wait() or (1 / 30)
			local step = def.Speed * dt
			travelled = travelled + step
			local position = ball.Position + flatLook * step
			ball.CFrame = CFrame.lookAt(position, position + flatLook) * CFrame.Angles(0, 0, travelled * 0.3)
			cream.CFrame = ball.CFrame * CF(0, 0.55, 0)
			for _, other, otherRoot in self:Targets(player) do
				if (otherRoot.Position - position).Magnitude <= def.HitRadius then
					self:Push(player, other, flatLook, def.Force)
					Remotes.BigCepelinasBurst:FireClient(other, position)
					Remotes.BigCepelinasBurst:FireClient(player, position)
					ball:Destroy()
					return
				end
			end
		end
		if ball.Parent then
			ball:Destroy()
		end
	end)
end

-- Gintarinė lazda: auksinė banga aplink žaidėją nustumia visus šalia
function WeaponService:AreaBlast(player, root, def)
	local center = root.Position
	local ring = Instance.new("Part")
	ring.Name = "AmberWave"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = V(0.3, 2, 2)
	ring.Color = C(255, 180, 40)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.3
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CFrame = CF(center - Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	local diameter = def.Range * 2
	TweenService:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = V(0.3, diameter, diameter), Transparency = 1 }):Play()
	game:GetService("Debris"):AddItem(ring, 0.6)
	for _, other, otherRoot in self:Targets(player) do
		local offset = otherRoot.Position - center
		local flat = Vector3.new(offset.X, 0, offset.Z)
		if flat.Magnitude <= def.Range then
			local direction = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(1, 0, 0)
			self:Push(player, other, direction, def.Force)
		end
	end
end

----------------------------------------------------------------------
-- Kalvės mygtukai lobby
----------------------------------------------------------------------
local function createPad(def, cframe)
	local radius = 2.4
	local pad = Build.Part({
		Name = "WeaponPad_" .. def.Id, Parent = workspace.Lobby, Shape = Enum.PartType.Cylinder,
		Size = V(0.8, radius * 2, radius * 2), CFrame = cframe * CFrame.Angles(0, 0, math.rad(90)),
		Color = C(200, 60, 50), Material = Enum.Material.SmoothPlastic,
		Tags = { "WeaponPad" }, Attributes = { WeaponId = def.Id, Price = def.Price },
	})
	Build.Part({ Name = "Glow", Parent = pad, Shape = Enum.PartType.Cylinder, Size = V(0.12, radius * 2 + 1.2, radius * 2 + 1.2), CFrame = pad.CFrame * CF(-0.36, 0, 0), Color = C(200, 60, 50), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false })
	Build.Sign(pad, { Name = "NameSign", TextKey = "Weapon_" .. def.Id, Size = UDim2.fromScale(7, 1.8), Offset = V(0, 4.2, 0), MaxDistance = 60 })
	Build.Billboard(pad, { Name = "PriceLabel", TextKey = "MoneyAmount", Nums = { amount = def.Price }, Size = UDim2.fromScale(6, 1.3), Offset = V(0, 2.5, 0), MaxDistance = 60, Color = C(255, 225, 120) })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy / Pirkti"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		WeaponService:Purchase(player, def.Id)
	end)
	table.insert(pads, { Part = pad, Def = def })
end

function WeaponService:CheckPads()
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local found = nil
		if root then
			for _, rec in ipairs(pads) do
				local offset = root.Position - rec.Part.Position
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= 3.2 and offset.Y > -1.5 and offset.Y < 7 then
					found = rec
					break
				end
			end
		end
		if found then
			if inside[player] ~= found.Part then
				inside[player] = found.Part
				self:Purchase(player, found.Def.Id)
			end
		else
			inside[player] = nil
		end
	end
end

----------------------------------------------------------------------
-- Init / Start
----------------------------------------------------------------------
function WeaponService:Init(services)
	S = services
end

function WeaponService:Start()
	local shopCF = S.MapBuilder.Anchors.WeaponShopCFrame
	if shopCF then
		-- Dvi eilės: pirmoje 4 pigesni, antroje likę
		local perRow = 4
		for i, def in ipairs(W.Items) do
			local rowIndex = math.floor((i - 1) / perRow)
			local inRow = (i - 1) % perRow
			local count = math.min(perRow, #W.Items - rowIndex * perRow)
			local x = (inRow - (count - 1) / 2) * 6.5
			createPad(def, shopCF * CF(x, 0.4, -6.5 - rowIndex * 6.5))
		end
	end

	task.spawn(function()
		while true do
			task.wait(W.CheckRate)
			local ok, err = pcall(self.CheckPads, self)
			if not ok then
				warn("[WeaponService] " .. tostring(err))
			end
		end
	end)

	local function onCharacter(player)
		task.wait(0.5)
		self:GiveTools(player)
	end
	local function setup(player)
		player.CharacterAdded:Connect(function()
			onCharacter(player)
		end)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		setup(player)
	end
	Players.PlayerAdded:Connect(setup)

	S.DataService:OnPlayerLoaded(function(player, data)
		for id in pairs(data.weapons) do
			player:SetAttribute("Weapon_" .. id, true)
		end
		self:GiveTools(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		inside[player] = nil
		cooldowns[player] = nil
	end)
end

return WeaponService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerStorage" referent="RBX70"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX63"><Properties><string name="Name">Templates</string></Properties><Item class="Model" referent="RBX60"><Properties><string name="Name">Plot</string></Properties></Item>
<Item class="Folder" referent="RBX61"><Properties><string name="Name">Machines</string></Properties></Item>
<Item class="Folder" referent="RBX62"><Properties><string name="Name">Items</string></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX72"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX71"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX64"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--[[
	EffectsController – kliento efektai ir garsai:
	  - 3D užrašų vertimas pagal kalbą (žymė "Loc")
	  - pirkimo mygtukų spalva: žalia – gali nupirkti, raudona – trūksta litų
	  - iššokantys „+31 Lt“ tekstai, monetų / „pop“ garsai
	  - konvejerių juostų animacija, besisukančios dalys, močiučių animacija ir kalbos burbulai
	  - Bulvių lietus (dekoratyvios bulvės tik kliente), Didžiojo Cepelino sprogimas
	  - muzika, VIP barjerai ir VIP žymė pokalbyje
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Config = ReplicatedStorage:WaitForChild("Config")
local Texts = require(Config:WaitForChild("Texts"))
local Settings = require(Config:WaitForChild("Settings"))
local Sounds = require(Config:WaitForChild("Sounds"))
local NumberFormat = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormat"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local C = Color3.fromRGB
local V = Vector3.new

local GREEN = C(70, 190, 70)
local RED = C(200, 60, 50)
local NEUTRAL = C(150, 120, 80)

local function lang()
	return player:GetAttribute("Lang") or "en"
end

----------------------------------------------------------------------
-- Garsai
----------------------------------------------------------------------
local soundCache = {}

local function getSound(id, volume)
	if not id or id == "" then
		return nil
	end
	local sound = soundCache[id]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = volume or Sounds.SfxVolume
		sound.Parent = SoundService
		soundCache[id] = sound
	end
	return sound
end

local function playSfx(id)
	if player:GetAttribute("Sfx") == false then
		return
	end
	local sound = getSound(id, id == Sounds.Coin and Sounds.CoinVolume or nil)
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end

-- Fonė muzika: grojaraštis ratu, atsitiktinė pradžia
local playlist = {}
for _, id in ipairs(type(Sounds.Music) == "table" and Sounds.Music or { Sounds.Music }) do
	if id and id ~= "" then
		table.insert(playlist, id)
	end
end
local music = nil
local musicIndex = 0

-- Radijas „Magė“: kai groja, fono muzika pristabdoma
local function radioActive()
	return (ReplicatedStorage:GetAttribute("RadioId") or "") ~= ""
end

local function playNextTrack()
	if #playlist == 0 or not music then
		return
	end
	musicIndex = musicIndex % #playlist + 1
	music.SoundId = playlist[musicIndex]
	if player:GetAttribute("Music") ~= false and not radioActive() then
		music:Play()
	end
end

local function updateMusic()
	if #playlist == 0 then
		return
	end
	if not music then
		music = Instance.new("Sound")
		music.Name = "Music"
		music.Volume = Sounds.MusicVolume
		music.Looped = #playlist == 1
		music.Parent = SoundService
		music.Ended:Connect(playNextTrack)
		musicIndex = math.random(1, #playlist) - 1
		playNextTrack()
	end
	if radioActive() then
		if music.IsPlaying then
			music:Pause()
		end
	elseif player:GetAttribute("Music") ~= false then
		if not music.IsPlaying then
			if music.TimePosition > 0 then
				music:Resume()
			else
				music:Play()
			end
		end
	else
		music:Stop()
	end
end

local radioSound = nil

-- Paleidžia radiją nuo tos vietos, kur jis groja serveryje (vėliau prisijungusiems)
local function startRadioSynced(sound)
	task.spawn(function()
		local waited = 0
		while sound.Parent and sound.TimeLength <= 0 and waited < 10 do
			task.wait(0.25)
			waited = waited + 0.25
		end
		if not sound.Parent or sound ~= radioSound then
			return
		end
		local startedAt = ReplicatedStorage:GetAttribute("RadioStartedAt") or 0
		local elapsed = workspace:GetServerTimeNow() - startedAt
		if sound.TimeLength > 0 and elapsed > 1 then
			sound.TimePosition = elapsed % sound.TimeLength
		end
		if player:GetAttribute("Music") ~= false and not sound.IsPlaying then
			sound:Play()
		end
	end)
end

local function updateRadio()
	local id = ReplicatedStorage:GetAttribute("RadioId") or ""
	if id == "" then
		if radioSound then
			radioSound:Destroy()
			radioSound = nil
		end
		updateMusic()
		return
	end
	if not radioSound or radioSound.SoundId ~= id then
		if radioSound then
			radioSound:Destroy()
		end
		radioSound = Instance.new("Sound")
		radioSound.Name = "MageRadio"
		radioSound.SoundId = id
		radioSound.Looped = true
		radioSound.Volume = ReplicatedStorage:GetAttribute("RadioVolume") or Settings.Radio.Volume
		radioSound.Parent = SoundService
		startRadioSynced(radioSound)
	end
	radioSound.Volume = ReplicatedStorage:GetAttribute("RadioVolume") or Settings.Radio.Volume
	updateMusic()
	if player:GetAttribute("Music") == false then
		radioSound:Pause()
	elseif not radioSound.IsPlaying and radioSound.TimeLength > 0 then
		radioSound:Resume()
	end
end

----------------------------------------------------------------------
-- Vertimai
----------------------------------------------------------------------
local function localize(label)
	local key = label:GetAttribute("TextKey")
	if not key then
		return
	end
	local args = {}
	for name, value in pairs(label:GetAttributes()) do
		if string.sub(name, 1, 4) == "Arg_" then
			args[string.sub(name, 5)] = value
		elseif string.sub(name, 1, 7) == "ArgNum_" then
			args[string.sub(name, 8)] = NumberFormat.Format(value)
		elseif string.sub(name, 1, 7) == "ArgKey_" then
			args[string.sub(name, 8)] = Texts.Get(lang(), value)
		end
	end
	label.Text = Texts.Get(lang(), key, args)
end

local function watchLabel(label)
	if not label:IsA("TextLabel") and not label:IsA("TextButton") then
		return
	end
	localize(label)
	label.AttributeChanged:Connect(function()
		localize(label)
	end)
end

for _, label in ipairs(CollectionService:GetTagged("Loc")) do
	watchLabel(label)
end
CollectionService:GetInstanceAddedSignal("Loc"):Connect(watchLabel)

player:GetAttributeChangedSignal("Lang"):Connect(function()
	for _, label in ipairs(CollectionService:GetTagged("Loc")) do
		localize(label)
	end
end)

----------------------------------------------------------------------
-- Pirkimo mygtukai: spalva pagal litus
----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(0.1)
		local money = player:GetAttribute("Money") or 0
		local pulse = (math.sin(os.clock() * 5) + 1) / 2
		local function paint(button, color, neon)
			button.Color = color
			button.Material = neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
			local glow = button:FindFirstChild("Glow")
			if glow then
				glow.Color = color
			end
		end
		for _, button in ipairs(CollectionService:GetTagged("BuyButton")) do
			if button:IsA("BasePart") then
				if button:GetAttribute("OwnerId") == player.UserId then
					local canBuy = money >= (button:GetAttribute("Price") or 0)
					paint(button, canBuy and GREEN:Lerp(C(170, 255, 140), pulse * 0.6) or RED, canBuy)
				else
					paint(button, NEUTRAL, false)
				end
			end
		end
		for _, pad in ipairs(CollectionService:GetTagged("WeaponPad")) do
			if pad:IsA("BasePart") then
				local id = pad:GetAttribute("WeaponId")
				local owned = player:GetAttribute("Weapon_" .. tostring(id)) == true
				local priceLabel = pad:FindFirstChild("PriceLabel")
				local label = priceLabel and priceLabel:FindFirstChild("Text")
				if owned then
					paint(pad, C(214, 172, 58), true)
					if label and label:GetAttribute("TextKey") ~= "Owned" then
						label:SetAttribute("TextKey", "Owned")
					end
				else
					local canBuy = money >= (pad:GetAttribute("Price") or 0)
					paint(pad, canBuy and GREEN:Lerp(C(170, 255, 140), pulse * 0.6) or RED, canBuy)
				end
			end
		end
	end
end)

----------------------------------------------------------------------
-- Pakartotinai naudojami dalelių emiteriai (pigu: vienas Part kiekvienam efektui)
----------------------------------------------------------------------
local fxAnchorFolder = Instance.new("Folder")
fxAnchorFolder.Name = "ParticleFX"
fxAnchorFolder.Parent = workspace

local function makeEmitter(name, props)
	local anchor = Instance.new("Part")
	anchor.Name = name
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = V(0.2, 0.2, 0.2)
	anchor.Parent = fxAnchorFolder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	for key, value in pairs(props) do
		emitter[key] = value
	end
	emitter.Parent = anchor
	return function(position, count)
		anchor.CFrame = CFrame.new(position)
		emitter:Emit(count)
	end
end

local emitDust = makeEmitter("DropDust", {
	Color = ColorSequence.new(C(235, 220, 185)), Size = NumberSequence.new(0.7, 0), Lifetime = NumberRange.new(0.3, 0.6),
	Speed = NumberRange.new(2, 4), SpreadAngle = Vector2.new(180, 180), Transparency = NumberSequence.new(0.3, 1),
})
local emitSparkle = makeEmitter("UpgradeSparkle", {
	Color = ColorSequence.new(C(255, 235, 130), C(255, 160, 60)), Size = NumberSequence.new(0.45, 0), Lifetime = NumberRange.new(0.4, 0.7),
	Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(180, 180), LightEmission = 1, Texture = "rbxasset://textures/particles/sparkles_main.dds",
})
local emitCoins = makeEmitter("SellCoins", {
	Color = ColorSequence.new(C(255, 210, 60)), Size = NumberSequence.new(0.5, 0.3), Lifetime = NumberRange.new(0.6, 0.9),
	Speed = NumberRange.new(8, 12), SpreadAngle = Vector2.new(25, 25), Acceleration = V(0, -35, 0), EmissionDirection = Enum.NormalId.Top,
	LightEmission = 0.4,
})

-- Savo sklypo produktai: dulkės iškritus, kibirkštys pravažiavus upgrader'į
local watchedItemFolders = {}
local function watchOwnPlot()
	local index = player:GetAttribute("PlotIndex") or 0
	local plots = workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot_" .. index)
	local items = plot and plot:FindFirstChild("Items")
	if not items or watchedItemFolders[items] then
		return
	end
	watchedItemFolders[items] = true
	items.ChildAdded:Connect(function(item)
		if not item:IsA("BasePart") or player:GetAttribute("PlotIndex") ~= index then
			return
		end
		task.defer(function()
			if item.Parent then
				emitDust(item.Position, 6)
			end
		end)
		item.AttributeChanged:Connect(function(name)
			if string.sub(name, 1, 4) == "Upg_" and item.Parent then
				emitSparkle(item.Position, 12)
			end
		end)
	end)
end
player:GetAttributeChangedSignal("PlotIndex"):Connect(watchOwnPlot)
task.defer(watchOwnPlot)

----------------------------------------------------------------------
-- „+31 Lt“ tekstai ir garsai
----------------------------------------------------------------------
local coinTimes = {}
local floatFolder = Instance.new("Folder")
floatFolder.Name = "FloatingTexts"
floatFolder.Parent = workspace

local function floatingText(text, position, color)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = V(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = floatFolder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 1.6)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 90
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Fondamento
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or C(255, 215, 80)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = C(60, 35, 10)
	label.Parent = gui
	local duration = Settings.UI.FloatingTextTime
	TweenService:Create(gui, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = V(0, 3.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, duration + 0.1)
end

Remotes.ItemSold.OnClientEvent:Connect(function(amount, position)
	emitCoins(position - V(0, 2.5, 0), 5)
	floatingText("+" .. NumberFormat.Format(amount) .. " Lt", position + V((math.random() - 0.5) * 1.5, 0, 0))
	local now = os.clock()
	local recent = 0
	for i = #coinTimes, 1, -1 do
		if now - coinTimes[i] < 1 then
			recent = recent + 1
		else
			table.remove(coinTimes, i)
		end
	end
	if recent < Settings.UI.MaxCoinSoundsPerSecond and player:GetAttribute("Beeps") ~= false then
		table.insert(coinTimes, now)
		playSfx(Sounds.Coin)
	end
end)

Remotes.MachineBuilt.OnClientEvent:Connect(function(position)
	playSfx(Sounds.Pop)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = floatFolder
	local puff = Instance.new("ParticleEmitter")
	puff.Color = ColorSequence.new(C(240, 225, 190))
	puff.Size = NumberSequence.new(1.5, 0)
	puff.Lifetime = NumberRange.new(0.5, 0.9)
	puff.Speed = NumberRange.new(6, 10)
	puff.SpreadAngle = Vector2.new(180, 180)
	puff.Rate = 0
	puff.Parent = anchor
	puff:Emit(25)
	Debris:AddItem(anchor, 1.5)
end)

Remotes.RebirthDone.OnClientEvent:Connect(function()
	playSfx(Sounds.Fanfare)
end)

Remotes.EventStarted.OnClientEvent:Connect(function()
	playSfx(Sounds.EventHorn)
end)

----------------------------------------------------------------------
-- Konvejerio juostos: judančios skersinės juostelės (tik kliente).
-- Juda Belt'o LookVector kryptimi – ta pačia, kuria serveris stumia produktus.
----------------------------------------------------------------------
local SLAT_SPACING = 5
local BELT_ANIMATION_DISTANCE = 160
local belts = {}
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ConveyorFX"
fxFolder.Parent = workspace

local function setupBelt(belt)
	if not belt:IsA("BasePart") or belts[belt] then
		return
	end
	local length = belt.Size.Z
	local slats = {}
	local slatColor = belt.Color:Lerp(C(0, 0, 0), 0.45)
	for i = 1, math.floor(length / SLAT_SPACING) do
		local slat = Instance.new("Part")
		slat.Name = "Slat"
		slat.Anchored = true
		slat.CanCollide = false
		slat.CanQuery = false
		slat.CanTouch = false
		slat.CastShadow = false
		slat.Size = V(belt.Size.X - 0.3, 0.06, 0.55)
		slat.Color = slatColor
		slat.Material = Enum.Material.SmoothPlastic
		slat.Transparency = belt.Transparency
		slat.Parent = fxFolder
		slats[i] = slat
	end
	belts[belt] = { Slats = slats, Length = length }
end

for _, belt in ipairs(CollectionService:GetTagged("ConveyorBelt")) do
	setupBelt(belt)
end
CollectionService:GetInstanceAddedSignal("ConveyorBelt"):Connect(setupBelt)
CollectionService:GetInstanceRemovedSignal("ConveyorBelt"):Connect(function(belt)
	local rec = belts[belt]
	if rec then
		for _, slat in ipairs(rec.Slats) do
			slat:Destroy()
		end
	end
	belts[belt] = nil
end)

----------------------------------------------------------------------
-- Močiutės: rankų animacija ir kalbos burbulai
----------------------------------------------------------------------
local grannies = {}

local function showBubble(granny, phraseIndex)
	local head = granny:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("SpeechBubble")
	if old then
		old:Destroy()
	end
	local phrases = Texts[lang()] and Texts[lang()].GrannyPhrases or Texts.en.GrannyPhrases
	local text = phrases[phraseIndex] or phrases[1]
	local gui = Instance.new("BillboardGui")
	gui.Name = "SpeechBubble"
	gui.Size = UDim2.fromScale(8, 2.6)
	gui.StudsOffset = V(0, 4.6, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.Parent = head
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = C(245, 232, 200)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.3, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = C(92, 58, 30)
	stroke.Thickness = 2
	stroke.Parent = frame
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.9, 0.84)
	label.Position = UDim2.fromScale(0.05, 0.08)
	label.Font = Enum.Font.Merriweather
	label.TextScaled = true
	label.TextColor3 = C(60, 35, 15)
	label.Text = text
	label.Parent = frame
	Debris:AddItem(gui, Settings.Grannies.PhraseShowTime)
	local root = granny:FindFirstChild("HumanoidRootPart")
	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	if root and myRoot and (root.Position - myRoot.Position).Magnitude < 40 and player:GetAttribute("Sfx") ~= false then
		local voiceId = Sounds.GrannyVoice and Sounds.GrannyVoice[phraseIndex]
		if voiceId and voiceId ~= "" then
			-- Lietuviškas močiutės balsas, girdisi šalia jos
			local voice = Instance.new("Sound")
			voice.Name = "GrannyVoice"
			voice.SoundId = voiceId
			voice.Volume = Sounds.GrannyVoiceVolume or 0.9
			voice.RollOffMinDistance = 8
			voice.RollOffMaxDistance = 45
			voice.Parent = head
			voice:Play()
			Debris:AddItem(voice, 8)
		else
			playSfx(Sounds.Giggle)
		end
	end
end

local function setupGranny(granny)
	if grannies[granny] then
		return
	end
	local motors = {}
	for _, d in ipairs(granny:GetDescendants()) do
		if d:IsA("Motor6D") and (d.Name == "RightShoulder" or d.Name == "LeftShoulder") then
			table.insert(motors, {
				Motor = d,
				Original = d.C0,
				Side = d.Name == "RightShoulder" and 1 or -1,
				Amp = d:GetAttribute("SwingAmp") or 0.45,
				Bias = d:GetAttribute("SwingBias") or 0.7,
			})
		end
	end
	local pivot = granny:GetPivot()
	local bits = {}
	for _, d in ipairs(granny:GetDescendants()) do
		if d.Name == "FloatBit" and d:IsA("BasePart") then
			table.insert(bits, { Part = d, Offset = pivot:ToObjectSpace(d.CFrame), Phase = math.random() * 6 })
		end
	end
	local rec = { Motors = motors, Offset = math.random() * 6, Bits = bits }
	grannies[granny] = rec

	-- Nusileidimas iš dangaus (tik ką nupirkta močiutė)
	local arrive = granny:GetAttribute("ArriveAt")
	if arrive and workspace:GetServerTimeNow() - arrive < 2.5 then
		local level = granny:GetAttribute("Level") or 1
		local beamColor = ({ C(150, 230, 120), C(255, 215, 80), C(255, 190, 60) })[level] or C(255, 255, 255)
		local beam = Instance.new("Part")
		beam.Name = "ArrivalBeam"
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
		beam.Shape = Enum.PartType.Cylinder
		beam.Material = Enum.Material.Neon
		beam.Color = beamColor
		beam.Transparency = 0.55
		beam.Size = V(70, 3.4, 3.4)
		beam.CFrame = pivot * CFrame.new(0, 35, 0) * CFrame.Angles(0, 0, math.rad(90))
		beam.Parent = fxAnchorFolder
		local shadow = Instance.new("Part")
		shadow.Name = "ArrivalShadow"
		shadow.Anchored = true
		shadow.CanCollide = false
		shadow.CanQuery = false
		shadow.CanTouch = false
		shadow.CastShadow = false
		shadow.Shape = Enum.PartType.Cylinder
		shadow.Material = Enum.Material.SmoothPlastic
		shadow.Color = C(20, 20, 20)
		shadow.Transparency = 0.5
		shadow.Size = V(0.05, 0.6, 0.6)
		shadow.CFrame = pivot * CFrame.new(0, -0.38, 0) * CFrame.Angles(0, 0, math.rad(90))
		shadow.Parent = fxAnchorFolder
		rec.Descend = { Base = pivot, Start = os.clock(), Duration = 1.9, Height = 55, Beam = beam, Shadow = shadow, Level = level }
		-- Saugiklis: šviesos tunelis visada dingsta, net jei močiutė pakeičiama animacijos metu
		Debris:AddItem(beam, 4)
		Debris:AddItem(shadow, 4)
		granny:PivotTo(pivot * CFrame.new(0, 55, 0))
	end
	granny:GetAttributeChangedSignal("Phrase"):Connect(function()
		local value = granny:GetAttribute("Phrase") or ""
		local index = tonumber(string.match(value, "^(%d+):"))
		if index then
			showBubble(granny, index)
		end
	end)
end

for _, granny in ipairs(CollectionService:GetTagged("Granny")) do
	setupGranny(granny)
end
CollectionService:GetInstanceAddedSignal("Granny"):Connect(setupGranny)
local function clearDescend(rec)
	local d = rec and rec.Descend
	if d then
		rec.Descend = nil
		if d.Beam then
			d.Beam:Destroy()
		end
		if d.Shadow then
			d.Shadow:Destroy()
		end
	end
end

CollectionService:GetInstanceRemovedSignal("Granny"):Connect(function(granny)
	clearDescend(grannies[granny])
	grannies[granny] = nil
end)

