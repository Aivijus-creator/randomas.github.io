<Item class="ServerStorage" referent="RBX121"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX120"><Properties><string name="Name">Maps</string></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX150"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">40</float><float name="CharacterWalkSpeed">16</float></Properties><Item class="StarterPlayerScripts" referent="RBX149"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX148"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX142"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX122"><Properties><string name="Name">AnimationController</string><ProtectedString name="Source"><![CDATA[-- AnimationController: plays real animations when a model has an Animator + ids, otherwise procedural
-- animations on the body joint (Idle, Walk, Cry, Tantrum, Eat, Sleep, Happy, Carried, Frozen, Chaos).
-- Also handles ghost visibility (hidden / blackout, revealed by any flashlight cone).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Config.Assets)
local MathUtil = require(Shared.Util.Math)

local AnimationController = {}
local entries: { [Model]: any } = {}

local function findJoint(model: Model): (JointInstance?, CFrame?)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil, nil
	end
	local j = root:FindFirstChild("BodyJoint")
	if j and j:IsA("JointInstance") then
		return j, j.C0
	end
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Part0 == root then
			return d, d.C0
		end
	end
	return nil, nil
end

local function animationId(model: Model, name: string): number?
	local folder = model:FindFirstChild("Animations")
	local a = folder and folder:FindFirstChild(name)
	if a and a:IsA("Animation") and a.AnimationId ~= "" then
		return -1 -- use the Animation object itself
	end
	local id = model:GetAttribute("BabyId")
	local per = id and Assets.Animations.Babies[id]
	local v = (per and per[name]) or Assets.Animations.BabyDefault[name]
	if v and v ~= 0 then
		return v
	end
	return nil
end

local function setup(model: Model)
	if entries[model] then
		return
	end
	local joint, baseC0 = findJoint(model)
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	local entry = {
		Model = model,
		Joint = joint,
		BaseC0 = baseC0,
		Animator = animator,
		Tracks = {} :: { [string]: AnimationTrack },
		Current = nil :: string?,
		Phase = math.random() * 10,
		Body = nil :: BasePart?,
		BodySize = nil :: Vector3?,
		Highlight = nil :: Highlight?,
		Parts = {} :: { BasePart },
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("SquashPart") then
				entry.Body = d
				entry.BodySize = d.Size / ((model:GetAttribute("Scale") or 1) :: number)
			end
			if d.Name ~= "HumanoidRootPart" then
				table.insert(entry.Parts, d)
			end
		end
	end
	entries[model] = entry
	model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			entries[model] = nil
		end
	end)
end

local function playReal(entry, name: string): boolean
	local animator = entry.Animator :: Animator?
	if not animator then
		return false
	end
	local track = entry.Tracks[name]
	if not track then
		local id = animationId(entry.Model, name)
		if not id then
			return false
		end
		local anim: Animation
		if id == -1 then
			anim = entry.Model.Animations[name]
		else
			anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://" .. tostring(id)
		end
		local ok, t = pcall(animator.LoadAnimation, animator, anim)
		if not ok then
			return false
		end
		track = t
		track.Looped = name ~= "Chaos" and name ~= "Eat" and name ~= "Happy"
		entry.Tracks[name] = track
	end
	if entry.Current ~= name then
		for n, t in entry.Tracks do
			if n ~= name and t.IsPlaying then
				t:Stop(0.2)
			end
		end
		track:Play(0.2)
		entry.Current = name
	end
	return true
end

local function procedural(entry, anim: string, t: number)
	local joint = entry.Joint
	if not joint or not entry.BaseC0 then
		return
	end
	local p = t + entry.Phase
	local offset = CFrame.new()
	local squash = 1
	local floatY = if entry.Model:GetAttribute("BabyId") == "Ghostie" then math.sin(p * 2) * 0.25 else 0
	if anim == "Idle" then
		offset = CFrame.new(0, math.sin(p * 2) * 0.06, 0)
		squash = 1 + math.sin(p * 2) * 0.03
	elseif anim == "Walk" then
		local hop = math.abs(math.sin(p * 9))
		offset = CFrame.new(0, hop * 0.55, 0) * CFrame.Angles(0, 0, math.sin(p * 9) * 0.12)
		squash = 1 + (0.5 - hop) * 0.18
	elseif anim == "Cry" then
		offset = CFrame.new(math.sin(p * 40) * 0.06, 0, 0) * CFrame.Angles(math.rad(-8), 0, 0)
	elseif anim == "Tantrum" then
		local hop = math.abs(math.sin(p * 16))
		offset = CFrame.new(math.sin(p * 30) * 0.1, hop * 0.7, 0) * CFrame.Angles(0, 0, math.sin(p * 16) * 0.25)
		squash = 1 + (0.5 - hop) * 0.25
	elseif anim == "Eat" then
		offset = CFrame.Angles(math.sin(p * 14) * 0.25, 0, 0)
	elseif anim == "Sleep" then
		offset = CFrame.new(0, math.sin(p * 1.2) * 0.04, 0) * CFrame.Angles(0, 0, math.rad(25))
		squash = 1 + math.sin(p * 1.2) * 0.04
	elseif anim == "Happy" then
		local cycle = p % 2.5
		if cycle < 0.6 then
			local k = cycle / 0.6
			offset = CFrame.new(0, math.sin(k * math.pi) * 1.1, 0) * CFrame.Angles(0, k * math.pi * 2, 0)
		else
			offset = CFrame.new(0, math.sin(p * 3) * 0.08, 0)
		end
	elseif anim == "Carried" then
		offset = CFrame.Angles(math.sin(p * 5) * 0.12, 0, math.sin(p * 3.5) * 0.15)
	elseif anim == "Frozen" then
		offset = CFrame.new()
	elseif anim == "Chaos" then
		local k = (p * 2) % 1
		offset = if k < 0.6 then CFrame.Angles(math.rad(-25) * (k / 0.6), 0, 0) else CFrame.Angles(math.rad(30), 0, 0)
	end
	joint.C0 = entry.BaseC0 * CFrame.new(0, floatY, 0) * offset
	if entry.Body and entry.BodySize then
		-- BodySize is the size at scale 1; the server may grow the model (Slimy) via the Scale attribute.
		local s = (entry.Model:GetAttribute("Scale") or 1) :: number
		local base = entry.BodySize * s
		entry.Body.Size = Vector3.new(base.X / math.sqrt(squash), base.Y * squash, base.Z / math.sqrt(squash))
	end
	-- red tint during tantrums
	if anim == "Tantrum" and not entry.Highlight then
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.fromRGB(255, 60, 60)
		hl.FillTransparency = 0.6
		hl.OutlineTransparency = 0.6
		hl.OutlineColor = Color3.fromRGB(255, 80, 80)
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = entry.Model
		entry.Highlight = hl
	elseif anim ~= "Tantrum" and entry.Highlight then
		entry.Highlight:Destroy()
		entry.Highlight = nil
	end
end

-- Ghost visibility --------------------------------------------------------------------------

local function revealedByFlashlight(pos: Vector3): boolean
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("FlashlightOn") then
			local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then
				local range = (p:GetAttribute("FlashlightRange") or 30) + 2
				local angle = (p:GetAttribute("FlashlightAngle") or 22) + 6
				if MathUtil.inCone(r.Position, r.CFrame.LookVector, pos, range, angle) then
					return true
				end
			end
		end
	end
	return false
end

function AnimationController:IsGhostVisible(model: Model): boolean
	local root = model.PrimaryPart
	if not root then
		return true
	end
	local hidden = model:GetAttribute("Hidden") == true
	local dc = model:FindFirstAncestorWhichIsA("Model")
	while dc and not dc.Name:match("^Daycare_") do
		dc = dc:FindFirstAncestorWhichIsA("Model")
	end
	local dark = dc ~= nil and dc:GetAttribute("PowerOn") == false
	if not hidden and not dark then
		return true
	end
	return revealedByFlashlight(root.Position)
end

local function updateGhost(entry)
	local model = entry.Model
	local visible = AnimationController:IsGhostVisible(model)
	local target = if visible then 0 else 0.95
	if entry.GhostT ~= target then
		entry.GhostT = target
		for _, p in entry.Parts do
			p.LocalTransparencyModifier = target
		end
		local tag = model:FindFirstChild("NameTag", true)
		if tag and tag:IsA("BillboardGui") then
			tag.Enabled = visible
		end
		local trail = model:FindFirstChild("GhostTrail", true)
		if trail and trail:IsA("Trail") then
			trail.Enabled = visible or model:GetAttribute("Hidden") == true
		end
	end
	model:SetAttribute("LocallyVisible", visible)
end

function AnimationController:Start()
	for _, tag in { "Baby", "PetModel", "NPCModel" } do
		for _, m in CollectionService:GetTagged(tag) do
			if m:IsA("Model") then
				setup(m)
			end
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(m)
			if m:IsA("Model") then
				task.defer(setup, m)
			end
		end)
	end
	local t0 = os.clock()
	RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for model, entry in entries do
			local root = model.PrimaryPart
			if root and (root.Position - camPos).Magnitude < 160 then
				local anim = model:GetAttribute("Anim") or "Idle"
				if not playReal(entry, anim) then
					procedural(entry, anim, t)
				end
				if model:GetAttribute("BabyId") == "Ghostie" and not model:GetAttribute("Pet") then
					updateGhost(entry)
				end
			end
		end
	end)
end

return AnimationController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX123"><Properties><string name="Name">BubbleController</string><ProtectedString name="Source"><![CDATA[-- BubbleController: need bubbles over babies, mood rings under them, and screen-edge arrows pointing at
-- babies in a tantrum (or the one the player tapped in the baby list).
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Needs = require(Shared.Config.Needs)
local Babies = require(Shared.Config.Babies)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local BubbleController = {}
local bubbles: { [Model]: any } = {}
local arrowGui: ScreenGui
local arrows: { [Model]: ImageLabel | TextLabel } = {}
local locateTarget: Model? = nil
local locateUntil = 0

local YELLOW = Color3.fromRGB(255, 220, 100)
local RED = Color3.fromRGB(240, 90, 90)

local function lowestNeed(model: Model): (string?, number)
	local list = model:GetAttribute("NeedList") or ""
	local best, bestV = nil, math.huge
	for n in string.gmatch(list, "[^,]+") do
		local v = model:GetAttribute("N_" .. n) or 100
		if v < bestV then
			best, bestV = n, v
		end
	end
	return best, bestV
end

local function inMySession(model: Model): boolean
	return State.Shift ~= nil and model:GetAttribute("Session") == State.Shift.Slot
end

local function setup(model: Model)
	if bubbles[model] or model:GetAttribute("Pet") then
		return
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	local adornee = root:FindFirstChild("HeadTop") or root
	local bb = Instance.new("BillboardGui")
	bb.Name = "NeedBubble"
	bb.Size = UDim2.fromOffset(54, 54)
	bb.StudsOffset = Vector3.new(0, if adornee == root then 3 else 1.4, 0)
	bb.MaxDistance = 120
	bb.LightInfluence = 0
	bb.Adornee = adornee
	bb.Enabled = false
	bb.Parent = root
	local bubble = Instance.new("Frame")
	bubble.Size = UDim2.fromScale(1, 1)
	bubble.BackgroundColor3 = YELLOW
	bubble.Parent = bb
	UI.corner(bubble, UDim.new(1, 0))
	UI.stroke(bubble, UI.Theme.Colors.Plum, 3)
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(0.8, 0.8)
	icon.Position = UDim2.fromScale(0.1, 0.1)
	icon.BackgroundTransparency = 1
	icon.TextScaled = true
	icon.Text = ""
	icon.Parent = bubble
	local scale = Instance.new("UIScale")
	scale.Parent = bubble
	-- mood ring (local only)
	local ring = Instance.new("Part")
	ring.Name = "MoodRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.08, 3.2, 3.2)
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.55
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Anchored = true
	ring.CastShadow = false
	ring.Parent = workspace
	bubbles[model] = { BB = bb, Bubble = bubble, Icon = icon, Scale = scale, Ring = ring, Root = root }
	model.AncestryChanged:Connect(function(_, parent)
		if not parent then
			ring:Destroy()
			bubbles[model] = nil
			local a = arrows[model]
			if a then
				a:Destroy()
				arrows[model] = nil
			end
		end
	end)
end

function BubbleController:Locate(uid: string)
	for _, m in CollectionService:GetTagged("Baby") do
		if m:GetAttribute("Uid") == uid then
			locateTarget = m
			locateUntil = os.clock() + 5
		end
	end
end

local function arrowFor(model: Model)
	local a = arrows[model]
	if not a then
		local l = Instance.new("TextLabel")
		l.Size = UDim2.fromOffset(56, 56)
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.BackgroundColor3 = RED
		l.TextScaled = true
		l.Font = Enum.Font.FredokaOne
		l.TextColor3 = Color3.new(1, 1, 1)
		l.Parent = arrowGui
		UI.corner(l, UDim.new(1, 0))
		UI.stroke(l, Color3.new(1, 1, 1), 3)
		local def = Babies.Defs[model:GetAttribute("BabyId") or ""]
		l.Text = (def and def.Emoji or "!")
		arrows[model] = l
		a = l
	end
	return a
end

function BubbleController:Start()
	arrowGui = UI.screen("ArrowsGui", 3)
	local sc = arrowGui:FindFirstChildOfClass("UIScale")
	if sc then
		sc:Destroy() -- arrows use raw viewport pixels
	end
	for _, m in CollectionService:GetTagged("Baby") do
		if m:IsA("Model") then
			setup(m)
		end
	end
	CollectionService:GetInstanceAddedSignal("Baby"):Connect(function(m)
		if m:IsA("Model") then
			task.defer(setup, m)
		end
	end)
	local t0 = os.clock()
	RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local cam = workspace.CurrentCamera
		local vp = cam.ViewportSize
		local used = {}
		for model, b in bubbles do
			local mine = inMySession(model)
			local need, v = lowestNeed(model)
			local tantrum = (model:GetAttribute("Tantrum") or "") ~= ""
			local visible = model:GetAttribute("LocallyVisible") ~= false
			local anim = model:GetAttribute("Anim")
			local show = mine and visible and anim ~= "Frozen" and model:GetAttribute("State") ~= "Leaving" and (tantrum or v < Needs.Thresholds.Bubble)
			b.BB.Enabled = show
			if show then
				local needId = if tantrum then model:GetAttribute("Tantrum") else need
				local def = needId and Needs.Defs[needId]
				b.Icon.Text = if tantrum then "💢" .. (def and def.Emoji or "") else (def and def.Emoji or "?")
				local red = tantrum or v < Needs.Thresholds.Crying
				b.Bubble.BackgroundColor3 = if red then RED else YELLOW
				b.BB.AlwaysOnTop = red
				b.Scale.Scale = 1 + math.sin(t * (if red then 9 else 5)) * 0.08
			end
			-- mood ring
			local mood = model:GetAttribute("Mood") or 70
			b.Ring.Transparency = if mine and visible and model:GetAttribute("State") ~= "Leaving" then 0.55 else 1
			if mine then
				b.Ring.Color = if mood > 70 then Color3.fromRGB(120, 230, 140) elseif mood > 35 then YELLOW else RED
				local root = b.Root
				local offset = model:GetAttribute("FloorOffset") or 1.45
				b.Ring.CFrame = CFrame.new(root.Position - Vector3.new(0, offset * (model:GetAttribute("Scale") or 1) - 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
			end
			-- edge arrows
			local wantArrow = mine and visible and (tantrum or (model == locateTarget and os.clock() < locateUntil))
			if wantArrow then
				local sp, onScreen = cam:WorldToViewportPoint(b.Root.Position)
				local isLocate = model == locateTarget and os.clock() < locateUntil
				if not onScreen or isLocate then
					local a = arrowFor(model)
					local x, y = sp.X, sp.Y
					if sp.Z < 0 then
						x, y = vp.X - x, vp.Y - y
					end
					x = math.clamp(x, 40, vp.X - 40)
					y = math.clamp(y, 60, vp.Y - 60)
					if onScreen and isLocate then
						y = math.max(60, y - 70)
					end
					a.Position = UDim2.fromOffset(x, y)
					a.BackgroundColor3 = if tantrum then RED else UI.Theme.Colors.Lavender
					a.Visible = true
					used[model] = true
				end
			end
		end
		for model, a in arrows do
			if not used[model] then
				a.Visible = false
			end
		end
	end)
	local _ = TweenService
end

return BubbleController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX124"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- CameraController: camera shake (setting-aware), hides daycare ceilings while inside, zoom limits.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local State = require(script.Parent.Parent.State)

local player = Players.LocalPlayer
local CameraController = { Locked = false }
local Controllers
local shake = 0

function CameraController:Shake(intensity: number, pos: Vector3?, radius: number?)
	local settings = Controllers.SettingsController.Settings
	if settings.CameraShake == false then
		return
	end
	if pos and radius then
		local c = player.Character
		local r = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not r or (r.Position - pos).Magnitude > radius then
			return
		end
	end
	shake = math.max(shake, intensity)
end

local function setCeilings(hidden: boolean)
	for _, c in CollectionService:GetTagged("Ceiling") do
		if c:IsA("BasePart") then
			c.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

function CameraController:Init(c)
	Controllers = c
end

function CameraController:Start()
	Remotes.event("CameraShake").OnClientEvent:Connect(function(i, pos, radius)
		self:Shake(i, pos, radius)
	end)
	CollectionService:GetInstanceAddedSignal("Ceiling"):Connect(function(c)
		if State.inShift() and c:IsA("BasePart") then
			c.LocalTransparencyModifier = 1
		end
	end)
	State.ShiftChanged:Connect(function(shift)
		setCeilings(shift ~= nil)
		player.CameraMaxZoomDistance = if shift then 32 else 40
	end)
	RunService:BindToRenderStep("MonstergartenShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if shake > 0.01 and not self.Locked then
			local cam = workspace.CurrentCamera
			local t = os.clock() * 40
			cam.CFrame = cam.CFrame * CFrame.Angles(math.noise(t, 0) * shake * 0.05, math.noise(0, t) * shake * 0.05, 0)
			shake = math.max(0, shake - dt * 2)
		end
	end)
end

return CameraController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX125"><Properties><string name="Name">CutsceneController</string><ProtectedString name="Source"><![CDATA[-- CutsceneController: parents drop-off / pick-up scenes at the hall window, screen fades, skip button.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local ModelRegistry = require(Shared.World.ModelRegistry)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local CutsceneController = { Active = false }
local Controllers
local gui: ScreenGui
local fade: Frame
local skipBtn: TextButton
local caption: TextLabel
local props: { Instance } = {}
local renderConn: RBXScriptConnection? = nil

local function clearProps()
	for _, p in props do
		p:Destroy()
	end
	props = {}
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
end

local function daycare(slot: number): Model?
	local dc = workspace:FindFirstChild("Daycares")
	return dc and dc:FindFirstChild("Daycare_" .. tostring(slot)) :: Model?
end

local function windowOf(m: Model): Model?
	for _, w in CollectionService:GetTagged("ParentDropoff") do
		if w:IsDescendantOf(m) then
			return w :: Model
		end
	end
	return nil
end

local function spawnParents(window: Model, babies: { any }, faces: boolean)
	local spot = window:FindFirstChild("ParentSpot") :: BasePart?
	if not spot then
		return
	end
	local n = math.min(#babies, 4)
	local seen = {}
	local i = 0
	for _, b in babies do
		if not seen[b.Id] and i < n then
			seen[b.Id] = true
			i += 1
			local ok, parent = pcall(ModelRegistry.getParent, b.Id)
			if ok and parent then
				local x = (i - (n + 1) / 2) * 16
				local base = spot.CFrame * CFrame.new(x, 0, 6 + math.random() * 4)
				local offset = parent:GetAttribute("FloorOffset") or 8
				parent:PivotTo(CFrame.lookAt(base.Position + Vector3.new(0, offset - 3, 0), spot.Position + Vector3.new(0, offset - 3, -30)))
				parent.Parent = workspace
				table.insert(props, parent)
				local start = parent:GetPivot()
				local phase = math.random() * 3
				local conn = RunService.RenderStepped:Connect(function()
					local t = os.clock() + phase
					parent:PivotTo(start * CFrame.new(0, math.sin(t * 1.5) * 0.8, 0) * CFrame.Angles(0, 0, math.sin(t) * 0.04))
				end)
				parent.Destroying:Connect(function()
					conn:Disconnect()
				end)
			end
		end
	end
	if faces then
		-- face rating above each baby
		for _, b in babies do
			for _, m in CollectionService:GetTagged("Baby") do
				if m:GetAttribute("Uid") == b.Uid and m.PrimaryPart then
					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(70, 70)
					bb.StudsOffset = Vector3.new(0, 3.5, 0)
					bb.AlwaysOnTop = true
					bb.Adornee = m.PrimaryPart
					bb.Parent = player:WaitForChild("PlayerGui")
					local t = Instance.new("TextLabel")
					t.Size = UDim2.fromScale(1, 1)
					t.BackgroundTransparency = 1
					t.TextScaled = true
					t.Text = if b.Score >= 85 then "😃" elseif b.Score >= 50 then "😐" else "😢"
					t.Parent = bb
					table.insert(props, bb)
				end
			end
		end
	end
end

local function complaint()
	local paper = UI.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, -0.2, 0), Size = UDim2.fromOffset(260, 180), Rotation = -12, Parent = gui }, C.White)
	local l = UI.label("", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20), TextColor3 = C.Red, Parent = paper })
	UI.bind(l, "Cutscene_Complaint")
	TweenService:Create(paper, TweenInfo.new(2.2, Enum.EasingStyle.Bounce), { Position = UDim2.fromScale(0.5, 0.55), Rotation = 8 }):Play()
	if Controllers.SoundController then
		Controllers.SoundController:Play("Shift_Complaint")
	end
	table.insert(props, paper)
end

function CutsceneController:Play(kind: string, data: any)
	clearProps()
	local m = daycare(data.Slot)
	local window = m and windowOf(m)
	if not window then
		return
	end
	self.Active = true
	Controllers.CameraController.Locked = true
	local cam = workspace.CurrentCamera
	local camPoint = window:FindFirstChild("CameraPoint") :: BasePart?
	local target = window:GetPivot().Position
	local startCF = (camPoint and camPoint.CFrame or window:GetPivot() * CFrame.new(0, 2, -14))
	cam.CameraType = Enum.CameraType.Scriptable
	local from = CFrame.lookAt(startCF.Position + Vector3.new(0, 14, -10), target)
	local to = CFrame.lookAt(startCF.Position, target + Vector3.new(0, 4, 0))
	cam.CFrame = from
	TweenService:Create(cam, TweenInfo.new(2.2, Enum.EasingStyle.Sine), { CFrame = to }):Play()
	spawnParents(window, data.Babies or {}, kind == "Return")
	caption.Text = Strings.t(if kind == "Arrival" then "Cutscene_Arrival" else "Cutscene_Return")
	caption.Visible = true
	skipBtn.Visible = true
	if kind == "Return" and (data.Stars or 0) == 0 then
		task.delay(2.5, complaint)
	end
	if Controllers.SoundController then
		Controllers.SoundController:Play("Env_Bell")
	end
end

function CutsceneController:Stop()
	if not self.Active then
		return
	end
	self.Active = false
	clearProps()
	caption.Visible = false
	skipBtn.Visible = false
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		cam.CameraSubject = hum
	end
	Controllers.CameraController.Locked = false
end

function CutsceneController:Fade(fadeIn: boolean, time: number)
	TweenService:Create(fade, TweenInfo.new(time or 0.5), { BackgroundTransparency = if fadeIn then 0 else 1 }):Play()
end

function CutsceneController:Init(c)
	Controllers = c
	gui = UI.screen("CutsceneGui", 30)
	fade = UI.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 10, Parent = gui })
	caption = UI.label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40), Size = UDim2.fromOffset(700, 50), TextColor3 = C.White, TextStrokeTransparency = 0.3, Visible = false, Parent = gui })
	skipBtn = UI.button("", C.Peach, function()
		Remotes.event("CutsceneSkip"):FireServer()
		skipBtn.Text = "✔"
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(150, 48), Visible = false, Parent = gui })
	UI.bind(skipBtn, "Cutscene_Skip")
end

function CutsceneController:Start()
	Remotes.event("Cutscene").OnClientEvent:Connect(function(kind, data)
		if kind == "End" then
			self:Stop()
			UI.bind(skipBtn, "Cutscene_Skip")
		else
			self:Play(kind, data or {})
		end
	end)
	Remotes.event("Fade").OnClientEvent:Connect(function(fadeIn, time)
		self:Fade(fadeIn, time)
	end)
	State.ShiftChanged:Connect(function(s)
		if not s then
			self:Stop()
		end
	end)
end

return CutsceneController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX126"><Properties><string name="Name">DebugController</string><ProtectedString name="Source"><![CDATA[-- DebugController: F2 opens the debug menu (Studio / creator / whitelisted users only; the server re-checks).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Babies = require(Shared.Config.Babies)
local Events = require(Shared.Config.Events)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local DebugController = {}
local window
local showAI = false
local labels: { [Model]: BillboardGui } = {}

local function cmd(name: string, ...)
	Remotes.event("DebugCommand"):FireServer(name, ...)
end

local function section(parent: Instance, order: number, title: string)
	local f = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	UI.label(title, { Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	local row = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = f })
	UI.grid(row, UDim2.fromOffset(120, 36), 6)
	return row
end

local function small(parent: Instance, text: string, fn: () -> ())
	UI.button(text, C.Lavender, fn, { Size = UDim2.fromOffset(120, 36), Parent = parent })
end

function DebugController:Init()
	local gui = UI.screen("DebugGui", 40)
	window = UI.window(gui, "Debug_Title", UDim2.fromOffset(820, 560), C.Mint)
	local scroll = UI.scroll(window.Content)
	UI.list(scroll, 10)
	local babies = section(scroll, 1, "Spawn baby")
	for _, id in Babies.Order do
		small(babies, Babies.Defs[id].Emoji .. " " .. id, function()
			cmd("SpawnBaby", id)
		end)
	end
	local needs = section(scroll, 2, "Set all needs")
	for _, v in { 0, 10, 30, 50, 100 } do
		small(needs, tostring(v), function()
			cmd("SetNeeds", v)
		end)
	end
	local events = section(scroll, 3, "Trigger event")
	for _, id in Events.Order do
		small(events, Events.Defs[id].Emoji .. " " .. id, function()
			cmd("TriggerEvent", id)
		end)
	end
	local misc = section(scroll, 4, "Misc")
	small(misc, "Time x1", function()
		cmd("TimeScale", 1)
	end)
	small(misc, "Time x5", function()
		cmd("TimeScale", 5)
	end)
	small(misc, "+1000 🪙", function()
		cmd("AddCoins", 1000)
	end)
	small(misc, "+10 ⭐", function()
		cmd("AddStars", 10)
	end)
	small(misc, "Unlock all", function()
		cmd("UnlockAll")
	end)
	small(misc, "AI labels", function()
		showAI = not showAI
		cmd("ShowAI", showAI)
	end)
	small(misc, "End shift", function()
		cmd("EndShift")
	end)
	small(misc, "Power off", function()
		cmd("PowerOff")
	end)
	small(misc, "Reset data", function()
		cmd("ResetData")
	end)
	local friends = section(scroll, 5, "Friendship = 5")
	for _, id in Babies.Order do
		small(friends, Babies.Defs[id].Emoji, function()
			cmd("Friendship", id)
		end)
	end
end

function DebugController:Start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.F2 and not processed and player:GetAttribute("DebugAllowed") then
			window.Toggle()
		end
	end)
	-- AI state labels
	task.spawn(function()
		while true do
			task.wait(0.5)
			local on = workspace:GetAttribute("DebugAI") == true
			for _, m in CollectionService:GetTagged("Baby") do
				local root = m.PrimaryPart
				if on and root and not labels[m] then
					local bb = Instance.new("BillboardGui")
					bb.Size = UDim2.fromOffset(160, 24)
					bb.StudsOffset = Vector3.new(0, 4.5, 0)
					bb.AlwaysOnTop = true
					bb.Adornee = root
					bb.Parent = player:WaitForChild("PlayerGui")
					local t = Instance.new("TextLabel")
					t.Size = UDim2.fromScale(1, 1)
					t.BackgroundTransparency = 0.4
					t.TextScaled = true
					t.Font = Enum.Font.Code
					t.Parent = bb
					labels[m] = bb
				end
				local bb = labels[m]
				if bb then
					bb.Enabled = on and m.Parent ~= nil
					local t = bb:FindFirstChildOfClass("TextLabel")
					if t then
						t.Text = tostring(m:GetAttribute("DebugState") or "")
					end
				end
			end
			for m, bb in labels do
				if not m.Parent then
					bb:Destroy()
					labels[m] = nil
				end
			end
		end
	end)
end

return DebugController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX127"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[-- EffectsController: all particle / beam / tween effects, built on the client from server signals and tags.
-- The server never creates particle spam itself; it sends Effect(name, payload) or sets tags/attributes.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Recipes = require(Shared.Config.Recipes)
local State = require(script.Parent.Parent.State)

local player = Players.LocalPlayer
local EffectsController = {}
local Controllers

local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

local function quality(): number
	return if Controllers.SettingsController:Quality() == "Low" then 0.4 else 1
end

local function holder(pos: Vector3, size: Vector3?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size or Vector3.one
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	return p
end

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Sparkle
	e.Rate = 0
	e.LightEmission = 0.3
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- One-shot burst at a position.
local function burst(pos: Vector3, count: number, props: { [string]: any }, life: number?)
	local h = holder(pos)
	local e = emitter(h, props)
	e:Emit(math.max(1, math.floor(count * quality())))
	Debris:AddItem(h, life or 3)
	return h
end

local function seq(a: number, b: number)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

local function textPop(pos: Vector3, text: string, color: Color3?, rise: number?)
	local h = holder(pos)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(60, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = h
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = color or Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.5
	t.Parent = bb
	TweenService:Create(h, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { CFrame = h.CFrame + Vector3.new(0, rise or 3, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(h, 1.3)
end

local function ring(pos: Vector3, radius: number, color: Color3, time: number?)
	local p = holder(pos + Vector3.new(0, 0.3, 0))
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.2, 1, 1)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.3
	TweenService:Create(p, TweenInfo.new(time or 0.8, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(p, (time or 0.8) + 0.1)
end

-- Named effects -------------------------------------------------------------------------------

local handlers: { [string]: (any) -> () } = {}

handlers.Hearts = function(d)
	burst(d.Position, 6, { Texture = TEX.Sparkle, Color = ColorSequence.new(Color3.fromRGB(255, 120, 160)), Size = seq(0.6, 0.2), Speed = NumberRange.new(2, 4), Lifetime = NumberRange.new(0.8, 1.2), SpreadAngle = Vector2.new(40, 40), Acceleration = Vector3.new(0, 3, 0) })
	textPop(d.Position, "❤️", nil, 2.5)
end
handlers.Angry = function(d)
	burst(d.Position, 10, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(240, 240, 240)), Size = seq(1, 2), Transparency = seq(0.3, 1), Speed = NumberRange.new(1, 2), Lifetime = NumberRange.new(1, 1.5), SpreadAngle = Vector2.new(60, 60) })
	textPop(d.Position, "😡", nil, 1.5)
end
handlers.Scared = function(d)
	textPop(d.Position, "❗", Color3.fromRGB(255, 220, 90), 2)
end
handlers.Eat = function(d)
	burst(d.Position, 8, { Color = ColorSequence.new(Color3.fromRGB(255, 220, 160)), Size = seq(0.3, 0.1), Speed = NumberRange.new(3, 5), Lifetime = NumberRange.new(0.5, 0.8), SpreadAngle = Vector2.new(70, 70), Acceleration = Vector3.new(0, -20, 0) })
	local dish = Recipes.Dishes[d.Dish]
	textPop(d.Position + Vector3.new(0, 1, 0), dish and dish.Emoji or "😋", nil, 2)
end
handlers.Bubbles = function(d)
	burst(d.Position, 25, { Color = ColorSequence.new(Color3.fromRGB(220, 240, 255)), Size = seq(0.4, 0.7), Transparency = seq(0.2, 0.8), Speed = NumberRange.new(1, 3), Lifetime = NumberRange.new(1.5, 2.5), SpreadAngle = Vector2.new(80, 80), Acceleration = Vector3.new(0, 2, 0) }, 4)
end
handlers.Splash = function(d)
	burst(d.Position, 20, { Color = ColorSequence.new(Color3.fromRGB(110, 180, 255)), Size = seq(0.3, 0.1), Speed = NumberRange.new(4, 7), Lifetime = NumberRange.new(0.5, 0.9), SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, -30, 0) })
end
handlers.Wail = function(d)
	ring(d.Position, d.Radius or 20, Color3.fromRGB(190, 150, 255), 1)
	task.delay(0.25, function()
		ring(d.Position, (d.Radius or 20) * 0.8, Color3.fromRGB(230, 200, 255), 0.9)
	end)
	textPop(d.Position + Vector3.new(0, 3, 0), "😭", nil, 2)
end
handlers.InkSpray = function(d)
	burst(d.Position, 30, { Color = ColorSequence.new(Color3.fromRGB(20, 15, 30)), Size = seq(0.6, 0.3), LightEmission = 0, Speed = NumberRange.new(6, 12), Lifetime = NumberRange.new(0.5, 0.9), SpreadAngle = Vector2.new(180, 40), Acceleration = Vector3.new(0, -30, 0) })
end
handlers.Stomp = function(d)
	ring(d.Position, 10, Color3.fromRGB(200, 180, 150), 0.6)
	burst(d.Position, 25, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(200, 185, 160)), Size = seq(1.5, 3), Transparency = seq(0.3, 1), Speed = NumberRange.new(5, 9), Lifetime = NumberRange.new(0.8, 1.2), SpreadAngle = Vector2.new(180, 10), LightEmission = 0 })
end
handlers.Sparks = function(d)
	burst(d.Position, 14, { Color = ColorSequence.new(Color3.fromRGB(255, 240, 120)), Size = seq(0.3, 0), Speed = NumberRange.new(6, 12), Lifetime = NumberRange.new(0.2, 0.5), SpreadAngle = Vector2.new(180, 180), LightEmission = 1 })
	-- little lightning beam
	local a = holder(d.Position)
	local b = holder(d.Position + Vector3.new(math.random(-3, 3), math.random(1, 3), math.random(-3, 3)))
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Parent, a1.Parent = a, b
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = a0, a1
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 160))
	beam.LightEmission = 1
	beam.Width0, beam.Width1 = 0.25, 0.05
	beam.CurveSize0 = math.random(-3, 3)
	beam.Parent = a
	Debris:AddItem(a, 0.2)
	Debris:AddItem(b, 0.2)
end
handlers.FrostBurst = function(d)
	ring(d.Position, d.Radius or 10, Color3.fromRGB(190, 235, 255), 0.7)
	burst(d.Position + Vector3.new(0, 1, 0), 30, { Color = ColorSequence.new(Color3.fromRGB(210, 245, 255)), Size = seq(0.4, 0.1), Speed = NumberRange.new(5, 10), Lifetime = NumberRange.new(0.6, 1), SpreadAngle = Vector2.new(180, 30) })
end
handlers.IceShatter = function(d)
	burst(d.Position + Vector3.new(0, 1.5, 0), 20, { Color = ColorSequence.new(Color3.fromRGB(200, 240, 255)), Size = seq(0.4, 0.2), Speed = NumberRange.new(5, 9), Lifetime = NumberRange.new(0.5, 0.9), SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -30, 0) })
end
handlers.Puff = function(d)
	burst(d.Position, 12, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(255, 245, 255)), Size = seq(1, 2.5), Transparency = seq(0.2, 1), Speed = NumberRange.new(2, 4), Lifetime = NumberRange.new(0.6, 1), SpreadAngle = Vector2.new(180, 180), LightEmission = 0.2 })
end
handlers.Hatch = function(d)
	handlers.Puff(d)
	burst(d.Position, 30, { Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 160, 220)), Size = seq(0.5, 0), Speed = NumberRange.new(5, 10), Lifetime = NumberRange.new(0.8, 1.5), SpreadAngle = Vector2.new(180, 180), LightEmission = 1 })
	textPop(d.Position + Vector3.new(0, 2, 0), "🐣", nil, 3)
end
handlers.RootsGrow = function(d)
	burst(d.Position, 20, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(140, 110, 80)), Size = seq(1, 2), Transparency = seq(0.3, 1), Speed = NumberRange.new(2, 5), Lifetime = NumberRange.new(0.8, 1.2), SpreadAngle = Vector2.new(180, 20), LightEmission = 0 })
end
handlers.Leaves = function(d)
	burst(d.Position, 18, { Color = ColorSequence.new(Color3.fromRGB(120, 200, 100)), Size = seq(0.5, 0.3), Speed = NumberRange.new(3, 6), Lifetime = NumberRange.new(1, 1.6), SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -6, 0), RotSpeed = NumberRange.new(-180, 180), LightEmission = 0 })
end
handlers.Chomp = function(d)
	textPop(d.Position, "😋", nil, 1.5)
end
handlers.Sparkle = function(d)
	burst(d.Position, 16, { Color = ColorSequence.new(Color3.fromRGB(255, 240, 160)), Size = seq(0.5, 0), Speed = NumberRange.new(2, 5), Lifetime = NumberRange.new(0.6, 1), SpreadAngle = Vector2.new(180, 180), LightEmission = 1 })
end
handlers.Ding = function(d)
	textPop(d.Position, "🔔", nil, 2)
	handlers.Sparkle(d)
end
handlers.Fizz = function(d)
	burst(d.Position + Vector3.new(0, 1, 0), 18, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(230, 230, 235)), Size = seq(1.5, 4), Transparency = seq(0.2, 1), Speed = NumberRange.new(3, 6), Lifetime = NumberRange.new(1, 2), SpreadAngle = Vector2.new(30, 30), LightEmission = 0 })
end
handlers.Steam = handlers.Fizz
handlers.Tantrum = function(d)
	textPop(d.Position + Vector3.new(0, 3, 0), "💢", Color3.fromRGB(255, 80, 80), 2.5)
end
handlers.GhostVanish = function(_d) end
handlers.InspectorNote = function(d)
	textPop(d.Position, "📝❗", Color3.fromRGB(255, 120, 120), 2)
end
handlers.Power = function(d)
	if not d.On then
		local cc = game:GetService("Lighting"):FindFirstChild("ColorCorrection") :: ColorCorrectionEffect?
		if cc then
			for _ = 1, 3 do
				cc.Brightness = -0.6
				task.wait(0.06)
				cc.Brightness = 0.1
				task.wait(0.06)
			end
			cc.Brightness = 0
		end
	end
end
handlers.Storm = function(_d) end
handlers.NetCatch = function(d)
	local a = holder(d.From + Vector3.new(0, 1, 0))
	local b = holder(d.To + Vector3.new(0, 1, 0))
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Parent, a1.Parent = a, b
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = a0, a1
	beam.Color = ColorSequence.new(Color3.fromRGB(240, 240, 240))
	beam.Width0, beam.Width1 = 0.2, 1.5
	beam.Transparency = NumberSequence.new(0.3)
	beam.Parent = a
	Debris:AddItem(a, 0.35)
	Debris:AddItem(b, 0.35)
end
handlers.Toy = function(d)
	local baby
	for _, m in CollectionService:GetTagged("Baby") do
		if m:GetAttribute("Uid") == d.Uid then
			baby = m
		end
	end
	local root = baby and baby.PrimaryPart
	if not root then
		return
	end
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.9, 0.9, 0.9)
	ball.Color = Color3.fromHSV(math.random(), 0.5, 1)
	ball.CanCollide = false
	ball.CanQuery = false
	ball.Anchored = true
	ball.Parent = workspace
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > (d.Duration or 10) or not root.Parent then
			conn:Disconnect()
			ball:Destroy()
			return
		end
		ball.CFrame = root.CFrame * CFrame.new(math.sin(t * 4) * 1.5, math.abs(math.sin(t * 6)) * 1.5 - 0.6, -1.6)
	end)
end
handlers.Cooking = function(_d) end
handlers.LullabyNotes = function(d)
	local m = d.Model
	if not m or not m.Parent then
		return
	end
	local root = m.PrimaryPart
	if root and not root:FindFirstChild("Notes") then
		local e = emitter(root, { Name = "Notes", Color = ColorSequence.new(Color3.fromRGB(190, 160, 255)), Size = seq(0.5, 0.2), Rate = 3 * quality(), Speed = NumberRange.new(1, 2), Lifetime = NumberRange.new(2, 3), SpreadAngle = Vector2.new(30, 30), Acceleration = Vector3.new(0, 1, 0) })
		e.Name = "Notes"
	end
end
handlers.FireSneeze = function(d)
	local h = holder(d.Position)
	h.CFrame = CFrame.lookAt(d.Position, d.Position + d.Direction)
	local e = emitter(h, {
		Texture = TEX.Fire,
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 90, 40)),
		Size = seq(1.2, 2.5),
		Transparency = seq(0.1, 1),
		Speed = NumberRange.new(14, 18),
		Lifetime = NumberRange.new(0.4, 0.55),
		SpreadAngle = Vector2.new(18, 18),
		EmissionDirection = Enum.NormalId.Front,
		LightEmission = 1,
	})
	e:Emit(math.floor(40 * quality()))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 60)
	light.Range = 14
	light.Brightness = 3
	light.Parent = h
	Debris:AddItem(h, 1)
end
handlers.ToolUse = function(d)
	if d.Player ~= player then
		EffectsController:ToolSpray(d.Player, d.Tool)
	end
end

-- Tool spray from a character's held item.
function EffectsController:ToolSpray(p: Player, toolId: string)
	local char = p.Character
	local item = char and char:FindFirstChild("HeldItem")
	local handle = item and (item :: Model).PrimaryPart
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not handle or not root then
		return
	end
	local origin = handle.Position
	local cf = CFrame.lookAt(origin, origin + root.CFrame.LookVector)
	local h = holder(origin)
	h.CFrame = cf
	local props
	if toolId == "Extinguisher" then
		props = { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)), Size = seq(0.6, 2.5), Transparency = seq(0.1, 1), Speed = NumberRange.new(16, 22), Lifetime = NumberRange.new(0.4, 0.6), SpreadAngle = Vector2.new(15, 15), LightEmission = 0 }
	elseif toolId == "WateringCan" then
		props = { Color = ColorSequence.new(Color3.fromRGB(120, 190, 255)), Size = seq(0.3, 0.2), Speed = NumberRange.new(10, 14), Lifetime = NumberRange.new(0.5, 0.7), SpreadAngle = Vector2.new(10, 10), Acceleration = Vector3.new(0, -25, 0) }
	elseif toolId == "Mop" then
		h.CFrame = CFrame.new((root.CFrame * CFrame.new(0, -2.8, -3)).Position)
		props = { Color = ColorSequence.new(Color3.fromRGB(230, 245, 255)), Size = seq(0.4, 0.6), Transparency = seq(0.2, 1), Speed = NumberRange.new(1, 3), Lifetime = NumberRange.new(0.6, 1), SpreadAngle = Vector2.new(180, 30) }
		-- mop wiggle
		local w = handle:FindFirstChildWhichIsA("WeldConstraint")
		local _ = w
	else
		props = { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)), Size = seq(0.3, 0), Speed = NumberRange.new(4, 6), Lifetime = NumberRange.new(0.3, 0.4), SpreadAngle = Vector2.new(30, 30) }
	end
	props.EmissionDirection = Enum.NormalId.Front
	local e = emitter(h, props)
	e:Emit(math.floor(14 * quality()))
	Debris:AddItem(h, 1.2)
	if Controllers.SoundController then
		local map = { Extinguisher = "Tool_Extinguisher", Mop = "Tool_Mop", WateringCan = "Tool_Water", Net = "Tool_Net" }
		if map[toolId] then
			Controllers.SoundController:Play(map[toolId], origin)
		end
	end
end

function EffectsController:LocalToolUse(toolId: string)
	self:ToolSpray(player, toolId)
end

-- Tag-driven persistent visuals -----------------------------------------------------------------------

local function setupFire(part: BasePart)
	local fire = Instance.new("Fire")
	fire.Heat = 12
	fire.Size = 5
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 90)
	fire.Parent = part
	local smoke = emitter(part, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(60, 55, 55)), Size = seq(2, 5), Transparency = seq(0.4, 1), Rate = 4 * quality(), Speed = NumberRange.new(3, 5), Lifetime = NumberRange.new(2, 3), SpreadAngle = Vector2.new(15, 15), LightEmission = 0, EmissionDirection = Enum.NormalId.Top })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 16
	light.Brightness = 2
	light.Shadows = false
	light.Parent = part
	local embers = emitter(part, { Color = ColorSequence.new(Color3.fromRGB(255, 200, 80)), Size = seq(0.2, 0), Rate = 8 * quality(), Speed = NumberRange.new(3, 6), Lifetime = NumberRange.new(0.8, 1.3), SpreadAngle = Vector2.new(25, 25), LightEmission = 1, EmissionDirection = Enum.NormalId.Top })
	local function update()
		local i = part:GetAttribute("Intensity") or 0.5
		fire.Size = 3 + i * 6
		smoke.Rate = (2 + i * 5) * quality()
		embers.Rate = (4 + i * 10) * quality()
	end
	part:GetAttributeChangedSignal("Intensity"):Connect(update)
	update()
	-- flicker
	task.spawn(function()
		while part.Parent do
			light.Brightness = 1.6 + math.random() * 1.2
			task.wait(0.08 + math.random() * 0.1)
		end
	end)
end

local function setupFireplace(part: BasePart)
	local fire = Instance.new("Fire")
	fire.Heat = 6
	fire.Size = 3
	fire.Color = Color3.fromRGB(255, 150, 60)
	fire.SecondaryColor = Color3.fromRGB(255, 230, 120)
	fire.Parent = part
end

-- Baby status visuals.
local function setupBaby(model: Model)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local visuals = {}
	local function clear(name)
		if visuals[name] then
			visuals[name]:Destroy()
			visuals[name] = nil
		end
	end
	local function refresh()
		local s = model:GetAttribute("Statuses") or ""
		local has = {}
		for name in string.gmatch(s, "[^,]+") do
			has[name] = true
		end
		if has.Burning and not visuals.Burning then
			local f = Instance.new("Fire")
			f.Size = 4
			f.Heat = 9
			f.Parent = root
			visuals.Burning = f
		elseif not has.Burning then
			clear("Burning")
		end
		if has.Frozen and not visuals.Frozen then
			local cube = Instance.new("Part")
			cube.Name = "IceCube"
			cube.Size = Vector3.new(3.4, 3.4, 3.4) * (model:GetAttribute("Scale") or 1)
			cube.Material = Enum.Material.Ice
			cube.Color = Color3.fromRGB(190, 235, 255)
			cube.Transparency = 0.35
			cube.CanCollide = false
			cube.CanQuery = false
			cube.Massless = true
			cube.Anchored = false
			cube.CFrame = root.CFrame
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = cube
			w.Parent = cube
			cube.Parent = model
			visuals.Frozen = cube
		elseif not has.Frozen then
			clear("Frozen")
		end
		if has.Wet and not visuals.Wet then
			visuals.Wet = emitter(root, { Color = ColorSequence.new(Color3.fromRGB(120, 190, 255)), Size = seq(0.2, 0.1), Rate = 6 * quality(), Speed = NumberRange.new(0, 1), Lifetime = NumberRange.new(0.5, 0.8), Acceleration = Vector3.new(0, -20, 0), SpreadAngle = Vector2.new(180, 180) })
		elseif not has.Wet then
			clear("Wet")
		end
		if (has.Inked or model:GetAttribute("Tint") == "Black") and not visuals.Ink then
			local hl = Instance.new("Highlight")
			hl.FillColor = Color3.fromRGB(20, 15, 30)
			hl.FillTransparency = 0.4
			hl.OutlineTransparency = 1
			hl.Parent = model
			visuals.Ink = hl
		elseif not has.Inked and model:GetAttribute("Tint") ~= "Black" then
			clear("Ink")
		end
		if has.Angry and not visuals.Angry then
			visuals.Angry = emitter(root, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(240, 240, 240)), Size = seq(0.6, 1.4), Transparency = seq(0.4, 1), Rate = 4 * quality(), Speed = NumberRange.new(1, 2), Lifetime = NumberRange.new(0.8, 1.2), EmissionDirection = Enum.NormalId.Top, LightEmission = 0 })
		elseif not has.Angry then
			clear("Angry")
		end
	end
	model:GetAttributeChangedSignal("Statuses"):Connect(refresh)
	model:GetAttributeChangedSignal("Tint"):Connect(refresh)
	refresh()
	-- Zzz while sleeping, hearts while very happy, tears when crying
	local zzz = emitter(root, { Color = ColorSequence.new(Color3.fromRGB(200, 210, 255)), Size = seq(0.5, 0.9), Transparency = seq(0, 1), Rate = 0, Speed = NumberRange.new(1, 1.5), Lifetime = NumberRange.new(1.5, 2), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(20, 20), LightEmission = 0.5 })
	local tears = emitter(root, { Color = ColorSequence.new(Color3.fromRGB(140, 200, 255)), Size = seq(0.25, 0.1), Rate = 0, Speed = NumberRange.new(2, 3), Lifetime = NumberRange.new(0.4, 0.6), SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, -25, 0) })
	local function onAnim()
		local a = model:GetAttribute("Anim")
		zzz.Rate = if a == "Sleep" then 1.5 * quality() else 0
		tears.Rate = if a == "Cry" or a == "Tantrum" then 10 * quality() else 0
	end
	model:GetAttributeChangedSignal("Anim"):Connect(onAnim)
	onAnim()
	-- birthday hat
	local function birthday()
		clear("Birthday")
		if model:GetAttribute("Birthday") then
			local hat = Instance.new("Part")
			hat.Shape = Enum.PartType.Cylinder
			hat.Size = Vector3.new(1.2, 0.8, 0.8)
			hat.Color = Color3.fromRGB(255, 170, 200)
			hat.Material = Enum.Material.Neon
			hat.CanCollide = false
			hat.Massless = true
			hat.CFrame = root.CFrame * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90))
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = hat
			w.Parent = hat
			hat.Parent = model
			visuals.Birthday = hat
		end
	end
	model:GetAttributeChangedSignal("Birthday"):Connect(birthday)
	birthday()
	-- ghost trail
	if model:GetAttribute("BabyId") == "Ghostie" then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.6, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.6, 0)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(220, 230, 255))
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		trail.Lifetime = 0.6
		trail.LightEmission = 0.7
		trail.Name = "GhostTrail"
		trail.Parent = root
	end
end

-- Appliance progress bubble + steam / smoke.
local function setupAppliance(model: Model)
	local slot = model:FindFirstChild("Slot") :: BasePart?
	if not slot then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "ApplianceGui"
	bb.Size = UDim2.fromOffset(120, 46)
	bb.StudsOffset = Vector3.new(0, 0.5, 0)
	bb.MaxDistance = 45
	bb.LightInfluence = 0
	bb.Parent = slot
	local icons = Instance.new("TextLabel")
	icons.Size = UDim2.new(1, 0, 0, 26)
	icons.BackgroundTransparency = 1
	icons.TextScaled = true
	icons.Text = ""
	icons.Parent = bb
	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.new(0.1, 0, 0, 30)
	barBg.Size = UDim2.new(0.8, 0, 0, 10)
	barBg.BackgroundColor3 = Color3.fromRGB(45, 38, 70)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(168, 230, 207)
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local steam = emitter(slot, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(245, 245, 250)), Size = seq(1, 3), Transparency = seq(0.5, 1), Rate = 0, Speed = NumberRange.new(2, 3), Lifetime = NumberRange.new(1.5, 2), EmissionDirection = Enum.NormalId.Top, LightEmission = 0 })
	local smoke = emitter(slot, { Texture = TEX.Smoke, Color = ColorSequence.new(Color3.fromRGB(30, 25, 25)), Size = seq(1.5, 4), Transparency = seq(0.2, 1), Rate = 0, Speed = NumberRange.new(3, 5), Lifetime = NumberRange.new(2, 3), EmissionDirection = Enum.NormalId.Top, LightEmission = 0 })
	local function refresh()
		local st = model:GetAttribute("State")
		local contents = model:GetAttribute("Contents") or ""
		local parts = {}
		for ing in string.gmatch(contents, "[^,]+") do
			local def = Recipes.Ingredients[ing]
			table.insert(parts, def and def.Emoji or "?")
		end
		local dish = model:GetAttribute("Dish") or ""
		if st == "Ready" and Recipes.Dishes[dish] then
			icons.Text = Recipes.Dishes[dish].Emoji .. " ✅"
		elseif st == "Burnt" then
			icons.Text = "💩 🔥"
		else
			icons.Text = table.concat(parts, " ")
		end
		barBg.Visible = st == "Cooking" or st == "Ready"
		fill.BackgroundColor3 = if st == "Ready" then Color3.fromRGB(255, 205, 60) else Color3.fromRGB(168, 230, 207)
		steam.Rate = if st == "Cooking" or st == "Ready" then 3 * quality() else 0
		smoke.Rate = if st == "Burnt" then 8 * quality() else 0
		bb.Enabled = icons.Text ~= "" or barBg.Visible
	end
	model:GetAttributeChangedSignal("State"):Connect(refresh)
	model:GetAttributeChangedSignal("Contents"):Connect(refresh)
	model:GetAttributeChangedSignal("Progress"):Connect(function()
		local p = model:GetAttribute("Progress") or 0
		fill.Size = UDim2.fromScale(if model:GetAttribute("State") == "Ready" then 1 else p, 1)
	end)
	refresh()
end

local function onTag(tag: string, fn: (Instance) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(fn, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(fn)
end

function EffectsController:Init(c)
	Controllers = c
end

function EffectsController:Start()
	Remotes.event("Effect").OnClientEvent:Connect(function(name, payload)
		local fn = handlers[name]
		if fn then
			task.spawn(fn, payload or {})
		end
	end)
	onTag("Fire", function(p)
		if p:IsA("BasePart") then
			setupFire(p)
		end
	end)
	onTag("FireplaceFlame", function(p)
		if p:IsA("BasePart") then
			setupFireplace(p)
		end
	end)
	onTag("Baby", function(m)
		if m:IsA("Model") then
			setupBaby(m)
		end
	end)
	onTag("Appliance", function(m)
		if m:IsA("Model") then
			setupAppliance(m)
		end
	end)
	onTag("AmbientParticles", function(p)
		for _, e in p:GetChildren() do
			if e:IsA("ParticleEmitter") then
				e.Rate *= quality()
			end
		end
	end)
	-- bath bubbles drift up from tub water
	onTag("BathWater", function(p)
		if p:IsA("BasePart") then
			emitter(p, { Color = ColorSequence.new(Color3.fromRGB(230, 245, 255)), Size = seq(0.3, 0.6), Transparency = seq(0.3, 1), Rate = 2 * quality(), Speed = NumberRange.new(0.5, 1), Lifetime = NumberRange.new(2, 3), EmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(30, 30) })
		end
	end)
	local _ = State
end

return EffectsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX128"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[-- HUDController: lobby HUD (coins, levels, menu buttons), shift HUD (clock, baby cards, held item,
-- building health, event banners), toasts, quests + daily gift windows, player name tags.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Babies = require(Shared.Config.Babies)
local Needs = require(Shared.Config.Needs)
local Tools = require(Shared.Config.Tools)
local Recipes = require(Shared.Config.Recipes)
local Events = require(Shared.Config.Events)
local Quests = require(Shared.Config.Quests)
local Progression = require(Shared.Config.Progression)
local P = require(Shared.Logic.ProgressionMath)
local MathUtil = require(Shared.Util.Math)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local HUDController = {}
local Controllers

local gui: ScreenGui
local lobby: Frame
local shift: Frame
local coinsLabel: TextLabel
local levelLabel: TextLabel
local levelBar: (number, Color3?) -> ()
local nannyLabel: TextLabel
local clockLabel: TextLabel
local timeBar: (number, Color3?) -> ()
local buildingBar: (number, Color3?) -> ()
local babyList: Frame
local heldIcon: TextLabel
local heldName: TextLabel
local toastHolder: Frame
local bannerFrame: Frame
local bannerText: TextLabel
local cards: { [string]: any } = {}
local questWindow, dailyWindow
local shownCoins = 0

local function emojiFor(held): string
	if not held then
		return "✋"
	end
	if held.Kind == "Tool" then
		return Tools.Defs[held.Id] and Tools.Defs[held.Id].Emoji or "🔧"
	elseif held.Kind == "Ingredient" then
		return Recipes.Ingredients[held.Id] and Recipes.Ingredients[held.Id].Emoji or "?"
	elseif held.Kind == "Dish" then
		return Recipes.Dishes[held.Id] and Recipes.Dishes[held.Id].Emoji or "?"
	elseif held.Kind == "Baby" then
		return Babies.Defs[held.Id] and Babies.Defs[held.Id].Emoji or "👶"
	elseif held.Kind == "Trash" then
		return "🗑️"
	elseif held.Kind == "Egg" then
		return "🥚"
	end
	return "?"
end

-- Toasts ------------------------------------------------------------------------------------------

local TOAST_COLORS = { info = C.Cream, good = C.Mint, bad = C.Pink, error = C.Pink, coins = C.Yellow, level = C.Lavender, unlock = C.Peach }

function HUDController:Toast(msg: any, kind: string?)
	local text = Strings.msg(msg)
	local f = UI.panel({ Size = UDim2.fromOffset(380, 48), BackgroundTransparency = 0.05, Parent = toastHolder }, TOAST_COLORS[kind or "info"] or C.Cream)
	UI.label(text, { Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextWrapped = true, Parent = f })
	local scale = UI.new("UIScale", { Scale = 0.3, Parent = f })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	if kind == "error" and Controllers.SoundController then
		Controllers.SoundController:Play("UI_Error")
	elseif Controllers.SoundController then
		Controllers.SoundController:Play("UI_Notify")
	end
	task.delay(3.5, function()
		TweenService:Create(scale, TweenInfo.new(0.25), { Scale = 0 }):Play()
		task.wait(0.3)
		f:Destroy()
	end)
end

-- Banner ------------------------------------------------------------------------------------------

function HUDController:Banner(id: string, phase: string, extra: any)
	local text
	if id == "ParentsComing" then
		text = Strings.t("Banner_ParentsComing")
	else
		local def = Events.Defs[id]
		local emoji = def and def.Emoji or "⭐"
		if phase == "start" then
			text = emoji .. " " .. Strings.t("Event_" .. id) .. " — " .. Strings.msg({ "EventDesc_" .. id, extra and extra.Baby or "" })
		elseif phase == "success" then
			text = emoji .. " " .. Strings.t("Event_Success", (extra and extra.Coins) or 0)
		else
			text = emoji .. " " .. Strings.t("Event_Fail")
		end
	end
	bannerText.Text = text
	bannerFrame.Visible = true
	bannerFrame.Position = UDim2.new(0.5, 0, 0, -120)
	TweenService:Create(bannerFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 90) }):Play()
	local token = os.clock()
	bannerFrame:SetAttribute("Token", token)
	task.delay(if phase == "start" then 5 else 3, function()
		if bannerFrame:GetAttribute("Token") == token then
			TweenService:Create(bannerFrame, TweenInfo.new(0.3), { Position = UDim2.new(0.5, 0, 0, -120) }):Play()
		end
	end)
end

-- Lobby HUD ----------------------------------------------------------------------------------------

local function buildLobby()
	lobby = UI.new("Frame", { Name = "Lobby", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local top = UI.panel({ Position = UDim2.fromOffset(16, 16), Size = UDim2.fromOffset(330, 116), Parent = lobby })
	coinsLabel = UI.label("🪙 0", { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, Parent = top })
	levelLabel = UI.label("🏠 1", { Position = UDim2.fromOffset(12, 42), Size = UDim2.new(1, -24, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = top })
	local bar
	bar, levelBar = UI.bar({ Position = UDim2.fromOffset(12, 70), Size = UDim2.new(1, -24, 0, 12), Parent = top }, C.Yellow)
	local _ = bar
	nannyLabel = UI.label("🍼 1", { Position = UDim2.fromOffset(12, 86), Size = UDim2.new(1, -24, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Parent = top })
	local menu = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.55, 0), Size = UDim2.fromOffset(150, 330), Parent = lobby })
	UI.list(menu, 8)
	local function menuBtn(order: number, key: string, color: Color3, fn: () -> ())
		local b = UI.button("", color, fn, { Size = UDim2.fromOffset(150, 48), LayoutOrder = order, Parent = menu })
		UI.bind(b, key)
	end
	menuBtn(1, "Menu_Shop", C.Mint, function()
		Controllers.ShopController:Open()
	end)
	menuBtn(2, "Menu_Wardrobe", C.Lavender, function()
		Controllers.WardrobeController:Open()
	end)
	menuBtn(3, "Menu_Pets", C.Peach, function()
		Controllers.PetController:Open()
	end)
	menuBtn(4, "Menu_Quests", C.Yellow, function()
		questWindow.Open()
	end)
	menuBtn(5, "Menu_Daily", C.Pink, function()
		dailyWindow.Open()
	end)
	menuBtn(6, "Menu_Settings", C.Cream, function()
		Controllers.SettingsController:Open()
	end)
	-- tutorial offer for new players
	local offer = UI.panel({ Name = "TutorialOffer", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(460, 110), Visible = false, Parent = lobby }, C.Yellow)
	local ot = UI.label("", { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 40), TextWrapped = true, Parent = offer })
	UI.bind(ot, "Tutorial_Offer")
	local yes = UI.button("", C.Mint, function()
		offer.Visible = false
		Remotes.event("TutorialAction"):FireServer("Replay")
	end, { Position = UDim2.fromOffset(40, 56), Size = UDim2.fromOffset(170, 44), Parent = offer })
	UI.bind(yes, "Tutorial_Start")
	local no = UI.button("", C.Pink, function()
		offer.Visible = false
		Remotes.event("TutorialAction"):FireServer("Skip")
	end, { Position = UDim2.new(1, -210, 0, 56), Size = UDim2.fromOffset(170, 44), Parent = offer })
	UI.bind(no, "Tutorial_Skip")
end

-- Shift HUD -----------------------------------------------------------------------------------------

local function buildShift()
	shift = UI.new("Frame", { Name = "Shift", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui })
	local top = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(300, 74), Parent = shift })
	clockLabel = UI.label("07:00", { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 40), Parent = top })
	local tb
	tb, timeBar = UI.bar({ Position = UDim2.fromOffset(14, 50), Size = UDim2.new(1, -28, 0, 12), Parent = top }, C.Mint)
	local _ = tb
	local bpanel = UI.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(230, 56), Parent = shift })
	local bl = UI.label("", { Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, 24), Parent = bpanel })
	UI.bind(bl, "HUD_Building")
	local bb
	bb, buildingBar = UI.bar({ Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 12), Parent = bpanel }, C.Green)
	local _2 = bb
	babyList = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 100), Size = UDim2.fromOffset(250, 600), Parent = shift })
	UI.list(babyList, 6)
	local held = UI.panel({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(200, 92), Parent = shift })
	heldIcon = UI.label("✋", { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(60, 60), Parent = held })
	heldName = UI.label("", { Position = UDim2.fromOffset(72, 10), Size = UDim2.new(1, -80, 0, 50), TextWrapped = true, Parent = held })
	local hint = UI.label("", { Position = UDim2.fromOffset(8, 66), Size = UDim2.new(1, -16, 0, 20), Font = Enum.Font.GothamBold, TextTransparency = 0.3, Parent = held })
	UI.bind(hint, "HUD_HeldHint")
end

local function cardFor(uid: string, babyId: string)
	local def = Babies.Defs[babyId]
	local f = UI.panel({ Size = UDim2.fromOffset(240, 60), Parent = babyList }, C.Cream)
	local btn = UI.new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = f })
	btn.Activated:Connect(function()
		Controllers.BubbleController:Locate(uid)
	end)
	UI.label(def and def.Emoji or "?", { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(46, 46), Parent = f })
	local name = UI.label(Strings.name(def and def.Name), { Position = UDim2.fromOffset(56, 2), Size = UDim2.new(1, -62, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
	local bars = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(56, 26), Size = UDim2.new(1, -62, 0, 30), Parent = f })
	UI.list(bars, 2, true)
	local setters = {}
	local needIds = {}
	for _, n in Needs.Order do
		if def and def.Needs[n] then
			table.insert(needIds, n)
		end
	end
	for _, n in needIds do
		local col = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1 / #needIds, -2, 1, 0), Parent = bars })
		UI.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), TextScaled = true, Text = Needs.Defs[n].Emoji, Parent = col })
		local _, set = UI.bar({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 8), Parent = col }, Needs.Defs[n].Color)
		setters[n] = set
	end
	return { Frame = f, Setters = setters, Name = name, Def = def }
end

local function findBaby(uid: string): Model?
	for _, m in CollectionService:GetTagged("Baby") do
		if m:GetAttribute("Uid") == uid then
			return m
		end
	end
	return nil
end

local function updateCards(t: number)
	for uid, card in cards do
		local m = findBaby(uid)
		if m then
			for n, set in card.Setters do
				local v = (m:GetAttribute("N_" .. n) or 100) / 100
				set(v, if v < 0.15 then C.Red elseif v < 0.35 then C.Yellow else Needs.Defs[n].Color)
			end
			local tantrum = (m:GetAttribute("Tantrum") or "") ~= ""
			if tantrum then
				card.Frame.BackgroundColor3 = if math.sin(t * 10) > 0 then C.Pink else C.Red
			elseif m:GetAttribute("Escaped") then
				card.Frame.BackgroundColor3 = C.Peach
			else
				card.Frame.BackgroundColor3 = C.Cream
			end
		end
	end
end

local function syncCards(shiftState)
	local want = {}
	for i, b in shiftState.Babies or {} do
		want[b.Uid] = true
		if not cards[b.Uid] then
			cards[b.Uid] = cardFor(b.Uid, b.Id)
		end
		cards[b.Uid].Frame.LayoutOrder = i
	end
	for uid, card in cards do
		if not want[uid] then
			card.Frame:Destroy()
			cards[uid] = nil
		end
	end
end

-- Lobby data ------------------------------------------------------------------------------------------

local function onData(d)
	if not d then
		return
	end
	local target = d.Coins
	local from = shownCoins
	shownCoins = target
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 0.6 do
			local k = (os.clock() - t0) / 0.6
			coinsLabel.Text = "🪙 " .. MathUtil.formatNumber(from + (target - from) * k)
			task.wait()
		end
		coinsLabel.Text = "🪙 " .. MathUtil.formatNumber(target)
	end)
	local lvl = P.daycareLevel(d.TotalStars)
	local cur, span = P.daycareProgress(d.TotalStars)
	levelLabel.Text = Strings.t("HUD_DaycareLevel", lvl, d.TotalStars)
	levelBar(if span then cur / span else 1)
	nannyLabel.Text = Strings.t("HUD_NannyLevel", d.NannyLevel, Strings.t(P.titleKey(d.NannyLevel)))
	-- "Golden daycare" (daycare level 15): the lobby sign shines gold for you
	for _, sign in CollectionService:GetTagged("LobbySign") do
		local label = sign:FindFirstChild("SignText", true)
		if label and label:IsA("TextLabel") then
			label.TextColor3 = if lvl >= 15 then C.Gold else Color3.fromRGB(255, 220, 140)
			label.Text = if lvl >= 15 then "✨ MONSTERGARTEN ✨" else "MONSTERGARTEN"
		end
	end
	local offer = lobby:FindFirstChild("TutorialOffer")
	if offer then
		offer.Visible = not d.TutorialDone and not State.inShift()
	end
	if questWindow and questWindow.IsOpen() then
		HUDController:RefreshQuests()
	end
	if dailyWindow and dailyWindow.IsOpen() then
		HUDController:RefreshDaily()
	end
end

-- Quests + daily --------------------------------------------------------------------------------------------

local questList: Frame
function HUDController:RefreshQuests()
	for _, c in questList:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local d = State.Data
	if not d then
		return
	end
	for i, q in d.DailyQuests.Quests do
		local def
		for _, qd in Quests.Pool do
			if qd.Id == q.Id then
				def = qd
			end
		end
		if def then
			local f = UI.panel({ Size = UDim2.new(1, -8, 0, 76), LayoutOrder = i, Parent = questList }, if q.Done then C.Mint else C.Cream)
			UI.label(Strings.t("Quest_" .. q.Id, def.Goal), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -120, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
			UI.label("🪙 " .. def.Reward, { Position = UDim2.new(1, -110, 0, 6), Size = UDim2.fromOffset(100, 30), Parent = f })
			local _, set = UI.bar({ Position = UDim2.fromOffset(12, 44), Size = UDim2.new(1, -110, 0, 14), Parent = f }, C.Lavender)
			set(q.Progress / def.Goal)
			UI.label(if q.Done then "✅" else (q.Progress .. "/" .. def.Goal), { Position = UDim2.new(1, -96, 0, 38), Size = UDim2.fromOffset(86, 26), Parent = f })
		end
	end
end

local dailyRow: Frame
local claimBtn: TextButton
function HUDController:RefreshDaily()
	for _, c in dailyRow:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local d = State.Data
	if not d then
		return
	end
	local today = math.floor(os.time() / 86400)
	local claimable, nextStreak = P.dailyReward(d.DailyReward.LastClaim, d.DailyReward.Streak, today)
	local current = if claimable then nextStreak else d.DailyReward.Streak
	for i, coins in Progression.DailyRewards do
		local idx = ((current - 1) % 7) + 1
		local col = if i < idx or (i == idx and not claimable) then C.Mint elseif i == idx then C.Yellow else C.Cream
		local f = UI.panel({ Size = UDim2.fromOffset(78, 100), LayoutOrder = i, Parent = dailyRow }, col)
		UI.label(Strings.t("Daily_Day", i), { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 24), Parent = f })
		UI.label("🎁", { Position = UDim2.fromOffset(4, 28), Size = UDim2.new(1, -8, 0, 36), Parent = f })
		UI.label("🪙" .. coins, { Position = UDim2.fromOffset(4, 68), Size = UDim2.new(1, -8, 0, 26), Parent = f })
	end
	claimBtn.Visible = claimable
end

function HUDController:OpenDaily()
	dailyWindow.Open()
end

-- Name tags -------------------------------------------------------------------------------------------------

local function nameTag(p: Player)
	local function attach(char: Model)
		local head = char:WaitForChild("Head", 10)
		if not head then
			return
		end
		local bb = Instance.new("BillboardGui")
		bb.Name = "MGNameTag"
		bb.Size = UDim2.fromOffset(220, 50)
		bb.StudsOffset = Vector3.new(0, 2.4, 0)
		bb.MaxDistance = 60
		bb.LightInfluence = 0
		bb.Adornee = head
		bb.Parent = player:WaitForChild("PlayerGui")
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.45, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBold
		title.TextScaled = true
		title.TextColor3 = C.Lavender
		title.TextStrokeTransparency = 0.5
		title.Parent = bb
		local name = Instance.new("TextLabel")
		name.Position = UDim2.fromScale(0, 0.45)
		name.Size = UDim2.new(1, 0, 0.55, 0)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.FredokaOne
		name.TextScaled = true
		name.TextStrokeTransparency = 0.4
		name.Text = p.DisplayName
		name.Parent = bb
		local function refresh()
			local key = p:GetAttribute("TitleKey")
			title.Text = (if key then Strings.t(key) else "") .. "  🍼" .. tostring(p:GetAttribute("NannyLevel") or 1)
			name.TextColor3 = if p:GetAttribute("VIP") then C.Gold else C.White
			name.Text = (if p:GetAttribute("VIP") then "👑 " else "") .. p.DisplayName
		end
		p:GetAttributeChangedSignal("TitleKey"):Connect(refresh)
		p:GetAttributeChangedSignal("NannyLevel"):Connect(refresh)
		p:GetAttributeChangedSignal("VIP"):Connect(refresh)
		State.LanguageChanged:Connect(refresh)
		refresh()
		char.AncestryChanged:Connect(function(_, parent)
			if not parent then
				bb:Destroy()
			end
		end)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	p.CharacterAdded:Connect(attach)
	if p.Character then
		task.spawn(attach, p.Character)
	end
end

-- Lifecycle ----------------------------------------------------------------------------------------------------

function HUDController:Init(c)
	Controllers = c
	gui = UI.screen("HUD", 2)
	buildLobby()
	buildShift()
	toastHolder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 170), Size = UDim2.fromOffset(380, 300), Parent = gui })
	UI.list(toastHolder, 6, false, Enum.HorizontalAlignment.Center)
	bannerFrame = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -120), Size = UDim2.fromOffset(620, 70), Visible = false, Parent = gui }, C.Lavender)
	bannerText = UI.label("", { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 1, -16), TextWrapped = true, Parent = bannerFrame })
	-- windows
	local wgui = UI.screen("HUDWindows", 15)
	questWindow = UI.window(wgui, "Quests_Title", UDim2.fromOffset(560, 380))
	questList = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = questWindow.Content })
	UI.list(questList, 8)
	questWindow.OnOpen = function()
		HUDController:RefreshQuests()
	end
	dailyWindow = UI.window(wgui, "Daily_Title", UDim2.fromOffset(640, 300), C.Peach)
	dailyRow = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 110), Parent = dailyWindow.Content })
	UI.list(dailyRow, 6, true, Enum.HorizontalAlignment.Center)
	claimBtn = UI.button("", C.Mint, function()
		Remotes.event("ClaimDaily"):FireServer()
		task.delay(0.6, function()
			HUDController:RefreshDaily()
		end)
	end, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 124), Size = UDim2.fromOffset(200, 50), Parent = dailyWindow.Content })
	UI.bind(claimBtn, "Daily_Claim")
	dailyWindow.OnOpen = function()
		HUDController:RefreshDaily()
	end
end

function HUDController:Start()
	Remotes.event("Notify").OnClientEvent:Connect(function(msg, kind)
		self:Toast(msg, kind)
	end)
	Remotes.event("Banner").OnClientEvent:Connect(function(id, phase, extra)
		self:Banner(id, phase, extra)
	end)
	State.DataChanged:Connect(onData)
	State.LanguageChanged:Connect(function()
		if State.Data then
			onData(State.Data)
		end
		for _, card in cards do
			card.Name.Text = Strings.name(card.Def and card.Def.Name)
		end
	end)
	State.ShiftChanged:Connect(function(s)
		lobby.Visible = s == nil
		shift.Visible = s ~= nil
		if s then
			UI.closeAll()
			syncCards(s)
			clockLabel.Text = "🕖 " .. MathUtil.formatClock(s.Clock or 7)
			timeBar(1 - math.clamp((s.Time or 0) / (s.Duration or 480), 0, 1), if (s.Duration - s.Time) < 30 then C.Red else C.Mint)
			buildingBar((s.Building or 100) / 100, if (s.Building or 100) < 50 then C.Red else C.Green)
		else
			syncCards({ Babies = {} })
			if State.Data then
				onData(State.Data)
			end
		end
	end)
	State.HeldChanged:Connect(function(held)
		heldIcon.Text = emojiFor(held)
		if not held then
			heldName.Text = ""
		else
			heldName.Text = Strings.msg({ "Name_Generic", held.Id })
			if held.Kind == "Trash" or (held.Kind == "Tool" and held.Id == "TrashBag") then
				heldName.Text ..= " ×" .. tostring(player:GetAttribute("TrashCount") or 0)
			end
		end
	end)
	player:GetAttributeChangedSignal("TrashCount"):Connect(function()
		State.HeldChanged:Fire(State.Held)
	end)
	local t0 = os.clock()
	RunService.Heartbeat:Connect(function()
		if shift.Visible then
			updateCards(os.clock() - t0)
			local s = State.Shift
			if s then
				clockLabel.Text = "🕖 " .. MathUtil.formatClock(s.Clock or 7)
			end
		end
	end)
	for _, p in Players:GetPlayers() do
		nameTag(p)
	end
	Players.PlayerAdded:Connect(nameTag)
end

return HUDController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX129"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[-- InputController: drop (Q / ButtonB), use tool (LMB / R2, hold to repeat), run (Shift / L3),
-- movement speed modifiers (carrying, bandage trails) and slipping on puddles.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local GameSettings = require(Shared.Config.GameSettings)
local Tools = require(Shared.Config.Tools)
local State = require(script.Parent.Parent.State)

local player = Players.LocalPlayer
local InputController = { Running = false, UsingHeld = false }
local lastUse = 0
local slipVel = Vector3.zero

local function root(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function InputController:Drop()
	if State.inShift() and State.Held then
		Remotes.event("DropHeld"):FireServer()
	end
end

function InputController:UseOnce()
	local held = State.Held
	if not State.inShift() or not held or held.Kind ~= "Tool" then
		return
	end
	local def = Tools.Defs[held.Id]
	if not def or def.Use == "Prompt" or def.Use == "Place" then
		return
	end
	if self.Running and def.Use == "Cone" then
		return -- no tools while running
	end
	local now = os.clock()
	if now - lastUse < 0.2 then
		return
	end
	lastUse = now
	local r = root()
	Remotes.event("UseTool"):FireServer(r and r.CFrame.LookVector or Vector3.new(0, 0, -1), true)
	local fx = State.Controllers.EffectsController
	if fx and fx.LocalToolUse then
		fx:LocalToolUse(held.Id)
	end
end

function InputController:SetUsing(on: boolean)
	self.UsingHeld = on
	if on then
		self:UseOnce()
	end
end

function InputController:SetRunning(on: boolean)
	self.Running = on
end

local function isTyping(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

function InputController:Start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if isTyping() then
			return
		end
		local kc = input.KeyCode
		if kc == Enum.KeyCode.Q or kc == Enum.KeyCode.ButtonB then
			self:Drop()
		elseif kc == Enum.KeyCode.LeftShift or kc == Enum.KeyCode.ButtonL3 then
			self:SetRunning(if kc == Enum.KeyCode.ButtonL3 then not self.Running else true)
		elseif kc == Enum.KeyCode.ButtonR2 then
			self:SetUsing(true)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			self:SetUsing(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local kc = input.KeyCode
		if kc == Enum.KeyCode.LeftShift then
			self:SetRunning(false)
		elseif kc == Enum.KeyCode.ButtonR2 or input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:SetUsing(false)
		end
	end)

	local trailParams = OverlapParams.new()
	trailParams.FilterType = Enum.RaycastFilterType.Include
	RunService.Heartbeat:Connect(function(dt)
		if self.UsingHeld then
			local held = State.Held
			local def = held and held.Kind == "Tool" and Tools.Defs[held.Id]
			if def and def.Use == "Cone" then
				self:UseOnce()
			end
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local r = root()
		if not hum or not r then
			return
		end
		local speed = if self.Running then GameSettings.RunSpeed else GameSettings.WalkSpeed
		local slow = player:GetAttribute("HeldSlow") or 0
		speed *= (1 - slow)
		-- bandage trails and slippery puddles (only in a shift)
		local slippery = false
		if State.inShift() then
			local pos = r.Position
			for _, t in CollectionService:GetTagged("BandageTrail") do
				if t:IsA("BasePart") and (t.Position - pos).Magnitude < 3.2 and math.abs(t.Position.Y - (pos.Y - 3)) < 2 then
					speed *= 0.5
					break
				end
			end
			for _, p in CollectionService:GetTagged("Puddle") do
				if p:IsA("BasePart") and p:GetAttribute("Slippery") then
					local flat = Vector3.new(p.Position.X - pos.X, 0, p.Position.Z - pos.Z).Magnitude
					if flat < p.Size.Y / 2 and math.abs(p.Position.Y - (pos.Y - 3)) < 2.5 then
						slippery = true
						break
					end
				end
			end
		end
		hum.WalkSpeed = speed
		-- slip: keep sliding in the previous direction
		local vel = r.AssemblyLinearVelocity
		local flatVel = Vector3.new(vel.X, 0, vel.Z)
		if slippery then
			slipVel = slipVel:Lerp(flatVel, math.min(1, dt * 1.5))
			if slipVel.Magnitude > 2 then
				r.AssemblyLinearVelocity = Vector3.new(slipVel.X, vel.Y, slipVel.Z)
			end
		else
			slipVel = flatVel
		end
	end)
end

return InputController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX130"><Properties><string name="Name">InteractionController</string><ProtectedString name="Source"><![CDATA[-- InteractionController: shows only the prompts that make sense for what you hold, renders them in the
-- custom bubble style (with a hold ring + touch support), and opens lobby windows from lobby prompts.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared.Strings)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local InteractionController = {}
local Controllers
local original: { [ProximityPrompt]: number } = {}
local shown: { [ProximityPrompt]: BillboardGui } = {}

local function matches(need: string?, held: any): boolean
	if not need or need == "" or need == "Any" then
		return true
	end
	for token in string.gmatch(need, "[^,]+") do
		if token == "Empty" and held == nil then
			return true
		elseif token == "Baby" and held and held.Kind == "Baby" then
			return true
		elseif held then
			local kind, id = token:match("^(%w+):(%w+)$")
			if kind == "Kind" and held.Kind == id then
				return true
			elseif kind and kind ~= "Kind" and held.Kind == kind and held.Id == id then
				return true
			end
		end
	end
	return false
end

local function visibleFor(prompt: ProximityPrompt): boolean
	if not matches(prompt:GetAttribute("NeedHeld"), State.Held) then
		return false
	end
	if prompt:GetAttribute("NeedsReveal") then
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		if model and model:GetAttribute("LocallyVisible") == false then
			return false
		end
	end
	-- don't offer to pick up / feed the baby you are carrying
	local uid = player:GetAttribute("HeldUid")
	if uid then
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		if model and model:GetAttribute("Uid") == uid then
			return false
		end
	end
	return true
end

local function refreshOne(prompt: ProximityPrompt)
	if not original[prompt] then
		original[prompt] = prompt.MaxActivationDistance
	end
	prompt.MaxActivationDistance = if visibleFor(prompt) then original[prompt] else 0
end

function InteractionController:Refresh()
	for prompt in original do
		if prompt.Parent then
			refreshOne(prompt)
		else
			original[prompt] = nil
		end
	end
end

local function promptText(prompt: ProximityPrompt): (string, string)
	local action = prompt:GetAttribute("Action") or ""
	local key = "Prompt_" .. action
	local text = if Strings.has(key) then Strings.t(key) else prompt.ActionText
	local obj = prompt.ObjectText
	if obj ~= "" then
		obj = Strings.msg({ "Name_Generic", obj })
	end
	return text, obj
end

local function keyLabel(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		local k = prompt.GamepadKeyCode.Name
		return (k:gsub("^Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "👆"
	end
	return prompt.KeyboardKeyCode.Name
end

local function show(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	local pg = player:WaitForChild("PlayerGui")
	local bb = Instance.new("BillboardGui")
	bb.Name = "PromptUI"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(230, 64)
	bb.StudsOffset = Vector3.new(0, 2.2, 0)
	bb.LightInfluence = 0
	bb.Adornee = prompt.Parent :: any
	bb.ResetOnSpawn = false
	bb.Active = true
	bb.Parent = pg
	local frame = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Cream, BackgroundTransparency = 0.05, Parent = bb })
	UI.corner(frame, UDim.new(1, 0))
	UI.stroke(frame, C.Plum, 3)
	local keyBtn = UI.new("TextButton", {
		Size = UDim2.fromOffset(50, 50),
		Position = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.Mint,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = C.Plum,
		Text = keyLabel(prompt, inputType),
		AutoButtonColor = false,
		Parent = frame,
	})
	UI.corner(keyBtn, UDim.new(1, 0))
	UI.stroke(keyBtn, C.Plum, 2)
	local ring = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Yellow, BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 0, Parent = frame })
	UI.corner(ring, UDim.new(1, 0))
	local text, obj = promptText(prompt)
	UI.new("TextLabel", {
		Position = UDim2.fromOffset(64, 6),
		Size = UDim2.new(1, -74, 0, 30),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Plum,
		Text = text,
		Parent = frame,
	})
	UI.new("TextLabel", {
		Position = UDim2.fromOffset(64, 36),
		Size = UDim2.new(1, -74, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Plum,
		TextTransparency = 0.3,
		Text = obj,
		Parent = frame,
	})
	local holdTween: Tween? = nil
	local c1 = prompt.PromptButtonHoldBegan:Connect(function()
		if prompt.HoldDuration > 0 then
			ring.Size = UDim2.fromScale(0, 1)
			holdTween = TweenService:Create(ring, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
			holdTween:Play()
		end
	end)
	local c2 = prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		ring.Size = UDim2.fromScale(0, 1)
	end)
	local c3 = prompt.Triggered:Connect(function()
		frame.BackgroundColor3 = C.Mint
		task.delay(0.15, function()
			frame.BackgroundColor3 = C.Cream
		end)
	end)
	if inputType == Enum.ProximityPromptInputType.Touch or prompt.ClickablePrompt then
		keyBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldBegin()
			end
		end)
		keyBtn.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldEnd()
			end
		end)
	end
	local scale = UI.new("UIScale", { Scale = 0.5, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	bb.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
		c3:Disconnect()
	end)
	shown[prompt] = bb
end

local function hide(prompt: ProximityPrompt)
	local bb = shown[prompt]
	if bb then
		bb:Destroy()
		shown[prompt] = nil
	end
end

function InteractionController:Init(c)
	Controllers = c
end

function InteractionController:Start()
	local function add(p)
		if p:IsA("ProximityPrompt") then
			refreshOne(p)
		end
	end
	for _, p in CollectionService:GetTagged("MGPrompt") do
		add(p)
	end
	CollectionService:GetInstanceAddedSignal("MGPrompt"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("MGPrompt"):Connect(function(p)
		original[p] = nil
		hide(p)
	end)
	State.HeldChanged:Connect(function()
		self:Refresh()
	end)
	-- ghost reveal changes continuously; refresh a few times a second
	task.spawn(function()
		while true do
			task.wait(0.25)
			self:Refresh()
		end
	end)
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			show(prompt, inputType)
		end
	end)
	ProximityPromptService.PromptHidden:Connect(hide)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local action = prompt:GetAttribute("Action")
		if action == "OpenShop" then
			Controllers.ShopController:Open()
		elseif action == "OpenWardrobe" then
			Controllers.WardrobeController:Open()
		elseif action == "OpenPets" then
			Controllers.PetController:Open()
		elseif action == "OpenDaily" then
			Controllers.HUDController:OpenDaily()
		end
	end)
	local _ = UserInputService
end

return InteractionController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX131"><Properties><string name="Name">LightingController</string><ProtectedString name="Source"><![CDATA[-- LightingController: lobby dusk vs. shift day cycle (07:00 -> 19:00) per player, blackout darkness,
-- dark rooms, storm (rain + lightning) and the full-moon tint. Also drives clock hands, swings, mobiles etc.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local State = require(script.Parent.Parent.State)

local player = Players.LocalPlayer
local LightingController = {}
local Controllers
local rainPart: Part? = nil

local LOBBY = {
	ClockTime = 18.6,
	Brightness = 1.6,
	Ambient = Color3.fromRGB(95, 80, 120),
	OutdoorAmbient = Color3.fromRGB(130, 105, 150),
	FogColor = Color3.fromRGB(150, 120, 170),
}

local function daycare(): Model?
	local shift = State.Shift
	local dc = workspace:FindFirstChild("Daycares")
	return shift and dc and dc:FindFirstChild("Daycare_" .. tostring(shift.Slot)) :: Model?
end

local function roomOf(m: Model, pos: Vector3): string?
	local vols = m:FindFirstChild("RoomVolumes")
	if not vols then
		return nil
	end
	for _, v in vols:GetChildren() do
		if v:IsA("BasePart") then
			local rel = v.CFrame:PointToObjectSpace(pos)
			local h = v.Size / 2
			if math.abs(rel.X) <= h.X and math.abs(rel.Y) <= h.Y and math.abs(rel.Z) <= h.Z then
				return v:GetAttribute("RoomName")
			end
		end
	end
	return nil
end

local function ensureRain(on: boolean)
	if on and not rainPart then
		local p = Instance.new("Part")
		p.Name = "LocalRain"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Transparency = 1
		p.Size = Vector3.new(120, 1, 120)
		p.Parent = workspace
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(180, 200, 255))
		e.Size = NumberSequence.new(0.15)
		e.Transparency = NumberSequence.new(0.3)
		e.Rate = if Controllers.SettingsController:Quality() == "Low" then 150 else 500
		e.Lifetime = NumberRange.new(1, 1.4)
		e.Speed = NumberRange.new(60, 70)
		e.EmissionDirection = Enum.NormalId.Bottom
		e.LightEmission = 0.3
		e.Parent = p
		rainPart = p
	elseif not on and rainPart then
		rainPart:Destroy()
		rainPart = nil
	end
end

local lightningAt = 0
local function lightningFlash()
	local cc = Lighting:FindFirstChild("ColorCorrection") :: ColorCorrectionEffect?
	if cc then
		cc.Brightness = 0.5
		TweenService:Create(cc, TweenInfo.new(0.4), { Brightness = 0 }):Play()
	end
	if Controllers.SoundController then
		Controllers.SoundController:Play("Env_Thunder")
	end
end

function LightingController:Init(c)
	Controllers = c
end

function LightingController:Start()
	local dark = Lighting:WaitForChild("DarkCorrection", 10) :: ColorCorrectionEffect?
	local cc = Lighting:FindFirstChild("ColorCorrection") :: ColorCorrectionEffect?
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local darkTarget = 0

	RunService.RenderStepped:Connect(function(dt)
		local shift = State.Shift
		local m = daycare()
		local char = player.Character
		local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local storm, fullMoon, powerOn = false, false, true
		if shift and m then
			storm = m:GetAttribute("Storm") == true
			fullMoon = m:GetAttribute("FullMoon") == true
			powerOn = m:GetAttribute("PowerOn") ~= false
			local clock = shift.Clock or 7
			if not shift.ClockFrozen and shift.Phase == "Playing" then
				-- extrapolate between 1 s state updates for a smooth sun
				shift.Clock = clock + dt * 12 / (shift.Duration or 480)
			end
			Lighting.ClockTime = Lighting.ClockTime + ((shift.Clock or 7) - Lighting.ClockTime) * math.min(1, dt * 2)
			local evening = math.clamp((Lighting.ClockTime - 16) / 3, 0, 1)
			Lighting.Brightness = (if storm then 1.2 else 2.4) - evening * 0.8
			Lighting.OutdoorAmbient = Color3.fromRGB(150, 145, 160):Lerp(Color3.fromRGB(170, 120, 110), evening)
			Lighting.Ambient = Color3.fromRGB(110, 105, 120)
			if atm then
				atm.Density = if storm then 0.5 else 0.25 + evening * 0.1
				atm.Color = Color3.fromRGB(220, 230, 245):Lerp(Color3.fromRGB(255, 180, 140), evening)
			end
			if cc then
				cc.TintColor = if fullMoon then Color3.fromRGB(210, 190, 255) else Color3.fromRGB(255, 245, 240)
			end
			-- darkness: blackout indoors, dark rooms
			local room = r and roomOf(m, r.Position)
			local indoor = room ~= nil and room ~= "Yard" and room ~= "Outside"
			darkTarget = 0
			if not powerOn and indoor then
				darkTarget = -0.32
			elseif room == "Basement" then
				darkTarget = -0.15
			elseif room == "Bedroom" and m:GetAttribute("CurtainsClosed") then
				darkTarget = -0.2
			end
			if storm then
				ensureRain(true)
				if rainPart and r then
					rainPart.CFrame = CFrame.new(r.Position + Vector3.new(0, 40, 0))
				end
				if os.clock() > lightningAt then
					lightningAt = os.clock() + math.random(6, 14)
					lightningFlash()
				end
			else
				ensureRain(false)
			end
		else
			ensureRain(false)
			Lighting.ClockTime = LOBBY.ClockTime
			Lighting.Brightness = LOBBY.Brightness
			Lighting.Ambient = LOBBY.Ambient
			Lighting.OutdoorAmbient = LOBBY.OutdoorAmbient
			if atm then
				atm.Density = 0.35
				atm.Color = Color3.fromRGB(230, 190, 210)
			end
			if cc then
				cc.TintColor = Color3.fromRGB(255, 240, 245)
			end
			darkTarget = 0
		end
		if dark then
			dark.Brightness = dark.Brightness + (darkTarget - dark.Brightness) * math.min(1, dt * 4)
		end
	end)

	-- Ambient animations (cheap, local): mobiles, swings, clocks, drifting balloon, bobbing arrows, eyes, flicker.
	local t0 = os.clock()
	RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		for _, m in CollectionService:GetTagged("Spinner") do
			if m:IsA("Model") and m.PrimaryPart then
				local base = m:GetAttribute("BaseCF")
				if not base then
					base = m:GetPivot()
					m:SetAttribute("BaseCF", base)
				end
				m:PivotTo(base * CFrame.Angles(0, t * (m:GetAttribute("Speed") or 0.5), 0))
			end
		end
		for _, seat in CollectionService:GetTagged("Swing") do
			local pivot = seat:GetAttribute("PivotCF")
			if seat:IsA("Model") and typeof(pivot) == "CFrame" then
				local base = seat:GetAttribute("BaseOffset")
				if not base then
					base = pivot:ToObjectSpace(seat:GetPivot())
					seat:SetAttribute("BaseOffset", base)
				end
				local angle = math.sin(t * 1.6 + (seat:GetAttribute("Phase") or 0)) * 0.35
				seat:PivotTo(pivot * CFrame.Angles(angle, 0, 0) * base)
			end
		end
		local clock = if State.Shift then (State.Shift.Clock or 7) else 18.5
		for _, hand in CollectionService:GetTagged("ClockHandHour") do
			local pivot = hand:GetAttribute("PivotCF")
			if typeof(pivot) == "CFrame" and hand:IsA("BasePart") then
				local a = (clock % 12) / 12 * math.pi * 2
				hand.CFrame = pivot * CFrame.Angles(0, 0, -a) * CFrame.new(0, (hand:GetAttribute("Length") or 1) / 2, 0)
			end
		end
		for _, hand in CollectionService:GetTagged("ClockHandMinute") do
			local pivot = hand:GetAttribute("PivotCF")
			if typeof(pivot) == "CFrame" and hand:IsA("BasePart") then
				local a = (clock % 1) * math.pi * 2
				hand.CFrame = pivot * CFrame.Angles(0, 0, -a) * CFrame.new(0, (hand:GetAttribute("Length") or 1) / 2, 0)
			end
		end
		for _, m in CollectionService:GetTagged("Drifter") do
			local c = m:GetAttribute("Center")
			if m:IsA("Model") and typeof(c) == "Vector3" then
				m:PivotTo(CFrame.new(c + Vector3.new(math.sin(t * 0.05) * 30, math.sin(t * 0.3) * 2, math.cos(t * 0.05) * 20)))
			end
		end
		for _, p in CollectionService:GetTagged("Bobber") do
			if p:IsA("BasePart") then
				local base = p:GetAttribute("BaseCF")
				if not base then
					base = p.CFrame
					p:SetAttribute("BaseCF", base)
				end
				p.CFrame = base + Vector3.new(0, math.sin(t * 3) * 0.6, 0)
			end
		end
		local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		for _, eye in CollectionService:GetTagged("LookingEye") do
			local center = eye:GetAttribute("Center")
			if eye:IsA("BasePart") and typeof(center) == "Vector3" and r then
				local d = r.Position - center
				local off = if d.Magnitude > 0.1 then d.Unit * 0.12 else Vector3.zero
				eye.Position = center + Vector3.new(off.X, math.clamp(off.Y, -0.08, 0.08), off.Z)
			end
		end
		for _, lamp in CollectionService:GetTagged("Flicker") do
			local light = lamp:FindFirstChildWhichIsA("PointLight", true)
			if light then
				local on = light:GetAttribute("ServerEnabled")
				if on == nil then
					light:SetAttribute("ServerEnabled", true)
				end
				light.Brightness = if math.noise(t * 3, lamp:GetPivot().Position.X) > 0.35 then 0.15 else 1.1
			end
		end
	end)
end

return LightingController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX132"><Properties><string name="Name">LoadingController</string><ProtectedString name="Source"><![CDATA[-- LoadingController: Monstergarten loading screen with a bouncing baby until your data has loaded.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Config.Assets)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local C = UI.Theme.Colors
local LoadingController = {}
local gui: ScreenGui

function LoadingController:Init()
	gui = UI.screen("LoadingGui", 100)
	local bg = UI.new("Frame", { BackgroundColor3 = C.Plum, Size = UDim2.fromScale(1, 1), Parent = gui })
	UI.new("UIGradient", { Color = ColorSequence.new(C.Plum, Color3.fromRGB(120, 90, 160)), Rotation = 90, Parent = bg })
	if Assets.Images.Logo ~= 0 then
		UI.new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(520, 200), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = "rbxassetid://" .. Assets.Images.Logo, Parent = bg })
	else
		UI.label("MONSTERGARTEN", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(700, 90), TextColor3 = C.Peach, TextStrokeTransparency = 0.6, Parent = bg })
	end
	local baby = UI.label("👾", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.fromOffset(110, 110), Parent = bg })
	local tag = UI.label("🍼 ...", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.75), Size = UDim2.fromOffset(500, 36), TextColor3 = C.Cream, Parent = bg })
	UI.bind(tag, "Loading_Tagline")
	TweenService:Create(baby, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), { Position = UDim2.fromScale(0.5, 0.55), Rotation = 10 }):Play()
end

function LoadingController:Start()
	local function finish()
		if not gui.Parent then
			return
		end
		local bg = gui:FindFirstChildOfClass("Frame")
		if bg then
			for _, d in bg:GetDescendants() do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
				elseif d:IsA("ImageLabel") then
					TweenService:Create(d, TweenInfo.new(0.6), { ImageTransparency = 1 }):Play()
				end
			end
			TweenService:Create(bg, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
		end
		task.delay(0.9, function()
			gui:Destroy()
		end)
	end
	if State.Data then
		task.delay(1, finish)
	else
		local conn
		conn = State.DataChanged:Connect(function()
			conn:Disconnect()
			task.delay(0.8, finish)
		end)
		task.delay(15, finish)
	end
end

return LoadingController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX133"><Properties><string name="Name">MobileController</string><ProtectedString name="Source"><![CDATA[-- MobileController: on-screen buttons for touch devices (Use, Drop, Run).
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Tools = require(Shared.Config.Tools)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local C = UI.Theme.Colors
local MobileController = {}
local Controllers
local gui

local function roundButton(text: string, color: Color3, pos: UDim2, size: number)
	local b = UI.button(text, color, nil, {
		Size = UDim2.fromOffset(size, size),
		Position = pos,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = gui,
	})
	UI.corner(b, UDim.new(1, 0))
	return b
end

function MobileController:Init(c)
	Controllers = c
end

function MobileController:Start()
	if not UserInputService.TouchEnabled then
		return
	end
	gui = UI.screen("MobileGui", 5)
	local use = roundButton("👆", C.Mint, UDim2.new(1, -110, 1, -230), 86)
	local drop = roundButton("⬇️", C.Peach, UDim2.new(1, -205, 1, -160), 66)
	local run = roundButton("🏃", C.Lavender, UDim2.new(1, -60, 1, -320), 62)
	use.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			Controllers.InputController:SetUsing(true)
		end
	end)
	use.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			Controllers.InputController:SetUsing(false)
		end
	end)
	drop.Activated:Connect(function()
		Controllers.InputController:Drop()
	end)
	run.Activated:Connect(function()
		local ic = Controllers.InputController
		ic:SetRunning(not ic.Running)
		run.BackgroundColor3 = if ic.Running then C.Yellow else C.Lavender
	end)
	local function refresh()
		local inShift = State.inShift()
		local held = State.Held
		local def = held and held.Kind == "Tool" and Tools.Defs[held.Id]
		use.Visible = inShift and def ~= nil and def.Use ~= "Prompt" and def.Use ~= "Place"
		use.Text = if def then def.Emoji else "👆"
		drop.Visible = inShift and held ~= nil
		run.Visible = true
	end
	State.HeldChanged:Connect(refresh)
	State.ShiftChanged:Connect(refresh)
	refresh()
end

return MobileController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX134"><Properties><string name="Name">PetController</string><ProtectedString name="Source"><![CDATA[-- PetController: adopt babies you're friends with, equip pets (they follow you in the lobby), rename them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Babies = require(Shared.Config.Babies)
local Progression = require(Shared.Config.Progression)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local PetController = {}
local window
local list: ScrollingFrame

local function render()
	if not window or not window.IsOpen() then
		return
	end
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local d = State.Data
	if not d then
		return
	end
	local order = 0
	local slots = player:GetAttribute("PetSlots") or 1
	local header = UI.label("", { Size = UDim2.new(1, -10, 0, 30), LayoutOrder = 0, Parent = list })
	header.Text = Strings.t("Pets_Slots", #d.EquippedPets, slots)
	header.Parent = list
	-- owned pets
	for idx, pet in d.Pets do
		order += 1
		local def = Babies.Defs[pet.BabyId]
		local equipped = table.find(d.EquippedPets, idx) ~= nil
		local f = UI.panel({ Size = UDim2.new(1, -10, 0, 64), LayoutOrder = order, Parent = list }, if equipped then C.Mint else C.Cream)
		UI.label(def and def.Emoji or "?", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(48, 48), Parent = f })
		local box = UI.new("TextBox", {
			Position = UDim2.fromOffset(62, 12),
			Size = UDim2.new(1, -310, 0, 40),
			BackgroundColor3 = C.White,
			Font = UI.Theme.Font,
			TextScaled = true,
			TextColor3 = C.Plum,
			Text = pet.Name,
			ClearTextOnFocus = false,
			Parent = f,
		})
		UI.corner(box, UDim.new(0, 10))
		local rename = UI.button("", C.Lavender, function()
			Remotes.event("PetAction"):FireServer("Rename", idx, box.Text)
		end, { Position = UDim2.new(1, -240, 0, 10), Size = UDim2.fromOffset(110, 44), Parent = f })
		UI.bind(rename, "Pets_Rename")
		local eq = UI.button("", if equipped then C.Pink else C.Mint, function()
			Remotes.event("PetAction"):FireServer("Equip", idx)
		end, { Position = UDim2.new(1, -122, 0, 10), Size = UDim2.fromOffset(112, 44), Parent = f })
		UI.bind(eq, if equipped then "Pets_Unequip" else "Pets_Equip")
	end
	-- adoptable babies (friendship progress)
	for _, id in Babies.Order do
		local has = false
		for _, p in d.Pets do
			if p.BabyId == id then
				has = true
			end
		end
		local seen = d.SeenBabies[id] or (d.BabyFriendship[id] or 0) > 0
		if not has and seen then
			order += 1
			local def = Babies.Defs[id]
			local fr = d.BabyFriendship[id] or 0
			local f = UI.panel({ Size = UDim2.new(1, -10, 0, 64), LayoutOrder = order, Parent = list }, C.Peach)
			UI.label(def.Emoji, { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(48, 48), Parent = f })
			UI.label(Strings.name(def.Name), { Position = UDim2.fromOffset(62, 6), Size = UDim2.new(1, -250, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
			local _, set = UI.bar({ Position = UDim2.fromOffset(62, 40), Size = UDim2.new(1, -250, 0, 12), Parent = f }, C.Pink)
			set(fr / Progression.FriendshipToAdopt)
			local can = fr >= Progression.FriendshipToAdopt
			local b = UI.button("", if can then C.Mint else Color3.fromRGB(190, 190, 190), function()
				if can then
					Remotes.event("PetAction"):FireServer("Adopt", id)
				end
			end, { Position = UDim2.new(1, -170, 0, 10), Size = UDim2.fromOffset(160, 44), Parent = f })
			b.Text = if can then Strings.t("Pets_Adopt") else ("❤️ " .. fr .. "/" .. Progression.FriendshipToAdopt)
		end
	end
	if order == 0 then
		local l = UI.label("", { Size = UDim2.new(1, -10, 0, 80), TextWrapped = true, LayoutOrder = 1, Parent = list })
		UI.bind(l, "Pets_Empty")
	end
end

function PetController:Open()
	if State.inShift() then
		return
	end
	window.Open()
end

function PetController:Init()
	local gui = UI.screen("PetsGui", 16)
	window = UI.window(gui, "Pets_Title", UDim2.fromOffset(700, 520), C.Peach)
	list = UI.scroll(window.Content)
	UI.list(list, 8)
	window.OnOpen = render
end

function PetController:Start()
	State.DataChanged:Connect(render)
	State.LanguageChanged:Connect(render)
end

return PetController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX135"><Properties><string name="Name">QueueController</string><ProtectedString name="Source"><![CDATA[-- QueueController: panel shown while waiting at a shift door (players, difficulty, start now, leave,
-- Head Nanny baby picker). Also hides the tutorial door once the tutorial is done.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Difficulty = require(Shared.Config.Difficulty)
local Babies = require(Shared.Config.Babies)
local P = require(Shared.Logic.ProgressionMath)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local QueueController = {}
local panel: Frame
local title: TextLabel
local avatars: Frame
local diffRow: Frame
local startBtn: TextButton
local babyRow: Frame
local current: any = nil
local thumbs: { [number]: string } = {}
local picked: { string } = {}

local function thumb(userId: number): string
	if thumbs[userId] then
		return thumbs[userId]
	end
	local ok, img = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
	thumbs[userId] = if ok then img else ""
	return thumbs[userId]
end

local function render()
	local q = current
	panel.Visible = q ~= nil
	if not q then
		return
	end
	local isHost = q.Host == player.UserId
	local modeKey = if q.Mode == "Shift" then "Queue_Title" elseif q.Mode == "Solo" then "Queue_Solo" else "Queue_Tutorial"
	if q.Waiting then
		title.Text = Strings.t("Queue_Waiting")
	elseif q.Countdown then
		title.Text = Strings.t(modeKey) .. "  ⏱ " .. Strings.t("Queue_Starting", q.Countdown)
	else
		title.Text = Strings.t(modeKey)
	end
	for _, c in avatars:GetChildren() do
		if c:IsA("ImageLabel") then
			c:Destroy()
		end
	end
	for i, uid in q.Players do
		local img = UI.new("ImageLabel", { Size = UDim2.fromOffset(52, 52), BackgroundColor3 = if uid == q.Host then C.Yellow else C.Lavender, Image = "", LayoutOrder = i, Parent = avatars })
		UI.corner(img, UDim.new(1, 0))
		task.spawn(function()
			img.Image = thumb(uid)
		end)
	end
	local d = State.Data
	local level = d and P.daycareLevel(d.TotalStars) or 1
	for _, b in diffRow:GetChildren() do
		if b:IsA("TextButton") then
			local id = b.Name
			local def = Difficulty.Defs[id]
			local unlocked = level >= def.UnlockLevel or (d and d.DebugUnlockAll)
			b.BackgroundColor3 = if q.Difficulty == id then C.Yellow elseif unlocked then def.Color else Color3.fromRGB(180, 180, 180)
			b.Text = Strings.t("Difficulty_" .. id) .. (if unlocked then "" else " 🔒")
			b.Active = isHost and unlocked
			b.AutoButtonColor = false
		end
	end
	diffRow.Visible = q.Mode == "Shift" or q.Mode == "Solo"
	startBtn.Visible = isHost and q.Mode ~= "Tutorial"
	babyRow.Visible = isHost and player:GetAttribute("HeadNanny") == true and q.Mode ~= "Tutorial"
end

local function buildBabyRow()
	for _, c in babyRow:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local d = State.Data
	for i, id in Babies.Order do
		local def = Babies.Defs[id]
		local unlocked = d and (P.isUnlocked(d.TotalStars, "Baby:" .. id) or d.DebugUnlockAll)
		if unlocked then
			local b = UI.button(def.Emoji, if table.find(picked, id) then C.Yellow else C.Cream, nil, { Size = UDim2.fromOffset(44, 44), LayoutOrder = i, Parent = babyRow })
			b.Activated:Connect(function()
				local at = table.find(picked, id)
				if at then
					table.remove(picked, at)
				else
					table.insert(picked, id)
				end
				b.BackgroundColor3 = if table.find(picked, id) then C.Yellow else C.Cream
				Remotes.event("QueueAction"):FireServer("Babies", picked)
			end)
		end
	end
end

function QueueController:Init()
	local gui = UI.screen("QueueGui", 8)
	panel = UI.panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(560, 230), Visible = false, Parent = gui }, C.Cream)
	title = UI.label("", { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 34), Parent = panel })
	avatars = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 46), Size = UDim2.new(1, -28, 0, 54), Parent = panel })
	UI.list(avatars, 6, true, Enum.HorizontalAlignment.Center)
	diffRow = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 106), Size = UDim2.new(1, -28, 0, 44), Parent = panel })
	UI.list(diffRow, 8, true, Enum.HorizontalAlignment.Center)
	for i, id in Difficulty.Order do
		local b = UI.button(id, Difficulty.Defs[id].Color, function()
			if current and current.Host == player.UserId then
				Remotes.event("QueueAction"):FireServer("Difficulty", id)
			end
		end, { Size = UDim2.fromOffset(160, 44), LayoutOrder = i, Parent = diffRow })
		b.Name = id
	end
	babyRow = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, -54), Size = UDim2.new(1, -28, 0, 46), Parent = panel })
	UI.list(babyRow, 4, true, Enum.HorizontalAlignment.Center)
	startBtn = UI.button("", C.Mint, function()
		Remotes.event("QueueAction"):FireServer("StartNow")
	end, { Position = UDim2.new(0.5, -180, 1, -60), Size = UDim2.fromOffset(170, 48), Parent = panel })
	UI.bind(startBtn, "Queue_StartNow")
	local leave = UI.button("", C.Pink, function()
		Remotes.event("QueueAction"):FireServer("Leave")
	end, { Position = UDim2.new(0.5, 10, 1, -60), Size = UDim2.fromOffset(170, 48), Parent = panel })
	UI.bind(leave, "Queue_Leave")
end

function QueueController:Start()
	Remotes.event("QueueUpdate").OnClientEvent:Connect(function(state)
		local wasNil = current == nil
		current = state
		if state and wasNil then
			picked = state.PreferredBabies and table.clone(state.PreferredBabies) or {}
			buildBabyRow()
		end
		render()
	end)
	State.LanguageChanged:Connect(render)
	-- hide the tutorial door after the tutorial is done
	State.DataChanged:Connect(function(d)
		for _, door in CollectionService:GetTagged("QueueDoor") do
			if door:GetAttribute("DoorId") == "Tutorial" then
				for _, p in door:GetDescendants() do
					if p:IsA("BasePart") then
						p.LocalTransparencyModifier = if d and d.TutorialDone then 0.85 else 0
					end
				end
			end
		end
	end)
end

return QueueController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX136"><Properties><string name="Name">ResultsController</string><ProtectedString name="Source"><![CDATA[-- ResultsController: animated end-of-shift screen (stars drop in, numbers count up, baby cards, MVP).
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Babies = require(Shared.Config.Babies)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local C = UI.Theme.Colors
local ResultsController = { Showing = false }
local Controllers
local gui: ScreenGui
local panel: Frame

local function countUp(label: TextLabel, prefix: string, target: number, time: number)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < time do
			label.Text = prefix .. tostring(math.floor(target * (os.clock() - t0) / time))
			task.wait()
		end
		label.Text = prefix .. tostring(target)
	end)
end

local function confetti(parent: Instance)
	for i = 1, 40 do
		local f = UI.new("Frame", {
			Size = UDim2.fromOffset(10, 16),
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			BackgroundColor3 = Color3.fromHSV(math.random(), 0.5, 1),
			Rotation = math.random(0, 360),
			BorderSizePixel = 0,
			ZIndex = 20,
			Parent = parent,
		})
		TweenService:Create(f, TweenInfo.new(1.6 + math.random() * 1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(f.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = f.Rotation + math.random(-360, 360),
		}):Play()
		task.delay(3.2, function()
			f:Destroy()
		end)
		if i % 10 == 0 then
			task.wait(0.05)
		end
	end
end

function ResultsController:Show(r)
	self.Showing = true
	if Controllers.SoundController then
		Controllers.SoundController:Music("Results")
	end
	for _, c in panel:GetChildren() do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") and not c:IsA("UIScale") then
			c:Destroy()
		end
	end
	panel.Visible = true
	local title = UI.label("", { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -32, 0, 44), Parent = panel })
	UI.bind(title, if r.Tutorial then "Results_TutorialDone" else "Results_Title")
	-- stars
	local starRow = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 90), Parent = panel })
	UI.list(starRow, 14, true, Enum.HorizontalAlignment.Center)
	for i = 1, 3 do
		local s = UI.label("⭐", { Size = UDim2.fromOffset(84, 84), TextTransparency = 0.85, LayoutOrder = i, Parent = starRow })
		if i <= (r.Stars or 0) then
			task.delay(0.5 + i * 0.5, function()
				local scale = UI.new("UIScale", { Scale = 3, Parent = s })
				s.TextTransparency = 0
				TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Bounce), { Scale = 1 }):Play()
				if Controllers.SoundController then
					Controllers.SoundController:Play("UI_Star")
				end
			end)
		end
	end
	-- numbers
	local personal = r.Personal or {}
	local stats = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 156), Size = UDim2.new(1, -40, 0, 70), Parent = panel })
	UI.list(stats, 10, true, Enum.HorizontalAlignment.Center)
	local function stat(order, prefix, value)
		local box = UI.panel({ Size = UDim2.fromOffset(150, 64), LayoutOrder = order, Parent = stats }, C.Peach)
		local l = UI.label(prefix .. "0", { Position = UDim2.fromOffset(6, 10), Size = UDim2.new(1, -12, 0, 44), Parent = box })
		countUp(l, prefix, value, 1.4)
	end
	stat(1, "📊 ", r.FinalScore or 0)
	stat(2, "🪙 ", personal.Coins or 0)
	stat(3, "✨ ", personal.XP or 0)
	stat(4, "🏠 ", r.BuildingScore or 0)
	-- MVP
	if r.MVPName then
		local mvp = UI.label("", { Position = UDim2.fromOffset(16, 232), Size = UDim2.new(1, -32, 0, 30), TextColor3 = C.Pumpkin, Parent = panel })
		mvp.Text = "👑 " .. Strings.t("Results_MVP", r.MVPName) .. (if personal.MVP then " (+20%)" else "")
	end
	-- baby cards
	local scroll = UI.scroll(panel, { Position = UDim2.fromOffset(16, 268), Size = UDim2.new(1, -32, 0, 120), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollingDirection = Enum.ScrollingDirection.X })
	UI.list(scroll, 8, true)
	for i, b in r.Babies or {} do
		local def = Babies.Defs[b.BabyId]
		local card = UI.panel({ Size = UDim2.fromOffset(96, 110), LayoutOrder = i, Parent = scroll }, if b.Score >= 85 then C.Mint elseif b.Score >= 50 then C.Yellow else C.Pink)
		UI.label((def and def.Emoji or "?") .. (b.Face or ""), { Position = UDim2.fromOffset(4, 6), Size = UDim2.new(1, -8, 0, 40), Parent = card })
		UI.label(Strings.name(def and def.Name), { Position = UDim2.fromOffset(4, 48), Size = UDim2.new(1, -8, 0, 22), Parent = card })
		UI.label(tostring(b.Score), { Position = UDim2.fromOffset(4, 72), Size = UDim2.new(1, -8, 0, 30), Parent = card })
	end
	-- buttons
	if not r.Tutorial then
		local again = UI.button("", C.Mint, function()
			Remotes.event("ResultsChoice"):FireServer("Again")
			self:Hide()
		end, { Position = UDim2.new(0.5, -220, 1, -66), Size = UDim2.fromOffset(200, 50), Parent = panel })
		UI.bind(again, "Results_Again")
	end
	local lobbyBtn = UI.button("", C.Lavender, function()
		Remotes.event("ResultsChoice"):FireServer("Lobby")
		self:Hide()
	end, { Position = UDim2.new(0.5, if r.Tutorial then -100 else 20, 1, -66), Size = UDim2.fromOffset(200, 50), Parent = panel })
	UI.bind(lobbyBtn, "Results_Lobby")
	if (r.Stars or 0) >= 2 then
		task.delay(2, function()
			confetti(gui)
		end)
	end
end

function ResultsController:Hide()
	self.Showing = false
	panel.Visible = false
end

function ResultsController:Init(c)
	Controllers = c
	gui = UI.screen("ResultsGui", 25)
	panel = UI.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 480), Visible = false, Parent = gui }, C.Cream)
end

function ResultsController:Start()
	Remotes.event("Results").OnClientEvent:Connect(function(r)
		self:Show(r or {})
	end)
	State.ShiftChanged:Connect(function(s)
		if not s and self.Showing then
			self:Hide()
		end
	end)
end

return ResultsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX137"><Properties><string name="Name">SettingsController</string><ProtectedString name="Source"><![CDATA[-- SettingsController: music / sfx volume, language, camera shake, effects quality, replay tutorial.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local C = UI.Theme.Colors
local SettingsController = {
	Settings = { MusicVolume = 0.5, SfxVolume = 0.8, Language = "auto", CameraShake = true, Quality = "High" },
}
local window
local rows = {}

local function set(key: string, value: any)
	SettingsController.Settings[key] = value
	Remotes.event("SetSetting"):FireServer(key, value)
	SettingsController:Refresh()
	if key == "Language" then
		local lang = Strings.resolve(value, State.player.LocaleId)
		Strings.setLanguage(lang)
		UI.relocalize()
		State.LanguageChanged:Fire(lang)
	end
end

function SettingsController:Quality(): string
	local q = self.Settings.Quality
	if q == "Auto" or q == nil then
		return if UserInputService.TouchEnabled then "Low" else "High"
	end
	return q
end

function SettingsController:Refresh()
	local s = self.Settings
	if rows.Music then
		rows.Music.Text = ("%d%%"):format(math.floor(s.MusicVolume * 100 + 0.5))
		rows.Sfx.Text = ("%d%%"):format(math.floor(s.SfxVolume * 100 + 0.5))
		rows.Lang.Text = if s.Language == "auto" then Strings.t("Settings_Auto") else string.upper(s.Language)
		rows.Shake.Text = Strings.t(if s.CameraShake then "On" else "Off")
		rows.Quality.Text = Strings.t("Quality_" .. tostring(s.Quality))
	end
end

local function row(parent, order: number, labelKey: string, build: (Frame) -> ())
	local r = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = order, Parent = parent })
	local l = UI.label("", { Size = UDim2.new(0.45, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
	UI.bind(l, labelKey)
	local right = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.45, 0), Size = UDim2.fromScale(0.55, 1), Parent = r })
	UI.list(right, 6, true, Enum.HorizontalAlignment.Right)
	build(right)
end

function SettingsController:Open()
	window.Open()
end

function SettingsController:Init()
	local gui = UI.screen("SettingsGui", 20)
	window = UI.window(gui, "Settings_Title", UDim2.fromOffset(520, 470))
	local list = window.Content
	UI.list(list, 8)
	local function volumeRow(order, key, settingKey, rowKey)
		row(list, order, key, function(right)
			UI.button("−", C.Peach, function()
				set(settingKey, math.max(0, math.floor((self.Settings[settingKey] - 0.1) * 10 + 0.5) / 10))
			end, { Size = UDim2.fromOffset(44, 44), LayoutOrder = 1, Parent = right })
			rows[rowKey] = UI.label("", { Size = UDim2.fromOffset(80, 44), LayoutOrder = 2, Parent = right })
			UI.button("+", C.Mint, function()
				set(settingKey, math.min(1, math.floor((self.Settings[settingKey] + 0.1) * 10 + 0.5) / 10))
			end, { Size = UDim2.fromOffset(44, 44), LayoutOrder = 3, Parent = right })
		end)
	end
	volumeRow(1, "Settings_Music", "MusicVolume", "Music")
	volumeRow(2, "Settings_Sfx", "SfxVolume", "Sfx")
	row(list, 3, "Settings_Language", function(right)
		rows.Lang = UI.button("", C.Lavender, function()
			local order = { "auto", "en", "lt" }
			local i = table.find(order, self.Settings.Language) or 1
			set("Language", order[(i % #order) + 1])
		end, { Size = UDim2.fromOffset(150, 44), Parent = right })
	end)
	row(list, 4, "Settings_Shake", function(right)
		rows.Shake = UI.button("", C.Lavender, function()
			set("CameraShake", not self.Settings.CameraShake)
		end, { Size = UDim2.fromOffset(150, 44), Parent = right })
	end)
	row(list, 5, "Settings_Quality", function(right)
		rows.Quality = UI.button("", C.Lavender, function()
			local order = { "High", "Low", "Auto" }
			local i = table.find(order, self.Settings.Quality) or 1
			set("Quality", order[(i % #order) + 1])
		end, { Size = UDim2.fromOffset(150, 44), Parent = right })
	end)
	-- Music Box game pass: pick a lobby track (only tracks with uploaded ids)
	local tracks = {}
	for _, t in require(Shared.Config.Assets).MusicBox do
		if t.Id ~= 0 then
			table.insert(tracks, t)
		end
	end
	if #tracks > 0 then
		row(list, 5.5, "Settings_MusicBox", function(right)
			local idx = 0
			rows.MusicBox = UI.button("🎶 -", C.Peach, function()
				if not State.player:GetAttribute("MusicBox") then
					return
				end
				idx = (idx % (#tracks + 1)) + 1
				local t = tracks[idx]
				rows.MusicBox.Text = if t then ("🎶 " .. t.Name) else "🎶 -"
				State.Controllers.SoundController:SetMusicBox(t and t.Id or nil)
			end, { Size = UDim2.fromOffset(200, 44), Parent = right })
		end)
	end
	row(list, 6, "Settings_Tutorial", function(right)
		local b = UI.button("", C.Yellow, function()
			window.Close()
			Remotes.event("TutorialAction"):FireServer("Replay")
		end, { Size = UDim2.fromOffset(150, 44), Parent = right })
		UI.bind(b, "Settings_Replay")
	end)
	self:Refresh()
end

function SettingsController:Start()
	State.DataChanged:Connect(function(data)
		if data and data.Settings then
			for k, v in data.Settings do
				self.Settings[k] = v
			end
			self:Refresh()
		end
	end)
	State.LanguageChanged:Connect(function()
		UI.relocalize()
		self:Refresh()
	end)
end

return SettingsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX138"><Properties><string name="Name">ShopController</string><ProtectedString name="Source"><![CDATA[-- ShopController: tabs Tools / Daycare / Cosmetics / Robux. Buying is validated on the server.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Tools = require(Shared.Config.Tools)
local Shop = require(Shared.Config.Shop)
local Cosmetics = require(Shared.Config.Cosmetics)
local Monetization = require(Shared.Config.Monetization)
local P = require(Shared.Logic.ProgressionMath)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local C = UI.Theme.Colors
local ShopController = {}
local window
local tabBar: Frame
local grid: ScrollingFrame
local tab = "Tools"
local productPrices: { [number]: string } = {}

local function card(order: number, emoji: string, name: string, sub: string, price: string, color: Color3, enabled: boolean, onBuy: () -> ())
	local f = UI.panel({ Size = UDim2.fromOffset(196, 200), LayoutOrder = order, Parent = grid }, color)
	UI.label(emoji, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 56), Parent = f })
	UI.label(name, { Position = UDim2.fromOffset(8, 66), Size = UDim2.new(1, -16, 0, 28), TextWrapped = true, Parent = f })
	UI.label(sub, { Position = UDim2.fromOffset(8, 96), Size = UDim2.new(1, -16, 0, 40), Font = Enum.Font.GothamBold, TextWrapped = true, TextTransparency = 0.2, Parent = f })
	local b = UI.button(price, if enabled then C.Mint else Color3.fromRGB(190, 190, 190), function()
		if enabled then
			onBuy()
		end
	end, { Position = UDim2.new(0, 12, 1, -54), Size = UDim2.new(1, -24, 0, 44), Parent = f })
	b.AutoButtonColor = false
end

local function clear()
	for _, c in grid:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
end

function ShopController:Render()
	if not window or not window.IsOpen() then
		return
	end
	clear()
	local d = State.Data
	if not d then
		return
	end
	local level = P.daycareLevel(d.TotalStars)
	for _, b in tabBar:GetChildren() do
		if b:IsA("TextButton") then
			b.BackgroundColor3 = if b.Name == tab then C.Yellow else C.Lavender
		end
	end
	if tab == "Tools" then
		for i, id in Tools.Order do
			local def = Tools.Defs[id]
			if #def.UpgradeCost > 0 then
				local lvl = d.ToolUpgrades[id] or 0
				local cost = def.UpgradeCost[lvl + 1]
				local unlocked = P.isUnlocked(d.TotalStars, "Tool:" .. id) or d.DebugUnlockAll
				local sub = Strings.t("Shop_Level", lvl + 1, #def.UpgradeCost + 1) .. "\n" .. Strings.t("ToolDesc_" .. id)
				local price = if not unlocked then Strings.t("Shop_Locked") elseif cost then ("🪙 " .. cost) else Strings.t("Shop_Max")
				card(i, def.Emoji, Strings.t("Item_" .. id), sub, price, C.Cream, unlocked and cost ~= nil and d.Coins >= cost, function()
					Remotes.event("ShopBuy"):FireServer("Tool", id)
				end)
			end
		end
	elseif tab == "Daycare" then
		for i, id in Shop.DaycareOrder do
			local def = Shop.DaycareUpgrades[id]
			local owned = d.DaycareUpgrades[id]
			local unlocked = level >= def.UnlockLevel or d.DebugUnlockAll
			local price = if owned then Strings.t("Shop_Owned") elseif not unlocked then Strings.t("Shop_NeedLevel", def.UnlockLevel) else ("🪙 " .. def.Cost)
			card(i, def.Emoji, Strings.t("Upgrade_" .. id), Strings.t("UpgradeDesc_" .. id), price, C.Cream, not owned and unlocked and d.Coins >= def.Cost, function()
				Remotes.event("ShopBuy"):FireServer("Daycare", id)
			end)
		end
	elseif tab == "Cosmetics" then
		for i, id in Cosmetics.Order do
			local def = Cosmetics.Defs[id]
			if def.Cost > 0 then
				local owned = d.Cosmetics.Owned[id]
				card(i, "👗", Strings.name(def.Name), Strings.t("Slot_" .. def.Slot), if owned then Strings.t("Shop_Owned") else ("🪙 " .. def.Cost), C.Cream, not owned and d.Coins >= def.Cost, function()
					Remotes.event("ShopBuy"):FireServer("Cosmetic", id)
				end)
			end
		end
	elseif tab == "Robux" then
		local order = 0
		local function robuxCard(emoji, nameKey, descKey, kind, id, pid)
			if pid == 0 then
				return
			end
			order += 1
			local price = productPrices[pid] or "R$"
			card(order, emoji, Strings.t(nameKey), Strings.t(descKey), price, C.Peach, true, function()
				Remotes.event("PromptPurchase"):FireServer(kind, id)
			end)
		end
		robuxCard("👑", "Pass_VIP", "PassDesc_VIP", "Pass", "VIP", Monetization.GamePasses.VIP)
		robuxCard("🍼", "Pass_HeadNanny", "PassDesc_HeadNanny", "Pass", "HeadNanny", Monetization.GamePasses.HeadNanny)
		robuxCard("🎶", "Pass_MusicBox", "PassDesc_MusicBox", "Pass", "MusicBox", Monetization.GamePasses.MusicBox)
		robuxCard("💰", "Pass_CoinPouch", "PassDesc_CoinPouch", "Pass", "CoinPouch", Monetization.GamePasses.CoinPouch)
		for _, pack in Shop.CoinPacks do
			robuxCard("🪙", "Product_" .. pack.Id, "ProductDesc_Coins", "Product", pack.Id, Monetization.Products[pack.Id])
		end
		for cid, pid in Monetization.PremiumCosmetics do
			local def = Cosmetics.Defs[cid]
			if def and pid ~= 0 then
				order += 1
				local owned = d.Cosmetics.Owned[cid]
				card(order, "✨", Strings.name(def.Name), Strings.t("Slot_" .. def.Slot), if owned then Strings.t("Shop_Owned") else (productPrices[pid] or "R$"), C.Peach, not owned, function()
					Remotes.event("PromptPurchase"):FireServer("Cosmetic", cid)
				end)
			end
		end
		if order == 0 then
			local l = UI.label("", { Size = UDim2.new(1, 0, 0, 60), TextWrapped = true, Parent = grid })
			UI.bind(l, "Shop_NoRobux")
			l.Parent = grid
		end
	end
end

function ShopController:Open()
	if State.inShift() then
		return
	end
	window.Open()
	self:Render()
end

function ShopController:Init()
	local gui = UI.screen("ShopGui", 16)
	window = UI.window(gui, "Shop_Title", UDim2.fromOffset(880, 560))
	tabBar = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), Parent = window.Content })
	UI.list(tabBar, 8, true)
	for i, id in { "Tools", "Daycare", "Cosmetics", "Robux" } do
		local b = UI.button("", C.Lavender, function()
			tab = id
			self:Render()
		end, { Size = UDim2.fromOffset(170, 44), LayoutOrder = i, Parent = tabBar })
		b.Name = id
		UI.bind(b, "ShopTab_" .. id)
	end
	grid = UI.scroll(window.Content, { Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 1, -56) })
	UI.grid(grid, UDim2.fromOffset(196, 200), 10)
	window.OnOpen = function()
		self:Render()
	end
end

function ShopController:Start()
	State.DataChanged:Connect(function()
		self:Render()
	end)
	State.LanguageChanged:Connect(function()
		self:Render()
	end)
	-- fetch Robux prices once (only for configured ids)
	task.spawn(function()
		local function price(id: number, infoType: Enum.InfoType)
			if id == 0 then
				return
			end
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
			if ok and info and info.PriceInRobux then
				productPrices[id] = "R$ " .. tostring(info.PriceInRobux)
			end
		end
		for _, id in Monetization.GamePasses do
			price(id, Enum.InfoType.GamePass)
		end
		for _, id in Monetization.Products do
			price(id, Enum.InfoType.Product)
		end
		for _, id in Monetization.PremiumCosmetics do
			price(id, Enum.InfoType.Product)
		end
	end)
end

return ShopController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX139"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[-- SoundController: SoundRegistry for SFX (2D or 3D), music with crossfades, ambience. Ids of 0 are skipped silently.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Assets = require(Shared.Config.Assets)
local State = require(script.Parent.Parent.State)

local SoundController = {}
local Controllers
local musicGroup: SoundGroup
local sfxGroup: SoundGroup
local currentMusic: Sound? = nil
local currentMusicName: string? = nil
local ambience: { [string]: Sound } = {}
local musicBoxTrack: number? = nil

local function asset(id: number): string
	return "rbxassetid://" .. tostring(id)
end

function SoundController:Play(name: string, position: Vector3?)
	local id = Assets.Sounds[name]
	if not id or id == 0 then
		return
	end
	local props = Assets.SoundProps[name] or {}
	local s = Instance.new("Sound")
	s.SoundId = asset(id)
	s.Volume = props.Volume or 0.6
	s.SoundGroup = sfxGroup
	if position then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.Transparency = 1
		holder.Size = Vector3.one
		holder.CFrame = CFrame.new(position)
		holder.Parent = workspace
		s.RollOffMaxDistance = props.MaxDistance or 50
		s.RollOffMinDistance = 6
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.Parent = holder
		s:Play()
		Debris:AddItem(holder, 8)
	else
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 8)
	end
end

function SoundController:Music(name: string?)
	if name == currentMusicName then
		return
	end
	currentMusicName = name
	local id = name and Assets.Music[name] or 0
	if name == "Lobby" and musicBoxTrack then
		id = musicBoxTrack
	end
	local old = currentMusic
	if old then
		TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 }):Play()
		Debris:AddItem(old, 1.6)
	end
	currentMusic = nil
	if id and id ~= 0 then
		local s = Instance.new("Sound")
		s.SoundId = asset(id)
		s.Looped = true
		s.Volume = 0
		s.SoundGroup = musicGroup
		s.Parent = SoundService
		s:Play()
		TweenService:Create(s, TweenInfo.new(1.5), { Volume = 0.5 }):Play()
		currentMusic = s
	end
end

function SoundController:SetMusicBox(id: number?)
	musicBoxTrack = id
	if currentMusicName == "Lobby" then
		currentMusicName = nil
		self:Music("Lobby")
	end
end

local function setAmbience(name: string, on: boolean)
	local id = Assets.Sounds[name]
	if not id or id == 0 then
		return
	end
	local s = ambience[name]
	if on and not s then
		s = Instance.new("Sound")
		s.SoundId = asset(id)
		s.Looped = true
		s.Volume = 0.3
		s.SoundGroup = sfxGroup
		s.Parent = SoundService
		s:Play()
		ambience[name] = s
	elseif not on and s then
		s:Destroy()
		ambience[name] = nil
	end
end

function SoundController:ApplyVolumes(settings)
	musicGroup.Volume = settings.MusicVolume or 0.5
	sfxGroup.Volume = settings.SfxVolume or 0.8
end

function SoundController:Init(c)
	Controllers = c
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Parent = SoundService
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "SFX"
	sfxGroup.Parent = SoundService
	local UI = require(script.Parent.Parent.UI.Components)
	UI.setClickSound(function()
		SoundController:Play("UI_Click")
	end)
end

local function countTantrums(): number
	local n = 0
	local slot = State.Shift and State.Shift.Slot
	for _, b in CollectionService:GetTagged("Baby") do
		if b:GetAttribute("Session") == slot and (b:GetAttribute("Tantrum") or "") ~= "" then
			n += 1
		end
	end
	return n
end

function SoundController:Start()
	Remotes.event("Sound").OnClientEvent:Connect(function(name, pos)
		self:Play(name, pos)
	end)
	State.DataChanged:Connect(function(d)
		if d and d.Settings then
			self:ApplyVolumes(d.Settings)
		end
	end)
	self:Music("Lobby")
	setAmbience("Env_Crickets", true)
	task.spawn(function()
		while true do
			task.wait(1)
			local shift = State.Shift
			if shift then
				setAmbience("Env_Crickets", false)
				setAmbience("Env_Birds", shift.Clock < 17)
				local storm = false
				local dc = workspace:FindFirstChild("Daycares")
				local m = dc and dc:FindFirstChild("Daycare_" .. tostring(shift.Slot))
				if m then
					storm = m:GetAttribute("Storm") == true
					if m:GetAttribute("FullMoon") then
						self:Music("FullMoon")
						setAmbience("Env_Rain", storm)
						continue
					end
				end
				setAmbience("Env_Rain", storm)
				if shift.Tutorial then
					self:Music("Tutorial")
				elseif countTantrums() >= 3 then
					self:Music("ShiftIntense")
				else
					self:Music("ShiftCalm")
				end
			elseif not (Controllers.ResultsController and Controllers.ResultsController.Showing) then
				setAmbience("Env_Birds", false)
				setAmbience("Env_Rain", false)
				setAmbience("Env_Crickets", true)
				self:Music("Lobby")
			end
		end
	end)
end

return SoundController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX140"><Properties><string name="Name">TutorialController</string><ProtectedString name="Source"><![CDATA[-- TutorialController: step bubble with text, progress, Next / Skip buttons and a 3D arrow over the target.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local TutorialController = {}
local panel: Frame
local text: TextLabel
local stepLabel: TextLabel
local nextBtn: TextButton
local arrow: BillboardGui
local step: any = nil

local function myDaycare(): Instance?
	local s = State.Shift
	local dc = workspace:FindFirstChild("Daycares")
	return s and dc and dc:FindFirstChild("Daycare_" .. tostring(s.Slot))
end

local function nearestTagged(tag: string): Instance?
	local dc = myDaycare()
	local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not dc or not r then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsDescendantOf(dc) then
			local pos = if inst:IsA("Model") then inst:GetPivot().Position elseif inst:IsA("BasePart") then inst.Position else nil
			if pos then
				-- the cook step points at the oven
				if tag == "Appliance" and inst:GetAttribute("Kind") ~= "Oven" then
					continue
				end
				if tag == "ToolRack" and inst:GetAttribute("ToolId") ~= "Extinguisher" then
					continue
				end
				local d = (pos - r.Position).Magnitude
				if d < bestD then
					best, bestD = inst, d
				end
			end
		end
	end
	return best
end

function TutorialController:Init()
	local gui = UI.screen("TutorialGui", 12)
	panel = UI.panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 96), Size = UDim2.fromOffset(560, 150), Visible = false, Parent = gui }, C.Yellow)
	stepLabel = UI.label("", { Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 22), Font = Enum.Font.GothamBold, Parent = panel })
	text = UI.label("", { Position = UDim2.fromOffset(14, 30), Size = UDim2.new(1, -28, 0, 64), TextWrapped = true, Parent = panel })
	nextBtn = UI.button("", C.Mint, function()
		Remotes.event("TutorialAction"):FireServer("Next")
	end, { Position = UDim2.new(1, -330, 1, -52), Size = UDim2.fromOffset(150, 42), Parent = panel })
	UI.bind(nextBtn, "Tutorial_Next")
	local skip = UI.button("", C.Pink, function()
		Remotes.event("TutorialAction"):FireServer("Skip")
	end, { Position = UDim2.new(1, -168, 1, -52), Size = UDim2.fromOffset(150, 42), Parent = panel })
	UI.bind(skip, "Tutorial_Skip")
	arrow = Instance.new("BillboardGui")
	arrow.Name = "TutorialArrow"
	arrow.Size = UDim2.fromOffset(70, 70)
	arrow.StudsOffset = Vector3.new(0, 7, 0)
	arrow.AlwaysOnTop = true
	arrow.Enabled = false
	arrow.Parent = player:WaitForChild("PlayerGui")
	local a = Instance.new("TextLabel")
	a.Size = UDim2.fromScale(1, 1)
	a.BackgroundTransparency = 1
	a.TextScaled = true
	a.Text = "⬇️"
	a.Parent = arrow
end

local function render()
	panel.Visible = step ~= nil and State.inShift()
	if not step then
		arrow.Enabled = false
		return
	end
	stepLabel.Text = Strings.t("Tutorial_Step", step.Index, step.Total)
	text.Text = Strings.t(step.Key)
	nextBtn.Visible = step.Wait == "Next"
end

function TutorialController:Start()
	Remotes.event("TutorialStep").OnClientEvent:Connect(function(index, data)
		if data then
			step = { Index = index, Key = data.Key, Target = data.Target, Total = data.Total, Wait = data.Wait }
			local snd = State.Controllers.SoundController
			if snd then
				snd:Play("UI_Notify")
			end
		else
			step = nil
		end
		render()
	end)
	State.ShiftChanged:Connect(function(s)
		if not s then
			step = nil
		end
		render()
	end)
	State.LanguageChanged:Connect(render)
	local t0 = os.clock()
	RunService.Heartbeat:Connect(function()
		if step and State.inShift() then
			local target = nearestTagged(step.Target)
			local adornee = if target and target:IsA("Model") then target.PrimaryPart elseif target and target:IsA("BasePart") then target else nil
			arrow.Adornee = adornee
			arrow.Enabled = adornee ~= nil
			arrow.StudsOffset = Vector3.new(0, 6 + math.sin((os.clock() - t0) * 4) * 0.8, 0)
		else
			arrow.Enabled = false
		end
	end)
end

return TutorialController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX141"><Properties><string name="Name">WardrobeController</string><ProtectedString name="Source"><![CDATA[-- WardrobeController: cosmetics by slot with a live 3D preview (ViewportFrame) of your character.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Strings = require(Shared.Strings)
local Cosmetics = require(Shared.Config.Cosmetics)
local CosmeticBuilder = require(Shared.World.CosmeticBuilder)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.Components)

local player = Players.LocalPlayer
local C = UI.Theme.Colors
local WardrobeController = {}
local window
local viewport: ViewportFrame
local list: ScrollingFrame
local slotBar: Frame
local slot = "Hat"
local preview: Model? = nil
local previewEquip: any = nil
local spin = 0

local function owned(id: string): boolean
	local d = State.Data
	return d ~= nil and (d.Cosmetics.Owned[id] == true or (id == "Apron_VIP" and player:GetAttribute("VIP") == true))
end

local function rebuildPreview()
	if preview then
		preview:Destroy()
		preview = nil
	end
	local char = player.Character
	if not char then
		return
	end
	char.Archivable = true
	local clone = char:Clone()
	char.Archivable = false
	if not clone then
		return
	end
	for _, d in clone:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("BillboardGui") or d.Name == "HeldItem" then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	local old = clone:FindFirstChild("Cosmetics")
	if old then
		old:Destroy()
	end
	clone:PivotTo(CFrame.new(0, 0, 0))
	CosmeticBuilder.apply(clone, previewEquip or {})
	-- welds in a viewport don't simulate; re-anchor cosmetic parts in place
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	clone.Parent = viewport
	preview = clone
	local cam = viewport.CurrentCamera or Instance.new("Camera")
	cam.Parent = viewport
	viewport.CurrentCamera = cam
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 1.5, -8), Vector3.new(0, 0.8, 0))
end

local function render()
	if not window or not window.IsOpen() then
		return
	end
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for _, b in slotBar:GetChildren() do
		if b:IsA("TextButton") then
			b.BackgroundColor3 = if b.Name == slot then C.Yellow else C.Lavender
		end
	end
	local d = State.Data
	if not d then
		return
	end
	local eq = d.Cosmetics.Equipped
	local order = 0
	-- "none" entry
	if slot ~= "ToolSkin" then
		order += 1
		local f = UI.panel({ Size = UDim2.new(1, -10, 0, 54), LayoutOrder = order, Parent = list }, C.Cream)
		local b = UI.button("", C.Pink, function()
			Remotes.event("Equip"):FireServer(slot, "")
		end, { Position = UDim2.fromOffset(6, 5), Size = UDim2.new(1, -12, 0, 44), Parent = f })
		UI.bind(b, "Wardrobe_None")
	end
	for _, id in Cosmetics.Order do
		local def = Cosmetics.Defs[id]
		if def.Slot == slot then
			order += 1
			local has = owned(id)
			local equipped = eq[slot] == id or (slot == "ToolSkin" and def.Tool and eq.ToolSkins[def.Tool] == id)
			local f = UI.panel({ Size = UDim2.new(1, -10, 0, 54), LayoutOrder = order, Parent = list }, if equipped then C.Mint elseif has then C.Cream else Color3.fromRGB(215, 210, 220))
			local swatch = UI.new("Frame", { Position = UDim2.fromOffset(8, 9), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = def.Color, Parent = f })
			UI.corner(swatch, UDim.new(1, 0))
			UI.label(Strings.name(def.Name) .. (if has then "" else " 🔒"), { Position = UDim2.fromOffset(52, 8), Size = UDim2.new(1, -170, 0, 38), TextXAlignment = Enum.TextXAlignment.Left, Parent = f })
			local tryBtn = UI.button("👁", C.Lavender, function()
				previewEquip = table.clone(eq)
				if slot ~= "ToolSkin" then
					previewEquip[slot] = id
				end
				rebuildPreview()
			end, { Position = UDim2.new(1, -112, 0, 6), Size = UDim2.fromOffset(46, 42), Parent = f })
			local _ = tryBtn
			if has then
				UI.button(if equipped then "✔" else "+", C.Mint, function()
					Remotes.event("Equip"):FireServer(slot, id)
				end, { Position = UDim2.new(1, -60, 0, 6), Size = UDim2.fromOffset(52, 42), Parent = f })
			end
		end
	end
end

function WardrobeController:Open()
	if State.inShift() then
		return
	end
	window.Open()
end

function WardrobeController:Init()
	local gui = UI.screen("WardrobeGui", 16)
	window = UI.window(gui, "Wardrobe_Title", UDim2.fromOffset(820, 520), C.Lavender)
	viewport = UI.new("ViewportFrame", { BackgroundColor3 = C.Cream, Size = UDim2.new(0.42, 0, 1, 0), Ambient = Color3.fromRGB(200, 190, 210), LightColor = Color3.new(1, 1, 1), Parent = window.Content })
	UI.corner(viewport)
	local right = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.45, 0, 0, 0), Size = UDim2.new(0.55, 0, 1, 0), Parent = window.Content })
	slotBar = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = right })
	UI.list(slotBar, 6, true)
	for i, s in Cosmetics.Slots do
		local b = UI.button("", C.Lavender, function()
			slot = s
			render()
		end, { Size = UDim2.new(0.2, -5, 1, 0), LayoutOrder = i, Parent = slotBar })
		b.Name = s
		UI.bind(b, "Slot_" .. s)
	end
	list = UI.scroll(right, { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 1, -54) })
	UI.list(list, 6)
	window.OnOpen = function()
		previewEquip = State.Data and table.clone(State.Data.Cosmetics.Equipped) or {}
		rebuildPreview()
		render()
	end
end

function WardrobeController:Start()
	State.DataChanged:Connect(function(d)
		if window.IsOpen() and d then
			previewEquip = table.clone(d.Cosmetics.Equipped)
			rebuildPreview()
			render()
		end
	end)
	State.LanguageChanged:Connect(render)
	RunService.RenderStepped:Connect(function(dt)
		if preview and window.IsOpen() then
			spin += dt * 0.6
			preview:PivotTo(CFrame.Angles(0, spin, 0))
		end
	end)
end

return WardrobeController
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX143"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Monstergarten client entry point. Loads controllers (Init on all, then Start on all).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
ReplicatedStorage:WaitForChild("Shared")
ReplicatedStorage:WaitForChild("Remotes")

local State = require(script.Parent.State)
local Folder = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"SettingsController", "SoundController", "InputController", "MobileController", "CameraController",
	"LightingController", "EffectsController", "AnimationController", "BubbleController",
	"InteractionController", "HUDController", "CutsceneController", "QueueController", "ResultsController",
	"ShopController", "WardrobeController", "PetController", "TutorialController", "DebugController",
	"LoadingController",
}

local Controllers = {}
State.Controllers = Controllers

for _, name in ORDER do
	local mod = Folder:FindFirstChild(name)
	if mod then
		local ok, c = pcall(require, mod)
		if ok then
			Controllers[name] = c
		else
			warn("[Client] failed to load", name, c)
		end
	end
end

for _, name in ORDER do
	local c = Controllers[name]
	if c and c.Init then
		local ok, err = pcall(c.Init, c, Controllers)
		if not ok then
			warn("[Client] Init failed", name, err)
		end
	end
end

for _, name in ORDER do
	local c = Controllers[name]
	if c and c.Start then
		task.spawn(function()
			local ok, err = pcall(c.Start, c)
			if not ok then
				warn("[Client] Start failed", name, err)
			end
		end)
	end
end

State.start()
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX144"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Client-side state store: player data snapshot, shift state, held item. Signals on change.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Net.Remotes)
local Signal = require(Shared.Util.Signal)
local Strings = require(Shared.Strings)

local player = Players.LocalPlayer

local State = {
	Data = nil :: any,
	Shift = nil :: any, -- current shift state (nil in lobby)
	Controllers = {} :: { [string]: any },
	DataChanged = Signal.new(),
	ShiftChanged = Signal.new(),
	HeldChanged = Signal.new(),
	LanguageChanged = Signal.new(),
	Held = nil :: { Kind: string, Id: string }?,
}

local function parseHeld(s: string?): any
	if not s or s == "" then
		return nil
	end
	local kind, id = s:match("^(%w+):(.+)$")
	if not kind then
		return nil
	end
	return { Kind = kind, Id = id }
end

function State.applyLanguage()
	local d = State.Data
	local lang = Strings.resolve(d and d.Settings and d.Settings.Language or "auto", player.LocaleId)
	if lang ~= Strings.language() then
		Strings.setLanguage(lang)
		State.LanguageChanged:Fire(lang)
	end
end

function State.inShift(): boolean
	return State.Shift ~= nil
end

function State.start()
	Remotes.event("DataChanged").OnClientEvent:Connect(function(data)
		State.Data = data
		State.applyLanguage()
		State.DataChanged:Fire(data)
	end)
	Remotes.event("ShiftState").OnClientEvent:Connect(function(shift)
		State.Shift = shift
		State.ShiftChanged:Fire(shift)
	end)
	player:GetAttributeChangedSignal("Held"):Connect(function()
		State.Held = parseHeld(player:GetAttribute("Held"))
		State.HeldChanged:Fire(State.Held)
	end)
	State.Held = parseHeld(player:GetAttribute("Held"))
	task.spawn(function()
		local ok, data = pcall(function()
			return Remotes.func("GetData"):InvokeServer()
		end)
		if ok and data and not State.Data then
			State.Data = data
			State.applyLanguage()
			State.DataChanged:Fire(data)
		end
	end)
end

State.parseHeld = parseHeld
State.player = player

return State
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX147"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX145"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[-- Tiny UI builder: rounded pastel panels, squishy buttons, bars, windows and live-localized text.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared.Strings)
local Tween = require(Shared.Util.Tween)
local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local UI = {}
UI.Theme = Theme

local bindings = setmetatable({}, { __mode = "k" }) :: { [Instance]: { key: string, args: { any } } }
local clickSound: (() -> ())? = nil

function UI.setClickSound(fn: () -> ())
	clickSound = fn
end

-- Generic constructor: UI.new("Frame", { props }, { children })
function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			elseif typeof(k) == "string" then
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(parent: Instance, radius: UDim?)
	return UI.new("UICorner", { CornerRadius = radius or Theme.Corner, Parent = parent })
end

function UI.stroke(parent: Instance, color: Color3?, thickness: number?)
	return UI.new("UIStroke", { Color = color or C.Plum, Thickness = thickness or Theme.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function UI.padding(parent: Instance, px: number)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

function UI.list(parent: Instance, padding: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function UI.grid(parent: Instance, cell: UDim2, padding: number?)
	return UI.new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

-- Text bound to a Strings key: re-localizes when the language changes.
function UI.bind(label: Instance, key: string, ...: any)
	bindings[label] = { key = key, args = { ... } }
	;(label :: any).Text = Strings.t(key, ...)
end

function UI.relocalize()
	for label, b in bindings do
		if label.Parent then
			(label :: any).Text = Strings.t(b.key, table.unpack(b.args))
		end
	end
end

function UI.screen(name: string, order: number?): ScreenGui
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = pg:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local sg = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 1,
		Parent = pg,
	})
	-- Scale everything down on small screens (phones).
	local scale = UI.new("UIScale", { Parent = sg })
	local function rescale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720) * 1.05, 0.55, 1.15)
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	return sg
end

function UI.panel(props: { [string]: any }?, color: Color3?): Frame
	local f = UI.new("Frame", { BackgroundColor3 = color or C.Cream, BorderSizePixel = 0 })
	if props then
		for k, v in props do
			if k ~= "Parent" then
				(f :: any)[k] = v
			end
		end
	end
	UI.corner(f)
	UI.stroke(f)
	if props and props.Parent then
		f.Parent = props.Parent
	end
	return f
end

function UI.label(text: string, props: { [string]: any }?): TextLabel
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		Text = text,
		TextColor3 = C.Plum,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 28),
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = 40, Parent = l })
	if props then
		for k, v in props do
			if k ~= "Parent" then
				(l :: any)[k] = v
			end
		end
		if props.Parent then
			l.Parent = props.Parent
		end
	end
	return l
end

function UI.button(text: string, color: Color3?, onClick: (() -> ())?, props: { [string]: any }?): TextButton
	local b = UI.new("TextButton", {
		BackgroundColor3 = color or C.Mint,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Theme.Font,
		Text = text,
		TextColor3 = C.Plum,
		TextScaled = true,
		Size = UDim2.fromOffset(140, 44),
	})
	UI.corner(b, UDim.new(0, 16))
	UI.stroke(b)
	UI.new("UITextSizeConstraint", { MaxTextSize = 30, Parent = b })
	UI.padding(b, 6)
	if props then
		for k, v in props do
			if k ~= "Parent" then
				(b :: any)[k] = v
			end
		end
	end
	local base = b.BackgroundColor3
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base:Lerp(C.White, 0.25) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	b.Activated:Connect(function()
		Tween.pop(b)
		if clickSound then
			clickSound()
		end
		if onClick then
			onClick()
		end
	end)
	if props and props.Parent then
		b.Parent = props.Parent
	end
	return b
end

-- Progress bar; returns the frame and a setter(0..1, color?).
function UI.bar(props: { [string]: any }?, fillColor: Color3?): (Frame, (number, Color3?) -> ())
	local bg = UI.new("Frame", { BackgroundColor3 = C.Dark, BackgroundTransparency = 0.3, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 10) })
	UI.corner(bg, UDim.new(1, 0))
	local fill = UI.new("Frame", { Name = "Fill", BackgroundColor3 = fillColor or C.Mint, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = bg })
	UI.corner(fill, UDim.new(1, 0))
	if props then
		for k, v in props do
			if k ~= "Parent" then
				(bg :: any)[k] = v
			end
		end
		if props.Parent then
			bg.Parent = props.Parent
		end
	end
	local function set(v: number, color: Color3?)
		TweenService:Create(fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(math.clamp(v, 0, 1), 1) }):Play()
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return bg, set
end

-- Modal window with a title and close button. Returns { Frame, Content, Open(), Close(), Toggle(), IsOpen() }.
function UI.window(parent: Instance, titleKey: string, size: UDim2, color: Color3?)
	local frame = UI.panel({
		Name = "Window_" .. titleKey,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		Visible = false,
		Parent = parent,
		ZIndex = 5,
	}, color or C.Cream)
	local title = UI.label("", { Size = UDim2.new(1, -70, 0, 44), Position = UDim2.fromOffset(16, 8), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	UI.bind(title, titleKey)
	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 58),
		Size = UDim2.new(1, -28, 1, -72),
		Parent = frame,
	})
	local scale = UI.new("UIScale", { Parent = frame })
	local api = {}
	local closeBtn = UI.button("✖", C.Pink, function()
		api.Close()
	end, { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -54, 0, 8), Parent = frame })
	closeBtn.Name = "Close"
	api.Frame = frame
	api.Content = content
	api.Title = title
	api.OnOpen = nil :: (() -> ())?
	function api.Open()
		if frame.Visible then
			return
		end
		frame.Visible = true
		scale.Scale = 0.6
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		if api.OnOpen then
			api.OnOpen()
		end
		UI.WindowOpened(api)
	end
	function api.Close()
		frame.Visible = false
	end
	function api.Toggle()
		if frame.Visible then
			api.Close()
		else
			api.Open()
		end
	end
	function api.IsOpen()
		return frame.Visible
	end
	UI.Windows[api] = true
	return api
end

UI.Windows = {} :: { [any]: boolean }
-- Only one modal at a time.
function UI.WindowOpened(opened)
	for w in UI.Windows do
		if w ~= opened and w.IsOpen() then
			w.Close()
		end
	end
end

function UI.closeAll()
	for w in UI.Windows do
		if w.IsOpen() then
			w.Close()
		end
	end
end

function UI.scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local s = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Plum,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	})
	if props then
		for k, v in props do
			(s :: any)[k] = v
		end
	end
	return s
end

return UI
]]></ProtectedString></Properties></Item>
