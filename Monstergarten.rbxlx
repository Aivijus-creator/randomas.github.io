<Item class="Folder" referent="RBX27"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">DataSchema</string><ProtectedString name="Source"><![CDATA[--!strict
-- Player data template + migrations. Pure (no Roblox services) so it can be unit tested.
local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local CURRENT_VERSION = 2

local function template()
	return {
		DataVersion = CURRENT_VERSION,
		Coins = 0,
		TotalStars = 0,
		NannyXP = 0,
		NannyLevel = 1,
		TutorialDone = false,
		ToolUpgrades = {
			Extinguisher = 0, Mop = 0, Flashlight = 0, Lullaby = 0, Net = 0,
			Hammer = 0, Shears = 0, WateringCan = 0, TrashBag = 0,
		},
		DaycareUpgrades = {
			DoublePot = false, ExtraRacks = false, SecondFireplace = false, AutoShutoff = false,
			MegaBlender = false, SecondOven = false, AutoFeeder = false, FireproofFurniture = false,
		},
		Cosmetics = {
			Owned = {} :: { [string]: boolean },
			Equipped = { Hat = "", Apron = "", Uniform = "", PetAccessory = "", ToolSkins = {} :: { [string]: string } },
		},
		BabyFriendship = {} :: { [string]: number },
		SeenBabies = {} :: { [string]: boolean },
		Pets = {} :: { { BabyId: string, Name: string } },
		EquippedPets = {} :: { number },
		DailyReward = { LastClaim = 0, Streak = 0 },
		DailyQuests = { Date = "", Quests = {} :: { any } },
		Stats = {
			ShiftsPlayed = 0, FiresPutOut = 0, BabiesFed = 0, BestScore = 0, ThreeStarShifts = 0,
			GhostsFound = 0, DishesCooked = 0,
		},
		Settings = { MusicVolume = 0.5, SfxVolume = 0.8, Language = "auto", CameraShake = true, Quality = "High" },
		ProcessedReceipts = {} :: { [string]: number },
		WeeklyBest = { Week = "", Score = 0 },
	}
end

-- Ordered migration steps: [fromVersion] = function(data)
local migrations: { [number]: (any) -> () } = {
	[1] = function(data)
		-- v1 -> v2: Equipped slots stored nil as missing; normalize to "" and add SeenBabies/WeeklyBest.
		local eq = data.Cosmetics and data.Cosmetics.Equipped
		if eq then
			for _, slot in { "Hat", "Apron", "Uniform", "PetAccessory" } do
				if eq[slot] == nil then
					eq[slot] = ""
				end
			end
		end
		data.SeenBabies = data.SeenBabies or {}
	end,
}

local DataSchema = {}
DataSchema.Version = CURRENT_VERSION
DataSchema.template = template

function DataSchema.migrate(data: any): any
	if type(data) ~= "table" then
		return template()
	end
	local v = tonumber(data.DataVersion) or 1
	while v < CURRENT_VERSION do
		local step = migrations[v]
		if step then
			step(data)
		end
		v += 1
	end
	data.DataVersion = CURRENT_VERSION
	TableUtil.reconcile(data, template())
	return data
end

return DataSchema
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">NeedMath</string><ProtectedString name="Source"><![CDATA[--!strict
-- Need decay math. Pure.
local Needs = require(script.Parent.Parent.Config.Needs)

local NeedMath = {}

function NeedMath.playerScale(players: number): number
	local n = math.clamp(players, 1, #Needs.PlayerScale)
	return Needs.PlayerScale[n]
end

-- Decay per second for one need of one baby.
function NeedMath.decayRate(needId: string, babyMult: number, difficultyMult: number, players: number): number
	local def = Needs.Defs[needId]
	if not def then
		return 0
	end
	return def.Base * babyMult * difficultyMult * NeedMath.playerScale(players)
end

function NeedMath.state(value: number): string
	local t = Needs.Thresholds
	if value <= 0 then
		return "Tantrum"
	elseif value < t.Crying then
		return "Crying"
	elseif value < t.Bubble then
		return "Bubble"
	elseif value > t.Happy then
		return "Happy"
	end
	return "Normal"
end

function NeedMath.mood(needs: { [string]: number }): number
	local sum, n = 0, 0
	for _, v in needs do
		sum += v
		n += 1
	end
	return if n > 0 then sum / n else 100
end

return NeedMath
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">ProgressionMath</string><ProtectedString name="Source"><![CDATA[--!strict
-- Level / unlock math. Pure.
local Progression = require(script.Parent.Parent.Config.Progression)

local P = {}

function P.daycareLevel(totalStars: number): number
	local lvl = 1
	for _, l in Progression.DaycareLevels do
		if totalStars >= l.Stars then
			lvl = l.Level
		end
	end
	return lvl
end

-- Progress to next daycare level: (current stars into level, stars needed for next level span) or nil at max.
function P.daycareProgress(totalStars: number): (number, number?)
	local lvl = P.daycareLevel(totalStars)
	local cur = Progression.DaycareLevels[lvl]
	local nxt = Progression.DaycareLevels[lvl + 1]
	if not nxt then
		return 1, nil
	end
	return totalStars - cur.Stars, nxt.Stars - cur.Stars
end

function P.isUnlocked(totalStars: number, unlockId: string): boolean
	local lvl = P.daycareLevel(totalStars)
	for _, l in Progression.DaycareLevels do
		if l.Level <= lvl and table.find(l.Unlocks, unlockId) then
			return true
		end
	end
	-- Not listed anywhere = always unlocked (e.g. base tools).
	for _, l in Progression.DaycareLevels do
		if table.find(l.Unlocks, unlockId) then
			return false
		end
	end
	return true
end

function P.unlocksAt(level: number): { string }
	local l = Progression.DaycareLevels[level]
	return if l then l.Unlocks else {}
end

function P.xpForLevel(level: number): number
	return math.floor(Progression.XPBase * level ^ Progression.XPExponent)
end

-- Apply XP; returns new level, remaining xp, and list of levels gained.
function P.applyXP(level: number, xp: number, gained: number): (number, number, { number })
	local gainedLevels = {}
	xp += gained
	while xp >= P.xpForLevel(level) do
		xp -= P.xpForLevel(level)
		level += 1
		table.insert(gainedLevels, level)
	end
	return level, xp, gainedLevels
end

function P.titleKey(nannyLevel: number): string
	local key = Progression.NannyTitles[1].Key
	for _, t in Progression.NannyTitles do
		if nannyLevel >= t.Level then
			key = t.Key
		end
	end
	return key
end

-- Daily reward: given last claim day index and streak, compute claimable + next streak.
function P.dailyReward(lastDay: number, streak: number, today: number): (boolean, number, number)
	if today <= lastDay then
		return false, streak, 0
	end
	local newStreak = if today == lastDay + 1 then streak + 1 else 1
	local cycle = Progression.DailyRewards
	local idx = ((newStreak - 1) % #cycle) + 1
	return true, newStreak, cycle[idx]
end

return P
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">RecipeMatch</string><ProtectedString name="Source"><![CDATA[--!strict
-- Recipe matching. Pure.
local Recipes = require(script.Parent.Parent.Config.Recipes)

local RecipeMatch = {}

local function sortedKey(list: { string }): string
	local copy = table.clone(list)
	table.sort(copy)
	return table.concat(copy, "+")
end

-- Exact match for an appliance + ingredient list. allowEvent lets the Cake recipe through.
function RecipeMatch.find(appliance: string, ingredients: { string }, allowEvent: boolean?): Recipes.Recipe?
	local key = sortedKey(ingredients)
	for _, r in Recipes.Recipes do
		if r.Appliance == appliance and (allowEvent or not r.Event) and sortedKey(r.Ingredients) == key then
			return r
		end
	end
	return nil
end

-- Can `ingredient` be added to `current` and still be on the way to some recipe?
function RecipeMatch.canAdd(appliance: string, current: { string }, ingredient: string, allowEvent: boolean?): boolean
	if #current >= Recipes.MaxSlots then
		return false
	end
	local want = table.clone(current)
	table.insert(want, ingredient)
	for _, r in Recipes.Recipes do
		if r.Appliance == appliance and (allowEvent or not r.Event) and #r.Ingredients >= #want then
			-- every wanted ingredient must be available in the recipe (multiset subset)
			local pool = table.clone(r.Ingredients)
			local ok = true
			for _, w in want do
				local idx = table.find(pool, w)
				if idx then
					table.remove(pool, idx)
				else
					ok = false
					break
				end
			end
			if ok then
				return true
			end
		end
	end
	return false
end

-- Feeding result: "Favorite" | "Suitable" | "Cake" | "Raw" | "Wrong" | "NoEat"
function RecipeMatch.feedResult(babyDef: any, itemKind: string, itemId: string): string
	if not babyDef.Eats then
		if babyDef.Id == "Yeti" and itemId == "Ice" then
			return "Ice"
		end
		return "NoEat"
	end
	if itemKind == "Ingredient" then
		if babyDef.FavoriteFood == "ANY" then
			return "Raw"
		end
		if babyDef.Id == "Yeti" and itemId == "Ice" then
			return "Ice"
		end
		return "Wrong"
	end
	if itemId == "Burnt" then
		return "Wrong"
	end
	if babyDef.FavoriteFood == "ANY" then
		return "Favorite"
	end
	if itemId == babyDef.FavoriteFood then
		return "Favorite"
	end
	if itemId == "Cake" then
		return "Cake"
	end
	if itemId == "Porridge" then
		return "Suitable"
	end
	return "Wrong"
end

return RecipeMatch
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Scoring</string><ProtectedString name="Source"><![CDATA[--!strict
-- Shift scoring formulas (GDD 10.2 / 10.3). Pure.
local MathUtil = require(script.Parent.Parent.Util.Math)

export type BabyResult = {
	TantrumSeconds: number,
	InTantrumAtEnd: boolean,
	Escaped: boolean,
	GhostHidden: boolean,
	AllNeedsHappy: boolean,
}

export type BuildingResult = {
	AvgFurnitureHP: number, -- 0..100
	Trash: number,
	Spills: number,
	FireBurning: boolean,
}

local Scoring = {}

function Scoring.babyScore(b: BabyResult): number
	local s = 100 - 0.5 * b.TantrumSeconds
	if b.InTantrumAtEnd then
		s -= 10
	end
	if b.Escaped then
		s -= 30
	end
	if b.GhostHidden then
		s -= 15
	end
	if b.AllNeedsHappy then
		s += 5
	end
	return MathUtil.clamp(s, 0, 100)
end

function Scoring.buildingScore(b: BuildingResult): number
	local s = b.AvgFurnitureHP - 1 * b.Trash - 2 * b.Spills
	if b.FireBurning then
		s -= 10
	end
	return MathUtil.clamp(s, 0, 100)
end

function Scoring.finalScore(babyScores: { number }, building: number, eventBonus: number): number
	local sum = 0
	for _, s in babyScores do
		sum += s
	end
	local avg = if #babyScores > 0 then sum / #babyScores else 100
	return MathUtil.clamp(0.7 * avg + 0.3 * building + math.min(eventBonus, 10), 0, 110)
end

function Scoring.stars(final: number): number
	if final >= 85 then
		return 3
	elseif final >= 60 then
		return 2
	elseif final >= 35 then
		return 1
	end
	return 0
end

function Scoring.coins(final: number, stars: number, eventCoins: number, difficultyMult: number): number
	return math.floor((50 + 2 * final + 25 * stars + eventCoins) * difficultyMult + 0.5)
end

function Scoring.xp(actions: number, base: number, max: number): number
	return math.min(base + actions, max)
end

return Scoring
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX29"><Properties><string name="Name">Net</string></Properties><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- All remotes in one place. The server creates them (Remotes.setup()), clients wait for them.
-- C>S = client to server, S>C = server to client.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	-- C>S
	"DropHeld", -- ()
	"UseTool", -- (dir: Vector3, holding: boolean)
	"QueueAction", -- (action: string, arg: any)
	"CutsceneSkip", -- ()
	"ResultsChoice", -- ("Again" | "Lobby")
	"ShopBuy", -- (kind: string, id: string)
	"Equip", -- (slot: string, id: string?)
	"PetAction", -- (action: string, index: number, arg: any)
	"ClaimDaily", -- ()
	"SetSetting", -- (key: string, value: any)
	"TutorialAction", -- ("Skip" | "Next" | "Replay")
	"DebugCommand", -- (cmd: string, ...)
	"PromptPurchase", -- (kind: "Pass" | "Product" | "Cosmetic", id: string)
	"PlayEmote", -- (name)
	-- S>C
	"Notify", -- (msg: {key,...}, kind: string)
	"DataChanged", -- (data snapshot)
	"ShiftState", -- (state table)
	"Cutscene", -- (kind: string, data)
	"Banner", -- (eventId: string, phase: string, extra)
	"Effect", -- (name: string, payload)
	"Sound", -- (name: string, position: Vector3?)
	"TutorialStep", -- (index: number, data)
	"QueueUpdate", -- (state or nil)
	"CameraShake", -- (intensity: number, position: Vector3?, radius: number?)
	"Fade", -- (fadeIn: boolean, time: number)
	"Results", -- (results table)
	"DebugInfo", -- (info)
}

local FUNCTIONS = {
	"GetData", -- () -> snapshot
	"GetLeaderboard", -- (board) -> entries
}

local Remotes = {}
local folder: Folder? = nil

function Remotes.setup()
	assert(RunService:IsServer(), "Remotes.setup is server-only")
	local f = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = "Remotes"
		nf.Parent = ReplicatedStorage
		f = nf
	end
	for _, name in EVENTS do
		if not (f :: Folder):FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = f
		end
	end
	for _, name in FUNCTIONS do
		if not (f :: Folder):FindFirstChild(name) then
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = f
		end
	end
	folder = f
end

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		Remotes.setup()
		return folder :: Folder
	end
	folder = ReplicatedStorage:WaitForChild("Remotes", 60) :: Folder
	return folder :: Folder
end

function Remotes.event(name: string): RemoteEvent
	local r = getFolder():WaitForChild(name, 30)
	assert(r and r:IsA("RemoteEvent"), "Unknown remote event " .. name)
	return r :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	local r = getFolder():WaitForChild(name, 30)
	assert(r and r:IsA("RemoteFunction"), "Unknown remote function " .. name)
	return r :: RemoteFunction
end

Remotes.EVENTS = EVENTS
Remotes.FUNCTIONS = FUNCTIONS

return Remotes
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Strings</string><ProtectedString name="Source"><![CDATA[--!strict
-- Localized strings. Usage: Strings.get(lang, key, ...) or (client) Strings.t(key, ...)
-- Placeholders use {1}, {2}, ... Missing keys fall back to English, then to the key itself.

local en = require(script.en)
local lt = require(script.lt)

local Strings = {}
Strings.Languages = { "en", "lt" }
local tables: { [string]: { [string]: string } } = { en = en, lt = lt }
local current = "en"

local function format(s: string, args: { any }): string
	return (s:gsub("{(%d+)}", function(i)
		local v = args[tonumber(i) :: number]
		if v == nil then
			return ""
		end
		return tostring(v)
	end))
end

function Strings.get(lang: string, key: string, ...: any): string
	local t = tables[lang] or en
	local s = t[key] or en[key] or key
	if select("#", ...) > 0 then
		return format(s, { ... })
	end
	return s
end

function Strings.has(key: string): boolean
	return en[key] ~= nil
end

-- Resolve "auto" from a LocaleId like "lt-lt" or "en-us".
function Strings.resolve(setting: string?, localeId: string?): string
	if setting and setting ~= "auto" and tables[setting] then
		return setting
	end
	local loc = string.lower(localeId or "en")
	if loc:sub(1, 2) == "lt" then
		return "lt"
	end
	return "en"
end

function Strings.setLanguage(lang: string)
	if tables[lang] then
		current = lang
	end
end

function Strings.language(): string
	return current
end

function Strings.t(key: string, ...: any): string
	return Strings.get(current, key, ...)
end

-- Localized display name from a { en = ..., lt = ... } table.
function Strings.name(n: { en: string, lt: string }?): string
	if not n then
		return "?"
	end
	return (n :: any)[current] or n.en
end

-- Localize an argument that is an id: a strings key, an item / room / upgrade / difficulty id,
-- a baby id or a cosmetic id. Anything else is returned unchanged.
local Babies = require(script.Parent.Config.Babies)
local Cosmetics = require(script.Parent.Config.Cosmetics)
function Strings.arg(v: any): any
	if type(v) ~= "string" then
		return v
	end
	if en[v] then
		return Strings.t(v)
	end
	for _, prefix in { "Item_", "Room_", "Upgrade_", "Difficulty_", "Pass_" } do
		if en[prefix .. v] then
			return Strings.t(prefix .. v)
		end
	end
	local b = Babies.Defs[v]
	if b then
		return Strings.name(b.Name)
	end
	local c = Cosmetics.Defs[v]
	if c then
		return Strings.name(c.Name)
	end
	return v
end

-- A server message is sent as { key, args } so each client localizes it (args are localized too).
function Strings.msg(m: any): string
	if type(m) == "string" then
		return Strings.t(m)
	elseif type(m) == "table" then
		local args = {}
		for i = 2, #m do
			args[i - 1] = Strings.arg(m[i])
		end
		return Strings.t(m[1], table.unpack(args))
	end
	return ""
end

return Strings
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">en</string><ProtectedString name="Source"><![CDATA[-- English strings (default).
