	Id: string,
	Name: { en: string, lt: string },
	UnlockLevel: number,
	Rarity: string,
	Needs: { [string]: number },
	FavoriteFood: string?,
	Eats: boolean,
	WalkSpeed: number,
	WanderRadius: number,
	CarrySlowdown: number, -- 0..1, fraction of walk speed removed from carrier
	Flammable: boolean,
	Curiosity: number, -- used by the Escape event to choose who runs
	Color: Color3,
	Chaos: string,
	ChaosInterval: number,
	Emoji: string,
}

