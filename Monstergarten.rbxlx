}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[--!strict
-- Cosmetics are built from parts at runtime (no uploads needed).
-- Slot: Hat | Apron | Uniform | ToolSkin | PetAccessory
-- Premium = bought with a Developer Product (id in Config/Monetization.PremiumCosmetics).

export type CosmeticDef = {
	Id: string,
	Slot: string,
	Name: { en: string, lt: string },
	Cost: number, -- 0 = not sold for coins (reward / premium / pass)
	Color: Color3,
	Style: string, -- builder style key
	Premium: boolean?,
	Tool: string?, -- for ToolSkin
	Material: Enum.Material?,
}

local C: { [string]: CosmeticDef } = {
	Hat_Bow = { Id = "Hat_Bow", Slot = "Hat", Name = { en = "Big Bow", lt = "Didelis kaspinas" }, Cost = 0, Color = Color3.fromRGB(255, 170, 165), Style = "Bow" },
	Hat_Beanie = { Id = "Hat_Beanie", Slot = "Hat", Name = { en = "Cozy Beanie", lt = "Jauki kepurytė" }, Cost = 0, Color = Color3.fromRGB(168, 230, 207), Style = "Beanie" },
	Hat_Crown = { Id = "Hat_Crown", Slot = "Hat", Name = { en = "Nanny Crown", lt = "Auklės karūna" }, Cost = 0, Color = Color3.fromRGB(255, 205, 60), Style = "Crown", Material = Enum.Material.Neon },
	Hat_Pumpkin = { Id = "Hat_Pumpkin", Slot = "Hat", Name = { en = "Pumpkin Hat", lt = "Moliūgo kepurė" }, Cost = 400, Color = Color3.fromRGB(255, 154, 60), Style = "Pumpkin" },
	Hat_Horns = { Id = "Hat_Horns", Slot = "Hat", Name = { en = "Monster Horns", lt = "Pabaisos ragai" }, Cost = 600, Color = Color3.fromRGB(195, 177, 225), Style = "Horns" },
	Hat_Chef = { Id = "Hat_Chef", Slot = "Hat", Name = { en = "Chef Hat", lt = "Virėjo kepurė" }, Cost = 800, Color = Color3.fromRGB(255, 255, 255), Style = "Chef" },
	Hat_Witch = { Id = "Hat_Witch", Slot = "Hat", Name = { en = "Witch Hat", lt = "Raganos kepurė" }, Cost = 0, Color = Color3.fromRGB(75, 63, 114), Style = "Witch", Premium = true },
	Apron_Mint = { Id = "Apron_Mint", Slot = "Apron", Name = { en = "Mint Apron", lt = "Mėtinė prijuostė" }, Cost = 200, Color = Color3.fromRGB(168, 230, 207), Style = "Apron" },
	Apron_Stars = { Id = "Apron_Stars", Slot = "Apron", Name = { en = "Starry Apron", lt = "Žvaigždėta prijuostė" }, Cost = 0, Color = Color3.fromRGB(75, 63, 114), Style = "ApronStars" },
	Apron_Peach = { Id = "Apron_Peach", Slot = "Apron", Name = { en = "Peach Apron", lt = "Persikinė prijuostė" }, Cost = 350, Color = Color3.fromRGB(255, 211, 182), Style = "Apron" },
	Apron_VIP = { Id = "Apron_VIP", Slot = "Apron", Name = { en = "VIP Apron", lt = "VIP prijuostė" }, Cost = 0, Color = Color3.fromRGB(255, 205, 60), Style = "ApronStars", Material = Enum.Material.Neon },
	Uniform_Lavender = { Id = "Uniform_Lavender", Slot = "Uniform", Name = { en = "Lavender Uniform", lt = "Levandų uniforma" }, Cost = 500, Color = Color3.fromRGB(195, 177, 225), Style = "Uniform" },
	Uniform_Night = { Id = "Uniform_Night", Slot = "Uniform", Name = { en = "Night Shift Uniform", lt = "Naktinės pamainos uniforma" }, Cost = 0, Color = Color3.fromRGB(60, 50, 95), Style = "Uniform" },
	Uniform_Pink = { Id = "Uniform_Pink", Slot = "Uniform", Name = { en = "Bubblegum Uniform", lt = "Kramtomosios gumos uniforma" }, Cost = 700, Color = Color3.fromRGB(255, 170, 165), Style = "Uniform" },
	Skin_DragonExtinguisher = { Id = "Skin_DragonExtinguisher", Slot = "ToolSkin", Tool = "Extinguisher", Name = { en = "Dragon Extinguisher", lt = "Drakono gesintuvas" }, Cost = 0, Color = Color3.fromRGB(60, 160, 90), Style = "Skin", Premium = true },
	Skin_RainbowMop = { Id = "Skin_RainbowMop", Slot = "ToolSkin", Tool = "Mop", Name = { en = "Rainbow Mop", lt = "Vaivorykštinė šluota" }, Cost = 900, Color = Color3.fromRGB(255, 120, 200), Style = "Skin", Material = Enum.Material.Neon },
	Skin_MoonFlashlight = { Id = "Skin_MoonFlashlight", Slot = "ToolSkin", Tool = "Flashlight", Name = { en = "Moon Flashlight", lt = "Mėnulio žibintuvėlis" }, Cost = 0, Color = Color3.fromRGB(200, 210, 255), Style = "Skin", Premium = true, Material = Enum.Material.Neon },
	PetAcc_Bow = { Id = "PetAcc_Bow", Slot = "PetAccessory", Name = { en = "Pet Bow", lt = "Augintinio kaspinėlis" }, Cost = 250, Color = Color3.fromRGB(255, 120, 150), Style = "Bow" },
	PetAcc_Crown = { Id = "PetAcc_Crown", Slot = "PetAccessory", Name = { en = "Pet Crown", lt = "Augintinio karūnėlė" }, Cost = 0, Color = Color3.fromRGB(255, 205, 60), Style = "Crown", Premium = true },
	GoldenSign = { Id = "GoldenSign", Slot = "Sign", Name = { en = "Golden Daycare", lt = "Auksinis darželis" }, Cost = 0, Color = Color3.fromRGB(255, 205, 60), Style = "Sign" },
}

local Order = {
	"Hat_Bow", "Hat_Beanie", "Hat_Crown", "Hat_Pumpkin", "Hat_Horns", "Hat_Chef", "Hat_Witch",
	"Apron_Mint", "Apron_Stars", "Apron_Peach", "Apron_VIP",
	"Uniform_Lavender", "Uniform_Night", "Uniform_Pink",
	"Skin_DragonExtinguisher", "Skin_RainbowMop", "Skin_MoonFlashlight",
	"PetAcc_Bow", "PetAcc_Crown",
}

return {
	Defs = C,
	Order = Order,
	Slots = { "Hat", "Apron", "Uniform", "ToolSkin", "PetAccessory" },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Difficulty</string><ProtectedString name="Source"><![CDATA[--!strict
export type DifficultyDef = {
	Id: string,
	UnlockLevel: number,
	BabyBonus: number,
	MinBabies: number,
	MaxBabies: number,
	NeedDecay: number,
	ChaosStrength: number,
	Events: number,
	Coins: number,
	Color: Color3,
}

local Difficulty: { [string]: DifficultyDef } = {
	Easy = { Id = "Easy", UnlockLevel = 1, BabyBonus = 2, MinBabies = 3, MaxBabies = 6, NeedDecay = 0.75, ChaosStrength = 0.75, Events = 1, Coins = 1.0, Color = Color3.fromRGB(168, 230, 207) },
	Normal = { Id = "Normal", UnlockLevel = 3, BabyBonus = 3, MinBabies = 4, MaxBabies = 8, NeedDecay = 1.0, ChaosStrength = 1.0, Events = 2, Coins = 1.5, Color = Color3.fromRGB(255, 211, 182) },
	Nightmare = { Id = "Nightmare", UnlockLevel = 9, BabyBonus = 4, MinBabies = 5, MaxBabies = 10, NeedDecay = 1.35, ChaosStrength = 1.5, Events = 3, Coins = 2.5, Color = Color3.fromRGB(195, 120, 200) },
}

return {
	Defs = Difficulty,
	Order = { "Easy", "Normal", "Nightmare" },
	MaxSameSpecies = 2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[--!strict
-- Random shift events (GDD section 9).

export type EventDef = {
	Id: string,
	Emoji: string,
	Duration: number,
	Reward: number,
	MinClock: number?, -- earliest in-game hour
	Weight: number,
}

local Events: { [string]: EventDef } = {
	Storm = { Id = "Storm", Emoji = "🌩️", Duration = 45, Reward = 50, Weight = 1 },
	Birthday = { Id = "Birthday", Emoji = "🎂", Duration = 90, Reward = 100, Weight = 1 },
	Inspector = { Id = "Inspector", Emoji = "🕵️", Duration = 60, Reward = 150, Weight = 1 },
	MysteryEgg = { Id = "MysteryEgg", Emoji = "🥚", Duration = 60, Reward = 0, Weight = 0.8 },
	FullMoon = { Id = "FullMoon", Emoji = "🌕", Duration = 40, Reward = 75, MinClock = 16, Weight = 0.8 },
	MessRain = { Id = "MessRain", Emoji = "🧹", Duration = 40, Reward = 5, Weight = 1 },
	Escape = { Id = "Escape", Emoji = "🎈", Duration = 30, Reward = 80, Weight = 1 },
}

local Order = { "Storm", "Birthday", "Inspector", "MysteryEgg", "FullMoon", "MessRain", "Escape" }

return {
	Defs = Events,
	Order = Order,
	MinGap = 90,
	-- Approximate anchor times (seconds into the shift); each is jittered.
	Anchors = { 90, 210, 330 },
	Jitter = 25,
	MaxBonusScore = 10,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">GameSettings</string><ProtectedString name="Source"><![CDATA[--!strict
-- Global tunables.
return {
	ShiftDuration = 480,
	ClockStart = 7,
	ClockEnd = 19,
	ParentsWarningAt = 450,
	CutsceneLength = 7,
	MaxSessions = 4,
	MaxPlayersPerShift = 6,
	QueueCountdown = 15,
	SessionSpacing = 1000,
	InteractRange = 12,
	RateLimitPerSecond = 10,
	NeedReplicateRate = 4, -- per second
	AITickRate = 0.25,
	NeedTickRate = 0.25,
	ResultsTimeout = 25,
	AutosaveInterval = 60,
	LeaderboardInterval = 60,
	MaxFires = 25,
	MaxPuddles = 60,
	MaxTrash = 40,
	FurnitureMaxHP = 100,
	WalkSpeed = 16,
	RunSpeed = 24,
	DebugUserIds = {} :: { number }, -- extra user ids allowed to use the F2 debug menu outside Studio
	RunTestsOnStart = false, -- set true (or Workspace attribute RunTests=true) to run unit tests in Studio
	DataStoreName = "MonstergartenPlayerData_v1",
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[--!strict
-- Game Pass / Developer Product ids. 0 = not created yet -> hidden in UI.
-- The author creates them on the Creator Dashboard and pastes the ids here.

return {
	GamePasses = {
		VIP = 0, -- gold name, VIP apron, +1 pet slot
		HeadNanny = 0, -- choose which babies come to the shift
		MusicBox = 0, -- pick lobby music
		CoinPouch = 0, -- +50% coins from shifts
	},
	Products = {
		CoinsSmall = 0,
		CoinsMedium = 0,
		CoinsLarge = 0,
	},
	-- Premium cosmetics sold as Developer Products: CosmeticId -> product id
	PremiumCosmetics = {
		Hat_Witch = 0,
		Skin_DragonExtinguisher = 0,
		Skin_MoonFlashlight = 0,
		PetAcc_Crown = 0,
	},
	CoinPouchBonus = 0.5,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Needs</string><ProtectedString name="Source"><![CDATA[--!strict
-- Need definitions. Base decay is per second at multiplier 1.

export type NeedDef = {
	Id: string,
	Base: number,
	Emoji: string,
	Color: Color3,
	Station: string?, -- CollectionService tag of the station that refills it (passive)
	Rate: number?, -- refill per second at station
}

local Needs: { [string]: NeedDef } = {
	Hunger = { Id = "Hunger", Base = 0.70, Emoji = "🍖", Color = Color3.fromRGB(255, 170, 90) },
	Sleep = { Id = "Sleep", Base = 0.50, Emoji = "💤", Color = Color3.fromRGB(140, 150, 255), Station = "Bed", Rate = 8 },
	Fun = { Id = "Fun", Base = 0.80, Emoji = "🧸", Color = Color3.fromRGB(255, 120, 170) },
	Clean = { Id = "Clean", Base = 0.45, Emoji = "🫧", Color = Color3.fromRGB(120, 210, 255) },
	Warmth = { Id = "Warmth", Base = 0.60, Emoji = "🔥", Color = Color3.fromRGB(255, 110, 60), Station = "Fireplace", Rate = 10 },
	Darkness = { Id = "Darkness", Base = 0.60, Emoji = "🌙", Color = Color3.fromRGB(110, 90, 160), Station = "DarkZone", Rate = 10 },
	Charge = { Id = "Charge", Base = 0.60, Emoji = "🔋", Color = Color3.fromRGB(255, 225, 80), Station = "ChargingStation", Rate = 12 },
	Sun = { Id = "Sun", Base = 0.60, Emoji = "☀️", Color = Color3.fromRGB(255, 220, 120), Station = "SunSpot", Rate = 10 },
	Water = { Id = "Water", Base = 0.60, Emoji = "💧", Color = Color3.fromRGB(90, 170, 255) },
	Cold = { Id = "Cold", Base = 0.60, Emoji = "🧊", Color = Color3.fromRGB(170, 230, 255), Station = "ColdSpot", Rate = 10 },
	Bandages = { Id = "Bandages", Base = 0.60, Emoji = "🩹", Color = Color3.fromRGB(240, 225, 190) },
}

local Order = { "Hunger", "Sleep", "Fun", "Clean", "Warmth", "Darkness", "Charge", "Sun", "Water", "Cold", "Bandages" }

-- Thresholds (see GDD section 4).
local Thresholds = {
	Happy = 70,
	Bubble = 35,
	Crying = 15,
	TantrumEnd = 50,
}

-- Player scaling of decay by number of nannies in the shift.
local PlayerScale = { 0.80, 0.90, 1.0, 1.05, 1.10, 1.15 }

-- Amounts restored by actions.
local Restore = {
	FeedFavorite = 60,
	FeedSuitable = 25,
	FeedCake = 40,
	FeedRaw = 20,
	FeedWrong = -10,
	ToyFun = 45,
	PlayFun = 30,
	Wash = 80,
	Water = 60,
	Bandage = 80,
	SleepLullaby = 14,
	IceFeedCold = 40,
}

return {
	Defs = Needs,
	Order = Order,
	Thresholds = Thresholds,
	PlayerScale = PlayerScale,
	Restore = Restore,
	AsleepOtherDecay = 0.5,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[--!strict
-- Daycare levels (by total stars) and nanny levels (by XP).

export type DaycareLevel = { Level: number, Stars: number, Unlocks: { string } }

-- Unlock ids: "Baby:<Id>", "Tool:<Id>", "Difficulty:<Id>", "Room:<Id>", "Shop:<UpgradeId>", "Cosmetic:<Id>"
local DaycareLevels: { DaycareLevel } = {
	{ Level = 1, Stars = 0, Unlocks = { "Baby:Dragling", "Baby:Slimy", "Baby:Ghostie", "Difficulty:Easy" } },
	{ Level = 2, Stars = 5, Unlocks = { "Tool:Hammer", "Tool:Lullaby" } },
	{ Level = 3, Stars = 12, Unlocks = { "Baby:Vampy", "Tool:Net", "Difficulty:Normal" } },
	{ Level = 4, Stars = 20, Unlocks = { "Baby:Octo" } },
	{ Level = 5, Stars = 30, Unlocks = { "Room:Basement" } },
	{ Level = 6, Stars = 42, Unlocks = { "Baby:Golem", "Tool:TrashBag" } },
	{ Level = 7, Stars = 56, Unlocks = { "Shop:SecondOven" } },
	{ Level = 8, Stars = 72, Unlocks = { "Baby:Sparky" } },
	{ Level = 9, Stars = 90, Unlocks = { "Difficulty:Nightmare" } },
	{ Level = 10, Stars = 110, Unlocks = { "Baby:Sprout", "Room:Greenhouse", "Tool:Shears", "Tool:WateringCan" } },
	{ Level = 11, Stars = 135, Unlocks = { "Shop:AutoFeeder" } },
	{ Level = 12, Stars = 160, Unlocks = { "Baby:Yeti", "Room:IceMat" } },
	{ Level = 13, Stars = 190, Unlocks = { "Shop:FireproofFurniture" } },
	{ Level = 14, Stars = 225, Unlocks = { "Baby:Mummy", "Tool:BandageRoll" } },
	{ Level = 15, Stars = 265, Unlocks = { "Cosmetic:GoldenSign" } },
}

local NannyTitles = {
	{ Level = 1, Key = "Title_Rookie" },
	{ Level = 5, Key = "Title_Helper" },
	{ Level = 10, Key = "Title_Whisperer" },
	{ Level = 15, Key = "Title_Tamer" },
	{ Level = 20, Key = "Title_ChaosLord" },
	{ Level = 30, Key = "Title_Legend" },
}

-- Rewards granted on reaching a nanny level (coins unless a cosmetic is listed).
local NannyLevelRewards: { [number]: { Coins: number?, Cosmetic: string? } } = {
	[2] = { Coins = 100 },
	[3] = { Cosmetic = "Hat_Bow" },
	[4] = { Coins = 150 },
	[5] = { Cosmetic = "Apron_Stars" },
	[6] = { Coins = 200 },
	[7] = { Cosmetic = "Hat_Beanie" },
	[8] = { Coins = 250 },
	[10] = { Cosmetic = "Uniform_Night" },
	[12] = { Coins = 400 },
	[15] = { Cosmetic = "Hat_Crown" },
}

return {
	DaycareLevels = DaycareLevels,
