	},
	Mummy = {
		Id = "Mummy",
		Name = { en = "Mumbles", lt = "Mumijukas" },
		UnlockLevel = 14,
		Rarity = "Epic",
		Needs = { Bandages = 1, Sleep = 1, Fun = 1 },
