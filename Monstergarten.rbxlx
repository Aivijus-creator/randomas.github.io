	},
	Slimy = {
		Id = "Slimy",
		Name = { en = "Slimy", lt = "Slaimukas" },
		UnlockLevel = 1,
		Rarity = "Common",
		Needs = { Hunger = 2, Clean = 1 },
		FavoriteFood = "ANY",
		Eats = true,
		WalkSpeed = 4.5,
		WanderRadius = 14,
		CarrySlowdown = 0.1,
		Flammable = false,
		Curiosity = 0.3,
		Color = Color3.fromRGB(140, 230, 120),
		Chaos = "EatFurniture",
		ChaosInterval = 1,
		Emoji = "🟢",
	},
	Ghostie = {
		Id = "Ghostie",
		Name = { en = "Ghostie", lt = "Vaiduokliukas" },
		UnlockLevel = 1,
		Rarity = "Common",
		Needs = { Fun = 1.5, Sleep = 1 },
		FavoriteFood = nil,
		Eats = false,
		WalkSpeed = 7,
		WanderRadius = 30,
		CarrySlowdown = 0,
		Flammable = false,
		Curiosity = 0.8,
		Color = Color3.fromRGB(235, 240, 255),
		Chaos = "Haunt",
		ChaosInterval = 10,
		Emoji = "👻",
	},
	Vampy = {
		Id = "Vampy",
		Name = { en = "Vampy", lt = "Vampyriukas" },
		UnlockLevel = 3,
		Rarity = "Uncommon",
		Needs = { Hunger = 1, Darkness = 1, Sleep = 1 },
		FavoriteFood = "BeetJuice",
		Eats = true,
		WalkSpeed = 6,
		WanderRadius = 18,
		CarrySlowdown = 0,
		Flammable = false,
		Curiosity = 0.4,
		Color = Color3.fromRGB(150, 110, 190),
		Chaos = "Wail",
		ChaosInterval = 7,
		Emoji = "🦇",
	},
	Octo = {
		Id = "Octo",
		Name = { en = "Octo", lt = "Aštuonkojukas" },
		UnlockLevel = 4,
		Rarity = "Uncommon",
		Needs = { Clean = 1.5, Fun = 1, Hunger = 1 },
		FavoriteFood = "FishMash",
		Eats = true,
		WalkSpeed = 5.5,
		WanderRadius = 16,
		CarrySlowdown = 0,
		Flammable = false,
		Curiosity = 0.6,
		Color = Color3.fromRGB(255, 160, 200),
