<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
-- Shared type definitions.

-- What a player holds: Kind + Id (+ optional extra like baby uid or trash count).
export type Held = {
	Kind: "Tool" | "Ingredient" | "Dish" | "Baby" | "Trash",
	Id: string,
	Extra: any?,
}

export type QueueState = {
	DoorId: string,
	Host: number,
	Players: { number },
	Difficulty: string,
	Countdown: number,
	Solo: boolean,
	Tutorial: boolean,
	Waiting: boolean,
	PreferredBabies: { string }?,
}

export type ShiftResults = {
	Stars: number,
	FinalScore: number,
	BuildingScore: number,
	Babies: { { BabyId: string, Score: number, Emoji: string } },
	Coins: number,
	XP: number,
	MVP: number?,
	EventCoins: number,
	Tutorial: boolean,
}

return nil
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX39"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">Maid</string><ProtectedString name="Source"><![CDATA[--!strict
-- Maid: collects connections / instances / functions / threads and cleans them all at once.
local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} :: { any } }, Maid)
end

function Maid:Give<T>(item: T): T
	table.insert(self._tasks, item)
	return item
end

local function cleanup(item: any)
	local t = typeof(item)
	if t == "RBXScriptConnection" then
		item:Disconnect()
	elseif t == "Instance" then
		item:Destroy()
	elseif t == "function" then
		item()
	elseif t == "thread" then
		pcall(task.cancel, item)
	elseif t == "table" then
		if item.Destroy then
			item:Destroy()
		elseif item.Disconnect then
			item:Disconnect()
		end
	end
end

function Maid:Clean()
	local tasks = self._tasks
	self._tasks = {}
	for i = #tasks, 1, -1 do
		local ok, err = pcall(cleanup, tasks[i])
		if not ok then
			warn("[Maid] cleanup error:", err)
		end
	end
end

Maid.Destroy = Maid.Clean

return Maid
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">Math</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pure math helpers (no Roblox dependencies except optional Vector3 use by callers).
local MathUtil = {}

function MathUtil.clamp(x: number, a: number, b: number): number
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

function MathUtil.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function MathUtil.round(x: number, step: number?): number
	local s = step or 1
	return math.floor(x / s + 0.5) * s
end

-- Is `point` within a cone starting at `origin` facing `dir` (unit), with half-angle in degrees and range?
function MathUtil.inCone(origin: Vector3, dir: Vector3, point: Vector3, range: number, halfAngleDeg: number): boolean
	local offset = point - origin
	local dist = offset.Magnitude
	if dist > range then
		return false
	end
	if dist < 0.5 then
		return true
	end
	local cos = offset.Unit:Dot(dir)
	return cos >= math.cos(math.rad(halfAngleDeg))
end

function MathUtil.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function MathUtil.formatClock(hours: number): string
	local h = math.floor(hours)
	local m = math.floor((hours - h) * 60)
	return string.format("%02d:%02d", h, m)
end

function MathUtil.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

function MathUtil.weightedPick<T>(items: { T }, weightOf: (T) -> number, rng: Random?): T?
	local total = 0
	for _, it in items do
		total += weightOf(it)
	end
	if total <= 0 then
		return nil
	end
	local r = (rng and rng:NextNumber() or math.random()) * total
	for _, it in items do
		r -= weightOf(it)
		if r <= 0 then
			return it
		end
	end
	return items[#items]
end

return MathUtil
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- Minimal Lua signal (no BindableEvent, no instance overhead).
local Signal = {}
Signal.__index = Signal

export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} :: { [any]: (...any) -> () } }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local key = {}
	self._handlers[key] = fn
	local conn = { Connected = true }
	local handlers = self._handlers
	function conn:Disconnect()
		self.Connected = false
		handlers[key] = nil
	end
	return conn
end

function Signal:Once(fn: (...any) -> ())
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...: any)
	for _, fn in self._handlers do
		task.spawn(fn, ...)
	end
end

function Signal:Wait(): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	table.clear(self._handlers)
end

return Signal
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">TableUtil</string><ProtectedString name="Source"><![CDATA[--!strict
local TableUtil = {}

function TableUtil.deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in t :: any do
		out[TableUtil.deepCopy(k)] = TableUtil.deepCopy(v)
	end
	return (out :: any) :: T
end

-- Fill missing keys in `target` from `template` (recursive). Existing values are kept.
function TableUtil.reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in template do
		if target[k] == nil then
			target[k] = TableUtil.deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and next(v) ~= nil and #v == 0 then
			TableUtil.reconcile(target[k], v)
		end
	end
	return target
end

function TableUtil.keys<K>(t: { [K]: any }): { K }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	return out
end

function TableUtil.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

function TableUtil.shuffle<T>(t: { T }, rng: Random?): { T }
	for i = #t, 2, -1 do
		local j = rng and rng:NextInteger(1, i) or math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

function TableUtil.find<T>(t: { T }, pred: (T) -> boolean): (T?, number?)
	for i, v in t do
		if pred(v) then
			return v, i
		end
	end
	return nil, nil
end

function TableUtil.map<T, U>(t: { T }, fn: (T) -> U): { U }
	local out = {}
	for i, v in t do
		out[i] = fn(v)
	end
	return out
end

return TableUtil
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Tween</string><ProtectedString name="Source"><![CDATA[--!strict
-- Small TweenService helpers.
local TweenService = game:GetService("TweenService")

local Tween = {}

function Tween.play(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function Tween.info(time: number, style: Enum.EasingStyle?, dir: Enum.EasingDirection?, repeats: number?, reverses: boolean?): TweenInfo
	return TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out, repeats or 0, reverses or false)
end

function Tween.loop(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?): Tween
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), props)
	tw:Play()
	return tw
end

-- Button "squish" feedback.
function Tween.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = gui
	end
	local s = scale :: UIScale
	s.Scale = 0.88
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return Tween
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX45"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">CharacterBuilder</string><ProtectedString name="Source"><![CDATA[-- CharacterBuilder: turns the author's character designs (CharacterData, imported from the 3D character
-- sheet) into Roblox models that follow the model contract:
--   PrimaryPart "HumanoidRootPart" (anchored, invisible), a "Body" part welded to it with the Weld
--   "BodyJoint" (procedural animations move it), every visible part welded to Body,
--   attachments HeadTop / Mouth / Hands, and the FloorOffset attribute.
local CharacterData = require(script.Parent.CharacterData)
local Babies = require(script.Parent.Parent.Config.Babies)

local CharacterBuilder = {}

local function newPart(className: string): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	return p
end

function CharacterBuilder.has(folder: string, id: string): boolean
	local f = (CharacterData :: any)[folder]
	return f ~= nil and f[id] ~= nil
end

function CharacterBuilder.build(folder: string, id: string): Model?
	local f = (CharacterData :: any)[folder]
	local def = f and f[id]
	if not def then
		return nil
	end
	local s: number = def.Scale
	local lift: number = def.Lift or 0
	local height = def.Height * s
	local centerY = height / 2 + lift

	local m = Instance.new("Model")
	m.Name = id
	local root = newPart("Part")
	root.Name = "HumanoidRootPart"
	root.Anchored = true
	root.Massless = false
	root.Transparency = 1
	root.Size = if folder == "Babies" then Vector3.new(2, 2, 1) else Vector3.new(2, 2, 1) * math.max(1, s / 2)
	root.CFrame = CFrame.new(0, centerY, 0)
	root.Parent = m
	m.PrimaryPart = root

	local body = newPart("Part")
	body.Name = "Body"
	body.Transparency = 1
	body.Size = Vector3.new(0.2, 0.2, 0.2)
	body.CFrame = root.CFrame
	body.Parent = m
	local joint = Instance.new("Weld")
	joint.Name = "BodyJoint"
	joint.Part0 = root
	joint.Part1 = body
	joint.C0 = CFrame.new()
	joint.Parent = root

	local rad = math.rad
	for i, p in def.Parts do
		local shape, pos, size, hex, rot, transparency, glow = p[1], p[2], p[3], p[4], p[5], p[6], p[7]
		if transparency >= 1 then
			continue
		end
		local part = newPart("Part")
		part.Name = "P" .. i
		local sz = Vector3.new(size[1], size[2], size[3]) * s
		if shape == "b" then
			part.Size = sz
		elseif shape == "c" then
			part.Shape = Enum.PartType.Cylinder -- axis along X, same as the sheet
			part.Size = sz
		else
			-- ellipsoid: a SpecialMesh sphere stretches to the part size
			part.Size = sz
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		part.Color = Color3.fromHex(hex)
		part.Transparency = transparency
		if glow == 1 then
			part.Material = Enum.Material.Neon
		end
		part.CFrame = CFrame.new(pos[1] * s, pos[2] * s + lift, pos[3] * s) * CFrame.Angles(rad(rot[1]), rad(rot[2]), rad(rot[3]))
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = part
		w.Parent = part
		part.Parent = m
	end

	-- attachments relative to the root
	local width = def.Width * s
	for _, info in {
		{ "HeadTop", Vector3.new(0, height / 2 + 0.3, 0) },
		{ "Mouth", Vector3.new(0, height * 0.1, -width * 0.4) },
		{ "Hands", Vector3.new(0, -height * 0.1, -width * 0.35) },
	} do
		local a = Instance.new("Attachment")
		a.Name = info[1]
		a.Position = info[2]
		a.Parent = root
	end

	if folder == "Babies" then
		local bdef = Babies.Defs[id]
		local bb = Instance.new("BillboardGui")
		bb.Name = "NameTag"
		bb.Size = UDim2.fromOffset(100, 22)
		bb.StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 1, 0)
		bb.MaxDistance = 40
		bb.LightInfluence = 0
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.fromScale(1, 1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.4
		tl.Text = if bdef then bdef.Emoji else id
		tl.Parent = bb
		bb.Parent = root
	end

	m:SetAttribute("FloorOffset", centerY)
	m:SetAttribute("Designed", true)
	m:SetAttribute("DisplayName", def.Name)
	return m
end

return CharacterBuilder
]]></ProtectedString></Properties></Item>
