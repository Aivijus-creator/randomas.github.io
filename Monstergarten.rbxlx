	NannyLevelRewards = NannyLevelRewards,
	XPBase = 100,
	XPExponent = 1.3,
	ShiftXPBase = 20,
	ShiftXPMax = 150,
	FriendshipToAdopt = 5,
	DailyRewards = { 50, 75, 100, 150, 200, 300, 500 },
	TutorialReward = 200,
	MVPBonus = 0.2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!strict
