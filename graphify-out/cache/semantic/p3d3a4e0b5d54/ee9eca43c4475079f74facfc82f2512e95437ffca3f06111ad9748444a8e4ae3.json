{"nodes": [{"id": "_claude_skills_3d_modeling_references_patterns_patterns_reference", "label": "3D Modeling Patterns Reference", "file_type": "document", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L1-L1029", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_topology_for_deformation", "label": "Topology for Deformation", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L7-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edge loops must follow muscle flow and joint rotation axes; min 3 loops per joint (5 for 180-degree bends); poles go in low-deformation areas, never at joints/lips/eyes."}, {"id": "_claude_skills_3d_modeling_references_patterns_pole_placement", "label": "Pole Placement (3-poles / 5-poles)", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L49-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_modular_asset_workflow", "label": "Modular Asset Workflow", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L80-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grid-based reusable pieces that snap together seamlessly; model in target engine units from the start; matching edges need identical vertex counts."}, {"id": "_claude_skills_3d_modeling_references_patterns_weld_modular_pieces", "label": "weld_modular_pieces (Blender Python)", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L132-L142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_lod_creation_strategy", "label": "LOD Creation Strategy", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L147-L219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LOD chain 100/50/25/12/5%; silhouette edges never removed; automatic LOD for static props, manual for characters, weapons, vehicles, hero props."}, {"id": "_claude_skills_3d_modeling_references_patterns_hard_surface_workflow", "label": "Hard Surface Modeling Workflow", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L223-L291", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive modifier stack (Mirror, Array, Boolean, Bevel, Weighted Normal, Triangulate, Subdivision); Exact boolean solver; weight-based bevels."}, {"id": "_claude_skills_3d_modeling_references_patterns_floating_geometry_technique", "label": "Floating Geometry Technique", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L279-L291", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_organic_sculpting_workflow", "label": "Organic Sculpting Workflow", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L295-L369", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three phases: primary forms (subdiv 1-2), secondary (3-4), tertiary detail (5-7); plan retopology during sculpt via polygroups/polypaint."}, {"id": "_claude_skills_3d_modeling_references_patterns_uv_unwrapping_strategy", "label": "UV Unwrapping Strategy", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L373-L475", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maximize texture resolution, hide seams in creases/material boundaries, keep consistent texel density; padding scales with texture resolution."}, {"id": "_claude_skills_3d_modeling_references_patterns_texel_density_standards", "label": "Texel Density Standards", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L384-L399", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Texel Density = Texture Resolution / World Size; hero chars 10.24 px/cm, NPCs 5.12, environment 2.56."}, {"id": "_claude_skills_3d_modeling_references_patterns_check_texel_density", "label": "check_texel_density (Blender Python)", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L406-L424", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_udim_workflow", "label": "UDIM Workflow", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L460-L475", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_high_to_low_baking", "label": "High to Low Poly Baking", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L479-L569", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transfer sculpt detail via normal/AO/curvature bakes; transforms applied, _high/_low/_cage naming, non-overlapping UVs, cage fully encompassing high poly."}, {"id": "_claude_skills_3d_modeling_references_patterns_bake_cage", "label": "Baking Cage", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L508-L530", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_retopology_workflow", "label": "Retopology Best Practices", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L573-L652", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual retopo for faces, joints and blend shapes; automatic (ZRemesher, Quad Remesher) acceptable for props and background assets."}, {"id": "_claude_skills_3d_modeling_references_patterns_character_poly_budgets", "label": "Character Poly Budgets", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L586-L609", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_export_pipeline", "label": "Export Pipeline Standards", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L656-L768", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Universal pre-export checklist (transforms applied, scale 1, outward normals, no n-gons, no non-manifold); FBX for Unreal/Unity, glTF for Godot/web, USD for film."}, {"id": "_claude_skills_3d_modeling_references_patterns_format_selection", "label": "Export Format Selection (FBX, glTF, OBJ, USD)", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L681-L702", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_naming_conventions", "label": "Asset Naming Conventions", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L772-L865", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[Prefix]_[AssetName]_[Variant]_[LOD/Type]; SM_/SK_/T_/M_ prefixes, single-letter texture suffixes, _LOD# suffixes; version-control friendly names."}, {"id": "_claude_skills_3d_modeling_references_patterns_n_gon_modeling", "label": "Anti-pattern: Modeling with N-gons", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L872-L893", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N-gons cause subdivision artifacts, inconsistent triangulation, shading discontinuities and unpredictable deformation."}, {"id": "_claude_skills_3d_modeling_references_patterns_unapplied_transforms", "label": "Anti-pattern: Exporting with Unapplied Transforms", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L896-L913", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_overlapping_uvs_baking", "label": "Anti-pattern: Overlapping UVs for Unique Bakes", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L917-L935", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_bad_boolean_cleanup", "label": "Anti-pattern: Poor Boolean Cleanup", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L938-L961", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_references_patterns_texel_density_inconsistency", "label": "Anti-pattern: Inconsistent Texel Density", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/references/patterns.md", "source_location": "L964-L983", "source_url": null, "captured_at": null, "author": null, "contr