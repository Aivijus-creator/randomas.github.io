{"nodes": [{"id": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "label": "3D Modeling Skill", "file_type": "document", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L1-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_skill_senior_3d_artist_persona", "label": "Senior 3D Artist / Technical Artist Persona", "file_type": "concept", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L11-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_skill_reference_system_usage", "label": "Reference System Usage", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L56-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference files are treated as source of truth: patterns.md for creation, sharp_edges.md for diagnosis, validations.md for review; user requests conflicting with them are corrected."}, {"id": "_claude_skills_3d_modeling_skill_always_apply_scale_rotation", "label": "Always Apply Scale and Rotation Before Export", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Battle scar: lost 3 days because a client FBX had scale 0.01, discovered only after baking."}, {"id": "_claude_skills_3d_modeling_skill_quads_required_for_deformation", "label": "Quads Required for Deforming Meshes", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L41-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quads are a requirement for anything that deforms; triangles OK only intentionally on static hard surface; n-gons never acceptable in final production geometry."}, {"id": "_claude_skills_3d_modeling_skill_texel_density_consistency_opinion", "label": "Texel Density Consistency", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Texel density inconsistency is the mark of amateur work; a team had to redo an LOD pipeline when QA rejected unstandardized texel density."}, {"id": "_claude_skills_3d_modeling_skill_non_destructive_workflows", "label": "Non-Destructive Workflows", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L47-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-destructive workflows save careers; if a boolean result needs cleanup, the boolean approach was wrong."}, {"id": "_claude_skills_3d_modeling_skill_bad_topology_over_poly_count", "label": "Bad Topology Matters More Than Poly Count", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L46,L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clean 5k tri model beats a messy 3k tri model; high poly counts aren't the enemy, bad topology at any count is."}, {"id": "_claude_skills_3d_modeling_skill_inverted_normals_after_mirroring", "label": "Inverted Normals After Mirroring (battle scar)", "file_type": "concept", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_skill_non_manifold_edges_physics", "label": "Non-Manifold Edges Breaking Physics (battle scar)", "file_type": "concept", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_3d_modeling_skill_automatic_uv_unwrap_lazy", "label": "Automatic UV Unwrap Is for Prototyping Only", "file_type": "rationale", "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto UV tools are fine for prototyping but lazy for production; Substance Painter can't fix bad UVs."}], "edges": [{"source": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "target": "_claude_skills_3d_modeling_skill_senior_3d_artist_persona", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "target": "_claude_skills_3d_modeling_skill_reference_system_usage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "target": "_claude_skills_3d_modeling_skill_always_apply_scale_rotation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "target": "_claude_skills_3d_modeling_skill_quads_required_for_deformation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_3d_modeling_skill_3d_modeling_skill", "target": "_claude_skills_3d_modeling_skill_texel_density_consistency_opinion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/3d-modeling/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_3d_modeling_skill_3d_mode