{"nodes": [{"id": "_claude_skills_ponytail_skill", "label": "Ponytail skill (lazy senior dev mode)", "file_type": "document", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_ponytail_skill_smallest_complete_change", "label": "Smallest complete change ladder", "file_type": "rationale", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L23-L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Take the first option that fully works: skip unasked features, reuse codebase helpers, then stdlib/platform, then installed deps, then a one-liner, else minimum code. Be lazy about the solution, never about completing the change (callers, tests, fixtures)."}, {"id": "_claude_skills_ponytail_skill_before_you_write", "label": "Before you write: scope check", "file_type": "rationale", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L19-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "List every place the change must reach (callers, tests, fixtures, config, exports) and what it could break for users; that is scope, extra features are not."}, {"id": "_claude_skills_ponytail_skill_never_cut", "label": "Never-cut list", "file_type": "rationale", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation at trust boundaries, error handling preventing data loss, security, accessibility, hardware calibration and anything the user asked for are never cut for brevity."}, {"id": "_claude_skills_ponytail_skill_shortcut_comment", "label": "Shortcut comment convention", "file_type": "concept", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shortcut with a known limit gets a comment 'shortcut: <the limit>, <when to upgrade>'."}, {"id": "_claude_skills_ponytail_skill_self_check_rule", "label": "Lazy code needs a self-check", "file_type": "rationale", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New non-trivial logic leaves one small test or assert-based self-check; trivial changes need none."}, {"id": "_claude_skills_ponytail_skill_levels", "label": "Ponytail levels (lite, full, ultra)", "file_type": "concept", "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L46-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lite builds what was asked and names the smaller option; full applies the rules (default); ultra also pushes back on unjustified parts of the request."}], "edges": [{"source": "_claude_skills_ponytail_skill", "target": "_claude_skills_ponytail_skill_smallest_complete_change", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L23", "weight": 1.0}, {"source": "_claude_skills_ponytail_skill", "target": "_claude_skills_ponytail_skill_before_you_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L19", "weight": 1.0}, {"source": "_claude_skills_ponytail_skill", "target": "_claude_skills_ponytail_skill_never_cut", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/ponytail/SKILL.md", "source_location": "L44", "weight": 1.0}, {"source": "_claude_skills_ponytail_skill", "target": "_claude_skills_ponytail_skill_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"